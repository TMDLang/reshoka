    /* 第 4 段 */
    | 1,, - 0 - 5,, - 0 - | 1,, - 0 - 1,, - - - | 5,, - 0 - 5,, - 0 - | 1,, - 5,, - 1,, - 0 - |

    /* 後奏 */
