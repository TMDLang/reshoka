    /* 前奏 */
    | 1,, - 0 - 5,, - 0 - | 4,, - 0 - 1,, - 0 - | 5,, - 0 - 5,, - 0 - | 1,, - - - - - 0 - |

    /* 第 1 段 */
    | 1,, - 0 - 5,, - 0 - | 1,, - 0 - 4,, - 0 - | 1,, - 0 - 5,, - 0 - | 1,, - 5,, - 1,, - 0 - |

    /* 第 2 段 */
