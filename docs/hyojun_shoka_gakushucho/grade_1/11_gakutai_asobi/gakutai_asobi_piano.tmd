** がくたいあそび（伴奏） **
!= 100
?= D
<2/4>
~ "詞：こどもの唱歌"
~ "曲：こどもの唱歌"

GakutaiAsobi:Vocal@|0|{
    <16*>
    /* 前奏 (4 小節) */
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - 0 - |
    L1| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |
    L2| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |

    /* 第 1 段 */
    | 1 - - 1 3 - - 3 | 5 - - 5 6 - - 6 | 5 - - 5 3 - - 3 | 1 - - - - - 0 - |
    L1| ヒョウ - - - シ - - オ | ソ - - ロ エ - - テ | イ - - ザ ス - - ス | メ - - - - - _ - |
    L2| ア - - シ ナ - - ミ | ソ - - ロ エ - - テ | イ - - ザ ス - - ス | メ - - - - - _ - |

    /* 第 2 段 */
    | 1' - - 7 6 - - 5 | 4 - - 3 2 - - 1 | 5 - 5 - 6 - - 7 | 1' - - - - - 0 - |
    L1| ガ - - ク タ - - イ | ア - - ソ ビ - - ワ | オ - モ - シ - - ロ | イ - - - - - _ - |
    L2| ガ - - ク タ - - イ | ア - - ソ ビ - - ワ | イ - サ - マ - - シ | イ - - - - - _ - |

    /* 第 3 段 */
    | 1 - - 1 1 - - 1 | 1 - - 1 1 - - - | 5 - - 5 5 - - 5 | 1 - - - - - 0 - |
    L1| タ - - イ コ - - ノ | オ - - ト ワ - - - | ド - - ン ド - - ゴ | ドン - - - - - _ - |
    L2| タ - - イ コ - - ノ | オ - - ト ワ - - - | ド - - ン ド - - コ | ドン - - - - - _ - |

    /* 第 4 段 */
    | 1 - - 1 5 - - 5 | 1' - - 5 3 - - - | 1 - - 1 1 - - 1 | 1 - - - - - 0 - |
    L1| ラ - - ッ パ - - ノ | オ - - ト ワ - - - | ト - - テ チ - - テ | タ - - - - - _ - |
    L2| ラ - - ッ パ - - ノ | オ - - ト ワ - - - | ト - - テ チ - - テ | タ - - - - - _ - |

    /* 後奏 (2 小節) */
    | 0 - - - - - - - | 0 - - - - - - - |
    L1| _ - - - - - - - | _ - - - - - - - |
    L2| _ - - - - - - - | _ - - - - - - - |
}

GakutaiAsobi:PianoRH@|0|{
    <16*>
    /* 前奏 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 0 - | 1+4+6 - 1+4+6 - 1+4+6 - 0 - | 2+4+5 - 2+4+5 - 1+3+5 - 2+4+5 - | 1+3+5 - - - - - 0 - |

    /* 第 1 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+4+6 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - - - - - 0 - |

    /* 第 2 段 */
    | 1+3+5 - 0 - 1+4+6 - 0 - | 7,+2+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 1+3+5 - 7,+2+5 - 7,+2+5 - | 1+3+5 - - - - - 0 - |

    /* 第 3 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+3+5 - - - | 7,+2+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - - - - - 0 - |

    /* 第 4 段 */
