** いぬ（伴奏） **
!= 120
?= D
<4/4>
~ "詞：文部省尋常小學唱歌"
~ "曲：文部省尋常小學唱歌"

Inu:Vocal@|0|{
    <8*>
    /* 前奏 (4 小節) */
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - 0 - |
    L1| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |
    L2| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |

    /* 第 1 行 */
    | 1 - - - 3 - 1 - | 1 - - 3 2 - 2 - | 1 - - 3 2 - 2 - | 1 - - - - - 0 - |
    L1| ソ - - - ト - エ - | デ - - ル ト - キ - | ト - - ン デ - キ - | テ - - - - - _ - |
    L2| ウ - - - チ - エ - | カ - - エ ル - ト - | オ - - オ フ - ッ - | テ - - - - - _ - |

    /* 第 2 行 */
    | 3 - - 4 5 - 6 - | 5 - - 6 5 - 3 - | 4 - 3 - 2 - 1 - | 2 - - - - - 0 - |
    L1| オ - - ッ テ - モ - | オ - - ッ テ - モ - | ツ - イ - テ - ク - | ル - - - - - _ - |
    L2| タ - - モ ト - ニ - | ス - - ガ ッ - テ - | ウ - レ - シ - ガ - | ル - - - - - _ - |

    /* 第 3 行 */
    | 1 - - 3 1 - 0 - | 3 - - 5 3 - 0 3 | 5 - 4 - 3 - 2 - | 1 - - - - - 0 - |
    L1| ポ - - チ ワ - _ - | ホ - - ン ト - _ ニ | カ - ワ - イ - イ - | ナ - - - - - _ - |
    L2| ポ - - チ ワ - _ - | ホ - - ン ト - _ ニ | カ - ワ - イ - イ - | ナ - - - - - _ - |

    /* 後奏 (2 小節) */
    | 0 - - - - - - - | 0 - - - - - - - |
    L1| _ - - - - - - - | _ - - - - - - - |
    L2| _ - - - - - - - | _ - - - - - - - |
}

Inu:PianoRH@|0|{
    <8*>
    /* 前奏 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 2+4+5 - 0 - 1+3+5 - 2+4+5 - | 1+3+5 - - - - - 0 - |

    /* 第 1 行 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - - - - - 0 - |

    /* 第 2 行 */
    | 1+3+5 - 0 - 1+4+6 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 1+4+6 - 1+3+5 - 7,+2+5 - 1+3+5 - | 7,+2+5 - - - - - 0 - |

    /* 第 3 行 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 1+4+6 - 1+3+5 - 7,+2+5 - 7,+2+5 - | 1+3+5 - - - - - 0 - |

    /* 後奏 */
    | 1+3+5 - 1+4+6 - 1+3+5 - 7,+2+5 - | 1+3+5 - - - - - 0 - |
}

Inu:PianoLH@|0|{
    <8*>
    /* 前奏 */
    | 1, - 0 - 5,, - 0 - | 4,, - 0 - 1,, - 0 - | 5,, - 0 - 5,, - 0 - | 1,, - - - - - 0 - |

    /* 第 1 行 */
    | 1,, - 0 - 5,, - 0 - | 1,, - 0 - 5,, - 0 - | 1,, - 0 - 5,, - 0 - | 1,, - 5,, - 1,, - 0 - |

    /* 第 2 行 */
    | 1,, - 0 - 4,, - 0 - | 1,, - 0 - 1,, - 0 - | 4,, - 1,, - 5,, - 1,, - | 5,, - - - - - 0 - |

    /* 第 3 行 */
    | 1,, - 0 - 5,, - 0 - | 1,, - 0 - 1,, - 0 - | 4,, - 1,, - 5,, - 5,, - | 1,, - 5,, - 1,, - 0 - |

    /* 後奏 */
    | 1,, - 4,, - 1,, - 5,, - | 1,,+5,,+1, - - - - - 0 - |
}

-> Inu[L1] -> Inu[L2] -> #
