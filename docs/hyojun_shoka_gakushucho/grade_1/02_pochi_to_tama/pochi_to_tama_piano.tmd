** ポチとタマ（伴奏） **
!= 96
?= F
<2/4>
~ "詞：石原和三郎"
~ "曲：田村虎藏"

PochiToTama:Vocal@|0|{
    <16*>
    /* 前奏 (4 小節) */
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - 0 - |
    L1| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |
    L2| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |

    /* 第 1 行 (4 小節) */
    | 1 - 1 - 1 - 1 - | 2 - 2 - 1 - - - | 2 - 2 - 2 - 2 - | 3 - - - - - 0 - |
    L1| コ - ノ - コ - ハ - | ポ - チ - ト - - - | モ - オ - シ - マ - | ス - - - - - _ - |
    L2| コ - ノ - コ - ハ - | タ - マ - ト - - - | モ - オ - シ - マ - | ス - - - - - _ - |

    /* 第 2 行 (4 小節) */
    | 4 - 4 - 3 - 4 - | 4 - 4 - 4 - 3 - | 2 - 2 - 3 - 3 - | 3 - - - - - 0 - |
    L1| チ - ン - チ - ン - | オ - ア - ズ - ケ - | ミ - ナ - ジョ - ウ - | ズ - - - - - _ - |
    L2| マ - イ - ニ - チ - | ゲ - ン - キ - ニ - | ア - ソ - ビ - マ - | ス - - - - - _ - |

    /* 第 3 行 (4 小節) */
    | 4 - 4 - 3 - - - | 3 - 3 - 4 - 4 - | 2 - 2 - 2 - 2 - | 2 - - - - - 0 - |
    L1| イ - マ - ニ - - - | オ - ト - ナ - ニ - | ナ - ッ - タ - ナ - | ラ - - - - - _ - |
    L2| イ - マ - ニ - - - | オ - ト - ナ - ニ - | ナ - ッ - タ - ナ - | ラ - - - - - _ - |

    /* 第 4 行 (4 小節) */
    | 4 - 4 - 3 - 4 - | 4 - 4 - 3 - - - | 2 - 2 - 2 - 2 - | 1 - - - - - 0 - |
    L1| ゴ - モ - ン - ノ - | バ - ン - オ - - - | ヨ - ク - シ - マ - | ショ - - - - - _ - |
    L2| ネ - ズ - ミ - ノ - | バ - ン - オ - - - | ヨ - ク - シ - マ - | ショ - - - - - _ - |

    /* 後奏 (2 小節) */
    | 0 - - - - - - - | 0 - - - - - - - |
    L1| _ - - - - - - - | _ - - - - - - - |
    L2| _ - - - - - - - | _ - - - - - - - |
}

PochiToTama:PianoRH@|0|{
    <16*>
    /* 前奏 (4 小節) */
    | 4 - 4 - 3 - 4 - | 4 - 4 - 3 - - - | 2 - 2 - 2 - 2 - | 1 - - - - - 0 - |

    /* 第 1 行 (4 小節) */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 7_+2+4 - 0 - 1+3+5 - 0 - | 7_+2+5 - 0 - 7_+2+5 - 0 - | 1+3+5 - - - - - 0 - |

    /* 第 2 行 (4 小節) */
    | 1+4+6 - 0 - 1+4+6 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 7_+2+5 - 0 - 1+3+5 - 0 - | 1+3+5 - - - - - 0 - |

    /* 第 3 行 (4 小節) */
    | 1+4+6 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+4+6 - 0 - | 7_+2+5 - 0 - 7_+2+5 - 0 - | 7_+2+5 - - - - - 0 - |

    /* 第 4 行 (4 小節) */
    | 1+4+6 - 0 - 1+4+6 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 7_+2+4 - 0 - 7_+2+4 - 0 - | 1+3+5 - - - - - 0 - |

    /* 後奏 (2 小節) */
    | 7_+2+4 - 0 - 7_+2+5 - 0 - | 1+3+5 - - - - - 0 - |
}

PochiToTama:PianoLH@|0|{
    <16*>
    /* 前奏 (4 小節) */
    | 4__ - 0 - 1_ - 0 - | 4__ - 0 - 1_ - 0 - | 5__ - 0 - 5__ - 0 - | 1_ - - - - - 0 - |

    /* 第 1 行 (4 小節) */
    | 1_ - 0 - 5__ - 0 - | 5__ - 0 - 1_ - 0 - | 5__ - 0 - 2__ - 0 - | 1_ - - - - - 0 - |

    /* 第 2 行 (4 小節) */
    | 4__ - 0 - 1_ - 0 - | 4__ - 0 - 1_ - 0 - | 5__ - 0 - 1_ - 0 - | 1_ - - - - - 0 - |

    /* 第 3 行 (4 小節) */
    | 4__ - 0 - 1_ - 0 - | 1_ - 0 - 4__ - 0 - | 5__ - 0 - 2__ - 0 - | 5__ - - - - - 0 - |

    /* 第 4 行 (4 小節) */
    | 4__ - 0 - 1_ - 0 - | 4__ - 0 - 1_ - 0 - | 5__ - 0 - 5__ - 0 - | 1_ - - - - - 0 - |

    /* 後奏 (2 小節) */
    | 5__ - 0 - 5__ - 0 - | 1__+5__+1_ - - - - - 0 - |
}

-> PochiToTama[L1] -> PochiToTama[L2] -> #
