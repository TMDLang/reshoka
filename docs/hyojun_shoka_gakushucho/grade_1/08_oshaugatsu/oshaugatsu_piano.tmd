** おしょうがつ（伴奏） **
!= 100
?= F
<2/4>
~ "詞：中村秋香"
~ "曲：納所弁次郎"

Oshaugatsu:Vocal@|0|{
    <16*>
    /* 前奏 (4 小節) */
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - 0 - |
    L1| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |
    L2| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |

    /* 第 1 段 */
    | 5, - - - 1 - 5, - | 1 - - 2 3 - 4 - | 5 - - 4 3 - 2 - | 1 - - - - - 0 - |
    L1| モ - - - ン - ニ - | タ - - テ タ - ル - | マ - - ツ タ - ケ - | ノ - - - - - _ - |
    L2| ト - - - ソ - ヤ - | オ - - ゾ ウ - ニ - | オ - - イ ワ - イ - | ノ - - - - - _ - |

    /* 第 2 段 */
    | 1 - - - 5, - 1 - | 2 - - 3 4 - 5 - | 1 - 5, - 2 - - 5 | 1 - - - - - 0 - |
    L1| ウ - - - エ - ニ - | ヒ - - ラ ヒ - ラ - | ヒ - ノ - ミ - - ハ | タ - - - - - _ - |
    L2| ア - - - ト - ワ - | ト - - モ ダ - チ - | ウ - チ - ヨ - - リ | テ - - - - - _ - |

    /* 第 3 段 */
    | 1 - - - 1 - 1 - | 2 - - 3 4 - 5 - | 6 - - 5 4 - 3 - | 2 - - - - - 0 - |
    L1| タ - - - コ - オ - | ア - - ゲ ル - ニ - | ホ - - ド ヨ - ク - | テ - - - - - _ - |
    L2| カ - - - ル - タ - | ス - - ゴ ロ - ク - | フ - - ク ビ - キ - | ヤ - - - - - _ - |

    /* 第 4 段 */
    | 1 - - - 5, - 1 - | 2 - - 3 4 - 5 - | 1 - 5, - 2 - - 5 | 1 - - - - - 0 - |
    L1| ハ - - - ネ - ニ - | サ - - ワ ラ - ヌ - | カ - ゼ - ガ - - フ | ク - - - - - _ - |
    L2| タ - - - レ - モ - | ウ - - レ シ - イ - | ア - ソ - ビ - - ゴ | ト - - - - - _ - |

    /* 後奏 (2 小節) */
    | 0 - - - - - - - | 0 - - - - - - - |
    L1| _ - - - - - - - | _ - - - - - - - |
    L2| _ - - - - - - - | _ - - - - - - - |
}

Oshaugatsu:PianoRH@|0|{
    <16*>
    /* 前奏 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 2+4+5 - 0 - 1+3+5 - 2+4+5 - | 1+3+5 - - - - - 0 - |

    /* 第 1 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+4+6 - 0 - | 1+3+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - - - - - 0 - |

    /* 第 2 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 7,+2+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - - - - - 0 - |

    /* 第 3 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 7,+2+5 - 0 - 7,+2+5 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 7,+2+5 - - - - - 0 - |

    /* 第 4 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 7,+2+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - - - - - 0 - |

    /* 後奏 */
    | 1+3+5 - 1+4+6 - 1+3+5 - 7,+2+5 - | 1+3+5 - - - - - 0 - |
}

Oshaugatsu:PianoLH@|0|{
    <16*>
    /* 前奏 */
    | 1,, - 0 - 5,, - 0 - | 4,, - 0 - 1,, - 0 - | 5,, - 0 - 5,, - 0 - | 1,, - - - - - 0 - |

    /* 第 1 段 */
    | 1,, - 0 - 5,, - 0 - | 1,, - 0 - 4,, - 0 - | 1,, - 0 - 5,, - 0 - | 1,, - 5,, - 1,, - 0 - |

    /* 第 2 段 */
    | 1,, - 0 - 5,, - 0 - | 5,, - 0 - 5,, - 0 - | 1,, - 5,, - 5,, - 5,, - | 1,, - 5,, - 1,, - 0 - |

    /* 第 3 段 */
    | 1,, - 0 - 5,, - 0 - | 5,, - 0 - 5,, - 0 - | 4,, - 0 - 1,, - 0 - | 5,, - 2,, - 5,, - 0 - |

    /* 第 4 段 */
    | 1,, - 0 - 5,, - 0 - | 5,, - 0 - 5,, - 0 - | 1,, - 5,, - 5,, - 5,, - | 1,, - 5,, - 1,, - 0 - |

    /* 後奏 */
    | 1,, - 4,, - 1,, - 5,, - | 1,,+5,,+1, - - - - - 0 - |
}

