** おんまよはしれ（伴奏） **
!= 100
?= B,
<2/4>
~ "詞：佛蘭西童謠"
~ "曲：ロオル、コルラン"

Onma:Vocal@|0|{
    <8*>
    /* 前奏 (2 小節) */
    | 0 - - - | 0 - - - |
    L1| _ - - - | _ - - - |
    L2| _ - - - | _ - - - |
    L3| _ - - - | _ - - - |

    /* 第 1 段 */
    | 0 0 3 3 | 3 4 5 5 | 5 - 5 5 | 6 5 4 3 |
    L1| _ _ オ ン | マ ヨ ハ シ | レ - ア シ | ナ ミ ソ ロ |
    L2| _ _ オ ン | マ ヨ ハ シ | レ - ア シ | ナ ミ ソ ロ |
    L3| _ _ オ ン | マ ヨ ハ シ | レ - ア シ | ナ ミ ソ ロ |

    /* 第 2 段 */
    | 2 - 5 5 | 5 4 3 2 | 1, 1, 1, 1, | 2 3 4 5 |
    L1| エ - ア ク | サ タ ズ ネ | テ ミ ド リ | ノ マ キ バ |
    L2| エ - ナ イ | テ ル コ ウ | マ ニ ク サ | オ バ カ リ |
    L3| エ - マ グ | サ ニ ナ ル | ク サ タ ク | サ ン ト リ |

    /* 第 3 段 */
    | 1, 1, 3 3 | 3 4 5 5 | 5 - 6 5 | 4 3 2 1, | 1, - 0 0 |
    L1| バ エ オ ン | マ ヨ ハ シ | レ - ア シ | ナ ミ ソ ロ | エ - _ _ |
    L2| マ ショウ オ ン | マ ヨ ハ シ | レ - ア シ | ナ ミ ソ ロ | エ - _ _ |
    L3| マ ショウ オ ン | マ ヨ ハ シ | レ - ア シ | ナ ミ ソ ロ | エ - _ _ |

    /* 後奏 (2 小節) */
    | 0 - - - | 0 - - - |
    L1| _ - - - | _ - - - |
    L2| _ - - - | _ - - - |
    L3| _ - - - | _ - - - |
}

Onma:PianoRH@|0|{
    <8*>
    /* 前奏 */
    | 1+3+5 0 1+3+5 0 | 1+3+5 0 1+3+5 0 |

    /* 第 1 段 */
    | 1+3+5 0 1+3+5 0 | 1+3+5 0 1+3+5 0 | 1+3+5 0 1+3+5 0 | 1+4+6 0 1+3+5 0 |

    /* 第 2 段 */
    | 7,+2+5 0 7,+2+5 0 | 7,+2+5 0 7,+2+5 0 | 1+3+5 0 1+3+5 0 | 7,+2+5 0 1+3+5 0 |

    /* 第 3 段 */
    | 1+3+5 0 1+3+5 0 | 1+3+5 0 1+3+5 0 | 1+3+5 0 1+4+6 0 | 1+3+5 0 7,+2+5 0 | 1+3+5 - 0 0 |

    /* 後奏 */
    | 1+3+5 0 7,+2+5 0 | 1+3+5 - - - |
}

Onma:PianoLH@|0|{
    <8*>
    /* 前奏 */
    | 1,, 0 5,, 0 | 1,, 0 5,, 0 |

    /* 第 1 段 */
    | 1,, 0 5,, 0 | 1,, 0 5,, 0 | 1,, 0 5,, 0 | 4,, 0 1,, 0 |

    /* 第 2 段 */
    | 5,, 0 2,, 0 | 5,, 0 2,, 0 | 1,, 0 5,, 0 | 5,, 0 1,, 0 |

    /* 第 3 段 */
    | 1,, 0 5,, 0 | 1,, 0 5,, 0 | 1,, 0 4,, 0 | 1,, 0 5,, 0 | 1,, - 0 0 |

    /* 後奏 */
    | 1,, 0 5,, 0 | 1,,+5,,+1, - - - |
}

