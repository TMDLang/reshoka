** はこにわ（伴奏） **
!= 88
?= D
<4/4>
~ "詞：大正幼年唱歌"
~ "曲：小松耕輔"

Hakone:Vocal@|0|{
    <8*>
    /* 前奏 (4 小節) */
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - 0 - |
    L1| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |
    L2| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |

    /* 第 1 段 */
    | 5 - 5 - 3 - - - | 2 - 3 - 4 - 5 - | 3 - 2 - 1 - 2 - | 1 - - - - - 0 - |
    L1| タ - カ - イ - - - | ト - コ - ロ - ワ - | ヤ - マ - デ - ス - | ヨ - - - - - _ - |
    L2| ヤ - マ - ニ - - - | コ - ト - リ - オ - | ト - マ - ラ - セ - | テ - - - - - _ - |

    /* 第 2 段 */
    | 3 - 3 - - - 3 - | 2 - 2 - 2 - 3 - | 4 - 3 - 2 - 2 - | 3 - - - - - 0 - |
    L1| ヒ - ク - - - イ - | ト - コ - ロ - ワ - | カ - ワ - デ - ス - | ヨ - - - - - _ - |
    L2| カ - ワ - - - ニ - | オ - フ - ネ - オ - | ウ - カ - バ - セ - | テ - - - - - _ - |

    /* 第 3 段 */
    | 5 - 5 - 5 - 5 - | 6 - 6 - 5 - 5 - | 3 - 3 - 2 - 3 - | 1 - - - - - 0 - |
    L1| ヤ - マ - ニ - ワ - | キ - オ - ウ - エ - | ク - サ - オ - ウ - | エ - - - - - _ - |
    L2| ウ - レ - シ - ヤ - | ボ - ク - ラ - ノ - | ハ - コ - ニ - ワ - | ガ - - - - - _ - |

    /* 第 4 段 */
    | 5 - 5 - 5 - 3 - | 2 - 2 - 3 - 4 - | 3 - 3 - 2 - 2 - | 1 - - - - - 0 - |
    L1| カ - ワ - ニ - ワ - | ハ - - - シ - オ - | カ - ケ - マ - ショ - | ウ - - - - - _ - |
    L2| コ - ン - ナ - ニ - | キ - レ - イ - ニ - | デ - キ - マ - シ - | タ - - - - - _ - |

    /* 後奏 (2 小節) */
    | 0 - - - - - - - | 0 - - - - - - - |
    L1| _ - - - - - - - | _ - - - - - - - |
    L2| _ - - - - - - - | _ - - - - - - - |
}

Hakone:PianoRH@|0|{
    <8*>
    /* 前奏 */
    | 1+3+5 - - - 1+3+5 - - - | 2+4+6 - - - 1+3+5 - - - | 3+5+1' - 2+5+7 - 1+3+5 - 2+4+6 - | 1+3+5 - - - - - 0 - |

    /* 第 1 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 2+4+6 - 0 - 1+3+5 - 0 - | 1+3+5 - 7,+2+5 - 1+3+5 - 7,+2+5 - | 1+3+5 - 0 - 1+3+5 - 0 - |

    /* 第 2 段 */
    | 1+3+6 - 0 - 1+3+6 - 0 - | 2+4+6 - 0 - 2+4+6 - 0 - | 2+4+6 - 1+3+5 - 7,+2+5 - 7,+2+5 - | 1+3+5 - 0 - 1+3+5 - 0 - |

    /* 第 3 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - |

    /* 第 4 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 7,+2+5 - 0 - 1+3+5 - 2+4+6 - | 1+3+5 - 1+3+5 - 7,+2+5 - 7,+2+5 - | 1+3+5 - - - - - 0 - |

    /* 後奏 */
    | 1+3+5 - 2+4+6 - 3+5+1' - 2+4+6 - | 1+3+5 - - - - - - - |
}

Hakone:PianoLH@|0|{
    <8*>
    /* 前奏 */
    | 1, - 1 - 5, - 1 - | 4, - 1 - 1, - 1 - | 1, - 5, - 6, - 4, - | 1, - - - - - 0 - |

    /* 第 1 段 */
    | 1, - 5, - 1, - 5, - | 4, - 1 - 1, - 5, - | 1, - 5, - 1, - 5, - | 1, - 5, - 1, - 0 - |

    /* 第 2 段 */
    | 6, - 3 - 6, - 3 - | 2, - 6, - 2, - 6, - | 2, - 3, - 5, - 5, - | 1, - 5, - 1, - 0 - |

    /* 第 3 段 */
    | 1, - 5, - 1, - 5, - | 4, - 1 - 1, - 5, - | 1, - 5, - 5, - 5, - | 1, - 5, - 1, - 0 - |

    /* 第 4 段 */
    | 1, - 5, - 1, - 5, - | 5, - 2 - 1, - 4, - | 5, - 5, - 5, - 5, - | 1, - 5, - 1, - 0 - |

    /* 後奏 */
    | 1, - 4, - 1, - 4, - | 1,+5,+1 - - - - - - - |
}

-> Hakone[L1] -> Hakone[L2] -> #
