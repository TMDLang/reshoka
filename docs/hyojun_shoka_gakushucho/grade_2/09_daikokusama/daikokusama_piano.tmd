** だいこくさま（伴奏） **
!= 100
?= D
<2/4>
~ "詞・曲：田村虎藏"

Dai:Vocal@|0|{
    <16*>
    /* 前奏 (2 小節) */
    | 0 - - - 0 - - - | 0 - - - 0 - - - |
    L1| _ - - - _ - - - | _ - - - _ - - - |
    L2| _ - - - _ - - - | _ - - - _ - - - |
    L3| _ - - - _ - - - | _ - - - _ - - - |
    L4| _ - - - _ - - - | _ - - - _ - - - |

    /* 第 1 行 (4 小節) */
    | 1 - - 1 1 - 2 - | 3 - - 3 3 - 3 - | 5 - - 5 6 - 6 - | 5 - - - - - 0 - |
    L1| お - - お き - な - | ふ - - く ろ - を - | か - - た に - か - | け - - - - - _ - |
    L2| だ - - い こ - く - | さ - - ま は - あ - | わ - - れ が - り - | い - - - - - _ - |
    L3| だ - - い こ - く - | さ - - ま の - い - | う - - と お - り - | い - - - - - _ - |
    L4| だ - - い こ - く - | さ - - ま は - た - | れ - - だ ら - う - | う - - - - - _ - |

    /* 第 2 行 (4 小節) */
    | 6 - - 7 1' - - 6 | 5 - 3 - 1 - 1 - | 2 - - 3 4 - 2 - | 1 - - - - - 0 - |
    L1| だ - - い こ - - く | さ - ま - が - ー - | き - - か か - る - | と - - - - - _ - |
    L2| き - - れ い - - な | み - ず - に - ー - | み - - を あ - ら - | い - - - - - _ - |
    L3| き - - れ い - - な | み - ず - に - ー - | み - - を あ - ら - | い - - - - - _ - |
    L4| お - - お く - - に | ぬ - し - の - ー - | み - - こ と - と - | て - - - - - _ - |

    /* 第 3 行 (4 小節) */
    | 2 - - 2 2 - 3 - | 4 - - 4 4 - 4 - | 3 - 5 - 2 - 2 - | 1 - - - - - 0 - |
    L1| こ - - こ に - ー - | い - - な ば - の - | し - ろ - う - さ - | ぎ - - - - - _ - |
    L2| が - - ま の - ー - | ほ - - わ た - に - | く - る - ま - れ - | と - - - - - _ - |
    L3| が - - ま の - ー - | ほ - - わ た - に - | く - る - ま - れ - | ば - - - - - _ - |
    L4| く - - に ち - ー - | ひ - - ら い - て - | よ - の - ひ - と - | を - - - - - _ - |

    /* 第 4 行 (4 小節) */
    | 6 - - 7 1' - - 6 | 5 - - 3 1 - - 1 | 2 - - 3 2 - 2 - | 1 - - - - - 0 - |
    L1| か - - わ を - - ー | む - - か れ - - て | あ - - か は - だ - | か - - - - - _ - |
    L2| よ - - く よ - - く | お - - し え - - て | や - - り ま - し - | た - - - - - _ - |
    L3| う - - さ ぎ - - は | も - - と の - - ー | し - - ろ う - さ - | ぎ - - - - - _ - |
    L4| た - - す け - - な | さ - - れ た - - ー | か - - み さ - ま - | よ - - - - - _ - |

    /* 後奏 (2 小節) */
    | 0 - 0 - 0 - 0 - | 0 - - - - - 0 - |
    L1| _ - _ - _ - _ - | _ - - - - - _ - |
    L2| _ - _ - _ - _ - | _ - - - - - _ - |
    L3| _ - _ - _ - _ - | _ - - - - - _ - |
    L4| _ - _ - _ - _ - | _ - - - - - _ - |
}

Dai:PianoRH@|0|{
    <16*>
    /* 前奏 */
    | 1+3+5 - - - 1+3+5 - - - | 2+5+7 - - - 1+3+5 - - - |

    /* 第 1 行 */
    | 1+3+5 - - 1+3+5 1+3+5 - 1+3+5 - | 1+3+5 - - 1+3+5 1+3+5 - 1+3+5 - | 1+3+5 - - 1+3+5 4+6 - 4+6 - | 1+3+5 - - - - - 0 - |

    /* 第 2 行 */
    | 4+6 - - 5+7 1'+3' - - 4+6 | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 2+4 - - 1+3 2+4 - 7,+2 - | 1+3+5 - - - - - 0 - |

    /* 第 3 行 */
    | 2+4+6 - - 2+4+6 2+4+6 - 1+3+5 - | 2+4+6 - - 2+4+6 2+4+6 - 2+4+6 - | 1+3+5 - 1+3+5 - 7,+2+4 - 7,+2+4 - | 1+3+5 - - - - - 0 - |

    /* 第 4 行 */
    | 4+6 - - 5+7 1'+3' - - 4+6 | 1+3+5 - - 1+3+5 1+3+5 - - 1+3+5 | 2+4 - - 1+3 7,+2+4 - 7,+2+4 - | 1+3+5 - - - - - 0 - |

    /* 後奏 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 1+3+5 - - - - - 0 - |
}

Dai:PianoLH@|0|{
    <16*>
    /* 前奏 */
    | 1, - 5,, - 1, - 5,, - | 5,, - 2, - 1, - - - |

    /* 第 1 行 */
    | 1, - 3,+5, - 1, - 3,+5, - | 1, - 3,+5, - 1, - 3,+5, - | 1, - 3,+5, - 4, - 6,, - | 1, - 3,+5, - 1, - 0 - |

    /* 第 2 行 */
    | 4, - 1, - 4, - 1, - | 1, - 3,+5, - 1, - 3,+5, - | 5,, - 2,+5, - 5,, - 2,+5, - | 1, - 3,+5, - 1, - 0 - |

    /* 第 3 行 */
    | 2, - 4,+6, - 2, - 4,+6, - | 2, - 4,+6, - 2, - 4,+6, - | 1, - 3,+5, - 5,, - 2,+5, - | 1, - 3,+5, - 1, - 0 - |

    /* 第 4 行 */
    | 4, - 1, - 4, - 1, - | 1, - 3,+5, - 1, - 3,+5, - | 5,, - 2,+5, - 5,, - 2,+5, - | 1, - 3,+5, - 1, - 0 - |

    /* 後奏 */
    | 1, - 3, - 5, - 5,, - | 1, - - - - - 0 - |
}

