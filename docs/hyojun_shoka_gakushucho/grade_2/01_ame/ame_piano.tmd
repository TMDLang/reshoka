** あめ（伴奏） **
!= 126
?= D
<4/4>
~ "詞：文部省尋常小學唱歌"
~ "曲：文部省尋常小學唱歌"

Ame:Vocal@|0|{
    <8*>
    /* 前奏 (4 小節) */
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - 0 - |
    L1| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |
    L2| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - _ - |

    /* 第 1 段 */
    | 1 - - 3 5 - 3 - | 1' - 5 - 3 - 0 - | 1 - - 3 5 - 3 - | 2 - 3 - 2 - 0 - |
    L1| フ - - レ フ - レ - | ア - メ - ヨ - _ - | ミ - - ヤ コ - ノ - | ア - メ - ヨ - _ - |
    L2| フ - - レ フ - レ - | ア - メ - ヨ - _ - | キ - - ナ カ - ノ - | ア - メ - ヨ - _ - |

    /* 第 2 段 */
    | 1 - - - 3 - 5 - | 1 - - 3 5 - 1' - | 6 - - 1' 6 - 5 - | 3 - 2 - 1 - 0 - |
    L1| ウ - - - マ - ヤ - | ク - - ル マ - ノ - | オ - - ウ ラ - イ - | タ - エ - ヌ - _ - |
    L2| ナ - - - ス - ヤ - | キ - - ュウ リ - ノ - | ハ - - ナ サ - キ - | ソ - ロ - ウ - _ - |

    /* 第 3 段 */
    | 1' - - 6 5 - 3 - | 1 - - 3 5 - 1' - | 6 - - 1' 6 - 5 - | 4 - 3 - 2 - 0 - |
    L1| マ - - ー チ - ノ - | ホ - - コ リ - ノ - | シ - - ズ マ - ル - | ホ - ド - ニ - _ - |
    L2| ハ - - タ ケ - ノ - | ツ - - ー チ - ノ - | ウ - - ル オ - ウ - | ホ - ド - ニ - _ - |

    /* 第 4 段 */
    | 5 - 3 - 2 - 0 - | 1' - - 6 5 - 3 - | 1 - - 3 5 - 3 - | 2 - 1 - 0 - - - |
    L1| ア - メ - ヨ - _ - | フ - - レ フ - レ - | ホ - - ド ヨ - ク - | フ - レ - _ - - - |
    L2| ア - メ - ヨ - _ - | フ - - レ フ - レ - | ホ - - ド ヨ - ク - | フ - レ - _ - - - |

    /* 後奏 (2 小節) */
    | 0 - - - - - - - | 0 - - - - - - - |
    L1| _ - - - - - - - | _ - - - - - - - |
    L2| _ - - - - - - - | _ - - - - - - - |
}

Ame:PianoRH@|0|{
    <8*>
    /* 前奏 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 2+4+5 - 0 - 1+3+5 - 2+4+5 - | 1+3+5 - - - - - 0 - |

    /* 第 1 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 7,+2+5 - 0 - 7,+2+5 - 0 - |

    /* 第 2 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 1+3+5 - 7,+2+5 - 1+3+5 - 0 - |

    /* 第 3 段 */
    | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 1+4+6 - 0 - 1+3+5 - 0 - | 7,+2+5 - 0 - 7,+2+5 - 0 - |

    /* 第 4 段 */
    | 1+3+5 - 0 - 7,+2+5 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 1+3+5 - 0 - 1+3+5 - 0 - | 7,+2+5 - 1+3+5 - 1+3+5 - - - |

    /* 後奏 */
    | 1+3+5 - 1+4+6 - 1+3+5 - 7,+2+5 - | 1+3+5 - - - - - - - |
}

Ame:PianoLH@|0|{
    <8*>
    /* 前奏 */
    | 1,, - 0 - 5,, - 0 - | 4,, - 0 - 1,, - 0 - | 5,, - 0 - 5,, - 0 - | 1,, - - - - - 0 - |

    /* 第 1 段 */
    | 1,, - 5,, - 1,, - 5,, - | 1,, - 5,, - 1,, - 0 - | 1,, - 5,, - 1,, - 5,, - | 5,, - 2,, - 5,, - 0 - |

    /* 第 2 段 */
    | 1,, - 5,, - 1,, - 5,, - | 1,, - 5,, - 1,, - 0 - | 4,, - 1,, - 1,, - 5,, - | 1,, - 5,, - 1,, - 0 - |

    /* 第 3 段 */
    | 1,, - 5,, - 1,, - 5,, - | 1,, - 5,, - 1,, - 0 - | 4,, - 1,, - 1,, - 5,, - | 5,, - 2,, - 5,, - 0 - |

    /* 第 4 段 */
    | 1,, - 0 - 5,, - 0 - | 1,, - 5,, - 1,, - 5,, - | 1,, - 5,, - 1,, - 5,, - | 5,, - 1,, - 1,, - - - |

    /* 後奏 */
    | 1,, - 4,, - 1,, - 5,, - | 1,,+5,,+1, - - - - - - - |
}

-> Ame[L1] -> Ame[L2] -> #
