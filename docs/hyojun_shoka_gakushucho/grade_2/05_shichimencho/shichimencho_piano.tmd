** しちめんちょう（伴奏） **
!= 104
?= C
<2/4>
~ "詞：葛原しげる"
~ "曲：梁田貞"
~ "出處：大正幼年唱歌"

Shichimencho:Vocal@|0|{
    <16*>
    /* ================= 前奏／序段 (4 小節) ================= */
    | 1 - 5 - 5 - 0 - | 1 - 5 - 5 - 0 - | 1 - 0 - 1 - 0 - | 1 - - - - - 0 - |
    L1| きょろっ - きょろっ - きょろっ - _ - | きょろっ - きょろっ - きょろっ - _ - | くっ - _ - くっ - _ - | く - - - - - _ - |
    L2| - - - - - - _ - | - - - - - - _ - | - - _ - - - _ - | - - - - - - _ - |

    /* ================= 第一段 (4 小節) ================= */
    | 1 - 3 5 1' - 5 - | 3 - - - 1 - - - | 2 - 4 6 2' - 7 - | 1' - - - - - 0 - |
    L1| あ - か い か - お - | し - - - て - - - | お - こ り ま - わ - | る - - - - - _ - |
    L2| あ - お い か - お - | し - - - て - - - | に - げ ー だ - し - | た - - - - - _ - |

    /* ================= 第二段 (4 小節) ================= */
    | 1 - 3 5 1' - 5 - | 3 - - - 1 - - - | 2 - 4 6 2' - 7 - | 1' - - - - - 0 - |
    L1| し - ち ー め - ん - | ちょう - - - は - - - | お - か ー し - い - | な - - - - - _ - |
    L2| し - ち ー め - ん - | ちょう - - - は - - - | お - か ー し - い - | な - - - - - _ - |

    /* ================= 第三段 (4 小節) ================= */
    | 1 - 3 5 1' - 5 - | 3 - - - 1 - - - | 2 - 4 6 2' - 7 - | 1' - - - - - 0 - |
    L1| は - ね を ひ - ろ - | げ - - - て - - - | お - こ り な - が - | ら - - - - - _ - |
    L2| は - ね を す - ぼ - | め - - - て - - - | に - げ ー て - い - | く - - - - - _ - |

    /* ================= 後奏／尾段 (4 小節) ================= */
    | 1 - 5 - 5 - 0 - | 1 - 5 - 5 - 0 - | 1 - 0 - 1 - 0 - | 1 - - - - - 0 - |
    L1| きょろっ - - - - - _ - | - - - - - - _ - | くっ - _ - くっ - _ - | く - - - - - _ - |
    L2| きょろっ - - - - - _ - | - - - - - - _ - | くっ - _ - くっ - _ - | く - - - - - _ - |
}

Shichimencho:PianoRH@|0|{
    <16*>
    /* 序段伴奏 */
    | 1+3 - 5 - 5 - 0 - | 1+3 - 5 - 5 - 0 - | 1+3 - 0 - 1+3 - 0 - | 1+3+5 - - - - - 0 - |

    /* 第一段 */
    | 1+3+5 - - - 3+5+1' - - - | 1+3+5 - - - 1+3+5 - - - | 2+4+6 - - - 2+4+7 - - - | 3+5+1' - - - - - 0 - |

    /* 第二段 */
    | 1+3+5 - - - 3+5+1' - - - | 1+3+5 - - - 1+3+5 - - - | 2+4+6 - - - 2+4+7 - - - | 3+5+1' - - - - - 0 - |

    /* 第三段 */
    | 1+3+5 - - - 3+5+1' - - - | 1+3+5 - - - 1+3+5 - - - | 2+4+6 - - - 2+4+7 - - - | 3+5+1' - - - - - 0 - |

    /* 尾段伴奏 */
    | 1+3 - 5 - 5 - 0 - | 1+3 - 5 - 5 - 0 - | 1+3 - 0 - 1+3 - 0 - | 1+3+5 - - - - - 0 - |
}

Shichimencho:PianoLH@|0|{
    <16*>
    /* 序段伴奏 */
    | 1, - - - 5,, - - - | 1, - - - 5,, - - - | 1, - 0 - 1, - 0 - | 1,, - - - - - 0 - |

    /* 第一段 */
    | 1, - - - 5,, - - - | 1, - - - 3, - - - | 2, - - - 5,, - - - | 1, - - - - - 0 - |

    /* 第二段 */
    | 1, - - - 5,, - - - | 1, - - - 3, - - - | 2, - - - 5,, - - - | 1, - - - - - 0 - |

    /* 第三段 */
    | 1, - - - 5,, - - - | 1, - - - 3, - - - | 2, - - - 5,, - - - | 1, - - - - - 0 - |

    /* 尾段伴奏 */
    | 1, - - - 5,, - - - | 1, - - - 5,, - - - | 1, - 0 - 1, - 0 - | 1,, - - - - - 0 - |
}

