** さんばのつばめ（伴奏） **
!= 100
?= G
<4/4>
~ "出處：唱歌新教材"

Tsubame:Vocal@|0|{
    <8*>
    /* 前奏 (2 小節) */
    | 0 - - - 0 - - - | 0 - - - 0 - - - |
    L1| _ - - - _ - - - | _ - - - _ - - - |
    L2| _ - - - _ - - - | _ - - - _ - - - |
    L3| _ - - - _ - - - | _ - - - _ - - - |

    /* 第 1 行 (4 小節) */
    | 5, - 1 2 3 - 3 - | 2 - - - 1 - 0 - | 1 - 3 - 5 - - - | 5 - - - - - - - |
    L1| い - つ の ま - に - | き - - - た - _ - | さ - ん - ば - - - | の - - - - - - - |
    L2| きょ - ね ん わ - か - | れ - - - た - _ - | さ - ん - ば - - - | の - - - - - - - |
    L3| こ - と し も - たっ - | しゃ - - - で - _ - | さ - ん - ば - - - | の - - - - - - - |

    /* 第 2 行 (3 小節) */
    | 3 3 3 3 1 - 0 - | 5, 5, 1 - 1 1 1 3 | 2 2 2 2 1 - 0 - |
    L1| つ う ば あ め - _ - | も と の - ふ る す が | こ い し い か - _ - |
    L2| つ う ば あ め - _ - | と ほ い - う み や ま | な が い た び - _ - |
    L3| つ う ば あ め - _ - | と - さ - ん か あ さん | そ の こ ど も - _ - |

    /* 第 3 行 (4 小節) */
    | 5, 5, 1 - 1 1 1 3 | 2 2 2 2 1 - 0 - | 3 3 3 3 3 3 1 - | 3 3 3 3 1 - 0 - |
    L1| の き の - ふ る す が | こ い し い か - _ - | ち ち ち ち ち っ ち - | ち ち ち っ ち - _ - |
    L2| べ つ に - つ か れ わ | な か っ た か - _ - | ち ち ち ち ち っ ち - | ち ち ち っ ち - _ - |
    L3| み ん な - た の し い | お も し ろ い - _ - | ち ち ち ち ち っ ち - | ち ち ち っ ち - _ - |

    /* 後奏 (2 小節) */
    | 0 - 0 - 0 - 0 - | 0 - - - - - - - |
    L1| _ - _ - _ - _ - | _ - - - - - - - |
    L2| _ - _ - _ - _ - | _ - - - - - - - |
    L3| _ - _ - _ - _ - | _ - - - - - - - |
}

Tsubame:PianoRH@|0|{
    <8*>
    /* 前奏 */
    | 1+3+5 - - - 1+3+5 - - - | 2+4+5 - - - 1+3+5 - - - |

    /* 第 1 行 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 2+4+6 - 2+4+6 - 1+3+5 - 0 - | 1+3+5 - 1+3+5 - 1+3+5 - - - | 1+3+5 - - - - - - - |

    /* 第 2 行 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 0 - | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 2+4+6 - 2+4+6 - 1+3+5 - 0 - |

    /* 第 3 行 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 2+4+6 - 2+4+6 - 1+3+5 - 0 - | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 1+3+5 - 1+3+5 - 1+3+5 - 0 - |

    /* 後奏 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 1+3+5 - - - - - - - |
}

Tsubame:PianoLH@|0|{
    <8*>
    /* 前奏 */
    | 1, - 5,, - 1, - 5,, - | 5,, - 2, - 1, - - - |

    /* 第 1 行 */
    | 1, - 5,, - 1, - 5,, - | 2, - 5,, - 1, - 0 - | 1, - 3, - 5, - - - | 1, - - - - - - - |

    /* 第 2 行 */
    | 1, - 3, - 1, - 0 - | 1, - 5,, - 1, - 5,, - | 2, - 5,, - 1, - 0 - |

    /* 第 3 行 */
    | 1, - 5,, - 1, - 5,, - | 2, - 5,, - 1, - 0 - | 1, - 5,, - 1, - 5,, - | 1, - 5,, - 1, - 0 - |

    /* 後奏 */
    | 1, - 3, - 5, - 5,, - | 1,, - - - - - - - |
}

-> Tsubame[L1] -> Tsubame[L2] -> Tsubame[L3] -> #
