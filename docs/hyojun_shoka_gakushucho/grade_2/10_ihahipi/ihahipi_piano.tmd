** いわいび（伴奏） **
!= 100
?= C
<4/4>
~ "出處：唱歌教科書"

Ihahi:Piano@|0|{
    <8*>
    /* 前奏 (2 小節) */
    | 0 - - - 0 - - - | 0 - - - 0 - - - |
    L1| _ - - - _ - - - | _ - - - _ - - - |
    L2| _ - - - _ - - - | _ - - - _ - - - |
    L3| _ - - - _ - - - | _ - - - _ - - - |

    /* 第 1 行 (4 小節) */
    | 1 - 3 - 5 - 1^ - | 7 - 7 - 6 - 5 - | 2 - 4 - 6 - 2^ - | 5 - 5 - 5 - 0 - |
    L1| す - ず - め - の - | な - く - こ - え - | や - ち - よ - と - | き - こ - え - _ - |
    L2| あ - さ - ひ - の - | み - は - た - は - | か - ど - な - み - | な - び - き - _ - |
    L3| い - ざ - い - ざ - | わ - れ - ら - も - | て - に - て - を - | と - り - て - _ - |

    /* 第 2 行 (4 小節) */
    | 3 - 4 5 6 - 5 - | 5 - 6 7 1^ - 5 - | 5 - 5 - 1^ - 7 - | 5 - 5 - 1 - 0 - |
    L1| に - わ な る - ー - | ま - つ ー か - ぜ - | ば - ん - ざ - い - | ひ - び - く - _ - |
    L2| し - ょ う か - の - | こ - え ー ご - え - | さ - と - ご - と - | み - て - り - _ - |
    L3| い - わ い て - ー - | あ - そ ー ば - ん - | う - れ - し - き - | きょ - う - を - _ - |

    /* 第 3 行 (4 小節) */
    | 1 - 3 - 5 - 1^ - | 2^ - 1^ - 7 - 5 - | 4 - 3 - 2 - - 3 | 1^ - 5 - 1 - 0 - |
    L1| た - の - ー - し - | た - の - ー - し - | きょ - う - の - ー - | い - わ - い - _ - |
    L2| た - の - ー - し - | た - の - ー - し - | きょ - う - の - ー - | い - わ - い - _ - |
    L3| た - の - ー - し - | た - の - ー - し - | きょ - う - の - ー - | い - わ - い - _ - |

    /* 後奏 (2 小節) */
    | 0 - 0 - 0 - 0 - | 0 - - - - - - - |
    L1| _ - _ - _ - _ - | _ - - - - - - - |
    L2| _ - _ - _ - _ - | _ - - - - - - - |
    L3| _ - _ - _ - _ - | _ - - - - - - - |
}

Ihahi:PianoRH@|0|{
    <8*>
    /* 前奏 */
    | 1+3+5 - - - 1+3+5 - - - | 2+4+5 - - - 1+3+5 - - - |

    /* 第 1 行 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 7_+2+5 - 7_+2+5 - 1+4+6 - 1+3+5 - | 2+4+6 - 2+4+6 - 2+4+6 - 2+4+6 - | 1+3+5 - 1+3+5 - 1+3+5 - 0 - |

    /* 第 2 行 */
    | 1+3+5 - 1+4+6 - 1+4+6 - 1+3+5 - | 1+3+5 - 1+4+6 - 1+3+5 - 1+3+5 - | 1+3+5 - 1+3+5 - 1+3+5 - 7_+2+5 - | 1+3+5 - 1+3+5 - 1+3+5 - 0 - |

    /* 第 3 行 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 2+4+6 - 1+3+5 - 7_+2+5 - 1+3+5 - | 1+4+6 - 1+3+5 - 2+4+5 - 2+4+5 - | 1+3+5 - 1+3+5 - 1+3+5 - 0 - |

    /* 後奏 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 1+3+5 - - - - - - - |
}

Ihahi:PianoLH@|0|{
    <8*>
    /* 前奏 */
    | 1_ - 5__ - 1_ - 5__ - | 5__ - 2_ - 1_ - - - |

    /* 第 1 行 */
    | 1_ - 5__ - 1_ - 5__ - | 5__ - 2_ - 4_ - 1_ - | 2_ - 6__ - 2_ - 6__ - | 5__ - 2_ - 5__ - 0 - |

    /* 第 2 行 */
    | 1_ - 4_ - 4_ - 1_ - | 1_ - 4_ - 1_ - 1_ - | 1_ - 1_ - 1_ - 5__ - | 1_ - 5__ - 1_ - 0 - |

    /* 第 3 行 */
    | 1_ - 5__ - 1_ - 5__ - | 2_ - 1_ - 5__ - 1_ - | 4_ - 1_ - 5__ - 5__ - | 1_ - 5__ - 1_ - 0 - |

    /* 後奏 */
    | 1_ - 3_ - 5_ - 5__ - | 1__ - - - - - - - |
}

