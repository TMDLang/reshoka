** しゃぼんだま（伴奏） **
!= 96
?= Eb
<2/4>
~ "詞：野口雨情"
~ "曲：中山晉平"
~ "出處：童謠小曲"

ShabonA:Vocal@|0|{
    <8*>
    /* 前奏 (2 小節) */
    | 0 0 0 0 | 0 0 0 0 |
    L1| _ _ _ _ | _ _ _ _ |
    L2| _ _ _ _ | _ _ _ _ |

    /* 弱起 (第 1 小節前) */
    | 0 0 0 5, |
    L1| _ _ _ し |
    L2| _ _ _ し |

    /* 第 1 行 (4 小節) */
    | 1 2 3 5 | 5 3 2 1 | 3 5 6 5 | 3 1 2 - |
    L1| や ぼ ん だ | ま と ん だ | や ね ま で | と ん だ - |
    L2| や ぼ ん だ | ま き え た | と ば ず に | き え た - |

    /* 第 2 行 (4 小節) */
    | 1 2 3 5 | 5 3 2 1 | 3 5 6 5 | 3 2 1 - |
    L1| や ね ま で | と ん で - | こ わ れ て | き え た - |
    L2| う ま れ て | す ぐ に - | こ わ れ て | き え た - |
}

ShabonA:PianoRH@|0|{
    <8*>
    /* 前奏 */
    | 1+3+5 - 1+3+5 - | 2+4+5 - 2+5+7 - |

    /* 弱起 */
    | 0 0 0 5, |

    /* 第 1 行 */
    | 1+3 - 3+5 - | 1+3+5 - 1+3+5 - | 3+5 - 4+6 - | 2+5 - 2+4 - |

    /* 第 2 行 */
    | 1+3 - 3+5 - | 1+3+5 - 1+3+5 - | 4+6 - 3+5 - | 2+4 - 1+3+5 - |
}

ShabonA:PianoLH@|0|{
    <8*>
    /* 前奏 */
    | 1, - 5, - | 5,, - 2, - |

    /* 弱起 */
    | 0 0 0 0 |

    /* 第 1 行 */
    | 1, - 5, - | 1, - 5,, - | 1, - 4, - | 5,, - 5, - |

    /* 第 2 行 */
    | 1, - 5, - | 1, - 5,, - | 4, - 1, - | 5,, - 1, - |
}

ShabonB:Vocal@|0|{
    <8*>
    /* 第 3 行：尾段 (4 小節) */
    | 6 6 5 3 | 1 2 3 0 | 3 5 6 5 | 3 2 1 0 |
    L1| か ぜ か ぜ | ふ く な _ | しゃ ぼ ん だ | ま と ば そ |

    /* 後奏 (2 小節) */
    | 0 0 0 0 | 0 0 0 0 |
    L1| _ _ _ _ | _ _ _ _ |
}

ShabonB:PianoRH@|0|{
    <8*>
    /* 尾段 */
    | 4+6 - 3+5 - | 2+4 - 2+5 - | 1+3 - 4+6 - | 2+4 - 1+3+5 - |

    /* 後奏 */
    | 3'+5' - 1'+3' - | 1+3+5 - - - |
}

ShabonB:PianoLH@|0|{
    <8*>
    /* 尾段 */
    | 4, - 1, - | 2, - 5,, - | 1, - 4, - | 5,, - 1, - |

    /* 後奏 */
    | 1, - 5, - | 1,, - - - |
}

-> ShabonA[L1] -> ShabonA[L2] -> ShabonB[L1] -> #
