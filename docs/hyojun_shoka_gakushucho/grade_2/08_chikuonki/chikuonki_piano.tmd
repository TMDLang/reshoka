** ちくおんき（伴奏） **
!= 104
?= G
<2/4>
~ "詞：葛原しげる"
~ "曲：梁田貞"
~ "出處：大正幼年唱歌"

Chiku:Vocal@|0|{
    <16*>
    /* 前奏 (2 小節) */
    | 0 - - - 0 - - - | 0 - - - 0 - - - |
    L1| _ - - - _ - - - | _ - - - _ - - - |
    L2| _ - - - _ - - - | _ - - - _ - - - |

    /* 第 1 行 (4 小節) */
    | 1 - - 3 5 - - - | 3 - - 2 1 - 5, - | 3 - - 2 3 - - 2 | 1 - - - - - 0 - |
    L1| は - - こ の - - - | な - - か か - ら - | こ - - え が - - で | る - - - - - _ - |
    L2| こ - - ん どは - - - | が - - く た - い - | い - - さ ま - - し | い - - - - - _ - |

    /* 第 2 行 (4 小節) */
    | 1 - - - 3 - 5 - | 3 - - 2 1 - 5, - | 3 - - 2 3 - - 2 | 1 - - - - - 0 - |
    L1| らっ - - - ぱ - の - | お - - く か - ら - | こ - - え が - - で | る - - - - - _ - |
    L2| ぴい - - - ぴ - い - | ど - - ん ど - ん - | い - - さ ま - - し | い - - - - - _ - |

    /* 第 3 行 (4 小節) */
    | 1 - - 3 5 - 5 - | 3 - - 2 1 - 5, - | 2 - - 3 5 - 3 - | 2 - - 3 2 - 0 - |
    L1| あ - - れ あ - れ - | ず - - い ぶ - ん - | お - - お き - な - | こ - - え よ - _ - |
    L2| た - - い こ - や - | ふ - - え を - - - | た - - た い - て - | ふ - - い て - _ - |

    /* 第 4 行 (4 小節) */
    | 1 - - 3 5, - - - | 3 - - 5 1 - - - | 3 - 2 - 1 - - 7, | 1 - - - - - 0 - |
    L1| だ - - れ が - - - | う - - たっ て - - - | い - る - の - - で | しょ - - - - - _ - |
    L2| ど - - こ で - - - | な - - らし て - - - | い - る - の - - で | しょ - - - - - _ - |

    /* 後奏 (2 小節) */
    | 0 - 0 - 0 - 0 - | 0 - - - - - 0 - |
    L1| _ - _ - _ - _ - | _ - - - - - _ - |
    L2| _ - _ - _ - _ - | _ - - - - - _ - |
}

Chiku:PianoRH@|0|{
    <16*>
    /* 前奏 */
    | 1+3+5 - - - 1+3+5 - - - | 2+4+5 - - - 1+3+5 - - - |

    /* 第 1 行 */
    | 1+3+5 - - 1+3+5 1+3+5 - - - | 1+3+5 - - 7,+2+4 1+3+5 - 5,+7,+2 - | 1+3+5 - - 7,+2+4 1+3+5 - - 7,+2+4 | 1+3+5 - - - - - 0 - |

    /* 第 2 行 */
    | 1+3+5 - - - 1+3+5 - 1+3+5 - | 1+3+5 - - 7,+2+4 1+3+5 - 5,+7,+2 - | 1+3+5 - - 7,+2+4 1+3+5 - - 7,+2+4 | 1+3+5 - - - - - 0 - |

    /* 第 3 行 */
    | 1+3+5 - - 1+3+5 1+3+5 - 1+3+5 - | 1+3+5 - - 7,+2+4 1+3+5 - 5,+7,+2 - | 6,+1+3 - - 6,+1+3 1+3+5 - 6,+1+3 - | 7,+2+4 - - 7,+2+4 7,+2+4 - 0 - |

    /* 第 4 行 */
    | 1+3+5 - - 1+3+5 5,+7,+2 - - - | 1+3+5 - - 1+3+5 1+3+5 - - - | 1+3+5 - 7,+2+4 - 1+3+5 - - 5,+7,+2 | 1+3+5 - - - - - 0 - |

    /* 後奏 */
    | 1+3+5 - 1+3+5 - 1+3+5 - 1+3+5 - | 1+3+5 - - - - - 0 - |
}

Chiku:PianoLH@|0|{
    <16*>
    /* 前奏 */
    | 1, - 5,, - 1, - 5,, - | 5,, - 2, - 1, - - - |

    /* 第 1 行 */
    | 1, - 3,+5, - 1, - 3,+5, - | 1, - 3,+5, - 5,, - 4,+5, - | 1, - 3,+5, - 5,, - 4,+5, - | 1, - 3,+5, - 1, - 0 - |

    /* 第 2 行 */
    | 1, - 3,+5, - 1, - 3,+5, - | 1, - 3,+5, - 5,, - 4,+5, - | 1, - 3,+5, - 5,, - 4,+5, - | 1, - 3,+5, - 1, - 0 - |

    /* 第 3 行 */
    | 1, - 3,+5, - 1, - 3,+5, - | 1, - 3,+5, - 5,, - 4,+5, - | 6,, - 3,+6, - 1, - 3,+5, - | 5,, - 2,+5, - 5,, - 0 - |

    /* 第 4 行 */
    | 1, - 3,+5, - 5,, - 4,+5, - | 1, - 3,+5, - 1, - 3,+5, - | 1, - 2, - 5,, - 5,, - | 1, - 3,+5, - 1, - 0 - |

    /* 後奏 */
    | 1, - 3, - 5, - 5,, - | 1, - - - - - 0 - |
}

-> Chiku[L1] -> Chiku[L2] -> #
