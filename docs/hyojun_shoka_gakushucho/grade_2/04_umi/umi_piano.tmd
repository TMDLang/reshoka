** うみ（伴奏） **
!= 108
?= D
<2/4>
~ "出處：西洋曲"

Umi:Vocal@|0|{
    <8*>
    /* 前奏 (2 小節) */
    | 0 - 0 - | 0 - 0 - |
    L1| _ - _ - | _ - _ - |
    L2| _ - _ - | _ - _ - |

    /* 第 1 段 (4 小節) */
    | 1 3 5 3 | 4 6 1' 6 | 5 5 5 5 | 3 1 1 - |
    L1| あ れ あ れ | お き べ に | し ら ほ が | み え る - |
    L2| あ れ あ れ | な み ま に | か も め が | う か ぶ - |

    /* 第 2 段 (4 小節) */
    | 1 3 5 3 | 4 6 1' 6 | 5 5 5 5 | 1 - 0 - |
    L1| し ら ほ を | み て き りゃ | あ し も と | に - _ - |
    L2| か も め を | み て き りゃ | み み ち か | く - _ - |

    /* 第 3 段 (4 小節) */
    | 1 3 5 3 | 4 6 1' - | 2' 1' 7 6 | 5 7 2' - |
    L1| お な み に | め な み - | ぴ ちゃ ぴ ちゃ | よ せ る - |
    L2| い そ べ の | ま つ が - | お る が ん | な ら す - |

    /* 第 4 段 (4 小節) */
    | 1 3 5 3 | 4 6 1' 6 | 5 5 5 5 | 1 - 0 - |
    L1| あ れ あ れ | し ら ほ は | も う み え | ぬ - _ - |
    L2| あ れ あ れ | か も め は | も う み え | ぬ - _ - |

    /* 後奏 (2 小節) */
    | 0 - 0 - | 0 - 0 - |
    L1| _ - _ - | _ - _ - |
    L2| _ - _ - | _ - _ - |
}

Umi:PianoRH@|0|{
    <8*>
    /* 前奏 */
    | 3 5 1' 3' | 2' 7 5 2 |

    /* 第 1 段 */
    | 1+3 - 3+5 - | 4+6 - 6+1' - | 5+7 - 7+2' - | 3+5 - 1+3 - |

    /* 第 2 段 */
    | 1+3 - 3+5 - | 4+6 - 6+1' - | 5+7 - 7+2' - | 1+3+5 - 0 - |

    /* 第 3 段 */
    | 1+3 - 3+5 - | 4+6 - 6+1' - | 2'+4' 1'+3' 7+2' 6+1' | 5+7 7+2' 2'+4' - |

    /* 第 4 段 */
    | 1+3 - 3+5 - | 4+6 - 6+1' - | 5+7 - 7+2' - | 1+3+5 - 0 - |

    /* 後奏 */
    | 1'+3' - 3+5 - | 1+3+5 - - - |
}

Umi:PianoLH@|0|{
    <8*>
    /* 前奏 */
    | 1, - 5, - | 5,, - 2, - |

    /* 第 1 段 */
    | 1, - 5, - | 4, - 1, - | 5,, - 2, - | 1, - 5,, - |

    /* 第 2 段 */
    | 1, - 5, - | 4, - 1, - | 5,, - 2, - | 1, - 0 - |

    /* 第 3 段 */
    | 1, - 5, - | 4, - 1, - | 2,, - 5,, - | 5,, - 5, - |

    /* 第 4 段 */
    | 1, - 5, - | 4, - 1, - | 5,, - 2, - | 1,, - 0 - |

    /* 後奏 */
    | 1, - 5, - | 1,, - - - |
}

-> Umi[L1] -> Umi[L2] -> #
