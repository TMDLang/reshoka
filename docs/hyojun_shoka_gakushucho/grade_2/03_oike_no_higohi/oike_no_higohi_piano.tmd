** お池の緋鯉（伴奏） **
!= 100
?= G
<2/4>
~ "詞：青木存義"
~ "曲：福井直秋"
~ "出處：かはいゝ唱歌"

Oike:Vocal@|0|{
    <16*>
    /* 前奏 (2 小節) */
    | 0 - - - 0 - - - | 0 - - - 0 - - - |
    L1| _ - - - _ - - - | _ - - - _ - - - |
    L2| _ - - - _ - - - | _ - - - _ - - - |

    /* 第 1 段 (4 小節) */
    | 3 - - 4 3 - - 2 | 1 - 2 - 3 - 1 - | 2 - - 3 2 - - 1 | 6, - 1 - 2 - 0 - |
    L1| う - - き も - - の | か - げ - か - ら - | あ - - た ま - - を | だ - し - て - _ - |
    L2| お - - お き - - な | お - く - ち - に - | お - - い か - - け | ら - れ - て - _ - |

    /* 第 2 段 (4 小節) */
    | 3 - - 4 5 - - - | 1 - - 2 3 - 5 - | 3 - - 3 2 - 1 - | 2 - 3 - 2 - 0 - |
    L1| な - - げ た - - - | ふ - - を く - う - | お - - い け - の - | ひ - ご - い - _ - |
    L2| な - - み の - - - | ま - - に ま - に - | や - - き ふ - が - | に - げ - る - _ - |

    /* 第 3 段 (4 小節: ひとつ・ふたつ・みいつ) */
    | 0 - - - 0 - - 5, | 5, - 5, - 0 - - 1 | 1 - 1 - 0 - - 3 | 3 - - - 5 - 0 - |
    L1| _ - - - _ - - ひ | と - つ - _ - - ふ | た - つ - _ - - み | い - - - つ - _ - |
    L2| _ - - - _ - - ゆ | ら - り - _ - - ゆ | ら - り - _ - - ゆ | ら - - - り - _ - |

    /* 第 4 段 (4 小節: ぱくぱくぱく) */
    | 1 - - 3 5 - 5 - | 4 - 4 - 3 - 1 - | 2 3 - 0 2 3 - 0 | 2 3 - 0 0 - - - |
    L1| み - - い つ - の - | お - く - ち - で - | ぱ く - _ ぱ く - _ | ぱ く - _ _ - - - |
    L2| ゆ - - ら め - く - | あ - と - か - ら - | ぱ く - _ ぱ く - _ | ぱ く - _ _ - - - |

    /* 後奏 (2 小節) */
    | 0 - - - 0 - - - | 0 - - - 0 - - - |
    L1| _ - - - _ - - - | _ - - - _ - - - |
    L2| _ - - - _ - - - | _ - - - _ - - - |
}

Oike:PianoRH@|0|{
    <16*>
    /* 前奏 */
    | 3 - 5 - 1' - 3' - | 2' - 7 - 5 - 2 - |

    /* 第 1 段 */
    | 3+5 - 3+5 - 3+5 - 3+5 - | 1+3 - 1+3 - 2+4 - 1+3 - | 2+4 - 2+4 - 1+4 - 7,+4 - | 1+3 - 1+3 - 1+3 - 0 - |

    /* 第 2 段 */
    | 3+5 - 3+5 - 5+1' - - - | 1+3 - 1+3 - 3+5 - 5+1' - | 3+5 - 3+5 - 2+6 - 1+5 - | 2+4 - 3+5 - 2+4 - 0 - |

    /* 第 3 段 */
    | 0 - - - 0 - - 2+5 | 1+3 - 1+3 - 0 - - 3+5 | 1+4 - 1+4 - 0 - - 3+5 | 3+5 - - - 2+4 - 0 - |

    /* 第 4 段 */
    | 1+3 - 3+5 - 5+1' - 5+1' - | 4+6 - 4+6 - 3+5 - 1+3 - | 2+4 3+5 - 0 2+4 3+5 - 0 | 2+4 3+5 - 0 1+3+5 - - - |

    /* 後奏 */
    | 3' - 1' - 5 - 3 - | 1 - 5, - 1+3+5 - - - |
}

Oike:PianoLH@|0|{
    <16*>
    /* 前奏 */
    | 1, - - - 5, - - - | 5,, - - - 2, - - - |

    /* 第 1 段 */
    | 1, - - - 5, - - - | 1, - - - 3, - - - | 4, - - - 2, - - - | 1, - - - 1,, - 0 - |

    /* 第 2 段 */
    | 1, - - - 3, - - - | 4, - - - 1, - - - | 3, - - - 6,, - - - | 5,, - - - 5, - 0 - |

    /* 第 3 段 */
    | 5,, - - - 5, - - - | 1, - - - 5,, - - - | 4,, - - - 5,, - - - | 1, - - - 5,, - 0 - |

    /* 第 4 段 */
    | 1, - - - 3, - - - | 4, - - - 5, - - - | 5,, - - - 1, - - - | 5,, - - - 1,, - - - |

    /* 後奏 */
    | 1, - - - 3, - - - | 5,, - - - 1,, - - - |
}

-> Oike[L1] -> Oike[L2] -> #
