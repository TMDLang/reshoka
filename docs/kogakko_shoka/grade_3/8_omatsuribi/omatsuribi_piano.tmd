::SCORE::
** おまつり日（祭典之日・鋼琴伴奏版） **
!= 132
?= E,
<2/4>
~ "日治時期公學校唱歌（第三學年・第八課）"
~ "國立臺灣歷史博物館典藏"

/* =========================================================================
   【曲目說明】
   ・出處：臺灣總督府編《公學校唱歌》第三學年用，第八課〈おまつり日〉（祭典之日），原書第 18–21 頁。
   ・調性與拍號：變ホ調（Eb 大調），主歌 2/4 拍（速度 != 132），尾奏轉 3/4 拍（速度 != 112）。
   ・背景與曲風：描寫臺灣神社祭典之日太鼓喧天、獻上蓬萊米與臺灣在地水果（蜜柑、文旦、白柚、香蕉、鳳梨、木瓜）
     以及抬神轎「えつさつさ」的歡騰景象。
   ・編曲說明（鋼琴伴奏版）：
     1. 前奏 (Intro, 4 小節)：引用第六行「たいこかついで、えつさつさ」的頓音與節奏動機，熱鬧開場。
     2. 主歌伴奏 (Omatsuribi, 24 小節 × 3 段)：右手 (PianoRH) 演奏充滿附點彈性的祭典旋律，
        左手 (PianoLH) 以太鼓般的低音與和弦節奏支撐，並在「えつさつさ」處與右手齊奏斷音呼應。
     3. 尾奏 (Coda, 4 小節)：三段歌詞唱畢後，依原譜轉為 3/4 拍（!= 112），以寬廣莊重的三拍子和聲收束全曲。

   【原書歌詞全文與中文語譯】（對應 image3.jpeg & image4.jpeg / P024–P025）

   一　たいわんじんじやのおまつり日、
   たいこはどんどんなつてゐる。
   今年はほう年、よい年だ。
   ほうらいまいをそなへませう。
   みこしかついで、えつさつさ、
   たいこかついで、えつさつさ。
   （語譯：臺灣神社的祭典之日，太鼓咚咚地響個不停。今年是豐年、好年冬，來獻上蓬萊米吧。抬起神轎，嘿呦嘿呦；抬起太鼓，嘿呦嘿呦。）

   二　たいわんじんじやのおまつり日、
   たいこはどんどんなつてゐる。
   みかんやぶんたん・ざぼんなど、
   いちばへかひにいきませう。
   みこしかついで、えつさつさ、
   たいこかついで、えつさつさ。
   （語譯：臺灣神社的祭典之日，太鼓咚咚地響個不停。蜜柑、文旦與白柚，一起去市場買回來吧。抬起神轎，嘿呦嘿呦；抬起太鼓，嘿呦嘿呦。）

   三　たいわんじんじやのおまつり日、
   たいこはどんどんなつてゐる。
   バナナやおんらい・もくくわなど、
   おせどへ行つてもぎませう。
   みこしかついで、えつさつさ、
   たいこかついで、えつさつさ。
   （語譯：臺灣神社的祭典之日，太鼓咚咚地響個不停。香蕉、鳳梨與木瓜，到屋後果園去摘下來吧。抬起神轎，嘿呦嘿呦；抬起太鼓，嘿呦嘿呦。）

   （尾奏：たいわんじんじやのおまつり日）
   ========================================================================= */

/* ==========================================================
   前奏 (Intro): 4 小節 (2/4 拍)
   以祭典太鼓「どんどん」與抬神轎「えつさつさ」的歡騰節奏展開
   ========================================================== */

Intro:PianoRH@|0|{
    <8*>
    | (1^ - - 1^)%(--) 6 - | (6 - - 5)%(--) (3 - - 1)%(--) | 2 0 5_ 0 | 1 - - 0 |
}

Intro:PianoLH@|0|{
    <8*>
    | 4_ [4] 4_ [4] | 4_ [4] 1_ [1] | 2_ 0 5_ 0 | 1_ [1] [1] 0 |
}

/* ==========================================================
   主歌段 (Omatsuribi): 24 小節 (2/4 拍)
   右手為唱歌主旋律，左手為祭典太鼓般的活潑伴奏
   ========================================================== */

Omatsuribi:PianoRH@|0|{
    <8*>
    /* ================= 第一行 (4 小節, image.jpeg / P022) ================= */
    | (1 - - 3)%(--) (5 - - 5)%(--) | (5 - - 5)%(--) (5 - - 5)%(--) | (3 - - 5)%(--) (6 - - 6)%(--) | 5 - - 0 |
    L1| (タ - - イ) (ワ - - ン) | (ジ - - ン) (ジャ - - ノ) | (オ - - マ) (ツ - - リ) | ビ - - 0 |
    L2| (た - - い) (わ - - ん) | (じ - - ん) (じゃ - - の) | (お - - ま) (つ - - り) | び - - 0 |
    L3| (タ - - イ) (ワ - - ン) | (ジ - - ン) (ジャ - - ノ) | (オ - - マ) (ツ - - リ) | ビ - - 0 |

    /* ================= 第二行 (4 小節, image.jpeg / P022) ================= */
    | (6 - - 1^)%(--) (6 - - 5)%(--) | 3 - 1 - | (2 - - 2)%(--) (2 - - 3)%(--) | 2 - - 0 |
    L1| (タ - - イ) (コ - - ハ) | ドン - ドン - | (ナ - - ツ) (テ - - ヰ) | ル - - 0 |
    L2| (た - - い) (こ - - は) | どん - どん - | (な - - つ) (て - - ゐ) | る - - 0 |
    L3| (タ - - イ) (コ - - ハ) | ドン - ドン - | (ナ - - ツ) (テ - - ヰ) | ル - - 0 |

    /* ================= 第三行 (4 小節, image.jpeg / P022) ================= */
    | (3 - - 2)%(--) (1 - - 3)%(--) | (5 - - 5)%(--) (5 - - 5)%(--) | (6 - - 5)%(--) (3 - - 5)%(--) | 6 - - 0 |
    L1| (コ - - ト) (シ - - ハ) | (ホ - - ウ) (ネ - - ン) | (ヨ - - イ) (ト - - シ) | ダ - - 0 |
    L2| (み - - か) (ん - - や) | (ぶ - - ん) (た - - ん) | (ざ - - ぼ) (ん - - な) | ど - - 0 |
    L3| (バ - - ナ) (ナ - - ヤ) | (オ - - ン) (ラ - - イ) | (モ - - ク) (クヮ - - ナ) | ド - - 0 |

    /* ================= 第四行 (4 小節, image.jpeg / P022) ================= */
    | (1^ - - 2^)%(--) (1^ - - 6)%(--) | (5 - - 5)%(--) 3 - | (2 - - 2)%(--) (3 - - 2)%(--) | 1 - - 0 |
    L1| (ホ - - ウ) (ラ - - イ) | (マ - - イ) ヲ - | (ソ - - ナ) (ヘ - - マ) | セウ - - 0 |
    L2| (い - - ち) (ば - - へ) | (か - - ひ) に - | (い - - き) (ま - - せ) | う - - 0 |
    L3| (オ - - セ) (ド - - ヘ) | (イ - - ツ) テ - | (モ - - ギ) (マ - - セ) | ウ - - 0 |

    /* ================= 第五行 (4 小節, image2.jpeg / P023) ================ */
    | 1 - 5_ 5_ | (1 - - 2)%(--) (3 - - 5)%(--) | 6 0 3 0 | 5 - - 0 |
    L1| ミ - コ シ | (カ - - ツ) (イ - - デ) | エッ 0 サッ 0 | サ - - 0 |
    L2| み - こ し | (か - - つ) (い - - で) | えっ 0 さっ 0 | さ - - 0 |
    L3| ミ - コ シ | (カ - - ツ) (イ - - デ) | エッ 0 サッ 0 | サ - - 0 |

    /* ================= 第六行 (4 小節, image2.jpeg / P023) ================ */
    | (1^ - - 1^)%(--) 6 - | (6 - - 5)%(--) (3 - - 1)%(--) | 2 0 5_ 0 | 1 - - 0 |
    L1| (タ - - イ) コ - | (カ - - ツ) (イ - - デ) | エッ 0 サッ 0 | サ - - 0 |
    L2| (た - - い) こ - | (か - - つ) (い - - で) | えっ 0 さっ 0 | さ - - 0 |
    L3| (タ - - イ) コ - | (カ - - ツ) (イ - - デ) | エッ 0 サッ 0 | サ - - 0 |
}

Omatsuribi:PianoLH@|0|{
    <8*>
    /* ================= 第一行 (4 小節) ================= */
    | 1_ [1] 5_ [1] | 1_ [1] 5_ [1] | 1_ [1] 4_ [4] | 1_ [1] 5_ 0 |

    /* ================= 第二行 (4 小節) ================= */
    | 4_ [4] 4_ [4] | 1_ [1] 1_ [1] | 5__ [5] 5__ [5] | 5_ [5] 5_ 0 |

    /* ================= 第三行 (4 小節) ================= */
    | 1_ [1] 5_ [1] | 1_ [1] 5_ [1] | 4_ [4] 1_ [1] | 6_ [6m] 6_ 0 |

    /* ================= 第四行 (4 小節) ================= */
    | 4_ [4] 4_ [4] | 1_ [1] 1_ [1] | 5_ [5] 5_ [5] | 1_ [1] 1_ 0 |

    /* ================= 第五行 (4 小節) ================= */
    | 1_ [1] 5_ [5] | 1_ [1] 5_ [1] | 4_ 0 1_ 0 | 5_ [5] 5_ 0 |

    /* ================= 第六行 (4 小節) ================= */
    | 4_ [4] 4_ [4] | 4_ [4] 1_ [1] | 2_ 0 5_ 0 | 1_ [1] 1_ 0 |
}

/* ==========================================================
   尾奏段 (Coda): 4 小節 (轉 3/4 拍, != 112)
   三段歌詞唱畢後，以寬廣莊重的三拍子作結
   ========================================================== */

Coda:PianoRH@|0|{
    <8*>
    /* ================= 第七行 (尾奏 4 小節, image2.jpeg / P023) =========== */
    {!=112} {<3/4>}
    | 3 2 1 - 2 - | 3 5 6 - 5 - | 3 5 2 - 3 - | 1 - - - 0 - |
    L| タ イ ワ - ン - | ジ ン ジャ - ノ - | オ マ ツ - リ - | ビ - - - 0 - |
}

Coda:PianoLH@|0|{
    <4*>
    {!=112} {<3/4>}
    | 1_ [1] 5_ | 1_ [4] [1] | 1_ [5] [1] | 1_ [1] 0 |
}

-> Intro
    -> Omatsuribi[L1]
    -> Omatsuribi[L2]
    -> Omatsuribi[L3]
    -> Coda
    -> #
