** 別れ **
!= 100
?= C
<4/4>
~ "詞：文部省"
~ "曲：文部省"
~ "臺灣總督府《公學校唱歌》第六學年用（昭和十五年，索書號 523.37 4322-4）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P066.jpg、P067.jpg，原書 pp. 62–63）：
   調性與拍號：ハ長調（C 大調）4/4 拍（弱起一拍），速度 ♩=100
   曲式結構：第 1–2 行（前 8 小節）譜下印有上下兩行片假名歌詞，第 2 行末附反覆記號（:||）；
             第 3–4 行（後 8 小節）譜下印單行片假名歌詞。

   春の朝（あした）花の下（もと）に、
   ともに楽しく親しみあひし、
   秋の夕（ゆふべ）月の影に、
   ともにうれしく語らひあひし、
   日頃のまじはり忘れぬほどに、
   惜しき別れをつげなん、さらば。
   ========================================================================= */

Wakare:Piano@|0|{
    <16*>
    /* ================= 第一行 (弱起一拍 + 3 小節 + 3 拍, P066.jpg) ================= */
    | 0 - - - 0 - - - 0 - - - {p} 1^ - - 1^ | 1^ - - - - - - - 0 - - - {mp} 1^ - - 1^ | 2^ - - - 1^ - - 2^ 1^ - - - 6 - - - | 4 - - 5 6 - - - 4 - - - 2 - - 3 | 5 - - - 1 - - - - - - - {mf} 1^ - - 1^ |
    L1| _ - - - _ - - - _ - - - ハ - - ル | ノ - - - - - - - _ - - - ハ - - ル | ノ - - - ア - - ー シ - - - タ - - - | ハ - - ー ナ - - - ノ - - - モ - - ー | ト - - - ニ - - - - - - - ト - - モ |
    L2| _ - - - _ - - - _ - - - ア - - キ | ノ - - - - - - - _ - - - ア - - キ | ノ - - - ユ - - ー フ - - - ベ - - - | ツ - - ー キ - - - ノ - - - カ - - ー | ゲ - - - ニ - - - - - - - ト - - モ |

    /* ================= 第二行 (句末 1^ 附延長記號與反覆記號 :||, P066.jpg) ================= */
    | 1^ - - - - - - - 0 - - - 1^ - - 1^ | 2^ - - - 1^ - - 2^ 1^ - - - 6 - - - | 2^ - - 2^ 1^ - - - 7 - - - 6 - - 5 | 6 - 7 - 1^ - - - - - - - {p} 5 - - - |
