** よろこび **
!= 120
?= B,
<4/4>
~ "臺灣總督府《公學校高等科唱歌》第一學年用（昭和十一年，索書號 0729 74）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P012.jpg–P013.jpg，原書 pp. 10–11）：
   調性與拍號：變ロ長調（Bb 大調，2 降記號），前段（第一、二行）4/4 拍（弱起 1 拍），
               後段（第三、四行，第三段結尾頌歌）轉 2/4 拍，速度 ♩=120
   樂譜結構說明：
   - 第一、二段僅演唱第一、二行（4/4 拍），於第二行末「I.II.」一、二房子反覆記號 :| 處反覆。
   - 第三段演唱第一、二行至「III.」三房子（「我等」），隨即轉入第三、四行之 2/4 拍樂段直至曲終（附延長記號 𝄐）。

   一
   東雲（しのゝめ）の光ほのかにさし出で、
   希望は燃ゆる、さやけき朝（あした）。

   二
   黃昏（たそがれ）の丘邊（をかべ）、彩雲（あやぐも）かゞよひ、
   生氣は滿つる、靜けき夕（ゆふべ）。

   三
   天皇（すめらぎ）の御稜威（みいつ）、くまなくかゞやき、
   美（うま）しの島に幸（さち）あり、我等。
   やよ歌へ友よ、よろこびの歌を。
   諸聲（もろごゑ）ほがらに、いざや歌はむ。
   ========================================================================= */

Yorokobi:Piano@|-1|{
    <16*>
    /* ================= 第一行 (4/4 拍，弱起 1 拍 + 4 小節，含第二行弱起 1 拍, P012.jpg) ================= */
    | 0 - - - 0 - - - 0 - - - {mf} 5_ - - 5_ | 1 - - - - - 1 - 1 - - - 7_ - - 1 | 2 - - - - - - - 0 - - - 3 - - 2 | 1 - 6_ - 1 - - - 5_ - - - - - 3_ - | 5_ - - - - - - - 0 - - - {f} 1_ - - 1_ |
    L1| _ - - - _ - - - _ - - - シ - - ノ | ノ - - - - - メ - ノ - - - ヒ - - カ | リ - - - - - - - _ - - - ホ - - ノ | カ - ニ - サ - - - シ - - - - - イ - | デ - - - - - - - _ - - - キ - - バ |
    L2| _ - - - _ - - - _ - - - た - - そ | が - - - - - れ - の - - - を - - か | べ - - - - - - - _ - - - あ - - や | ぐ - も - か - - - が - - - - - よ - | ひ - - - - - - - _ - - - せ - - い |
    L3| _ - - - _ - - - _ - - - ス - - メ | ラ - - - - - ギ - ノ - - - ミ - - イ | ツ - - - - - - - _ - - - ク - - マ | ナ - ク - カ - - - ガ - - - - - ヤ - | キ - - - - - - - _ - - - ウ - - マ |

    /* ================= 第二行 (4/4 拍，4 小節，含 I.II. 與 III. 結尾, P012.jpg) ================= */
    | 4_ - - - - - - - 4_ - - - 6_ - - 6_ | 5_ - - - - - - - 0 - - - 6_ - - 6_ | 5_ - - - 1 - - - 2 - - - - - 3 - | 1 - - - - - - - 0 - - - 0 - - - |
    L1| ウ - - - - - - - ハ - - - モ - - ユ | ル - - - - - - - _ - - - サ - - ヤ | ケ - - - キ - - - ア - - - - - シ - | タ - - - - - - - _ - - - _ - - - |
    L2| き - - - - - - - は - - - み - - つ | る - - - - - - - _ - - - し - - づ | け - - - き - - - ゆ - - - - - ふ - | べ - - - - - - - _ - - - _ - - - |
    L3| シ - - - - - - - ノ - - - シ - - マ | ニ - - - - - - - _ - - - サ - - チ | ア - - - リ - - - ワ - - - - - レ - | ラ - - - - - - - _ - - - _ - - - |

    /* ================= 第三行 (轉 2/4 拍，8 小節，第三段後半, P012.jpg) ================= */
