    L2| _ - _ - _ - ほ - | の - - に か - す - | め - - - る - や - | ま - - ー ふ - も - | と - - - - - を - |
    L3| _ - _ - _ - キ - | ギ - - ノ コ - ズ - | ヱ - - - ニ - ハ - | ナ - - ー ヒ - ラ - | キ - - - - - ホ - |

