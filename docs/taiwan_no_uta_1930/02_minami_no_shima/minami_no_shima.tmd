** 南の島 **
~ "作歌：上村一仁"
~ "作曲：一條愼三郎（花蓮港紅座社蕃謠改編）"
~ "昭和五年八月《臺灣教育》第 337 號〈臺灣の歌審査員の作曲發表〉第 81 頁"
~ "tag: orthography:historical_kana"
!= 104
?= B,
<2/4>

/*
曲目解說與史料考釋：
・出處：昭和五年（1930 年）八月號《臺灣教育》第 337 號第 81 頁〈臺灣の歌審査員の作曲發表〉。
・作歌：上村一仁（全八節歌詞）。
・作曲：一條愼三郎（審查員，採集花蓮港紅座社蕃謠改編）。
・音樂特徵：二降記號（B♭ 大調記譜，實為 C 小調五聲音階 C–E♭–F–G–B♭），2/4 拍，速度 ♩=104，弱起 1/8 拍。樂曲具臺灣阿美族（花蓮港紅座社）呼應歌謠特色，帶有「ヨイ ヨイ」（原譜以「↑」標示喊聲）吶喊呼應與「イヤホホ ホライ」之襯詞唱腔。
・與 1929 年版之異同：1929 年《臺灣の歌》（御大典記念事業發行集）所載之〈南の島〉為中山常雄作曲（ニ調陽音階）；1930 年本版則為一條愼三郎全新改編採譜之蕃謠版本，詞同而曲迥異。
・原刊全八節直排歌詞：
  一、冬(ふゆ)がいやなら／南(みなみ)の島(しま)へ ヨイヨイ／雪(ゆき)のない島(しま)／イヤホホ ホライ／春(はる)の島(しま)
  二、夢(ゆめ)が見(み)たけりや／南(みなみ)の島(しま)へ ヨイヨイ／椰子(やし)の木(こ)かげで／イヤホホ ホライ／戀(こひ)のゆめ
  三、笛(ふえ)が吹(ふ)きたきや／南(みなみ)の島(しま)へ ヨイヨイ／山(やま)に涼風(すゞかぜ)／イヤホホ ホライ／音(ね)もふるふ
  四、樂(らく)がしたけりや／南(みなみ)の島(しま)へ ヨイヨイ／牛(うし)の脊(せ)にのりや／イヤホホ ホライ／日(ひ)が暮(く)れる
  五、胡弓(こきゆう)ききたきや／南(みなみ)の島(しま)へ ヨイヨイ／絃(いと)のあはれに／イヤホホ ホライ／涙(なみだ)さへ
  六、月夜(つきよ)戀(こ)ふなら／南(みなみ)の島(しま)へ ヨイヨイ／遠音(とほね)ちやるめら／イヤホホ ホライ／青(あを)い月(つき)
  七、花(はな)を探(さ)ぐるなら／南(みなみ)の島(しま)へ ヨイヨイ／年(ねん)が年(ねん)中(ぢゆう)／イヤホホ ホライ／花(はな)の島(しま)
  八、唄(うた)が好(す)きなら／南(みなみ)の島(しま)へ ヨイヨイ／島(しま)が唄(うた)だよ／イヤホホ ホライ／唄(うた)はでも
*/

Main:Piano@|0|{
    <16*>
    /* ===== 第一行：冬がいやなら ===== */
    /* m.1 (弱起 1/8) */
    | 0 - - - - - 6_ - |
    L1| 0 - - - - - フ - |
    L2| 0 - - - - - ユ - |
    L3| 0 - - - - - フ - |
    L4| 0 - - - - - ラ - |
    L5| 0 - - - - - コ - |
    L6| 0 - - - - - ツ - |
    L7| 0 - - - - - ハ - |
    L8| 0 - - - - - ウ - |

    /* m.2 */
    | 1 - - - - - 6_ - |
    L1| ユ - - - - - ー - |
    L2| メ - - - - - ー - |
    L3| エ - - - - - ー - |
    L4| ク - - - - - ー - |
    L5| キ - - - - - ー - |
    L6| キ - - - - - ー - |
    L7| ナ - - - - - ー - |
    L8| タ - - - - - ー - |

    /* m.3 */
    | 6_ - - - 1 - - 1 |
    L1| ガ - - - ー - - ー |
    L2| ガ - - - ー - - ー |
    L3| ガ - - - ー - - ー |
    L4| ガ - - - ー - - ー |
    L5| ユウ - - - ー - - ー |
    L6| ヨ - - - ー - - ー |
    L7| ヲ - - - ー - - ー |
    L8| ガ - - - ー - - ー |

    /* m.4 */
    | 2 - - 1 2 - - - |
    L1| イ - - ヤ ナ - - - |
    L2| ミ - - タ ケ - - - |
    L3| フ - - キ タ - - - |
    L4| シ - - タ ケ - - - |
    L5| キ - - キ タ - - - |
    L6| コ - - フ ナ - - - |
    L7| サ - - グ ル - - - |
    L8| ス - - キ ナ - - - |

    /* m.5 */
    | 6_ - - 6_ 5_ - 4_ - |
    L1| ラ - - ー ー - ー - |
    L2| リヤ - - ー ー - ー - |
    L3| キヤ - - ー ー - ー - |
    L4| リヤ - - ー ー - ー - |
    L5| キヤ - - ー ー - ー - |
    L6| ラ - - ー ー - ー - |
    L7| ナ - - ー ラ - ー - |
    L8| ラ - - ー ー - ー - |

    /* ===== 第二行：南の島へ（ヨイ ヨイ） ===== */
    /* m.6 */
    | 5_ - - 6_ 5_ - - - |
    L1| ミ - - ナ ミ - - - |
    L2| ミ - - ナ ミ - - - |
    L3| ミ - - ナ ミ - - - |
    L4| ミ - - ナ ミ - - - |
    L5| ミ - - ナ ミ - - - |
    L6| ミ - - ナ ミ - - - |
    L7| ミ - - ナ ミ - - - |
    L8| ミ - - ナ ミ - - - |

    /* m.7 */
    | 1 - - - 5_ - - 4_ |
    L1| ノ - - - シ - - ー |
    L2| ノ - - - シ - - ー |
    L3| ノ - - - シ - - ー |
    L4| ノ - - - シ - - ー |
    L5| ノ - - - シ - - ー |
    L6| ノ - - - シ - - ー |
    L7| ノ - - - シ - - ー |
    L8| ノ - - - シ - - ー |

    /* m.8 */
    | 2_ - 4_ - 5_ - - - |
    L1| マ - ー - ヘ - - - |
    L2| マ - ー - ヘ - - - |
    L3| マ - ー - ヘ - - - |
    L4| マ - ー - ヘ - - - |
    L5| マ - ー - ヘ - - - |
    L6| マ - ー - ヘ - - - |
    L7| マ - ー - ヘ - - - |
    L8| マ - ー - ヘ - - - |

    /* m.9 (延音線接「ヘ」+ 喊聲「↑ ヨイ」) */
    | - - - - 5_ - - - |
    L1| - - - - ヨイ - - - |
    L2| - - - - ヨイ - - - |
    L3| - - - - ヨイ - - - |
    L4| - - - - ヨイ - - - |
    L5| - - - - ヨイ - - - |
    L6| - - - - ヨイ - - - |
    L7| - - - - ヨイ - - - |
    L8| - - - - ヨイ - - - |

    /* m.10 (喊聲「↑ ヨイ」+ 八分休止 + 第三行弱起 1/8) */
    | 5_ - - - 0 - 5_ - |
    L1| ヨイ - - - 0 - ユ - |
    L2| ヨイ - - - 0 - ヤ - |
    L3| ヨイ - - - 0 - ヤ - |
    L4| ヨイ - - - 0 - ウ - |
    L5| ヨイ - - - 0 - イ - |
    L6| ヨイ - - - 0 - ト - |
    L7| ヨイ - - - 0 - ネ - |
    L8| ヨイ - - - 0 - シ - |

    /* ===== 第三行：雪のない島 ===== */
    /* m.11 */
    | 6_ - - - - - 5_ - |
    L1| キ - - - - - ー - |
    L2| シ - - - - - ー - |
    L3| マ - - - - - ー - |
    L4| シ - - - - - ー - |
    L5| ト - - - - - ー - |
    L6| ホ - - - - - ー - |
    L7| ン - - - - - ー - |
    L8| マ - - - - - ー - |

    /* m.12 */
    | 4_ - - - 5_ - - 6_ |
    L1| ノ - - - ー - - ー |
    L2| ノ - - - ー - - ー |
    L3| ニ - - - ー - - ー |
    L4| ノ - - - ー - - ー |
    L5| ノ - - - ー - - ー |
    L6| ネ - - - ー - - ー |
    L7| ガ - - - ー - - ー |
    L8| ガ - - - ー - - ー |

    /* m.13 */
    | 2 - - 1 2 - - - |
    L1| ナ - - イ シ - - - |
    L2| コ - - カ ゲ - - - |
    L3| ス - - ズ カ - - - |
    L4| セ - - ニ ノ - - - |
    L5| ア - - ハ レ - - - |
    L6| チヤ - - ル メ - - - |
    L7| ネ - - ン ヂユ - - - |
    L8| ウ - - タ ダ - - - |

    /* m.14 */
    | 6_ - - 6_ 5_ - 4_ - |
    L1| マ - - ー ー - ー - |
    L2| デ - - ー ー - ー - |
    L3| ゼ - - ー ー - ー - |
    L4| リヤ - - ー ー - ー - |
    L5| ニ - - ー ー - ー - |
    L6| ラ - - ー ー - ー - |
    L7| ウ - - ー ー - ー - |
    L8| ヨ - - ー ー - ー - |

    /* ===== 第四行：イヤホホ ホライ 春の島 ===== */
    /* m.15 (原住民襯詞：イヤホホ) */
    | 6__ - - 1_ 6__ - - 1_ |
    L1| イ - - ヤ ホ - - ホ |
    L2| イ - - ヤ ホ - - ホ |
    L3| イ - - ヤ ホ - - ホ |
    L4| イ - - ヤ ホ - - ホ |
    L5| イ - - ヤ ホ - - ホ |
    L6| イ - - ヤ ホ - - ホ |
    L7| イ - - ヤ ホ - - ホ |
    L8| イ - - ヤ ホ - - ホ |

    /* m.16 (原住民襯詞：ホライ) */
    | 4_ - - - 2_ - 1_ - |
    L1| ホ - - - ラ - イ - |
    L2| ホ - - - ラ - イ - |
    L3| ホ - - - ラ - イ - |
    L4| ホ - - - ラ - イ - |
    L5| ホ - - - ラ - イ - |
    L6| ホ - - - ラ - イ - |
    L7| ホ - - - ラ - イ - |
    L8| ホ - - - ラ - イ - |

    /* m.17 */
    | 0 - 5_ - 4_ - - - |
    L1| 0 - ハ - ル - - - |
    L2| 0 - コ - ヒ - - - |
    L3| 0 - ネ - モ - - - |
    L4| 0 - ヒ - ガ - - - |
    L5| 0 - ナ - ミ - - - |
    L6| 0 - ア - ヲ - - - |
    L7| 0 - ハ - ナ - - - |
    L8| 0 - ウ - タ - - - |

    /* m.18 */
    | 5_ - - - 2_ - 1_ 6__ |
    L1| ノ - - - シ - ー ー |
    L2| ノ - - - ユ - ー ー |
    L3| フ - - - ル - ー ー |
    L4| ク - - - レ - ー ー |
    L5| ダ - - - サ - ー ー |
    L6| イ - - - ツ - ー ー |
    L7| ノ - - - シ - ー ー |
    L8| ハ - - - デ - ー ー |

    /* m.19 (附點四分音符延長記號 + 補齊弱起八分休止) */
    | 2_ - - - - - 0 - |
    L1| マ - - - - - 0 - |
    L2| メ - - - - - 0 - |
    L3| フ - - - - - 0 - |
    L4| ル - - - - - 0 - |
    L5| ヘ - - - - - 0 - |
    L6| キ - - - - - 0 - |
    L7| マ - - - - - 0 - |
    L8| モ - - - - - 0 - |
}

