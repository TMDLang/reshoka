::SCORE::
** オサル (ピアノ伴奏付) **
!= 108
?= C
<2/4>
~ "曲：大正幼年唱歌 第六集"

/* =========================================================================
   オサル (Osaru) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P069.jpg (Notebook 2, p.1)
   ========================================================================= */

Osaru:Vocal@|0| {
    <16*>
    | {mf} 5 - 6 5 5 - 0 - | 5 - 6 5 5 - 0 - | 3 - 0 - 2 - 0 - | 5_ - - - 0 - - - |
    /* @Vocal:   オ サー ー ル オ サー ー ル キ ヤ ッ */
    | 6 - 1^ 2^ 1^ - 0 - | 6 - 1^ 2^ 1^ - 0 - | 6 - 0 - 5 - 0 - | 3 - - - 0 - - - |
    | 5 - - 5 5 - 5 - | 5 - 1^ - 5 - - - | 3 - - 3 3 - 3 - | 3 - 5 - 2 - - - |
    | 5 - 6 5 5 - 0 - | 5 - 6 5 5 - 0 - | 3 - 0 - 2 - 0 - | 5_ - - - 0 - - - |
    | 6 - 1^ 2^ 1^ - 0 - | 6 - 1^ 2^ 1^ - 0 - | 6 - 0 - 5 - 0 - | 1 - - - 0 - - - |
}

Osaru:PianoRH@|0| {
    <16*>
    | {mp} 1+3+5 - - - 1+3+5 - - - | 1+3+5 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+7_+2 - - - | 2_+5_+7_ - - - 0 - - - |
    | 1+4+6 - - - 1+4+6 - - - | 1+4+6 - - - 1+4+6 - - - | 1+4+6 - - - 1+3+5 - - - | 5_+1+3 - - - 0 - - - |
    | 1+3+5 - - - 1+3+5 - - - | 1+3+5 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+1+3 - - - | 5_+1+3 - - - 5_+7_+2 - - - |
    | 1+3+5 - - - 1+3+5 - - - | 1+3+5 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+7_+2 - - - | 2_+5_+7_ - - - 0 - - - |
    | 1+4+6 - - - 1+4+6 - - - | 1+4+6 - - - 1+4+6 - - - | 1+4+6 - - - 5_+7_+2+5 - - - | 3_+5_+1 - - - 0 - - - |
}

Osaru:PianoLH@|0| {
    <16*>
    | 1 - - - 5_ - - - | 1 - - - 5_ - - - | 1 - - - 5_ - - - | 5__ - - - 0 - - - |
    /* @Vocal:   オッ カ ケー テ コ ロン ー デ キ ヤ ッ */
    | 4_ - - - 1 - - - | 4_ - - - 1 - - - | 4_ - - - 1 - - - | 1_ - - - 0 - - - |
    /* @Vocal:   オ ヤ ザ ル コ ザ ル イッ ショ ニ ア ソ ブ */
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 1 - - - 5_ - - - | 1 - - - 5_ - - - |
    /* @Vocal:   アッ チ デ モ コッ チ デ モ キ ヤ ッ */
    | 1 - - - 5_ - - - | 1 - - - 5_ - - - | 1 - - - 5_ - - - | 5__ - - - 0 - - - |
    /* @Vocal:   オ サー ー ル オ サー ー ル キ ヤ ッ */
    | 4_ - - - 1 - - - | 4_ - - - 1 - - - | 4_ - - - 5_ - - - | 1_ - - - 0 - - - |
}

-> Osaru -> #
