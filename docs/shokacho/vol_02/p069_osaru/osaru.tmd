    | 5 - - 5 5 - 5 - | 5 - 1^ - 5 - - - | 3 - - 3 3 - 3 - | 3 - 5 - 2 - - - |
    /* @Vocal: オ ヤ ザ ル コ ザ ル イッ ショ ニ ア ソ ブ */
