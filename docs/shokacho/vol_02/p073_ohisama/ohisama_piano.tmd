::SCORE::
** オ日様 (ピアノ伴奏付) **
!= 104
?= C
<2/4>
~ "曲：大正幼年唱歌 第八集"

/* =========================================================================
   オ日様 (Ohisama) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P073.jpg (Notebook 2, p.5)
   ========================================================================= */

Ohisama_A:Vocal@|0| {
    <16*>
    | {mf} 3 - 1 - 5 - 3 - | 1^ - 5 - - - 0 - | 6 - 1^ - 5 - - 1 | 3 - 2 - - - 0 - |
    /* @Vocal:   キ ラ キ ラ キ ラ ヒ ガ シ ニ 出 テ */
    | 3 - 1 - 5 - 3 - | 1^ - 5 - - - 0 - | 6 - 1^ - 5 - - 3 | 2 - 1 - - - 0 - |
}

Ohisama_A:PianoRH@|0| {
    <16*>
    | {mp} 5_+1+3 - - - 1+3+5 - - - | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+7_+2 - - - |
    | 5_+1+3 - - - 1+3+5 - - - | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 1+3+5 - - - | 5_+7_+2 - - - 3_+5_+1 - - - |
}

Ohisama_A:PianoLH@|0| {
    <16*>
    | 1 - - - 3_ - - - | 5_ - - - 1 - - - | 4_ - - - 1 - - - | 5_ - - - 5__ - - - |
    /* @Vocal:   ギ ラ ギ ラ ギ ラ ニ シ ニ シ ヅ ム */
    | 1 - - - 3_ - - - | 5_ - - - 1 - - - | 4_ - - - 1 - - - | 5_ - - - 1_ - - - |
}

Ohisama_B:Vocal@|0| {
    <16*>
    | 1^ - 2^ - 1^ - - 5 | 6 - 3 - - - 0 - | 1^ - 2^ - 1^ - - 5 | 6 - 2 - - - 0 - |
    /* @Vocal:   キ ラ キ ラ キ ラ ギ ラ ギ ラ ギ ラ */
    | 1^ - 2^ - 1^ - - 5 | 6 - 3 - - - 0 - | 1^ - 2^ - 1^ - - 5 | 6 - 1^ - - - 0 - |
}

Ohisama_B:PianoRH@|0| {
    <16*>
    | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 5_+1+3 - - - | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 5_+7_+2 - - - |
    | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 5_+1+3 - - - | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 3+5+1^ - - - |
}

Ohisama_B:PianoLH@|0| {
    <16*>
    | 1 - - - 3_ - - - | 4_ - - - 1 - - - | 1 - - - 3_ - - - | 4_ - - - 5_ - - - |
    /* @Vocal:   ヒ ガ シ ニ 出 テ ニ シ ニ シ ヅ ム */
    | 1 - - - 3_ - - - | 4_ - - - 1 - - - | 1 - - - 3_ - - - | 4_ - - - 1 - - - |
}

Ohisama_A_Return:Vocal@|0| {
    <16*>
    | 3 - 1 - 5 - 3 - | 1^ - 5 - - - 0 - | 6 - 1^ - 5 - - 1 | 3 - 2 - - - 0 - |
    /* @Vocal:   キ ラ キ ラ キ ラ ヒ ガ シ ニ 出 テ */
    | 3 - 1 - 5 - 3 - | 1^ - 5 - - - 0 - | 6 - 1^ - 5 - - 3 | 2 - 1 - - - 0 - |
}

Ohisama_A_Return:PianoRH@|0| {
    <16*>
    | 5_+1+3 - - - 1+3+5 - - - | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+7_+2 - - - |
    | 5_+1+3 - - - 1+3+5 - - - | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 1+3+5 - - - | 5_+7_+2 - - - 3_+5_+1 - - - |
}

Ohisama_A_Return:PianoLH@|0| {
    <16*>
    | 1 - - - 3_ - - - | 5_ - - - 1 - - - | 4_ - - - 1 - - - | 5_ - - - 5__ - - - |
    /* @Vocal:   ギ ラ ギ ラ ギ ラ ニ シ ニ シ ヅ ム */
    | 1 - - - 3_ - - - | 5_ - - - 1 - - - | 4_ - - - 1 - - - | 5_ - - - 1_ - - - |
}

-> Ohisama_A -> Ohisama_B -> Ohisama_A_Return -> #
