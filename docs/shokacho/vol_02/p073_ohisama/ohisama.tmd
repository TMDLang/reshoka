** オ日様 **
!= 104
?= C
<2/4>
~ "曲：大正幼年唱歌 第八集"

/* =========================================================================
   オ日様 (Ohisama)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P073.jpg (Notebook 2, p.5)
   Notation: Handwritten numbered notation (Jianpu)
   Annotations: ハ調 二拍子, 大正幼年唱歌 第八集 廿七頁
   Note: Score has Segno on bar 1, Fine at bar 8, and D.S. at bar 16 (total 24 bars).
   ・Reference Audio: [大正幼年唱歌チャンネル (YouTube)](https://www.youtube.com/@%E5%A4%A7%E6%AD%A3%E5%B9%BC%E5%B9%B4%E5%94%B1%E6%AD%8C%E3%83%81%E3%83%A3%E3%83%B3%E3%83%8D%E3%83%AB/videos)

   ========================================================================= */

Ohisama_A:Vocal@|0|{
    <16*>
    /* 歌詞: */
    /* キラキラ キラ ヒガシニ 出テ / ギラギラ ギラ ニシニ シヅム */
    /* キラキラ キラ ギラギラ ギラ / ヒガシニ 出テ ニシニ シヅム */
    /* キラキラ キラ ヒガシニ 出テ / ギラギラ ギラ ニシニ シヅム (Fine) */
    | {mf} 3 - 1 - 5 - 3 - | 1^ - 5 - - - 0 - | 6 - 1^ - 5 - - 1 | 3 - 2 - - - 0 - |
    /* @Vocal: キ ラ キ ラ キ ラ ヒ ガ シ ニ 出 テ */
    | 3 - 1 - 5 - 3 - | 1^ - 5 - - - 0 - | 6 - 1^ - 5 - - 3 | 2 - 1 - - - 0 - |
    /* @Vocal: ギ ラ ギ ラ ギ ラ ニ シ ニ シ ヅ ム */
}

Ohisama_B:Vocal@|0|{
    <16*>
    | 1^ - 2^ - 1^ - - 5 | 6 - 3 - - - 0 - | 1^ - 2^ - 1^ - - 5 | 6 - 2 - - - 0 - |
    /* @Vocal: キ ラ キ ラ キ ラ ギ ラ ギ ラ ギ ラ */
    | 1^ - 2^ - 1^ - - 5 | 6 - 3 - - - 0 - | 1^ - 2^ - 1^ - - 5 | 6 - 1^ - - - 0 - |
    /* @Vocal: ヒ ガ シ ニ 出 テ ニ シ ニ シ ヅ ム */
}

Ohisama_A_Return:Vocal@|0|{
    <16*>
    | 3 - 1 - 5 - 3 - | 1^ - 5 - - - 0 - | 6 - 1^ - 5 - - 1 | 3 - 2 - - - 0 - |
    /* @Vocal: キ ラ キ ラ キ ラ ヒ ガ シ ニ 出 テ */
    | 3 - 1 - 5 - 3 - | 1^ - 5 - - - 0 - | 6 - 1^ - 5 - - 3 | 2 - 1 - - - 0 - |
    /* @Vocal: ギ ラ ギ ラ ギ ラ ニ シ ニ シ ヅ ム */
}

-> Ohisama_A -> Ohisama_B -> Ohisama_A_Return -> #
