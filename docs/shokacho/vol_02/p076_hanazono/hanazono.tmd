** 花園 **
!= 100
?= E,
<4/4>
~ "曲：教育幼稚唱歌集"

/* =========================================================================
   花園 (Hanazono)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P076.jpg (Notebook 2, p.8)
   Notation: Handwritten numbered notation (Jianpu)
   Annotations: 変ホ調 4/4, 教育幼稚唱歌集 (九六頁)
   ========================================================================= */

Hanazono:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* 1. (姉) タネヲ バマイテ ナヘ ウヘテ / マイニチ ニイニチ ミヅ カケテ */
    /* (妹) ナカヨク ツクッタ ハナゾノ ニ / ハナノ イロイロ サキマシタ */
    /* 2. (弟) コギク ナデシコ アサガホ ヤ / キレイニ サイタ ウレシイ ナ */
    /* (三人) トウサン カアサン ミテ チャウダイ / ホメテ チャウダイ コノ ハナヲ */
    | 0 - - - - - - - - - - - {mf} 1 - - - | 3 - - - - - 2 - 1 - - - 3 - - - | 5 - - - - - - - 5 - - - 5 - - - | 6 - - - - - - - 5 - - - 3 - 1 - | 2 - - - - - - - - - - - 1 - - - |
    /* @Vocal: タ ネ ヲ バ マ イ テ ナ ヘ ウ ヘ テ ー マ */
    /* @Vocal: コ ギ ク ー ナ デ シ コ ア サ ガ ホ ヤ ー キ */
    | 3 - - - - - 2 - 1 - - - 3 - - - | 5 - - - - - - - 5 - - - 5 - - - | 6 - - - - - - - 5 - - - 3 - 2 - | 1 - - - - - - - - - - - 2 - - - |
    /* @Vocal: イ ニ チ ニ イ ニ チ ミ ヅ カ ケ テ ー ナ */
    /* @Vocal: レ イ ニ サ イ タ ー ウ レ シ イ ナ ー ト */
    | 3 - - - - - 2 - 3 - - - 3 - - - | 5 - - - - - 3 - 5 - - - 5 - - - | 6 - - - - - - - 5 - - - 3 - 1 - | 2 - - - - - - - - - - - 1 - - - |
    /* @Vocal: カ ヨ ク ツ ク ッ タ ハ ナ ゾ ノ ニ ー ハ */
    /* @Vocal: ウ サ ン カ ア サ ン ミ テ チャウ ダ イ ー ホ */
    | 3 - - - - - - - 2 - - - 1 - 2 - | 1 - - - - - - - 6_ - - - 5_ - - - | 6_ - - - - - 5_ - 6_ - - - 2 - - - | 1 - - - - - - - - - - - 0 - - - |
    /* @Vocal: ナ ノ イ ロ イ ロ サ キ マ シ タ */
    /* @Vocal: メ テ チャウ ダ イ ー コ ノ ハ ナ ヲ */
}

-> Hanazono -> #
