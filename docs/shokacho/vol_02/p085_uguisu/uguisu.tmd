::SCORE::
** うぐひす **
!= 96
?= E,
<4/4>
~ "曲：不詳"

/* =========================================================================
   うぐひす (Uguisu)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P085.jpg (Notebook 2, p.17)
   Notation: Handwritten 5-line staff (3 flats = Eb major, 4/4 time, 24 bars)
   ========================================================================= */

Uguisu:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* ホホケキョ ホホケキョ ひなたの むらの */
    /* ウメノキ ニ ホケ キョ ミヅイロ */
    /* リボンノ ウグヒス ガ */
    /* ホホケキョ ホホケキョ ホ ホケキョト */
    /* ナイテ ヰ ル */
    | {f} 3 - - - 3 - - 2 1 - - - 0 - - - | 3 - - - 3 - - 2 1 - - - 0 - - - | {mp} 5_ - - - 5_ - - - 6_ - - - 7_ - - - | 1 - - - 1 - - - 2 - - - 3 - - - |
    /* @Vocal: ホ ホ ケ キョ ホ ホ ケ キョ ひ な た の む ー ら の */
    | 2 - - - 3 - 1 - 6_ - - - 5_ - - - | 6_ - - - - - - - - - - - 0 - - - | 0 - - - - - - - 0 - 5 - 6 - 7 - | 1^ - - - - - - - - - - - - - - - | {f} 7, - - - - - 6 - 6 - - - 6 - - - |
    /* @Vocal: ウ メ ー ノ キ ニ ホ ー ケ キョ ミ ヅ イ ロ */
    | 6 - - - - - 5 - 3 - - - 3 - - - | {p} 2' - - - 3 - 6_ - 5_ - - - 6_ - - - | 5_ - - - 7, - 6 - 5 - - - - - - - | 5 - - - - - - - - - - - - - - - | 5 - - - - - - - - - - - 0 - - - |
    /* @Vocal: リ ボ ン ノ ウ グ ヒ ス ガ ー ー ー ー ー */
    | {f} 3 - - - 3 - - 2 1 - - - 0 - - - | 3 - - - 3 - - 2 1 - - - 0 - - - | 5_ - - - 6_ - - - 7_ - - - 2 - - - | 0 - 3^ - 2^ - 1^ - 6 - - - 0 - - - |
    /* @Vocal: ホ ホ ケ キョ ホ ホ ケ キョ ホ ー ー ー ホ ケ キョ ト */
    | 2 - - - 3 - - - 6_ - - - 7_ - - - | 1 - - - - - 3 - 2 - - - 6_ - - - | 1 - - - - - - - - - - - - - - - | 1 - - - - - - - 0 - - - - - - - | 0 - - - - - - - - - - - - - - - | 0 - - - - - - - - - - - - - - - |
    /* @Vocal: ナ イ テ ー ヰ ー ル ー ー ー */
}

-> Uguisu -> #
