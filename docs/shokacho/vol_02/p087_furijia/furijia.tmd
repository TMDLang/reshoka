::SCORE::
** フリージア **
!= 96
?= E
<4/4>
~ "曲：不詳"

/* =========================================================================
   フリージア (Furījia)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P087.jpg (Notebook 2, p.19)
   Notation: Handwritten 5-line staff (4 sharps = E major, 4/4 time, 20 bars)
   ========================================================================= */

Furijia_Intro:Vocal@|0| {
    <16*>
    | 0 - - - - - - - - - - - - - - - | 0 - - - - - - - - - - - - - - - |
}

Furijia_A:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* フリージヤ / フリージア ユカシキカノ フリージア */
    /* ヤマノカゲノ オンシツノ コホリノカベノ */
    /* ナカニ ハルヲ ユメミル フリジア */
    /* カホリテマツ フリジア フリージア */
    /* フリージア ユカシキカノ フリージア */
    | {mf} 3 - - - 5 - - - 3 - - - 5 - - - | 3 - - - - - - - - - - - - - - - | 2 - - - 4 - 2 - 2 - - - 7_ - - - | 1 - 2 - 3 - 4 - 3 - 2 - 3 - - - | 2 - - - 4 - 2 - 1 - - - 1 - - - |
    /* @Vocal: フ リ ー ジ ヤ ー フ リ ー ジ ア ユ カ シ キ カ ー ノ フ リ ー ジ ア */
    | 6_ - 7_ - 1 - - - 6_ - 6_ - 6_ - 5_ - | 1 - - - 2 - 3 - 4 - 4 - 4 - 4 - | 3 - 5 - 6 - 6 - {f} 6 - 6 - 6 - 6 - |
    /* @Vocal: ヤ マ ノ カ ゲ ノ ー オ ン シ ツ ノ ー ー ー コ ホ リ ノ カ ベ ノ ー */
    | 5 - - - - - - - 3 - - - 2 - - - | 1 - 1 - 7_ - 1 - 2 - 3 - 2 - 1 - | 7_ - - - 2 - - - 5 - - - 3 - - - |
    /* @Vocal: ナ カ ニ ハ ル ヲ ー ユ メ ミ ー ル フ リ ジ ア */
    | {p} 6_ - 1 - 2 - 4 - 3 - 2 - 1 - - - | 6_ - - - 7_ - - - 1 - - - 2 - - - | {mf} 3 - - - 5 - - - 3 - - - 5 - - - | 3 - - - - - - - - - - - - - - - |
    /* @Vocal: カ ホ リ テ マ ー ツ フ リ ジ ア フ リ ー ジ ア ー */
    | 2 - - - 4 - 2 - 2 - - - 7_ - - - | 1 - 2 - 3 - 4 - 3 - 2 - 3 - - - | 2 - - - 4 - 2 - 1 - - - 1 - - - |
    /* @Vocal: フ リ ー ジ ア ユ カ シ キ カ ー ノ フ リ ー ジ ア */
}

-> Furijia_Intro -> Furijia_A -> #
