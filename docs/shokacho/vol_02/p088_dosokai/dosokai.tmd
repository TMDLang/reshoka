::SCORE::
** 同窓會（二部合唱） **
!= 108
?= F
<4/4>
~ "曲：不詳"

/* =========================================================================
   同窓會（二部合唱） (Dōsōkai — Two-Part Chorus)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P088.jpg (Notebook 2, p.20)
   Notation: Handwritten 5-line staff (1 flat = F major, 4/4 time, 16 bars, 2-part chorus)
   ========================================================================= */

Dosokai:Vocal1@|0| {
    <16*>
    /* 歌詞: */
    /* 1. マナービノ マドノー アケークレ ニ / ツクエナラ ベーテー フミヲヨ ミ */
    /* ハナニモミ ヂーニー アソビシ モ / アアーアノ ヤマヨー コノカハ ヨ */
    /* 2. おもーいで おほきー このーには の / そのーとも がきのー へだてな く */
    /* こころひと つーにー てをとり て / ともにはげ まーんー ひとのみ ち */
    /* 3. モユールガ ゴトキー ヨローコビ ニ / タカキシノ オーンー カンシャシ テ */
    /* ボカウーノ サカエー イノラマ シ / タノーシヤ タノシー コノマト ヰ */
    | {mf} 3 - - - 3 - - 4 5 - - - 5 - - - | 6 - - - 6 - - - 5 - - - - - - - | 2 - - - 2 - - 3 4 - - - 2 - - - | 3 - - - - - - - - - - - 0 - - - |
    /* @Vocal1: マ ナー ビ ノ マ ド ノ ア ケ ク レ ニ */
    /* @Vocal1: お もー い で お ほ き こ の に は の */
    /* @Vocal1: モ ユー ル ガ ゴ ト キ ヨ ロ コ ビ ニ */
    | 5 - - - 3 - - 4 5 - - - 5 - - - | 6 - - - 6 - - - 5 - - - - - - - | 2 - - - 3 - - - 4 - - - 3 - - - | 2 - - - - - - - - - - - 0 - - - |
    | 2 - - - 2 - - 3 4 - - - 2 - - - | 3 - - - 4 - - - 5 - - - - - - - | 6 - - - 6 - - - 5 - - - 4' - - - | 5 - - - - - - - - - - - 0 - - - |
    | {f} 6 - - - 6 - - 6 5 - - - 3 - - - | 4 - - - 4 - - - 3 - - - - - - - | 2 - - - 2 - - - 3 - - - 2 - - - | 1 - - - - - - - - - - - 0 - - - |
}

Dosokai:Vocal2@|0| {
    <16*>
    | {mf} 1 - - - 1 - - 2 3 - - - 3 - - - | 4 - - - 4 - - - 3 - - - - - - - | 5_ - - - 5_ - - 5_ 5_ - - - 5_ - - - | 1 - - - - - - - - - - - 0 - - - |
    /* @Vocal2: マ ナー ビ ノ マ ド ノ ア ケ ク レ ニ */
    /* @Vocal2: お もー い で お ほ き こ の に は の */
    /* @Vocal2: モ ユー ル ガ ゴ ト キ ヨ ロ コ ビ ニ */
    /* @Vocal1: ツ ク エ ナ ラ ベ テ フ ミ ヲ ヨ ミ */
    /* @Vocal1: そ の と も が き の へ だ て な く */
    /* @Vocal1: タ カ キ シ ノ オ ン カ ン シャ シ テ */
    | 1 - - - 1 - - 2 3 - - - 3 - - - | 4 - - - 2 - - - 1 - - - - - - - | 5_ - - - 1 - - - 7_ - - - 1 - - - | 5_ - - - - - - - - - - - 0 - - - |
    /* @Vocal2: ツ ク エ ナ ラ ベ テ フ ミ ヲ ヨ ミ */
    /* @Vocal2: そ の と も が き の へ だ て な く */
    /* @Vocal2: タ カ キ シ ノ オ ン カ ン シャ シ テ */
    /* @Vocal1: ハ ナ ニ モ ミ ヂ ニ ア ソ ビ シ モ */
    /* @Vocal1: こ こ ろ ひ と つ に て を と り て */
    /* @Vocal1: ボ カ ウ ノ サ カ エ イ ノ ラ マ シ */
    | 7_ - - - 7_ - - 1 2 - - - 7_ - - - | 1 - - - 2 - - - 3 - - - - - - - | 1 - - - 1 - - - 2 - - - 2 - - - | 7_ - - - - - - - - - - - 0 - - - |
    /* @Vocal2: ハ ナ ニ モ ミ ヂ ニ ア ソ ビ シ モ */
    /* @Vocal2: こ こ ろ ひ と つ に て を と り て */
    /* @Vocal2: ボ カ ウ ノ サ カ エ イ ノ ラ マ シ */
    /* @Vocal1: ア アー ア ノ ヤ マ ヨ コ ノ カ ハ ヨ */
    /* @Vocal1: と もー に は げ ま ん ひ と の み ち */
    /* @Vocal1: タ ノー シ ヤ タ ノ シ コ ノ マ ト ヰ */
    | {f} 1 - - - 1 - - 1 1 - - - 1 - - - | 2 - - - 7_ - - - 1 - - - - - - - | 6_ - - - 6_ - - - 5_ - - - 5_ - - - | 1 - - - - - - - - - - - 0 - - - |
    /* @Vocal2: ア アー ア ノ ヤ マ ヨ コ ノ カ ハ ヨ */
    /* @Vocal2: と もー に は げ ま ん ひ と の み ち */
    /* @Vocal2: タ ノー シ ヤ タ ノ シ コ ノ マ ト ヰ */
}

