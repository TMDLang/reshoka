::SCORE::
** 汽車 (ピアノ伴奏付) **
!= 112
?= C
<2/4>
~ "曲：大正幼年唱歌 第二集"

/* =========================================================================
   汽車 (Kisha) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P071.jpg (Notebook 2, p.3)
   ========================================================================= */

Kisha:Vocal@|0| {
    <16*>
    | {mf} 3 - - - 2 - 1 - | 3 - 5 - 5 - 0 - | 6 - 1^ - - - 6 - | 5 - 3 - 5 - 0 - |
    /* @Vocal:   キ シャハ ヤ イ ー ケ ム リ ハ イ テ */
    /* @Vocal:   キ シャト ホ ル ー オ ト ヲ タ テ テ */
    | 3 - - 3 2 - 1 - | 3 - 5 - 6 - 5 - | 3 - 5 - - - 3 - | 2 - 2 - 1 - 0 - |
    | 1^ - 1^ - - - 6 - | 1^ - 1^ - 5 - 0 - | 6 - 1^ - - - 6 - | 5 - 3 - 5 - 0 - |
    | 3 - - 3 2 - 1 - | 3 - 5 - 6 - 5 - | 3 - 5 - - - 3 - | 2 - 2 - 1 - 0 - |
}

Kisha:PianoRH@|0| {
    <16*>
    | {mp} 5_+1+3 - - - 5_+7_+2 - - - | 5_+1+3 - - - 1+3+5 - - - | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 0 - - - |
    | 5_+1+3 - - - 5_+1 - - - | 5_+1+3 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+1+3 - - - | 5_+7_+2 - - - 3_+5_+1 - - - |
    | 3+5+1^ - - - 1+4+6 - - - | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 0 - - - |
    | 5_+1+3 - - - 5_+1 - - - | 5_+1+3 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+1+3 - - - | 5_+7_+2 - - - 3_+5_+1 - - - |
}

Kisha:PianoLH@|0| {
    <16*>
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 4_ - - - 4_ - - - | 1 - - - 0 - - - |
    /* @Vocal:   ヤ マ コ エ カ ハ コ エ キ シャ ハ ハ ヤ イ */
    /* @Vocal:   イ キ ツ キ ヤ ス マ ズ キ シャ ハ ス ギ ル */
    | 1 - - - 5_ - - - | 1 - - - 4_ - - - | 5_ - - - 1 - - - | 5_ - - - 1_ - - - |
    /* @Vocal:   キ シャ ハ ハ シ ル 汽 テキ ナ ラ シ */
    /* @Vocal:   キ シャ ハ イ ッ タ ケ ムリ ノ コ シ */
    | 1 - - - 4_ - - - | 1 - - - 3_ - - - | 4_ - - - 4_ - - - | 1 - - - 0 - - - |
    /* @Vocal:   野 ヲ ス ギ サ ト ス ギ キ シャ ハ ハ シ ル */
    /* @Vocal:   ト モ ノ セ ニ ヲ ノ セ キ シャ ハ イ ッ タ */
    | 1 - - - 5_ - - - | 1 - - - 4_ - - - | 5_ - - - 1 - - - | 5_ - - - 1_ - - - |
}

-> Kisha -> #
