/* =========================================================================
   軍艦 (Gunkan)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P074.jpg (Notebook 2, p.6)
   Notation: Handwritten numbered notation (Jianpu)
   Annotations: ト調 四拍子, 大正幼年唱歌 第二集 廿九頁
   ========================================================================= */

Gunkan:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* 1. グン艦 ススム ナミヲ 立テテ / ケムリヲ 吐イテ イサマシク */
    /* 2. タイ炮 ノセテ イサミ ススム / アサヒノ ミハタ ヒルガヘシ */
    /* (Refrain) アレヨ アレヨ ススム ススム / グンカン ススム ナミタテテ */
    | {f} 5_ - - - 5_ - - - 5_ - - - - - - - | 5_ - - - 3_ - - - 1_ - - - - - - - | 2_ - - - 3_ - - - 5_ - - - - - - - | 3_ - - - 5_ - - - 2_ - - - - - - - |
    /* @Vocal: グ ン 艦 ー ス ス ム ー ナ ミ ヲ ー 立 テ テ ー */
    /* @Vocal: タ イ 炮 ー ノ セ テ ー イ サ ミ ー ス ス ム ー */
    | 5_ - - - 5_ - - - 5_ - - - - - - - | 5_ - - - 3_ - - - 1_ - - - - - - - | 2_ - - - 3_ - - - 5_ - - - 2_ - - - | 1_ - - - - - - - - - - - 0 - - - |
    /* @Vocal: ケ ム リ ヲ 吐 イ テ ー イ サ マ シ ク ー ー */
    /* @Vocal: ア サ ヒ ノ ミ ハ タ ー ヒ ル ガ ヘ シ ー ー */
    | 2_ - - - 3_ - - - 5_ - - - - - - - | 3_ - - - 5_ - - - 2_ - - - - - - - | 2_ - - - 3_ - - - 5_ - - - - - - - | 3_ - - - 5_ - - - 2_ - - - - - - - |
    /* @Vocal: ア レ ヨ ー ア レ ヨ ー ス ス ム ー ス ス ム ー */
    | 5_ - - - 5_ - - - 5_ - - - - - - - | 5_ - - - 3_ - - - 1_ - - - - - - - | 2_ - - - 3_ - - - 5_ - - - 2_ - - - | 1_ - - - - - - - - - - - 0 - - - |
    /* @Vocal: グ ン カ ン ス ス ム ー ナ ミ タ テ テ ー ー */
}

