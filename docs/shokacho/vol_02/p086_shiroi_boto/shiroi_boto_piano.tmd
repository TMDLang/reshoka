::SCORE::
** 白いボート (ピアノ伴奏付) **
!= 96
?= G
<6/8>
~ "曲：不詳"

/* =========================================================================
   白いボート (Shiroi Bōto) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P086.jpg (Notebook 2, p.18)
   ========================================================================= */

ShiroiBoto:Vocal@|0| {
    <16*>
    | {mp} 3 - 3 - 3 - 5 - 3 - 2 - | 1 - - 2 - - 3 - 2 - 1 - | 6_ - 1 - 6_ - 5_ - 6_ - 1 - | 2 - - - - - 0 - - - - - |
    /* @Vocal:   し ろ い ボ ー ト が ゆ ら ゆ ら と と ほ い な ぎ さ に つ */
    | 3 - 3 - 3 - 5 - 3 - 2 - | 1 - - 2 - - 3 - 2 - 1 - | 2 - 3 - 2 - 5_ - 7_ - 2 - | 1 - - - - - 0 - - - - - |
    | 6_ - 6_ - 6_ - 6_ - 7_ - 1 - | 2 - - 2 - - 2 - 1 - 6_ - | 5_ - 1 - 2 - 3 - 2 - 3 - | 5 - - - - - 0 - - - - - |
    | 6 - 6 - 6 - 5 - 3 - 2 - | 1 - - 2 - - 3 - 2 - 1 - | 2 - 2 - 2 - 3 - 2 - 6_ - | 5_ - - - - - 0 - - - - - |
    | 3 - 3 - 3 - 5 - 3 - 2 - | 1 - - 2 - - 3 - 2 - 1 - | 6_ - 1 - 6_ - 5_ - 6_ - 1 - | 2 - - - - - 0 - - - - - |
    | 3 - 5 - 6 - 5 - 3 - 1 - | 2 - - 3 - - 2 - 1 - 6_ - | 5_ - 1 - 2 - 3 - 2 - 7_ - | 1 - - - - - 0 - - - - - |
}

ShiroiBoto:PianoRH@|0| {
    <16*>
    | {p} 5_+1+3 - - - - - 5_+1+3 - - - - - | 5_+1+3 - - - - - 5_+1 - - - - - | 4_+6_+1 - - - - - 3_+5_+1 - - - - - | 5_+7_+2 - - - - - 0 - - - - - |
    | 5_+1+3 - - - - - 5_+1+3 - - - - - | 5_+1+3 - - - - - 5_+1 - - - - - | 5_+7_+2 - - - - - 5_+7_+2 - - - - - | 3_+5_+1 - - - - - 0 - - - - - |
    | 4_+6_+1 - - - - - 4_+6_+1 - - - - - | 4'_+6_+2 - - - - - 4'_+6_+2 - - - - - | 3_+5_+1 - - - - - 5_+1+3 - - - - - | 7_+2+5 - - - - - 0 - - - - - |
    | 1+4+6 - - - - - 1+3+5 - - - - - | 5_+1+3 - - - - - 5_+1 - - - - - | 4'_+6_+2 - - - - - 4'_+6_+2 - - - - - | 2_+5_+7_ - - - - - 0 - - - - - |
    | 5_+1+3 - - - - - 5_+1+3 - - - - - | 5_+1+3 - - - - - 5_+1 - - - - - | 4_+6_+1 - - - - - 3_+5_+1 - - - - - | 5_+7_+2 - - - - - 0 - - - - - |
    | 5_+1+3 - - - - - 1+3+5 - - - - - | 5_+7_+2 - - - - - 4_+6_+1 - - - - - | 3_+5_+1 - - - - - 5_+7_+2 - - - - - | 3_+5_+1 - - - - - 0 - - - - - |
}

ShiroiBoto:PianoLH@|0| {
    <16*>
    | 1 - - - - - 3_ - - - - - | 1 - - - - - 3_ - - - - - | 4_ - - - - - 1 - - - - - | 5_ - - - - - 0 - - - - - |
    /* @Vocal:   し ろ い ボ ー ト が つ ん だ の は キャン デ ィ プ ー リ ン カ */
    | 1 - - - - - 3_ - - - - - | 1 - - - - - 3_ - - - - - | 5_ - - - - - 5__ - - - - - | 1_ - - - - - 0 - - - - - |
    /* @Vocal:   い ろ と り ど り の は な ぐ わ し ぎ ん で く る ん だ チョ */
    /* @Vocal:   ふ ね の な か に は た れ も ゐ ず ひ と な し じ ま の ね */
    | 4_ - - - - - 4_ - - - - - | 2_ - - - - - 2_ - - - - - | 1 - - - - - 1 - - - - - | 5_ - - - - - 0 - - - - - |
    /* @Vocal:   い ろ と り ど り の は な ぐ わ し ぎ ん で く る ん だ チョ */
    /* @Vocal:   ひ と な し じ ま の ね む の き に あ か い い ん こ が く */
    | 4_ - - - - - 1 - - - - - | 1 - - - - - 3_ - - - - - | 2_ - - - - - 2_ - - - - - | 5_ - - - - - 0 - - - - - |
    /* @Vocal:   し ろ い ボ ー ト が ゆ ら ゆ ら と と ほ い な ぎ さ に つ */
    /* @Vocal:   あ か い い ん こ が く び か し げ け ふ も な が め て ゐ */
    | 1 - - - - - 3_ - - - - - | 1 - - - - - 3_ - - - - - | 4_ - - - - - 1 - - - - - | 5_ - - - - - 0 - - - - - |
    /* @Vocal:   ぎ ん で く る ん だ チョ コ レ ー ト ぎ ん で く る ん だ ト */
    /* @Vocal:   け ふ も な が め て ゐ り ま し た け ふ も な が め て た */
    | 1 - - - - - 3_ - - - - - | 5_ - - - - - 4_ - - - - - | 5_ - - - - - 5__ - - - - - | 1_ - - - - - 0 - - - - - |
}

