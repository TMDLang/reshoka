** お星様 (ピアノ伴奏付) **
!= 96
?= F
<2/4>
~ "曲：愛吟抄 (大正十二年)"

/* =========================================================================
   お星様 (Ohoshisama) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P077.jpg (Notebook 2, p.9)
   ========================================================================= */

Ohoshisama:Vocal@|0| {
    <16*>
    | {mp} 5_ - 1 - 1 - 1 - | 2 - 1 2 3 - - - | 5 - 5 - 3 - - - | 2 - 1 - 2 - - - |
    /* @Vocal:   オ ヒ サ マ ハ イッ ー タ ニ シ ノ ソ ラ ニ */
    /* @Vocal:   ユ メ ミ テ ネ ムー ー ル ヨナ カ ノ ソ ラ ニ */
    | 1 - - - 2 - 2 - | 3 - - - 6 - - - | 5 - 3 - 2 - - 3 | 1 - - - - - 0 - |
    | 2 - 3 - 2 - 1 - | 2 - 3 - 2 - - - | 5 - - - 5 - 3 - | 2 - 1 - 2 - - - |
    | 1 - - - 2 - 3 - | 5 - 6 - 5 - 3 - | 2 - 2 3 2 - 2 2 | 1 - - - - - 0 - |
}

Ohoshisama:PianoRH@|0| {
    <16*>
    | {p} 3_+5_+1 - - - 5_+1 - - - | 5_+7_+2 - - - 5_+1+3 - - - | 1+3+5 - - - 5_+1+3 - - - | 5_+7_+2 - - - 5_+7_+2 - - - |
    | 5_+1 - - - 5_+7_+2 - - - | 5_+1+3 - - - 1+4+6 - - - | 1+3+5 - - - 5_+7_+2 - - - | 3_+5_+1 - - - 0 - - - |
    | 5_+7_+2 - - - 5_+7_+2 - - - | 5_+7_+2 - - - 5_+7_+2 - - - | 1+3+5 - - - 5_+1+3 - - - | 5_+7_+2 - - - 5_+7_+2 - - - |
    | 5_+1 - - - 5_+1+3 - - - | 1+3+5 - - - 1+3+5 - - - | 5_+7_+2 - - - 5_+7_+2 - - - | 3_+5_+1 - - - 0 - - - |
}

Ohoshisama:PianoLH@|0| {
    <16*>
    | 1 - - - 3_ - - - | 5_ - - - 1 - - - | 1 - - - 3_ - - - | 5_ - - - 5__ - - - |
    /* @Vocal:   ヨ ヒ ノ ミョウ ジョウ ウ ツ ク シ ヤ */
    /* @Vocal:   ギ ン ノ マ サ ゴ ウ ツ ク シ ヤ */
    | 1 - - - 5_ - - - | 1 - - - 4_ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
    /* @Vocal:   ワ タ シ ノ ス キ ナ オ ホ シ サー マ */
    | 5_ - - - 2_ - - - | 5_ - - - 5__ - - - | 1 - - - 3_ - - - | 5_ - - - 5__ - - - |
    /* @Vocal:   イ ツ モ ヤ サ シ ク キ ラ キ ラ キ ラ キ */
    | 1 - - - 3_ - - - | 1 - - - 4_ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
}

