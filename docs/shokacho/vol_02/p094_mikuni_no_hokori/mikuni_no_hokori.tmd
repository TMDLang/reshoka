    | 1^ - - - 7 - - 6 5 - - - 3 - 0 - | 2 - - - 2 - - - 3 - - - 5 - - - | 6 - - - 5 - - - 3 - - - - - 0 - |
    | 2 - - 3 2 - - 3 5 - - - 6 - - - | 1 - - - - - - - - - - - 0 - - - | 6 - - 6 6 - - - 5 - - 6 5 - - - |
    | 1 - - 2 1 - - - 2 - - 3 5 - - 6 | 3 - - - 3 - - 2 1 - - - 0 - - - | 6 - - 6 6 - - 5 3 - - 5 6 - - 5 |

    /* ================= P094.jpg 第 5 行 – P095.jpg 第 1 行 ================= */
    | 3 - - 5 2 - - 1 6_ - - - 5_ - - - | 1 - - - - - - - - - - - 0 - - - |
