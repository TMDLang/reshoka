::SCORE::
** 近眼のしくじり **
!= 108
?= A
<4/4>
~ "曲：不詳 (大正十三年二月十一日 邱氏より抄)"

/* =========================================================================
   近眼のしくじり (Kingan no Shikujiri)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P080.jpg (Notebook 2, p.12)
   Notation: Handwritten numbered notation (Jianpu) on pasted grid sheet
   Annotations: イ調, (大正十三年二月十一日) (邱氏より抄)
   ========================================================================= */

KinganNoShikujiri_A:Melody@|0| {
    <16*>
    /* 原譜は歌詞なしの数字譜（イ調、全32小節） */
    | {mf} 5_ - - - 5_ - - - 1 - - - 1 - - - | 2 - - - - - - - 3 - - - 0 - - - | 5_ - - - 5_ - - - 1 - - - 1 - - - | 2 - - - - - - - - - - - 0 - - - |
    | 1^ - - - 6 - - - 5 - - - 3 - - - | 5 - - - 5 - - - 2 - - - - - - - | 3 - - - 5 - - - 5 - - - 6 - - - | 5 - - - - - - - - - - - 0 - - - |
    | 6 - - - 1^ - - - 6 - - - 6 - - - | 5 - - - 5 - - - 3 - - - - - - - | 5 - - - 6 - - - 5 - - - 3 - - - | 2 - - - - - - - - - - - 0 - - - |
    | 3 - - - 2 - - - 3 - - - 2 - - - | 3 - - - 3 - - - 2 - - - 3 - - - | 5 - - - - - - - 3 - - - 1 - - - | 5 - - - - - - - - - - - 0 - - - |
}

KinganNoShikujiri_B:Melody@|0| {
    <16*>
    | 5 - - - 6 - - - 6 - - - 5 - - - | 1^ - - - 1^ - - - 6 - - - 5 - - - | 2^ - - - 2^ - - - 2^ - - - 3^ - - - | 2^ - - - - - - - - - - - 0 - - - |
    | 3^ - - - 3^ - - - 2^ - - - 2^ - - - | 1^ - - - 1^ - - - 6 - - - 6 - - - | 2^ - - - 2^ - - - 1^ - - - 6 - - - | 2^ - - - - - - - 4'^ - - - - - - - |
    | 3^ - - - 4'^ - - - 1^ - - - 6 - - - | 5 - - - 5 - - - 3 - - - - - - - | 5 - - - 6 - - - 5 - - - 3 - - - | 2 - - - - - - - - - - - 0 - - - |
    | 3 - - - 1 - - - 5 - - - 3 - - - | 6 - - - 6 - - - 5 - - - 3 - - - | 5 - - - 1^ - - - 3^ - - - 2^ - - - | 1^ - - - - - - - - - - - 0 - - - |
}

-> KinganNoShikujiri_A -> KinganNoShikujiri_B -> #
