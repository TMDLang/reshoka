::SCORE::
** 九人のくろんぼ (ピアノ伴奏付) **
!= 100
?= C
<2/4>
~ "曲：不詳"

/* =========================================================================
   九人のくろんぼ (Kunin no Kuronbo) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P084.jpg (Notebook 2, p.16)
   ========================================================================= */

KuninNoKuronbo_Intro:Vocal@|0| {
    <16*>
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - |
}

KuninNoKuronbo_Intro:PianoRH@|0| {
    <16*>
    | {mp} 4_+6_+2 - - - 5_+1+3 - - - | 4_+6_+2 - - - 4_+6_ - - - | 5_+1+3 - - - 5_+7_+2 - - - | 3_+5_+1 - - - 0 - - - |
}

KuninNoKuronbo_Intro:PianoLH@|0| {
    <16*>
    | 2_ - - - 1 - - - | 2_ - - - 6__ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
}

KuninNoKuronbo_A:Vocal@|0| {
    <16*>
    | {mp} 2 - 3 - 2 - 1 - | 2 - 3 - 2 - 6_ 6_ |
    /* @Vocal:   く に ん の く ろ ん ぼ が */
    /* @Vocal:   オ ホ キ ナ ハ ゲ タ カ ー */
    /* @Vocal:   お ほ き な は げ た か ー */
    | 5 - 5 - 5 - 3 - | 2 - 3 - 5 - 6 - | 1^ - - - - - - - | 1^ - - - - - - - |
    | 2^ - 2^ - 1^ - 2^ - | 3^ - 1^ - 6 - 1^ - | 5 - 6 - 5 - 3 - | 2 - 3 - 1 - - - |
}

KuninNoKuronbo_A:PianoRH@|0| {
    <16*>
    | {p} 4_+6_+2 - - - 4_+6_+1 - - - | 4_+6_+2 - - - 4_+6_ - - - |
    | 1+3+5 - - - 5_+1+3 - - - | 5_+7_+2 - - - 1+4+6 - - - | 3+5+1^ - - - 3+5+1^ - - - | 3+5+1^ - - - 0 - - - |
    | 2+5+7 - - - 2+5+7 - - - | 3+6+1^ - - - 1+4+6 - - - | 1+3+5 - - - 5_+1+3 - - - | 5_+7_+2 - - - 3_+5_+1 - - - |
}

KuninNoKuronbo_A:PianoLH@|0| {
    <16*>
    | 2_ - - - 6__ - - - | 2_ - - - 6__ - - - |
    /* @Vocal:   ず ら り と な ー ら ん だ ー */
    /* @Vocal:   オ キ カ ラ ト ン デ キ タ ー */
    /* @Vocal:   く ろ ん ぼ さ ー ら つ た ー */
    | 1 - - - 3_ - - - | 5_ - - - 4_ - - - | 1 - - - 5_ - - - | 1 - - - 0 - - - |
    /* @Vocal:   た ー れ も し ら な い は ま べ の は な し */
    /* @Vocal:   ナ ー ミ ノ シ ヅ カ ナ ア ー サ ノ ハ ナ シ */
    /* @Vocal:   は じ め は よ つ た り そ れ か ら ご に ん */
    | 5_ - - - 5_ - - - | 6_ - - - 4_ - - - | 1 - - - 3_ - - - | 5_ - - - 1_ - - - |
}

KuninNoKuronbo_Outro:Vocal@|0| {
    <16*>
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - |
}

KuninNoKuronbo_Outro:PianoRH@|0| {
    <16*>
    | {mp} 1+3+5 - - - 1+4+6 - - - | 1+3+5 - - - 5_+1+3 - - - | 5_+7_+2 - - - 5_+7_+2 - - - | 3_+5_+1 - - - 0 - - - |
}

KuninNoKuronbo_Outro:PianoLH@|0| {
    <16*>
    | 1 - - - 4_ - - - | 1 - - - 3_ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
}

-> KuninNoKuronbo_Intro -> KuninNoKuronbo_A -> KuninNoKuronbo_Outro -> #
