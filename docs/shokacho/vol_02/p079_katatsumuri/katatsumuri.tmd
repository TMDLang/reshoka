::SCORE::
** カタツムリ **
!= 96
?= C
<2/4>
~ "曲：大正幼年唱歌 第五集"

/* =========================================================================
   カタツムリ (Katatsumuri)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P079.jpg (Notebook 2, p.11)
   Notation: Handwritten numbered notation (Jianpu)
   Annotations: ハ調 (イ短調) 2/4, 大正幼唱 第五集
   ========================================================================= */

Katatsumuri:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* 1. オニハノ スミノ カタツムリ / ネムッテ ヰルカト オモッタラ */
    /* カヒノ ウチカラ ヌケダシテ / ヒトリデ シヅカニ ハヒダシテ */
    /* オウチヲ セオッテ ハヒダシタ / ドコヘ イクノカ カタツムリ */
    /* 2. アタマノ サキニハ シラヌマニ / ニホンノ ナガイ ツノガデル */
    /* ツノノ サキニハ メガアッテ / ミマハシ ナガラ ハッテイク */
    /* ツノハ ノビタリ チヂンダリ / メハ カクレタリ デテキタリ */
    | {mp} 6_ - 6_ - 6_ - 6_ - | 7_ - 7_ - 7_ - - - | 1 - 1 - 7_ - 6_ - | 4_ - - - - - 0 - |
    /* @Vocal: オ ニ ハ ノ ス ミ ノ カ タ ツ ム リ */
    /* @Vocal: ア タ マ ノ サ キ ニ シ ラ ヌ マ ニ */
    | 2 - 2 - 2 - 2 - | 3 - 3 - 4 - 4 - | 3 - 3 - 4 - 2 - | 3 - - - - - 0 - |
    /* @Vocal: ネ ム ッ テ ヰ ル カ ト オ モ ッ タ ラ */
    /* @Vocal: ニ ホ ン ノ ナ ガ イ ー ツ ノ ガ デ ル */
    | 6_ - 6_ - 6_ - - - | 7_ - 7_ - 7_ - 7_ - | 1 - 1 - 7_ - 6_ - | 4_ - - - - - 0 - |
    /* @Vocal: カ ヒ ノ ウ チ カ ラ ヌ ケ ダ シ テ */
    /* @Vocal: ツ ノ ノ サ キ ニ ハ メ ガ ア ッ テ */
    | 2 - 2 - 2 - 2 - | 3 - 3 - 4 - 4 - | 6 - 4 - 3 - 2 - | 3 - - - - - 0 - |
    /* @Vocal: ヒ ト リ デ シ ヅ カ ニ ハ ヒ ダ シ テ */
    /* @Vocal: ミ マ ハ シ ナ ガ ラ ー ハ ッ テ イ ク */
    | 6_ - 6_ - 7_ - 7_ - | 1 - 1 - 7_ - 7_ - | 3 - 1 - 7_ - 6_ - | 7_ - - - - - 0 - |
    /* @Vocal: オ ウ チ ヲ セ オ ッ テ ハ ヒ ダ シ タ */
    /* @Vocal: ツ ノ ハ ー ノ ビ タ リ チ ヂ ン ダ リ */
    | 1 - - - 7_ - 1 - | 6_ - 6_ - 4_ - 4_ - | 6_ - 4_ - 3_ - 2_ - | 3_ - - - - - 0 - |
    /* @Vocal: ド コ ヘ イ ク ノ カ カ タ ツ ム リ */
    /* @Vocal: メ ハ ー カ ク レ タ リ デ テ キ タ */
}

-> Katatsumuri -> #
