** カタツムリ (ピアノ伴奏付) **
!= 96
?= C
<2/4>
~ "曲：大正幼年唱歌 第五集"

/* =========================================================================
   カタツムリ (Katatsumuri) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P079.jpg (Notebook 2, p.11)
   ========================================================================= */

Katatsumuri:Vocal@|0| {
    <16*>
    | {mp} 6_ - 6_ - 6_ - 6_ - | 7_ - 7_ - 7_ - - - | 1 - 1 - 7_ - 6_ - | 4_ - - - - - 0 - |
    /* @Vocal:   オ ニ ハ ノ ス ミ ノ カ タ ツ ム リ */
    /* @Vocal:   ア タ マ ノ サ キ ニ シ ラ ヌ マ ニ */
    | 2 - 2 - 2 - 2 - | 3 - 3 - 4 - 4 - | 3 - 3 - 4 - 2 - | 3 - - - - - 0 - |
    | 6_ - 6_ - 6_ - - - | 7_ - 7_ - 7_ - 7_ - | 1 - 1 - 7_ - 6_ - | 4_ - - - - - 0 - |
    | 2 - 2 - 2 - 2 - | 3 - 3 - 4 - 4 - | 6 - 4 - 3 - 2 - | 3 - - - - - 0 - |
    | 6_ - 6_ - 7_ - 7_ - | 1 - 1 - 7_ - 7_ - | 3 - 1 - 7_ - 6_ - | 7_ - - - - - 0 - |
    | 1 - - - 7_ - 1 - | 6_ - 6_ - 4_ - 4_ - | 6_ - 4_ - 3_ - 2_ - | 3_ - - - - - 0 - |
}

Katatsumuri:PianoRH@|0| {
    <16*>
    | {p} 3_+6_ - - - 3_+6_ - - - | 3_+5'_+7_ - - - 3_+5'_+7_ - - - | 3_+6_+1 - - - 3_+6_ - - - | 2_+4_+6_ - - - 0 - - - |
    | 4_+6_+2 - - - 4_+6_+2 - - - | 6_+1+3 - - - 6_+2+4 - - - | 6_+1+3 - - - 6_+2+4 - - - | 5'_+7_+3 - - - 0 - - - |
    | 3_+6_ - - - 3_+6_ - - - | 3_+5'_+7_ - - - 3_+5'_+7_ - - - | 3_+6_+1 - - - 3_+6_ - - - | 2_+4_+6_ - - - 0 - - - |
    | 4_+6_+2 - - - 4_+6_+2 - - - | 6_+1+3 - - - 6_+2+4 - - - | 6_+2+4 - - - 4_+6_+2 - - - | 5'_+7_+3 - - - 0 - - - |
    | 3_+6_ - - - 3_+5'_+7_ - - - | 3_+6_+1 - - - 3_+5'_+7_ - - - | 6_+1+3 - - - 3_+6_ - - - | 3_+5'_+7_ - - - 0 - - - |
    | 3_+6_+1 - - - 3_+5'_+7_ - - - | 3_+6_ - - - 2_+4_ - - - | 2_+4_+6_ - - - 7__+2_+4_ - - - | 7__+3_+5'_ - - - 0 - - - |
}

Katatsumuri:PianoLH@|0| {
    <16*>
    | 6_ - - - 3_ - - - | 3_ - - - 7__ - - - | 6_ - - - 3_ - - - | 2_ - - - 0 - - - |
    /* @Vocal:   ネ ム ッ テ ヰ ル カ ト オ モ ッ タ ラ */
    /* @Vocal:   ニ ホ ン ノ ナ ガ イ ー ツ ノ ガ デ ル */
    | 2_ - - - 6__ - - - | 6_ - - - 2_ - - - | 6_ - - - 2_ - - - | 3_ - - - 0 - - - |
    /* @Vocal:   カ ヒ ノ ウ チ カ ラ ヌ ケ ダ シ テ */
    /* @Vocal:   ツ ノ ノ サ キ ニ ハ メ ガ ア ッ テ */
    | 6_ - - - 3_ - - - | 3_ - - - 7__ - - - | 6_ - - - 3_ - - - | 2_ - - - 0 - - - |
    /* @Vocal:   ヒ ト リ デ シ ヅ カ ニ ハ ヒ ダ シ テ */
