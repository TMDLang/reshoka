<4/4>
~ "曲：大正幼年唱歌 第五集"

/* =========================================================================
   ゴモン (Gomon)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P078.jpg (Notebook 2, p.10)
   Notation: Handwritten numbered notation (Jianpu)
   Annotations: = 2/2, 大正幼唱 第五集
   ========================================================================= */

Gomon:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* イソーイデ クレバ ミエタ ミエタ / ゴモーンガ ミエタ ウレシヤ ウレシヤ */
    /* ゴモーンノ ナカニ アレ アレ ミエル / センーセイガ ミエル ウレシヤ ウレシヤ */
    | {mf} 5 - - - 3 - 4 - 5 - - - 3 - 4 - | 5 - - - 1^ - - - 5 - - - 0 - - - | 6 - - - 5 - - - 4 - - - 0 - - - | 5 - - - 4 - - - 3 - - - 0 - - - |
    /* @Vocal: イ ソー イ デ ク レ バ ミ エ タ ミ エ タ */
    | 5 - - - 3 - 4 - 5 - - - 3 - 4 - | 5 - - - 1^ - - - 5 - - - 0 - - - | 6 - - - 5 - - - 4 - - - 2 - - - | 1 - - - 1 - 1 - 1 - - - 0 - - - |
    /* @Vocal: ゴ モー ン ガ ミ エ タ ウ レ シ ヤ ウレシ ヤ */
    | 2 - - - 7_ - 1 - 2 - - - 7_ - 1 - | 2 - - - 3 - - - 2 - - - 0 - - - | 3 - - - 1 - 2 - 3 - - - 1 - 2 - | 3 - - - 6 - - - 5 - - - 0 - - - |
    /* @Vocal: ゴ モー ン ノ ナ カ ニ ア レ ア レ ミ エ ル */
    | 5 - - - 3 - 4 - 5 - - - 3 - 4 - | 5 - - - 1^ - - - 5 - - - 0 - - - | 6 - - - 5 - - - 4 - - - 2 - - - | 1 - - - 1 - 1 - 1 - - - 0 - - - |
    /* @Vocal: セ ンー セ イ ミ エ ル ウ レ シ ヤ ウレシ ヤ */
}

-> Gomon -> #
