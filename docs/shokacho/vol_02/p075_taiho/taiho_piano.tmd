::SCORE::
** 大砲 (ピアノ伴奏付) **
!= 108
?= C
<2/4>
~ "曲：大正幼年唱歌 第八集"

/* =========================================================================
   大砲 (Taihō) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P075.jpg (Notebook 2, p.7)
   ========================================================================= */

Taiho:Vocal@|0| {
    <16*>
    | {f} 5 - - 5 5 - 5 - | 5 - 5 - 5 - 5 - | 1^ - 1^ 1^ 1^ - 1^ - | 1^ - - - - - 0 - |
    /* @Vocal:   タ イ ハ ウ ガ ラ ガ ラ ヒ キ ダ ー シ テ */
    /* @Vocal:   ハ ウ ダ イ ガ ラ ガ ラ ク ヅ レ ー ダ ス */
    | 6 - - 6 6 - 6 - | 6 - 6 - 6 - 6 - | 2^ - - 2^ 2^ - 2^ - | 2^ - - - - - 0 - |
    | 5 - - - 5 - - - | 1^ - - - - - 5 - | 6 - - - 6 - - - | 5 - - - - - - - | 6 - - - - - 6 - | 5 - - - 4 - - - | 3 - - - 4 - - - | 5 - - - - - - - |
    | 5 - - - 5 - - - | 1^ - - - 5 - - - | 2^ - - - 2^ - - - | 5 - - - - - - - | 6 - - - 6 - - - | 5 - - - 5 - - - | 1^ - - - - - - - | 1^ - - - 0 - - - |
}

Taiho:PianoRH@|0| {
    <16*>
    | {mf} 1+3+5 - - - 1+3+5 - - - | 1+3+5 - - - 1+3+5 - - - | 3+5+1^ - - - 3+5+1^ - - - | 3+5+1^ - - - 0 - - - |
    | 1+4+6 - - - 1+4+6 - - - | 1+4+6 - - - 1+4+6 - - - | 2+5+7 - - - 2+5+7 - - - | 2+5+7 - - - 0 - - - |
    | 1+3+5 - - - 1+3+5 - - - | 3+5+1^ - - - 1+3+5 - - - | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 1+3+5 - - - | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 7_+2+4 - - - | 5_+1+3 - - - 7_+2+4 - - - | 1+3+5 - - - 1+3+5 - - - |
    | 1+3+5 - - - 1+3+5 - - - | 3+5+1^ - - - 1+3+5 - - - | 2+5+7 - - - 2+5+7 - - - | 7_+2+5 - - - 7_+2+5 - - - | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 7_+2+5 - - - | 3+5+1^ - - - 3+5+1^ - - - | 3+5+1^ - - - 0 - - - |
}

Taiho:PianoLH@|0| {
    <16*>
    | 1 - - - 5_ - - - | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 1 - - - 0 - - - |
    /* @Vocal:   ド ン ド ン ウ チ ダ ス イ サ マ シ サ */
    /* @Vocal:   ド ン ド ン ニ ゲ ダ ス テ キ ノ ヘ イ */
    | 4_ - - - 1 - - - | 4_ - - - 1 - - - | 5_ - - - 2_ - - - | 5_ - - - 0 - - - |
    /* @Vocal:   オ ホ キ ナ ヤ マ モ ー ク ヅ レ ル ヤ ウ ナ ー */
    /* @Vocal:   ニ ゲ ダ ス ヤ ウ ナ ー コ シ ヌ ケ ヘ イ ハ ー */
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 4_ - - - 4_ - - - | 1 - - - 5_ - - - | 4_ - - - 4_ - - - | 1 - - - 5_ - - - | 1 - - - 5_ - - - | 1 - - - 5_ - - - |
    /* @Vocal:   オ ホ キ ナ オ ト ヨ ー イ サ マ シ ヤ ー ー */
    /* @Vocal:   ゼ ン メ ツ サ セ ヨ ー ネ ラ ヒ ウ テ ー ー */
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 5_ - - - 2_ - - - | 5_ - - - 5__ - - - | 4_ - - - 4_ - - - | 5_ - - - 5__ - - - | 1 - - - 5_ - - - | 1_ - - - 0 - - - |
}

-> Taiho -> #
