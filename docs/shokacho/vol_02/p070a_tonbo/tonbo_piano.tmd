::SCORE::
** トンボ (ピアノ伴奏付) **
!= 104
?= B,
<4/4>
~ "曲：大正幼年唱歌 第六集"

/* =========================================================================
   トンボ (Tonbo) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P070.jpg top (Notebook 2, p.2)
   ========================================================================= */

Tonbo:Vocal@|0| {
    <16*>
    | {mf} 5_ - - - 3 - 1^ - 5 - - - - - 0 - | 6 - - - 5 - 3^ - 2^ - - - - - 0 - | 3^ - - - 1^ - 6 - 5 - - - - - 0 - | 1^ - - - 5 - 3 - 2 - - - - - 0 - |
    /* @Vocal:   トン ボ トン ボ 來イ 來イ ー リャウ ハ ネ ヒロ ゲ テ */
    | 5_ - - - 3 - 1^ - 5 - - - - - 0 - | 6 - - - 5 - 3^ - 2^ - - - - - 0 - | 3^ - - - 1^ - 6 - 5 - - - - - 0 - | 6 - - - 7 - 2^ - 1^ - - - - - 0 - |
}

Tonbo:PianoRH@|0| {
    <16*>
    | {mp} 5_+1+3 - - - 5_+1+3 - - - 1+3+5 - - - 0 - - - | 1+4+6 - - - 1+3+5 - - - 2+5+7 - - - 0 - - - | 3+5+1^ - - - 1+4+6 - - - 1+3+5 - - - 0 - - - | 1+3+5 - - - 5_+1+3 - - - 5_+7_+2 - - - 0 - - - |
    | 5_+1+3 - - - 5_+1+3 - - - 1+3+5 - - - 0 - - - | 1+4+6 - - - 1+3+5 - - - 2+5+7 - - - 0 - - - | 3+5+1^ - - - 1+4+6 - - - 1+3+5 - - - 0 - - - | 1+4+6 - - - 2+5+7 - - - 3+5+1^ - - - 0 - - - |
}

Tonbo:PianoLH@|0| {
    <16*>
    | 1 - - - 3_ - - - 5_ - - - 0 - - - | 4_ - - - 1 - - - 5_ - - - 0 - - - | 1 - - - 4_ - - - 1 - - - 0 - - - | 1 - - - 3_ - - - 5_ - - - 0 - - - |
    /* @Vocal:   ス ズ シ イ カー ゼ ニ スイ ス イ トン デ コ イ */
    | 1 - - - 3_ - - - 5_ - - - 0 - - - | 4_ - - - 1 - - - 5_ - - - 0 - - - | 1 - - - 4_ - - - 1 - - - 0 - - - | 4_ - - - 5_ - - - 1 - - - 0 - - - |
}

-> Tonbo -> #
