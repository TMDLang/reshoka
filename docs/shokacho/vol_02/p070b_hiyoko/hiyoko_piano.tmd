::SCORE::
** ヒヨコ (ピアノ伴奏付) **
!= 104
?= B,
<2/4>
~ "曲：大正幼年唱歌 第五集"

/* =========================================================================
   ヒヨコ (Hiyoko) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P070.jpg bottom (Notebook 2, p.2)
   ========================================================================= */

Hiyoko:Vocal@|0| {
    <16*>
    | {mf} 2^ - 2^ - 2^ - - - | 2^ - 2^ - 2^ - - - | 3^ - 2^ - 1^ - 6 - | 5 - 5 - 5 - 0 - |
    /* @Vocal:   ヒ ヨ コ ヒ ヨ コ ピ ヨ ピ ヨ ナ イ テ */
    /* @Vocal:   ヒ ヨ コ ヒ ヨ コ ヒ ヨ コ ガ イ チ ハ */
    | 6 - - - 1^ - 6 - | 5 - - 5 6 - 5 - | 3 - - 3 5 - 3 - | 2 - 2 - 2 - 0 - |
    | 3 - - - - - 2 - | 3 - - - 5 - - - | 6 - - - - - 5 - | 6 - 0 - 1^ - - - |
}

Hiyoko:PianoRH@|0| {
    <16*>
    | {mp} 2+5+7 - - - 2+5+7 - - - | 2+5+7 - - - 2+5+7 - - - | 3+5+1^ - - - 1+4+6 - - - | 1+3+5 - - - 1+3+5 - - - |
    | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+1+3 - - - | 5_+7_+2 - - - 0 - - - |
    | 5_+1+3 - - - 5_+7_+2 - - - | 5_+1+3 - - - 1+3+5 - - - | 1+4+6 - - - 1+3+5 - - - | 1+4+6 - - - 3+5+1^ - - - |
}

Hiyoko:PianoLH@|0| {
    <16*>
    | 5_ - - - 5_ - - - | 5_ - - - 5_ - - - | 1 - - - 4_ - - - | 1 - - - 5_ - - - |
    /* @Vocal:   オ ヤ ノ マ ハ リ デ ヨ ロ コ ビ ナ ガ ラ */
    /* @Vocal:   カ キ ネ ノ ソー ト デ マ ヨ ヒ ゴ ナ ッ テ */
    | 4_ - - - 4_ - - - | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 5_ - - - 0 - - - |
    /* @Vocal:   エ ヲ ヒ ロ フ ピ ヨ ピ ヨ */
    /* @Vocal:   ピ ヨ ピ ヨ ー ピ ヨ ピ ヨ */
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 4_ - - - 1 - - - | 4_ - - - 1 - - - |
}

-> Hiyoko -> #
