** 朝 (早晨) **
!= 120
?= D
<4/4>
~ "公學校唱歌帳 (P213, 285頁, 昭和2年1月29日)"

/*
   歌詞：
   一、
   クサーバノ ツユヲ フミーワケーテ
   キコーリハ ヤマニ ノボーリユーク
   ウーレーシキ アサーヨ タノーシキ アサーヨ
   クーモーラヌ ヒカゲハ タカネヨーリ
   二、
   こうしを ひいて くさかりに
   のこらは のべに いそぎゆく
   （うれしき あさよ たのしき あさよ）
   すずめの うたは をちこちに
   三、
   ワレラモ イザヤ ガクカウニ
   イタリテ ケフノ ケイコセム
   （ウーレーシキ アサーヨ タノーシキ アサーヨ）
   シャウカノ コエハ ハヤアレニ
*/

Main:Vocal@|0| {
    <16*>
    | 1 - - - 1 - 3 - 5 - - - 3 - - - | 6 - - - 5 - - - 3 - - - 0 - - - | 6 - 5 - 6 - 5 - 3 - - - 1 - - - | 2 - - - - - - - - - - - 0 - - - |
    | 1 - - - 1 - 3 - 5 - - - 3 - - - | 6 - - - 5 - - - 3 - - - 0 - - - | 1^ - - - 7 - 6 - 5 - - - 6 - 7 - | 1^ - - - - - - - 5 - - - 0 - - - |
    | 1 - 2 - 3 - 1 - 2 - 3 - 5 - - - | 6 - - - 5 - 3 - 5 - - - 0 - - - | 1^ - - - 7 - 6 - 5 - - - 5 - 6 - | 5 - - - 3 - 1 - 2 - - - 0 - - - |
    | 1 - 2 - 3 - 4 - 5 - - - 5 - - - | 6 - - - 6 - - - 5 - - - 5 - - - | 6 - - - - - 6 - 5 - - - 6 - 7 - | 1^ - - - - - - - - - - - 0 - - - |
}

