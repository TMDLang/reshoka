** 蟹の鋏とぎ（鋼琴伴奏版） **
!= 112
?= D
<3/4>
~ "日治時期公學校《唱歌帳》（典藏號 2020.006.0843・P168）"

/* =========================================================================
   【曲目說明】
   ・出處：《唱歌帳》（國立臺灣歷史博物館典藏號 2020.006.0843）第 P168.jpg 頁。
   ・調性與拍號：ニ調（D 大調），3/4 拍轉 2/4 拍，速度 != 112。
   ・編曲說明（鋼琴伴奏版）：
     1. 前奏 (Intro, 4 小節)：以 3/4 拍輕快華爾滋律動引出螃蟹磨鉗子的海邊情景。
     2. 主歌伴奏 (PartA 16 小節 3/4 拍 + PartB 4 小節 2/4 拍)：忠實呈現原譜末行變拍之俏皮設計。
   ========================================================================= */

Intro:PianoRH@|0| {
    <8*>
    | 1 2 3 - 5 - | 6 6 5 - 1^ - | 5 3 2 - 5 - | 1 - - - 0 - |
}

Intro:PianoLH@|0| {
    <4*>
    | 1_ [1] [1] | 4__ [4_] 1_ | 5__ [5_] [5_] | 1_ [1] 0 |
}

PartA:PianoRH@|0| {
    <8*>
    | 1 2 3 - 5 - | 6 5 1^ - 5 - | 6 5 6 5 3 1 | 2 - - - 0 - |
    | 1 2 3 - 5 - | 6 5 1^ - 5 - | 3 5 3 - 2 3 | 1 - - - 0 - |
    | 1^ 1^ 1^ - 1^ - | 2^ 2^ 1^ - 6 - | 5 5 6 - 5 6 | 1^ - - - 0 - |
    | 1 2 3 - 5 - | 6 6 5 - 1^ - | 5 3 2 - 5 - | 1 - - - 0 - |
}

PartA:PianoLH@|0| {
    <4*>
    | 1_ [1] [1] | 4__ [4_] 1_ | 4__ [4_] 1_ | 5__ [5_] 0 |
    | 1_ [1] [1] | 4__ [4_] 1_ | 5__ [5_] [5_] | 1_ [1] 0 |
    | 1_ [1] [1] | 5__ [5_] 4__ | 5__ [5_] [5_] | 1_ [1] 0 |
    | 1_ [1] [1] | 4__ [4_] 1_ | 5__ [5_] [5_] | 1_ [1] 0 |
}

PartB:PianoRH@|0| {
    <8*>
    {<2/4>}
    | 1 5_ 1 2 | 3 2 3 4 | 6 - - 5 | 2 3 1 - |
}

PartB:PianoLH@|0| {
    <8*>
    {<2/4>}
    | 1_ [1] 1_ [1] | 1_ [1] 1_ [1] | 4__ [4_] 1_ [1] | 5__ [5_] 1_ 0 |
}

ResetMeter:PianoRH@|0| {
    <8*>
    {<3/4>}
    | 0 - - - - - |
}

ResetMeter:PianoLH@|0| {
    <4*>
    {<3/4>}
