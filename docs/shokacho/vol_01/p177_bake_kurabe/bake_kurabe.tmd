    | 5_ - - - 0 - 5 - | 6 - 5 - 3 - 2 - | 1 - 1 - 0 - 1 - | 6_ - 6_ - 1 - 2 - |
    | 3 - - - 0 - 3 3 | 1 - 3 - 7,_ - 3 3 | 1 - 3 - 7,_ - 3 3 | 1 - 3 - 5 - 5 - |
    | 6 - - - 0 - 5 - | 1 - 3 - 7,_ - 3 3 | 1 - 3 - 7,_ - 3 3 | 1 - 3 - 2 - 1 - |
    | 5 - - - - - - - | 2 - 2 2 - 3 5 - | 2 - 2 2 - 3 5 - | 2 - 5 - 3 - 6 - |
    | 5 - 3 - 2 - - - | 5 - 6 - 5 - 3 - | 5 - 5 6 5 5 3 - | 2 - 5 - 3 - 2 - |
    | 1 - 5 - 5 - - - | 2 - 1 2 - 3 5 - | 2 - 2 2 - 3 5 - | 2 - 3 - 2 - 1 - |
    | 2 - 5 - 5 - - - | 5 - 6 - 5 3 2 1 | 5 - 5 6 5 5 3 - | 2 - 5 - 3 - 6 - |
