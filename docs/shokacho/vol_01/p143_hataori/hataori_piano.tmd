** 機織（手毬唄・鋼琴伴奏版） **
!= 84
?= F
<2/4>
~ "詞：野口雨情"
~ "曲：中山晋平"
~ "日治時期公學校《唱歌帳》（典藏號 2020.006.0843・P143）"

/* =========================================================================
   【曲目說明】
   ・出處：《唱歌帳》（國立臺灣歷史博物館典藏號 2020.006.0843）第 P143.jpg 頁印刷曲譜。
   ・作詞／作曲：野口雨情 歌、中山晋平 曲。
   ・調性與拍號：ヘ長調（F 大調，1♭），2/4 拍，速度 != 84。
   ・編曲說明（鋼琴伴奏版）：
     完整數位化原書印刷之雙手鋼琴伴奏譜，忠實重現中山晋平為手毬唄設計之右手跳音和弦與左手定音節奏。
   ========================================================================= */

Song:PianoRH@|0|{
    <16*>
    /* 第 1–4 小節: おいで　おいで　お客においで */
    | 0 - 5_ - 6_ - 1 - | 0 - 6_+1 - 6_+1 - 6_+1 - | 0 - 1+3 - 0 - 1+3 - | 6_+2 - 6_+1 - 6_+2 - - - |

    /* 第 5–8 小節: わたしゃこのごろ　機織りました */
    | 0 - 1 - 2 - 1 - | 0 - 6_+2 - 1+5 - 1+5 - | 0 - 1+3 - 6_+2 - 5_+1 - | 6_+6 - 5_+5 - 6_+6 - - - |

    /* 第 9–12 小節: ひとつ　日の出の　鶴織りました */
    | 0 - 5_ - 6_ - 1 - | 0 - 6_+2 - 6_+1 - 6_+2 - | 0 - 1+3 - 0 - 1+3 - | 6_+2 - 6_+1 - 6_+2 - - - |

    /* 第 13–16 小節: ふたつ　芙蓉の　花織りました */
    | 0 - 1 - 2 - 1 - | 0 - 6_+2 - 1+5 - 1+5 - | 0 - 1+3 - 6_+2 - 6_+2 - | 6_+6 - 5_+5 - 6_+6 - - - |

    /* 第 17–20 小節: みつ　三笠の　月織りました */
    | 0 - 1 - 1 - 6_ - | 1 - 2 - 3 - 3 - | 2 - 2 - 1 - 1 - | 6_+6 - 5_+5 - 6_+6 - - - |
}

Song:PianoLH@|0|{
    <16*>
    /* 第 1–4 小節 */
    | 1_ - - - 0 - - - | 5__ - - - 0 - - - | 6__ - - - 3_ - - - | 2_ - - - 5__ - - - |

    /* 第 5–8 小節 */
    | 1_ - - - 0 - - - | 5__ - - - 0 - - - | 6__ - - - 3_ - - - | 6__ - - - 6__ - - - |

    /* 第 9–12 小節 */
    | 1_ - - - 0 - - - | 5__ - - - 0 - - - | 6__ - - - 3_ - - - | 2_ - - - 5__ - - - |

    /* 第 13–16 小節 */
    | 1_ - - - 0 - - - | 5__ - - - 0 - - - | 6__ - - - 2_ - - - | 6__ - - - 6__ - - - |

    /* 第 17–20 小節 */
    | 1_ - - - 6__ - - - | 1_ - - - 3_ - - - | 2_ - - - 5__ - - - | 6__ - - - 6__ - - - |
