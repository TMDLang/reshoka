    | {mf} 1 - - - 3 - - 2 1 - - - 5_ - - - | 1 - - - 3 - - 2 1 - - - 5_ - - - | 1 - 7_ - 1 - 2 - 3 - 2 - 3 - 4 - | 5 - - - 4 - - 3 2 - - - 0 - - - |

    /* 前段（第 2 次，二房子）：イ ザ ウ タ ヘ | イ ザ ハ ヤ セ | コ ガ ネ ノ タ リ ホ ノ | カ ガ ヤ キ */
    | 1 - - - 3 - - 2 1 - - - 5_ - - - | 1 - - - 3 - - 2 1 - - - 5_ - - - | 1 - 7_ - 1 - 2 - 3 - 2 - 3 - 4 - | 5 - - - 2 - - 3 1 - - - 0 - - - |

