    /* w: ユ フ ベ ノ ヤ ミ ヂ ニ カ ゲ ハ キ エ テ */
    /* w: ゆ ふ べ の ひ か り に か げ は と ほ く */
    | {f} 5 - 1^ - 7 - | 6 6 6 - 5 - | {mf} 4 3 2 2 1 3 | 5 - - - 0 - |
    /* w: ア ス ハ イ ヅ コ ノ ノ ヂ ヲ * ハ シ リ */
    /* w: け ふ の お も ひ を わ れ ら の か ほ に */
    | 1 7_ 1 - 5_ - | 3 2' 3 - 1 - | {p} 5 4' 5 - 2 3 | 1 - - - 0 - |
    /* w: ヨ ソ ノ キ シ ベ ノ ハ ナ ヲ ヤ ド ス */
    /* w: し ら れ ぬ さ と に の せ て は し る */
}

