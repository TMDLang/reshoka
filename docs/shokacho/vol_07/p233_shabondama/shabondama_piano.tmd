    | 1+3 - 1+3 - 5_+2 - 5_+1 - | 5_+2 - 7_+5 - 7_+5 - 0 - | 6_ - 6_ - 5_ - 1 - | 5_+3 - 5_+7_+2 - 3_+5_+1 - 0 - |
