    /* @lyrics= "ア ノ ヤ マ コ ー エ テ カ ハ ー コ エ テ" */
    | 3 - 5 - 6 - 5 - | 0 3 5 6 1^ - 5 - | 0 5 6 1^ 3 - 2 - | 1 - - - - - 0 - |
