ChikameNoShikujiri:Vocal@|0| {
    <8*>
    | 5 1^ 1^ - 2^ - 3^ - | 5 5 1^ 1^ 2^ - - - | 1^ 6 5 3 5 5 2 - | 3 5 5 6 5 - - - |
    /* w: オ ヒ ワ ケ ノ イ シ ノ ウ ヘ カ ラ ス ガ イ チ ハ ト マッ テ ル */
    /* w: あ る ひ と が に は と り を か か え て ま ち に う り に ゆ く */
    | 6 1^ 6 6 5 5 3 - | 5 6 5 3 2 - - - | 3 2 3 2 3 3 2 3 | 5 5 3 1 5 - - - |
    /* w: チ カ メ ガ ヒ ト ト ミ チ ガ ヘ テ モ シ モ シ ム ラ ノ ド ウ マ キ ハ */
    /* w: ち か め が そ れ を う ち な が め さ て さ て き れ い な お め し も の */
    | 5 6 6 5 1^ 1^ 1^ 5 | 2^ 2^ 2^ 3^ 2^ - - - | 3^ 3^ 2^ 2^ 1^ 1^ 6 - | 2^ 2^ 1^ 6 2' - 2'^ - |
    /* w: オ タ ヅ ネ シ マ ス ト イ イ タ レ バ カ ラ ス ハ ツ イ ト ト ン デ イ ク * */
    /* w: み せ て と しっ ぽ を ひ い た れ ば に は と り ふ ん を ペーッ と し た * */
    | 3^ 3^ 1^ 6 5 5 3 - | 5 6 5 3 2 - - - | 3 1 5 3 6 6 5 3 | 5 1^ 3^ 2^ 1^ - - - |
    /* w: チ カ メ ハ キュウ ニ テ ヲ ア ゲ テ モ シ モ シ ボ ウ シ ガ ト ビ マ シ タ */
    /* w: ち か め は か ほ を ふ き な が ら つ ば き を か け ず と よ さ さう に */
}

