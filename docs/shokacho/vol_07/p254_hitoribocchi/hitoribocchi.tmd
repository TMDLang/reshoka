::SCORE::
** ひとりぼっち (孤零零) **
!= 76
?= G
<2/4>
~ "公學校唱歌帳 補遺 — 蓬 69頁ヨリ"
~ "詞：富原義徳"

Hitoribocchi:Vocal@|0| {
    <8*>
    | (3 3 3)%(--) 3 - | (2 3 4)%(--) 3 - | (1 3_ -)%(--) (1 1 6_)%(--) | 7_ - 0 - |
    /* w: マ イ ゴ ノ マ イ ゴ ノ ホ タ ル * サ ン */
    /* w: マ イ ゴ ノ マ イ ゴ ノ ホ タ ル * サ ン */
    | (3 - 3_)%(--) 3 - | (2 3 4)%(--) 3 - | (1 - 3)%(--) (1 - 7_)%(--) | 6_ - (0 0 3_)%(--) |
    /* w: ク ラ イ ア マ ヨ ヲ ショ ン ボ リ ト ク */
    /* w: あ を い あ か り を ほ ん の り と く */
    | (6_ - 3_)%(--) (6_ 7_ 1)%(--) | 1 - 0 - | (1 - 3)%(--) (1 7_ 6_)%(--) | 7_ - (0 0 3)%(--) |
    /* w: サ ノ オ ウ チ ニ ユ キ マ * シ タ ヒ */
    /* w: さ の お や ど に つ け ま * し た ヒ */
    | (6 - 4)%(--) (4 3 2)%(--) | 3 - 0 - | (1 - 3)%(--) (1 - 7_)%(--) | 6_ - 0 - |
    /* w: ト リ ポッ チ デ サ ビ シ サ ニ */
    /* w: ト リ ポッ チ デ サ ビ シ サ ニ */
}

-> Hitoribocchi -> #
