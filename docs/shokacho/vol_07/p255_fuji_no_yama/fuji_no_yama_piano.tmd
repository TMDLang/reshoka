    | 3+5 - - 3+5 3+5 - 3+5 - | 4+6 - 4+6 - 3+5 - 0 - | 3+1^ - - 3+1^ 3+1^ 5+2^ 5+3^ 3+5 | 7_+2 - - - - - 0 - |
