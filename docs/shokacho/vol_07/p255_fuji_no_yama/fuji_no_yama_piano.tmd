** 富士の山 (富士山) (Piano Accompaniment) **
!= 108
?= F
<4/4>
~ "公學校唱歌帳 補遺 — 蓬 70頁ヨリ"
~ "曲：原田比古士良"

FujiNoYama:Vocal@|0| {
    <8*>
    | 5 - - 5 5 - 5 - | 6 - 6 - 5 - 0 - | 1^ - - 1^ 1^ 2^ 3^ 5 | 2 - - - - - 0 - |
    /* w: ア タ マ ヲ ク モ ノ ウ ヘ ニ * ダ シ */
    /* w: あ を そ ら た か く そ び え * た ち */
    | 6 - - 6 6 1^ 1^ 6 | 5 - 5 - 1 - 0 - | 5 5 5 - 5 - 3 2 | 1 - - - - - 0 - |
    /* w: シ ハ ウ * ノ * ヤ マ ヲ ミ オ ロ シ テ */
    /* w: か ら だ * に * ゆ き の き も の き て */
    | 2 3 2 1 6_ 6_ 6_ - | 1 1 1 6_ 5_ - 0 - | 6_ 1 1 6_ 5_ 5_ 1 - | 2 3 3 2 1 - 0 - |
    /* w: カ ミ ナ リ サ マ ヲ シ タ ニ キ ク カ ミ ナ リ サ マ ヲ シ タ ニ キ ク */
    /* w: か す み の す そ を と ほ く ひ く か す み の す そ を と ほ く ひ く */
    | 5 - - - 3 - 1 - | 5 - - - 6 - 5 - | 3 - 5 5 3 3 2 2 | 1 - - - - - 0 - |
    /* w: フ ジ ハ フ ジ ハ ニ ホ ン イ チ ノ ヤマ */
    /* w: ふ じ は ふ じ は ニ ホ ン イ チ の やま */
}

