::SCORE::
** 夕立小立 (陣雨) (Piano Accompaniment) **
!= 112
?= E
<2/4>
~ "公學校唱歌帳 補遺 — 蓬 65頁ヨリ"
~ "詞：富原義徳"

YudachiKodachi:Vocal@|0| {
    <16*>
    | 0 - - - 0 - 1 1 |
    /* w: ユ フ */
    /* w: ユ フ */
    /* w: ユ フ */
    | 1 - - 5_ 1 - 2 - | 3 - - - 5 - 5 - | 1^ - - 6 6 - - - | 6 - - - 0 - 5 5 |
    /* w: ダ チ コ ダ チ ア バ レ ン ボ * シ ー */
    /* w: ダ チ コ ダ チ ア バ レ ン ボ * せ い */
    /* w: ダ チ コ ダ チ ア バ レ ン ボ * ハッ * */
    | 1^ - - 7 6 - - 5 | 3 - - - 2 - 3 - | 5 - 3 2 1 - - - | 1 - - - 0 - 5 5 |
    /* w: リッ パ ショ リ デ ピ チャ ピ チャ ト * オ イ */
    /* w: た か のっ ぽ の は な ゆ り を * ゆ ら */
    /* w: パ ノ カ ヘ ル ヲ コ ロ コ ロ ト * コ ロ */
    | 1 - 3 - 5 - 1^ - | 6 - - - 5 - - - | 0 - 2 3 5_ - - 5_ | 1 - - - 0 - - - |
    /* w: ケ ノ キ ン ギョ ヲ タ タ イ テ ル */
    /* w: ゆ ら ゆ す ぶ り おっ ちゃっ た */
    /* w: ガ シ オ ト シ テ イッ チャッ タ */
}

YudachiKodachi:PianoRH@|0| {
    <16*>
    | 0 - - - 0 - 1+3 - |
    | 5_+1 - - 5_ 5_+1 - 5_+2 - | 1+3 - - - 3+5 - 3+5 - | 3+1^ - - 4+6 4+6 - - - | 4+6 - - - 0 - 3+5 - |
    | 3+1^ - - 5+7 4+6 - - 3+5 | 1+3 - - - 7_+2 - 1+3 - | 2+5 - 1+3 7_+2 5_+1 - - - | 5_+1 - - - 0 - 3+5 - |
    | 5_+1 - 1+3 - 3+5 - 3+1^ - | 4+6 - - - 3+5 - - - | 0 - 7_+2 1+3 2_+5_ - - 2_+5_ | 5_+1 - - - 0 - - - |
}

YudachiKodachi:PianoLH@|0| {
    <8*>
    | 0 - 0 1_ |
    | 1_ 5_ 1_ 5_ | 1_ 5_ 1_ 5_ | 4_ 1 4_ 1 | 4_ 1 5_ - |
    | 1_ 5_ 4_ 1 | 1_ 5_ 5_ - | 5_ 5__ 1_ 5_ | 1_ 5_ 1_ 0 |
    | 1_ 5_ 1_ 5_ | 4_ 1 1_ 5_ | 5_ 5_ 5__ 5__ | 1_ - 0 - |
}

