/* =========================================================================
   舞踏（舞蹈） — Piano Accompaniment
   Source: 唱歌帖 (2020.006.0843), P230.jpg (bottom pasted slip)
   Marginal notes: 変ロ 3/4 軽快
   ========================================================================= */

Buto:Vocal@|0| {
    <8*>
    | {mf} 1 - 5 6 3 - | 5 - 5 4 2 - | 1 - 2 3 1 - | 5 - - - 0 - |
    /* @lyrics= "ヒ ラ ヒ ラ ヒ ラ ー リ マ ヒ ノ ソ デ" */
    | 1 - 5 6 3 - | 5 - 5 4 2 - | 5 - 6 - 7 - | 1^ - - - 0 - |
    /* @lyrics= "ク ル ク ル ク ル ー リ カ ヘ ス デ" */
    | {f} 3^ 2^ 1^ - 0 - | {mf} 1^ 7 6 - 0 - | 5 - 6 5 4 - | 3 2 3 - 0 - |
    /* @lyrics= "テ フ カ ハ ナ カ タ チ マ フ オ ト メ" */
    | {p} 3^ 2^ 1^ - 0 - | 1^ 7 6 - 0 - | {f} 5 - 6 4 7 5 | 1^ - - - 0 - |
    /* @lyrics= "ハ ナ カ テ フ カ オ モ ー シ ー ロ" */
}

Buto:PianoRH@|0| {
    <8*>
    | {mf} 1 - 5 6 1+3 - | 7_+5 - 5 4 7_+2 - | 1 - 2 3 1 - | 7_+2+5 - 7_+2+5 - 0 - |
    | 1 - 5 6 1+3 - | 7_+5 - 5 4 7_+2 - | 1+5 - 2+6 - 2+7 - | 3+5+1^ - - - 0 - |
    | {f} 3^ 2^ 3+1^ - 0 - | {mf} 1^ 7 1+6 - 0 - | 7_+5 - 6 5 7_+4 - | 3 2 1+3 - 0 - |
    | {p} 3^ 2^ 3+1^ - 0 - | 1^ 7 1+6 - 0 - | {f} 1+5 - 6 4 7 5 | 3+5+1^ - - - 0 - |
}

Buto:PianoLH@|0| {
    <4*>
    | 1_ 5_ 5_ | 5__ 5_ 5_ | 1_ 5_ 3_ | 5__ 2_ 5__ |
    | 1_ 5_ 5_ | 5__ 5_ 5_ | 3_ 4_ 5_ | 1_ 5__ 1_ |
    | 1_ 5_ 1_ | 4_ 1_ 4_ | 5__ 5_ 5_ | 1_ 5__ 1_ |
    | 1_ 5_ 1_ | 4_ 1_ 4_ | 5__ 4_ 5_ | 1_ - 0 |
}

