~ "曲：不詳"

/* =========================================================================
   陸軍記念日行進歌 (Rikugun Kinembi Kōshinka) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P053.jpg – P054.jpg (Insert)
   ========================================================================= */

RikugunKinembiKoshinka:Vocal@|0| {
    <16*>
    | {f} 5 - - 6 5 - - 3 | 5 - - 6 5 - - 1^ | 3^ - - 2^ 1^ - - 6 | 5 - - - 0 - - - |
    /* @Vocal:   め い ぢ さ ん じ ふ は ち ね ん の */
    /* @Vocal:   ち ゆう ゆ う む ひ の ま す ら を が */
    | 6 - - 1^ 6 - - 5 | 1^ - - 2^ 1^ - - 1^ | 2^ - - 1^ 6 - - 1^ | 2^ - - - 0 - - - |
    | 3^ - - 2^ 1^ - - 6 | 5 - - 6 5 - - 3 | 2 - - 3 2 - - 1 | 2 - - - 0 - - - |
    | 5 - - 6 5 - - 3 | 1 - - 2 3 - - 5 | 6 - - 6 5 - - 1^ | 5 - - - 0 - - - |
    | 2^ - - 3^ 2^ - - 1^ | 6 - - 5 6 - - 1^ | 3^ - - 2^ 1^ - - 6 | 5 - - - 0 - - - |
    | 1 - - 2 3 - - 5 | 6 - - 6 5 - - 1^ | 2^ - - 3^ 2^ - - 7 | 1^ - - - 0 - - - |
}

RikugunKinembiKoshinka:PianoRH@|0| {
    <16*>
    | {mf} 1+3+5 - - - 1+3+5 - - - | 1+3+5 - - - 3+5+1^ - - - | 3+5+1^ - - - 1+4+6 - - - | 1+3+5 - - - 0 - - - |
    | 1+4+6 - - - 1+3+5 - - - | 3+5+1^ - - - 3+5+1^ - - - | 2+6+2^ - - - 1+4'+6 - - - | 2+5+7 - - - 0 - - - |
    | 3+5+1^ - - - 1+4+6 - - - | 1+3+5 - - - 5_+1+3 - - - | 5_+7_+2 - - - 5_+1+3 - - - | 5_+7_+2 - - - 0 - - - |
    | 1+3+5 - - - 5_+1+3 - - - | 5_+1+3 - - - 1+3+5 - - - | 1+4+6 - - - 3+5+1^ - - - | 1+3+5 - - - 0 - - - |
    | 2+5+7 - - - 3+5+1^ - - - | 1+4+6 - - - 1+4+6 - - - | 3+5+1^ - - - 1+4+6 - - - | 1+3+5 - - - 0 - - - |
    | 5_+1+3 - - - 1+3+5 - - - | 1+4+6 - - - 3+5+1^ - - - | 2+5+7 - - - 2+5+7 - - - | 3+5+1^ - - - 0 - - - |
}

RikugunKinembiKoshinka:PianoLH@|0| {
    <16*>
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 1 - - - 4_ - - - | 1 - - - 0 - - - |
    /* @Vocal:   は る な ほ さ む き き の ふ け ふ */
    /* @Vocal:   た み の ぎ ふ ん を せ に お ひ つ */
    | 4_ - - - 1 - - - | 1 - - - 6_ - - - | 2_ - - - 2_ - - - | 5_ - - - 0 - - - |
    /* @Vocal:   さ つ き と う あ の そ ら を お ほひ */
    /* @Vocal:   き み の み い つ を か ざ し と し */
    | 1 - - - 4_ - - - | 1 - - - 3_ - - - | 5_ - - - 1 - - - | 5_ - - - 0 - - - |
    /* @Vocal:   ひ き ゆう ひ やく ま ん ま ん し ゆう の */
    /* @Vocal:   ぜ ん だ い み も ん の か ち を え て */
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 4_ - - - 1 - - - | 5_ - - - 0 - - - |
    /* @Vocal:   の に た い ぢ せ し そ の か み を */
    /* @Vocal:   き よく き へ ん ぽ ん ほ う て ん の */
    | 5_ - - - 1 - - - | 4_ - - - 4_ - - - | 1 - - - 4_ - - - | 5_ - - - 0 - - - |
    /* @Vocal:   お も へ ば ち わ き に く お ど る */
    /* @Vocal:   し ろ に た ち し は け ふ な る ぞ */
    | 1 - - - 3_ - - - | 4_ - - - 1 - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
}

