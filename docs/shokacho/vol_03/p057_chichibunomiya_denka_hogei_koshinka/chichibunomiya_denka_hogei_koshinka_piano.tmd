::SCORE::
** 秩父宮殿下奉迎行進歌 (ピアノ伴奏付) **
!= 112
?= F
<2/4>
~ "曲：不詳 (大正十四年五月)"
~ "詞：松井實"

/* =========================================================================
   秩父宮殿下奉迎行進歌 (Chichibunomiya Denka Hōgei Kōshinka) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P057.jpg – P058.jpg (Notebook 1, p.15)
   ========================================================================= */

ChichibunomiyaDenkaHogeiKoshinka_A:Vocal@|0| {
    <16*>
    | {mf} 1 - - 2 3 - 1 - | 5 - - - 3 - - - | 2 - 1 - 2 - 3 - | 1 - - - 0 - - - |
    /* @Vocal:   ほ う て い ば ん り つ つ が な く */
    /* @Vocal:   や ま は み ど り に か ぜ か を り */
    /* @Vocal:   お ん え い し ー の を を し さ よ */
    /* @Vocal:   み く に の は た て ひ の も と の */
    | 6 - 6 - 5 - 3 - | 5 - - - 1^ - - - | 6 - 5 - 3 - 5 - | 2 - - - 0 - - - |
    | 2 - - 3 2 - 1 - | 6_ - 1 - 2 - 3 - | 5 - 6 - 5 - 3 - | 1^ - - - 0 - - - |
}

ChichibunomiyaDenkaHogeiKoshinka_A:PianoRH@|0| {
    <16*>
    | {mp} 5_+1+3 - - - 5_+1+3 - - - | 1+3+5 - - - 5_+1+3 - - - | 5_+7_+2 - - - 5_+7_+2 - - - | 5_+1+3 - - - 0 - - - |
    | 1+4+6 - - - 1+3+5 - - - | 1+3+5 - - - 3+5+1^ - - - | 1+4+6 - - - 1+3+5 - - - | 5_+7_+2 - - - 0 - - - |
    | 5_+7_+2 - - - 5_+1 - - - | 4_+6_+1 - - - 5_+7_+2 - - - | 1+3+5 - - - 1+3+5 - - - | 3+5+1^ - - - 0 - - - |
}

ChichibunomiyaDenkaHogeiKoshinka_A:PianoLH@|0| {
    <16*>
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
    /* @Vocal:   た い へ い や う を の り こ え て */
    /* @Vocal:   う み は な ぎ た る さ つ き ば れ */
    /* @Vocal:   お ん こ と ば ー の や さ し さ よ */
    /* @Vocal:   し づ め と た て る に ひ た か の */
    | 4_ - - - 1 - - - | 1 - - - 3_ - - - | 4_ - - - 1 - - - | 5_ - - - 0 - - - |
    /* @Vocal:   え い べ い け ん がく に む か は る る */
    /* @Vocal:   き ー る ん の み な と に お め し か ん */
    /* @Vocal:   た か さ ご じ ー ま に み ひ か り の */
    /* @Vocal:   た ー か き す が た を み そ な は れ */
    | 5_ - - - 1 - - - | 4_ - - - 5_ - - - | 1 - - - 5_ - - - | 1 - - - 0 - - - |
}

ChichibunomiyaDenkaHogeiKoshinka_B1:Vocal@|0| {
    <16*>
    | 6 - - 1^ 5 - 3 - | 2 - - - 5 - - - | 3 - 2 - 3 - 2 - | 1 - - - 0 - - - |
    /* @Vocal:   ち ち ぶ の み や を む か へ ま せ */
    /* @Vocal:   あ ふ ぐ わ れ ら の う れ し さ よ */
    /* @Vocal:   か が や き わ た る か し こ さ よ */
}

ChichibunomiyaDenkaHogeiKoshinka_B1:PianoRH@|0| {
    <16*>
    | 1+4+6 - - - 1+3+5 - - - | 5_+7_+2 - - - 7_+2+5 - - - | 5_+1+3 - - - 5_+7_+2 - - - | 5_+1+3 - - - 0 - - - |
}

ChichibunomiyaDenkaHogeiKoshinka_B1:PianoLH@|0| {
    <16*>
    | 4_ - - - 1 - - - | 5_ - - - 5_ - - - | 1 - - - 5__ - - - | 1_ - - - 0 - - - |
}

ChichibunomiyaDenkaHogeiKoshinka_B2:Vocal@|0| {
    <16*>
    | {f} 1 - - - 0 - 5_ - | 1 - - - 0 - 3 - | 5 - - - 5 - - - | 1^ - - - - - - - |
    /* @Vocal:   れ ば ん ざい ば ん ざ い ざ い */
}

ChichibunomiyaDenkaHogeiKoshinka_B2:PianoRH@|0| {
    <16*>
    | {f} 5_+1+3 - - - 3_+5_ - - - | 5_+1+3 - - - 5_+1+3 - - - | 1+3+5 - - - 1+3+5 - - - | 3+5+1^ - - - - - - - |
}

ChichibunomiyaDenkaHogeiKoshinka_B2:PianoLH@|0| {
    <16*>
    | 1 - - - 5_ - - - | 1 - - - 3_ - - - | 5_ - - - 5__ - - - | 1_ - - - - - - - |
}

-> ChichibunomiyaDenkaHogeiKoshinka_A -> ChichibunomiyaDenkaHogeiKoshinka_B1 -> ChichibunomiyaDenkaHogeiKoshinka_B2 -> #
