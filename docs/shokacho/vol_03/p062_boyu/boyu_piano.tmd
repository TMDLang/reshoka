::SCORE::
** 亡友 (ピアノ伴奏付) **
!= 76
?= E,
<2/4>
~ "曲：不詳"

/* =========================================================================
   亡友 (Bōyū) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P062.jpg (Notebook 1, p.16)
   ========================================================================= */

Boyu_A:Vocal@|0| {
    <16*>
    | {mp} 1 - - - 2 - 3 - | 5 - - - 6 - - - | 5 - - - 1^ - - - | 6 - 5 - 6 - 5 - |
    /* @Vocal:   イ ト モ ユ カ シ キ ワ ガ ト モ ー */
    /* @Vocal:   つ ね は ま な び の に は な ー き */
    | 6 - - - 6 - 6 - | 5 - - - 1^ - - - | 5 - 3 - 2 - 3 - | 1 - - - - - 0 - |
}

Boyu_A:PianoRH@|0| {
    <16*>
    | {p} 5_+1+3 - - - 5_+7_+2 - - - | 1+3+5 - - - 1+4+6 - - - | 1+3+5 - - - 3+5+1^ - - - | 1+4+6 - - - 1+3+5 - - - |
    | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 3+5+1^ - - - | 1+3+5 - - - 5_+7_+2 - - - | 5_+1+3 - - - 0 - - - |
}

Boyu_A:PianoLH@|0| {
    <16*>
    | 1 - - - 5_ - - - | 1 - - - 4_ - - - | 1 - - - 3_ - - - | 4_ - - - 1 - - - |
    /* @Vocal:   オ モ カ ゲ ノ ミ ノ コ シ テ */
    /* @Vocal:   あ と さ き び き し は な のタマ */
    | 4_ - - - 4_ - - - | 1 - - - 6_ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
}

Boyu_B:Vocal@|0| {
    <16*>
    | 0 - 6 - 6 - 6 - | 5 - - - 3 - - - | 5 - - - 6 - - - | 5 - 3 - 2 - 0 - |
    /* @Vocal:   シ ラ ズ ヤ イ ヅ コ ニ ワ ガ ツ */
    /* @Vocal:   あ す よ り た れ と ま た ふ み */
    | 1 - - - - - 2 - | 3 - 5 - 6 - 5 - | 3 - - - 2 - 0 - | 5 - - - 6 - 5 - |
    | 3 - - - 5 - - - | 2 - 1 - 2 - - - | 1 - - - - - - - |
}

Boyu_B:PianoRH@|0| {
    <16*>
    | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 5_+1+3 - - - | 1+3+5 - - - 1+4+6 - - - | 1+3+5 - - - 5_+7_+2 - - - |
    | 5_+1+3 - - - 5_+7_+2 - - - | 5_+1+3 - - - 1+4+6 - - - | 5_+1+3 - - - 5_+7_+2 - - - | 1+3+5 - - - 1+4+6 - - - |
    | 5_+1+3 - - - 1+3+5 - - - | 6_+1+2 - - - 5_+7_+2 - - - | 5_+1+3 - - - - - - - |
}

Boyu_B:PianoLH@|0| {
    <16*>
    | 4_ - - - 4_ - - - | 1 - - - 3_ - - - | 1 - - - 4_ - - - | 5_ - - - 5__ - - - |
    /* @Vocal:   キ ミ ル タ ビ ニ カ ナ シ ム ー */
    /* @Vocal:   よ む ま ど の ー は な を も ー */
    | 1 - - - 5_ - - - | 1 - - - 4_ - - - | 5_ - - - 5__ - - - | 1 - - - 4_ - - - |
    /* @Vocal:   オ モ ー ヒ ー ー */
    /* @Vocal:   め で ー ん ー ー */
    | 1 - - - 3_ - - - | 4_ - - - 5_ - - - | 1_ - - - - - - - |
}

-> Boyu_A -> Boyu_B -> #
