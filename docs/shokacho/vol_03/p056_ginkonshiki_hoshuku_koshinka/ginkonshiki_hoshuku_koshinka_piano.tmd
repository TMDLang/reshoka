::SCORE::
** 銀婚式奉祝行進歌 (ピアノ伴奏付) **
!= 112
?= G
<2/4>
~ "曲：一條氏"
~ "詞：古山氏"

/* =========================================================================
   銀婚式奉祝行進歌 (Ginkonshiki Hōshuku Kōshinka) — Piano Accompaniment
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P055.jpg – P056.jpg (Insert)
   ========================================================================= */

GinkonshikiHoshukuKoshinka_A:Vocal@|0| {
    <16*>
    | {mf} 5_ - - - 1 - - - | 3 - - 2 1 - - - | 2 - - - 3 - - - | 5 - - - - - 0 - |
    /* @Vocal:   イ ハ ヘ モ ロ ビ ト */
    /* @Vocal:   か へ る す み れ ー */
    /* @Vocal:   ハ ル ニ ミ チ テ ー */
    | 6 - - - 5 - - - | 3 - - 2 1 - - - | 2 - - - 2 - - - | 5_ - - - - - 0 - |
    | 1 - - - 7_ - 6_ - | 5_ - - - 1 - 2 - | 3 - - - 2 - - - | 1 - - - - - 0 - |
}

GinkonshikiHoshukuKoshinka_A:PianoRH@|0| {
    <16*>
    | {mp} 3_+5_ - - - 5_+1 - - - | 5_+1+3 - - - 5_+1 - - - | 5_+7_+2 - - - 5_+1+3 - - - | 7_+2+5 - - - 0 - - - |
    | 1+4+6 - - - 1+3+5 - - - | 5_+1+3 - - - 5_+1 - - - | 4'_+6_+2 - - - 4'_+6_+2 - - - | 2_+5_+7_ - - - 0 - - - |
    | 5_+1 - - - 4_+6_ - - - | 3_+5_ - - - 5_+1 - - - | 5_+1+3 - - - 5_+7_+2 - - - | 3_+5_+1 - - - 0 - - - |
}

GinkonshikiHoshukuKoshinka_A:PianoLH@|0| {
    <16*>
    | 1 - - - 3_ - - - | 5_ - - - 1 - - - | 5_ - - - 1 - - - | 5_ - - - 0 - - - |
    /* @Vocal:   ケ フ ノ ヨ キ ヒ */
    /* @Vocal:   ほ ほ ゑ み て */
    /* @Vocal:   ハ ナ サ カ ヒ */
    | 4_ - - - 1 - - - | 5_ - - - 1 - - - | 2_ - - - 2_ - - - | 5_ - - - 0 - - - |
    /* @Vocal:   ニ ジ フ ゴ ネ ン ノ */
    /* @Vocal:   る り の は ね フ */
    /* @Vocal:   ト リ サ ヘ ウ タ フ */
    | 1 - - - 4_ - - - | 1 - - - 3_ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
}

GinkonshikiHoshukuKoshinka_B1:Vocal@|0| {
    <16*>
    | 2 - - - 2 - 3 - | 4 - - - 2 - - - | 3 - - - 5 - 3 - | 2 - - - - - 0 - |
    /* @Vocal:   ソ ノ ム カ シ カ シ コ ド コ ロ ノ */
    /* @Vocal:   り の と り は よ は な り ぬ れ ど */
    | 5_ - - - 1 - - - | 3 - - - 2 - 1 - | 6_ - - - 1 - - - | 5_ - - - - - 0 - |
    | 1 - - - 2 - 3 - | 5 - - - 6 - 5 - | 3 - - - 2 - - - | 1 - - - - - 0 - |
}

GinkonshikiHoshukuKoshinka_B1:PianoRH@|0| {
    <16*>
    | 5_+7_+2 - - - 5_+7_+2 - - - | 5_+7_+4 - - - 5_+7_+2 - - - | 5_+1+3 - - - 5_+1+3 - - - | 5_+7_+2 - - - 0 - - - |
    | 3_+5_ - - - 5_+1 - - - | 5_+1+3 - - - 5_+1 - - - | 4_+6_ - - - 4_+6_+1 - - - | 3_+5_ - - - 0 - - - |
    | 5_+1 - - - 5_+1+3 - - - | 1+3+5 - - - 1+4+6 - - - | 5_+1+3 - - - 5_+7_+2 - - - | 3_+5_+1 - - - 0 - - - |
}

GinkonshikiHoshukuKoshinka_B1:PianoLH@|0| {
    <16*>
    | 5_ - - - 5_ - - - | 5_ - - - 5_ - - - | 1 - - - 1 - - - | 5_ - - - 0 - - - |
    /* @Vocal:   オ ホ マ ヘ ニ ス メ ラ ミ コ ト ノ */
    /* @Vocal:   あ ふ ぎ み よ み い つ は い よ よ */
    | 1 - - - 3_ - - - | 5_ - - - 1 - - - | 4_ - - - 4_ - - - | 1 - - - 0 - - - |
    /* @Vocal:   チ ギ リ タ マ ヒ シ ヨ キ ヒ ナ レ */
    /* @Vocal:   あ め つ ち の む た き は み な し */
    | 1 - - - 3_ - - - | 1 - - - 4_ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
}

GinkonshikiHoshukuKoshinka_B2:Vocal@|0| {
    <16*>
    | {f} 2 - - - 2 - - - | 5 - - - 3 - - - | 2 - - 3 2 - - 1 | 7_ - - - - - 0 - |
    /* @Vocal:   タ ケ ノ ソ ノ イ ザ ホ ギ マ ツ レ */
    | 1 - - - 1 - - - | 2 - - - 2 - - - | 3 - 1 - 3 - 5 - | 5 - - - - - 0 - |
    | 6 - - - 6 - - - | 5 - - - 3 - - - | 2 - 2 - 3 - 2 - | 1 - - - - - 0 - |
}

GinkonshikiHoshukuKoshinka_B2:PianoRH@|0| {
    <16*>
    | {f} 5_+7_+2 - - - 5_+7_+2 - - - | 1+3+5 - - - 5_+1+3 - - - | 4'_+6_+2 - - - 4'_+6_+2 - - - | 2_+5_+7_ - - - 0 - - - |
    | 5_+1 - - - 5_+1 - - - | 5_+7_+2 - - - 5_+7_+2 - - - | 5_+1+3 - - - 1+3+5 - - - | 7_+2+5 - - - 0 - - - |
    | 1+4+6 - - - 1+4+6 - - - | 1+3+5 - - - 5_+1+3 - - - | 5_+7_+2 - - - 5_+7_+2 - - - | 3_+5_+1 - - - 0 - - - |
}

GinkonshikiHoshukuKoshinka_B2:PianoLH@|0| {
    <16*>
    | 5_ - - - 5_ - - - | 1 - - - 1 - - - | 2_ - - - 2_ - - - | 5_ - - - 0 - - - |
    /* @Vocal:   コ コ ノ ヘ ノ ク モ ヰ ニ タ カ ク */
    | 1 - - - 3_ - - - | 5_ - - - 5_ - - - | 1 - - - 1 - - - | 5_ - - - 0 - - - |
    /* @Vocal:   テ ン ワ ウ ヘ イ カ バ ン バ ン ザ イ */
    | 4_ - - - 4_ - - - | 1 - - - 3_ - - - | 5_ - - - 5__ - - - | 1_ - - - 0 - - - |
}

