::SCORE::
** 銀婚式奉祝行進歌 **
!= 112
?= G
<2/4>
~ "曲：一條氏"
~ "詞：古山氏"

/* =========================================================================
   銀婚式奉祝行進歌 (Ginkonshiki Hōshuku Kōshinka)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P055.jpg – P056.jpg (Insert)
   Notation: Handwritten 5-line staff (1 sharp = G major, 2/4 time)
   Annotations: (大正十四年五月), 古山氏作歌 / 一條氏作曲
   Note: Staves 1–3 ([A], 12 bars) are followed by Staves 4–6 ([B1], 12 bars)
   for Verses 1 & 2, and Staves 7–9 ([B2], 12 bars) for Verse 3.
   ========================================================================= */

GinkonshikiHoshukuKoshinka_A:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* 一、イハヘ モロビト ケフノ ヨキヒ / ニジフ ゴネンノ ソノム カシ / カシコ ドコロノ オホマ ヘニ */
    /* 二、かへる すみれ ほほゑ みて / るりの はねフ りのと りは / よはなり ぬれど あふぎ みよ */
    /* 三、ハルニ ミチテ ハナサ カヒ / トリサヘ ウタフ タケノ ソノ / イザホギ マツレ ココノ ヘノ */
    | {mf} 5_ - - - 1 - - - | 3 - - 2 1 - - - | 2 - - - 3 - - - | 5 - - - - - 0 - |
    /* @Vocal: イ ハ ヘ モ ロ ビ ト */
    /* @Vocal: か へ る す み れ ー */
    /* @Vocal: ハ ル ニ ミ チ テ ー */
    | 6 - - - 5 - - - | 3 - - 2 1 - - - | 2 - - - 2 - - - | 5_ - - - - - 0 - |
    /* @Vocal: ケ フ ノ ヨ キ ヒ */
    /* @Vocal: ほ ほ ゑ み て */
    /* @Vocal: ハ ナ サ カ ヒ */
    | 1 - - - 7_ - 6_ - | 5_ - - - 1 - 2 - | 3 - - - 2 - - - | 1 - - - - - 0 - |
    /* @Vocal: ニ ジ フ ゴ ネ ン ノ */
    /* @Vocal: る り の は ね フ */
    /* @Vocal: ト リ サ ヘ ウ タ フ */
}

GinkonshikiHoshukuKoshinka_B1:Vocal@|0| {
    <16*>
    /* 第一・二番後半 (Staves 4–6): */
    /* 一、ソノム カシ / カシコ ドコロノ オホマ ヘニ / スメラ ミコトノ カシコ クモ / キサイノ ミヤト モモト セヲ / チギリ タマヒシ ヨキヒ ナレ */
    /* 二、りのと りは / よはなり ぬれど あふぎ みよ / みいつは いよよ かがや きて / たけの そのふの みさか えは / あめつち のむた きはみ なし */
    | 2 - - - 2 - 3 - | 4 - - - 2 - - - | 3 - - - 5 - 3 - | 2 - - - - - 0 - |
    /* @Vocal: ソ ノ ム カ シ カ シ コ ド コ ロ ノ */
    /* @Vocal: り の と り は よ は な り ぬ れ ど */
    | 5_ - - - 1 - - - | 3 - - - 2 - 1 - | 6_ - - - 1 - - - | 5_ - - - - - 0 - |
    /* @Vocal: オ ホ マ ヘ ニ ス メ ラ ミ コ ト ノ */
    /* @Vocal: あ ふ ぎ み よ み い つ は い よ よ */
    | 1 - - - 2 - 3 - | 5 - - - 6 - 5 - | 3 - - - 2 - - - | 1 - - - - - 0 - |
    /* @Vocal: チ ギ リ タ マ ヒ シ ヨ キ ヒ ナ レ */
    /* @Vocal: あ め つ ち の む た き は み な し */
}

GinkonshikiHoshukuKoshinka_B2:Vocal@|0| {
    <16*>
    /* 第三番後半 (Staves 7–9): */
    /* 三、タケノ ソノ / イザホギ マツレ ココノ ヘノ / クモヰニ タカク ヒビク マデ / テンワウ ヘイカ バンバン ザイ / クワウゴウ ヘイカ バンバン ザイ */
    | {f} 2 - - - 2 - - - | 5 - - - 3 - - - | 2 - - 3 2 - - 1 | 7_ - - - - - 0 - |
    /* @Vocal: タ ケ ノ ソ ノ イ ザ ホ ギ マ ツ レ */
    | 1 - - - 1 - - - | 2 - - - 2 - - - | 3 - 1 - 3 - 5 - | 5 - - - - - 0 - |
    /* @Vocal: コ コ ノ ヘ ノ ク モ ヰ ニ タ カ ク */
    | 6 - - - 6 - - - | 5 - - - 3 - - - | 2 - 2 - 3 - 2 - | 1 - - - - - 0 - |
    /* @Vocal: テ ン ワ ウ ヘ イ カ バ ン バ ン ザ イ */
}

-> GinkonshikiHoshukuKoshinka_A -> GinkonshikiHoshukuKoshinka_B1 -> GinkonshikiHoshukuKoshinka_B2 -> #
