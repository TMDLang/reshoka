** 皇太子殿下御成婚奉祝提燈行列進行歌 **
!= 112
?= G
<2/4>
~ "曲：不詳 (大正十三年)"

/* =========================================================================
   皇太子殿下御成婚奉祝提燈行列進行歌 (Kōtaishi Denka Goseikon Hōshuku Chōchin Gyōretsu Shinkōka)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P061.jpg (Notebook 1, p.15)
   Notation: Handwritten 5-line staff (1 sharp = G major, 2/4 time, 20 bars)
   ========================================================================= */

KotaishiDenkaChochinGyoretsuShinkoka:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* 一、シンリョク カヲル コゾノハル / アヲギ マツリシ ミヒカリヲ / オモヘバ イヨヨ ミニシミテ / ケフノ ミノリノ カシコサヨ / ケフノ ミノリノ カシコサヨ */
    /* 二、ケフシモ アゲマス ミノリヲト / クリカヘ シテモ ナホツキヌ / ソノヨロ コビヲ コヨヒマタ / コヽロ ユクマデ ウタハナム / コヽロ ユクマデ ウタハナム */
    /* 三、ナモフサ ハシキ タカサゴノ / ヨロヅヲ カケテ ウタフナル / ワレラガ コエハ ココノエノ / クモノヘ タカク ヒビクラム / クモノヘ タカク ヒビクラム */
    | {mf} 5 - 5 - 5 - 5 - | 3 - 5 - 1 - 3 - | 2 - 1 - 6_ - 1 - | 5_ - - - - - 0 - |
    /* @Vocal: シ ン リョ ク カ ヲ ル ー コ ゾ ノ ハ ル */
    /* @Vocal: ケ フ シ モ ア ゲ マ ス ミ ノ リ ヲ ト */
    /* @Vocal: ナ モ フ サ ハ シ キ ー タ カ サ ゴ ノ */
    | 1 - 1 - 1 - 2 - | 3 - 3 - 5 - - - | 6 - 6 - 5 - 3 - | 5 - - - - - 0 - |
    /* @Vocal: ア ヲ ギ マ ツ リ シ ミ ヒ カ リ ヲ */
    /* @Vocal: ク リ カ ヘ シ テ モ ナ ホ ツ キ ヌ */
    /* @Vocal: ヨ ロ ヅ ヲ カ ケ テ ウ タ フ ナ ル */
    | 3 - 2 - 1 - 2 - | 3 - 3 - 2 - 1 - | 6_ - 1 - 2 - 2 - | 2 - - - - - 0 - |
    /* @Vocal: オ モ ヘ バ イ ヨ ヨ ー ミ ニ シ ミ テ */
    /* @Vocal: ソ ノ ヨ ロ コ ビ ヲ ー コ ヨ ヒ マ タ */
    /* @Vocal: ワ レ ラ ガ コ エ ハ ー コ コ ノ エ ノ */
    | 1 - 1 - 2 - 2 - | 3 - 3 - 5 - - 6 | 5 - 3 - 2 - 5 - | 3 - - - - - 0 - |
    /* @Vocal: ケ フ ノ ー ミ ノ リ ノ カ シ コ サ ヨ */
    /* @Vocal: コ コ ロ ー ユ ク マ デ ウ タ ハ ナ ム */
    /* @Vocal: ク モ ノ ヘ タ カ ク ー ヒ ビ ク ラ ム */
    | {f} 6 - 6 - 5 - 3 - | 2 - 1 - 6_ - 1 - | 2 - 2 - 3 - 2 - | 1 - - - - - 0 - |
    /* @Vocal: ケ フ ー ノ ミ ノ リ ノ カ シ コ サ ヨ */
    /* @Vocal: コ コ ロ ー ユ ク マ デ ウ タ ハ ナ ム */
    /* @Vocal: ク モ ノ ヘ タ カ ク ー ヒ ビ ク ラ ム */
}

