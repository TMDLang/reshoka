::SCORE::
** 金剛石・水は器 **
!= 92
?= G
<4/4>
~ "曲：奥好義 (昭憲皇太后御歌)"

/* =========================================================================
   金剛石・水は器 (Kongōseki / Mizu wa Utsuwa)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P051.jpg – P052.jpg (Insert)
   Notation: Handwritten 5-line staff (1 sharp = G major, 4/4 time, 32 bars)
   ========================================================================= */

KongosekiMizuWaUtsuwa:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* 1 (金剛石): コンガウ セキモ ミガカズバ / タマノ ヒカリハ ソハザラム / ヒトモ マナビテ ノチニコソ / マコトノ トクハ アラハルレ */
    /* トケイノ ハリノ タエマナク / メグルガ ゴトク トキノマノ / ヒカゲ ヲシミテ ハゲミナバ / イカナル ワザカ ナラザラム */
    /* 2 (水は器): みづは うつはに したがひて / そのさま ざまに なりぬなり / ひとは まじはる ともにより / よきに あしきに うつるなり */
    /* おのれに まさる よきともを / えらび もとめて もろともに / こころの こまに むちうちて / まなびの みちに すすめかし */
    | {mf} 5_ - - - 5_ - - - 5_ - - - 1 - - - | 1 - - - 6_ - - - 5_ - - - 1 - - - | 2 - - - 2 - - - 3 - - - 2 - - - | 1 - - - - - - - - - - - 0 - - - |
    /* @Vocal: コ ン ガ ウ セ キ モ ミ ガ カ ズ バ */
    /* @Vocal: み ー づ は う つ は に し た が ひ て */
    | 3 - - - 3 - - - 2 - - - 3 - - - | 5 - - - 5 - - - 3 - - - 3 - - - | 2 - - - 2 - - - 3 - - - 2 - - - | 5_ - - - - - - - - - - - 0 - - - |
    /* @Vocal: タ マ ノ ヒ カ リ ハ ソ ハ ザ ラ ム */
    /* @Vocal: そ の さ ま ざ ー ま に な り ぬ な り */
    | 5_ - - - 5_ - - - 5_ - - - 6_ - - - | 7_ - - - 7_ - - - 2 - - - 2 - - - | 1 - - - 1 - - - 2 - - - 3 - - - | 2 - - - - - - - - - - - 0 - - - |
    /* @Vocal: ヒ ト モ マ ナ ビ テ ノ チ ニ コ ソ */
    /* @Vocal: ひ と は ま じ は る と も に よ り */
    | 3 - - - 3 - - - 5 - - - 5 - - - | 6 - - - 3 - - - 2 - - - 3 - - - | 2 - - - 3 - - - 2 - - - 5 - - - | 3 - - - - - - - - - - - 0 - - - |
    /* @Vocal: マ コ ト ノ ト ク ハ ア ラ ハ ル レ */
    /* @Vocal: よ ー き に あ し き に う つ る な り */
    | 5 - - - 5 - - - 5 - - - 5 - - - | 6 - - - 5 - - - 3 - - - 1 - - - | 2 - - - 2 - - - 1 - - - 6_ - - - | 5_ - - - - - - - - - - - 0 - - - |
    /* @Vocal: ト ケ イ ノ ハ リ ノ タ エ マ ナ ク */
    /* @Vocal: お の れ に ま さ る よ き と も を */
    | 5_ - - - 6_ - - - 5_ - - - 3_ - - - | 5_ - - - 1 - - - 2 - - - 3 - - - | 2 - - - 2 - - - 1 - - - 2 - - - | 3 - - - - - - - - - - - 0 - - - |
    /* @Vocal: メ グ ル ガ ゴ ト ク ト キ ノ マ ノ */
    /* @Vocal: え ー ら び も と め て も ろ と も に */
    | 5 - - - 5 - - - 3 - - - 2 - - - | 1 - - - 6_ - - - 5_ - - - 1 - - - | 6_ - - - 5_ - - - 5_ - - - 1 - - - | 2 - - - - - - - - - - - 0 - - - |
    /* @Vocal: ヒ カ ゲ ヲ シ ミ テ ハ ゲ ミ ナ バ */
    /* @Vocal: こ こ ろ の こ ー ま に む ち う ち て */
    | 3 - - - 3 - - - 2 - - - 1 - - - | 2 - - - 5 - - - 3 - - - 1 - - - | 2 - - - 5_ - - - 6_ - - - 7_ - - - | 1 - - - - - - - - - - - 0 - - - |
    /* @Vocal: イ カ ナ ル ワ ザ カ ナ ラ ザ ラ ム */
    /* @Vocal: ま な び の み ち に す す め か し */
}

