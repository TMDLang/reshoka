::SCORE::
** れんげさう **
!= 96
?= F
<4/4>
~ "曲：正聴会編 唱歌学習帳 四年"

/* =========================================================================
   れんげさう (Rengesō)
   Source: 唱歌帖 (Shōkachō, NMTH 2020.006.0843) — P063.jpg (Notebook 1, p.17)
   Notation: Handwritten 5-line staff (1 flat = F major, 4/4 time, 16 bars)
   Annotations: ヘ調 4/4, (小学生ノ歌), 正聴会編 唱歌学習帳 四年
   ========================================================================= */

Rengeso:Vocal@|0| {
    <16*>
    /* 歌詞: */
    /* 1. イマハ レンゲノ ハナ ザカリ / タニモ ハタニモ イチメン ニ / ハナモウ センヲ シキツメ テ / ベニ ヤム ラサキ ウツ クシイ */
    /* 2. ああれん げさう れん げさう / てにも かごにも つみため て / たのしい こころ もろとも に / はる のみ かみに ささ げませう */
    | {mp} 5_ - - - 3_ - - - 5_ - - - 1 - - - | 2 - - - 3 - - - 5 - - - 3 - - - | 2 - - - 3 - 2 - 1 - - - 6_ - - - | 5_ - - - - - - - - - - - 0 - - - |
    /* @Vocal: イ マ ハ レ ン ゲ ノ ハ ナ ザ カ リ */
    /* @Vocal: あ あ れ ん げ さ う れ ん げ さ う */
    | {mf} 1 - - - 3_ - - - 5_ - - - 1 - - - | 2 - 3 - 5 - - - 5 - - - 3 - - - | 2 - - - - - 3 - 2 - 1 - 6_ - - - | 1 - - - - - - - - - - - 0 - - - |
    /* @Vocal: タ ニ モ ハ タ ー ニ モ イ チ メ ー ン ニ */
    /* @Vocal: て に も か ご ー に も つ み た ー め て */
    | {mf} 2 - - - - - 3 - 5 - - - 2 - - - | 1 - - - 6_ - - - 5_ - - - 1 - - - | 2 - - - 3 - 2 - 3 - - - 5 - - - | 6 - - - - - - - 5 - - - {f} 1^ - - - |
    /* @Vocal: ハ ナ モウ セ ン ヲ シ キ ツ メ テ ー ー */
    /* @Vocal: た の しい こ こ ろ も ろ と も に ー ー */
    | 6 - 5 - 3 - - - 5 - - - 5 - - - | {p} 6 - 5 - 3 - - - 2 - 3 - 5 - - - | 1 - - - 2 - 3 - 2 - - - - - 1 - | 1 - - - - - - - - - - - 0 - - - |
    /* @Vocal: ベ ニ ヤ ム ラ サ キ ー ウ ー ツ ク シ ー イ */
    /* @Vocal: は る の み か み に ー さ ー さ げ ま ー せう */
}

-> Rengeso -> #
