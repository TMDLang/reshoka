::SCORE::
** 起床喇叭・點呼喇叭・消燈喇叭 **
!= 112
?= C
<2/4>
~ "出處：《唱歌帖》（2020.006.0843）P041.jpg (bottom)（7. 貼附喇叭譜）"

/* =========================================================================
   原書資訊（對應 P041.jpg 下半貼附紙張）：
   1. 起床喇叭（Reveille）
   2. 點呼喇叭（Roll Call）
   3. 消燈喇叭（Taps / Lights Out，註記「次ハ二消ユ」「次ハ二ヰユ」）
   ========================================================================= */

KishoRappa:Piano@|0| {
    <16*>
    {f}
    /* 1. 起床喇叭 */
    | 0 - - - 0 - 5 - | 1^ 5 1^ - 1^ 5 1^ - | 3^ 1^ 3^ 1^ 1^ 5 1^ - | 5 1^ 1^ - 1^ 3^ 1^ - | 1^ - - 3^ 1^ - 3^ - |
    | 3^ 3^ 3^ - 3^ 3^ 3^ - | 5^ 3^ 5^ 3^ 5^ 3^ 5^ 3^ | 1^ 3^ 1^ - 5 5 5 - | 1^ - - - - - 0 - |
    /* 2. 點呼喇叭 */
    | 0 - - - 0 - 5 5 | 1^ - 5 5 1^ - 5 5 | 1^ - 1^ - 1^ - 3^ - | 5^ 5^ 5^ - 5^ - 5^ - | 3^ 3^ 3^ - 5^ - 3^ - |
    | 1^ - - - 0 - 1^ 3^ | 1^ - - - 0 - 5 5 | 1^ - 5 5 1^ - 5 5 | 1^ - 1^ - 1^ - 3^ - | 5^ 5^ 5^ - 5^ - 5^ - |
    | 3^ 3^ 3^ - 5^ - 3^ - | 1^ - - - 0 - 1^ 3^ | 1^ - - - 0 - - - |
    /* 3. 消燈喇叭 */
    {mf}
    | 1^ - 1^ - 1^ - 1^ - | 1^ - 3^ - 1^ - 3^ - | 5^ - - - - - - - |
    {p}
    | 5^ - - - 0 - - - |
    {mf}
    | 5^ 3^ 5^ 3^ 5^ - 3^ - | 1^ - 3^ - 1^ - 5 - | 1^ - - - - - - - |
    {pp}
    | 1^ - - - 0 - - - |
}

-> KishoRappa -> #
