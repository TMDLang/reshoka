/* =========================================================================
   title = 君が代
   ?= C
   != 69
   <4/4>
   來源：『唱歌帖』(2020.006.0843) 第一冊 p.13 上半頁 (掃描頁 P048.jpg)
   記譜：手抄五線譜（共11小節，附強弱記號 p, mf, f）
   歌詞：
   キミガヨハ チヨニヤチヨニ サザレイシノ
   イハホトナリテ コケノムスマデ
   ========================================================================= */

KimiGaYo:Vocal@|0| {
    <16*>
    /* キ ミ ガ ヨ ハ チ ヨ ニ ヤ チ ヨ ニ */
    | {p} 2 - - - 1 - - - 2 - - - 3 - - - | 5 - - - 3 - - - 2 - - - - - - - | {mf} 3 - - - 5 - - - 6 - - - 5 - 6 - | 2^ - - - 7 - - - 6 - - - 5 - - - |
    /* サ ザ レ イ シ ノ イ ハ ホ ト ナ リ テ */
    | 3 - - - 5 - - - 6 - - - - - - - | {f} 1^ - - - 2^ - - - 1^ - - - - - - - | {mf} 3 - - - 5 - - - 6 - - - 5 - - - | 3 - - - - - 2 - 5_ - - - - - - - |
    /* コ ケ ノ ム ス マ デ */
    | 6 - - - 1^ - - - 2^ - - - - - - - | 1^ - - - 2^ - - - 6 - - - 5 - - - | 6 - - - 5 - 3 - 2 - - - - - - - |
}

