/* =========================================================================
   原書資訊與歌詞全文（對應 P010.jpg）：
   調性與拍號：ハ調 2/4 拍（C 大調 2/4 拍），♩=92
   註記：2.3年 / 昭2.11.30 刊りすより

   一、
   ソックリ ウツツタ ワタシノ シャシン
   クロイ イロマデ アリノママ
   クチハ イマデモ モノイヒサウ
   ドンナニ ミテモ ワンパク ガホ

   二、
   じゃうづに とられた わたしの しゃしん
   ほほの ゑくぼも うつってる
   かよふ ちまでも みえるやう
   やっぱり これは よそいき がほ
   ========================================================================= */

WatashiNoShashin:Piano@|0| {
    <16*>
    {mf}
    | 1^ - - - 6 - 5 - | 3 - 3 - 2 - 1 - | 2 - 2 - 3 - 2 - | 5 - 6 - 5 - 0 - |
    | 6 - - - 1^ - 6 - | 3^ - 3^ - 2^ - 1^ - | 2^ - - 1^ 3^ - 2^ - | 1^ - - - - - 0 - |
    | 1 - 1 - 2 - 0 - | 1 - 2 - 3 - 5 - | 6 - 6 - 5 - 6 - | 5 - - - - - 0 - |
    | 1^ - - 2^ 1^ - 6 - | 5 - 6 - 5 - 0 - | 3 - 5 - 2 - 3 - | 1 - 1 - 0 - - - |
}

