    /* ふ - じ の | た か ね の */
    | 3 - 2 3 | 5 5 3 5 |
    L1| ふ - じ の | た か ね の |
    L2| あ - さ ひ | に に ほ ふ |
    /* い や た か | に - - - */
    | 6 6 5 3 | 2 - - 0 |
    L1| い や た か | に - - _ |
    L2| さ く ら に | ぞ - - _ |
    /* ひ ノ フ | い や く */
    | 5 5 3 5 | 6 6 5 3 |
    L1| ひ の で の | く に の そ |
    L2| や ま と の | こ こ ろ は |
    /* の す が た | は - - - */
    | 6 6 5 5 | 6 - 5 3 | 2 2 2 1 | 2 - - 0 |
