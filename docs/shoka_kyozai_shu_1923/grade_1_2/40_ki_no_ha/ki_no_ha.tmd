    | 5 - 5 - 3 - 3 - | 2 - 2 - 1 - 2 - | 3 - - 3 2 - 1 - | 3 - 2 - 2 - 0 - |
    L1| ど - こ - か - ら - | き - た - の - か - | とん - - で き - た - | き - の - は - _ - |
    L2| ど - こ - か - ら - | き - た - の - か - | とん - - で き - た - | き - の - は - _ - |

    /* ================= 第二行 (4 小節, P089.jpg) ================= */
