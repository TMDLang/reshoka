    L2| は - ま - | べ - に - | や - ど - | れ - ば - |

    /* ================= 第二行 (4 小節, P376.jpg) ================= */
    | 7 - 3^ - | 1^ - 4^ - | 2^ - 3^ 4^ | 3^ - - - |
    L1| コ - ト - | ノ - ネ - | キ - コ - | ユ - - - |
    L2| た - い - | こ - ぞ - | ひ - び - | く - - - |

    /* ================= 第三行 (4 小節, P376.jpg) ================= */
    | 3^ - 4^ 3^ | 2^ - 3^ - | 1^ - 2^ - | 7 - 1^ - |
    L1| ユ - カ - | シ - ヤ - | タ - ガ - | テ - ゾ - |
    L2| あ - や - | し - や - | な - に - | ご - と - |

    /* ================= 第四行 (4 小節, P376.jpg) ================= */
    | 1^ - 7 6 | 4 - 6 - | 1^ - 7 - | 1^ - - - |
    L1| マ - ツ - | フ - ク - | カ - ゼ - | ヨ - - - |
    L2| い - そ - | う - つ - | な - み - | よ - - - |
}

