/* =========================================================================
   > [!NOTE]
   > **原書資訊與歌詞全文**（對應 `P332.jpg`–`P333.jpg`，原書 p. 324–325，尋常科五・六學年第 46 首）：
   > - **調性與拍號**：ハ調四拍子（C 大調 4/4 拍），♩= 100，弱起一拍
   > - **曲式結構**：文部省唱歌名曲〈わかれ〉（`P332.jpg` 歌詞頁題作「わかれ」，`P333.jpg` 樂譜頁題作「別れ」）。前 8 小節譜下印有雙層歌詞（第一遍「ハルノ…」與第二遍「あきの…」），第 8 小節第 3 拍 `1^` 附延長記號與反覆記號（`:||`），反覆演唱兩遍後接後 8 小節「ひごろのまじはり…」。本檔依實際演唱曲式展開為 `PartA[L1] -> PartA[L2] -> PartB`。
   >
   > 春（はる）の朝（あした）　花（はな）の下（もと）に
   > 共（とも）に樂（たの）しく　親（した）しみ合（あ）ひし
   > 秋（あき）の夕（ゆふべ）　月（つき）の影（かげ）に
   > 共（とも）に嬉（うれ）しく　語（かた）らひ合（あ）ひし
   > 日頃（ひごろ）の交（まじは）り　忘（わす）れぬ程（ほど）に
   > 惜（を）しき別（わか）れを　告（つ）げなんさらば。
   ========================================================================= */

PartA:Piano@|0| {
    <16*>
    /* ================= 前半段 (弱起 1 拍 + 8 小節反覆 :||, P333.jpg) ================= */
    | 0 - - - 0 - - - 0 - - - {p} 1^ - - 1^ | 1^ - - - 0 - - - {mp} 1^ - - 1^ 2^ - - - | 1^ - - 2^ 1^ - - - 6 - - - 4 - - 5 | 6 - - - 4 - - - 2 - - 3 5 - - - |
    L1| _ - - - _ - - - _ - - - ハ - - ル | ノ - - - _ - - - ハ - - ル ノ - - - | ア - - - シ - - - タ - - - ハ - - - | ナ - - - ノ - - - モ - - - ト - - - |
    L2| _ - - - _ - - - _ - - - あ - - き | の - - - _ - - - あ - - き の - - - | ゆ - - - ふ - - - べ - - - つ - - - | き - - - の - - - か - - - げ - - - |

    | 1 - - - - - - - {mf} 1^ - - 1^ 1^ - - - | 0 - - - 1^ - - 1^ 2^ - - - 1^ - - 2^ | 1^ - - - 6 - - - 2^ - - 2^ 1^ - - - | 7 - - - 6 - - 5 6 - 7 - 1^ - - - |
    L1| ニ - - - - - - - ト - - モ ニ - - - | _ - - - ト - - モ ニ - - - タ - - ノ | シ - - - ク - - - シ - - タ シ - - - | ミ - - - ア - - - ヒ - - - シ - - - |
    L2| に - - - - - - - と - - も に - - - | _ - - - と - - も に - - - う - - れ | し - - - く - - - か - - た ら - - - | ひ - - - あ - - - ひ - - - し - - - |
}

PartB:Piano@|0| {
    <16*>
    /* ================= 後半段 (弱起 1 拍 + 8 小節, P333.jpg) ================= */
    | 0 - - - 0 - - - 0 - - - {p} 5 - - - | 5 - - - - - 5 - 5 - - - 3 - - - | 2 - - - - - 2 - 2 - - - 1 - - - | 2 - - - - - 1 - 2 - - - 3 - - - |
    L| _ - - - _ - - - _ - - - ひ - - - | ご - - - - - ろ - の - - - ま - - - | じ - - - - - は - り - - - わ - - - | す - - - - - れ - ぬ - - - ほ - - - |

    | 5 - - - 6 - - - - - - - 1^ - - - | {mf} 2^ - - - - - 6 - 6 - - - 5 - - - | 3 - - - 5 - - - - - - - {p} 1 - 1 - | 2 - - - - - 1 - 3 - - - 2 - - - | 1 - - - - - - - 0 - - - 0 - - - |
    L| ど - - - に - - - - - - - を - - - | し - - - - - き - わ - - - か - - - | れ - - - を - - - - - - - つ - げ - | な - - - - - ん - さ - - - ら - - - | ば - - - - - - - _ - - - _ - - - |
}

