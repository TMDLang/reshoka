/* =========================================================================
   【過場三 Transition 3】鐵鎚遠去・烈日白道 (4 小節, 由 G 大調轉入 E 大調, != 88)
   留在 G 大調記譜 (?= G) 進行實質轉調準備：
     - 第 1 小節：由 G 大調 [1] 轉入關係小調 Em [6m] (6_ 1 3 = E-G-B)，打鐵回音漸遠
     - 第 2 小節：經過 Am7 [2m7] 與 F#m7-5 (7_ 2 4 6 = F#-A-C-E)
     - 第 3-4 小節：進入 E 大調之屬七和弦 B7 (3_ 5'_ 7_ 2 = B-D#-F#-A)，
       以鮮明的升音 D# (`5'`) 與七音 A (`2`) 三全音預告 E 大調的陽光，解決至下一樂章《牛車》！
   ========================================================================= */

Trans3_To_Gyusha:Flute@|0| {
    <8*>
    {!= 88}
    {mp}
    | 3^ 5^ 5^ 0 0 0 0 0 | 0 0 1^ 6 4^ - 2^ - |
    {p}
    /* 在 B7 上吹出 F# (7^) 與導音 D# (5'^) */
    | 0 0 0 0 7^ - 2^^ - | 5'^ - 7^ - 5'^ - 0 0 |
}

Trans3_To_Gyusha:Oboe@|0| {
    <8*>
    {mp}
    | 0 0 0 0 6_ 1 3 0 | 2 - - 1 7_ - 6_ - |
    {p}
    /* 雙簧管吟唱 B7 的導音 D# (5'_) 與七音 A (2) */
    | 5'_ - - 5'_ 7_ - 2 - | 7_ - - 5'_ 5'_ - 0 0 |
}

Trans3_To_Gyusha:Clarinet@|0| {
    <8*>
    {mp}
    | 1 - 5_ - 6_ - - - | 4_ - 6_ - 7_ - 2 - |
    {p}
    /* 單簧管勾勒 B7 的 A (2) 與 D# (5'_) 三全音 */
    | 3_ - - 3_ 5'_ - 7_ - | 2 - 7_ - 5'_ - 0 0 |
}

Trans3_To_Gyusha:Violin@|0| {
    <8*>
    {mp}
    | 5 - 3 - 6_ - - - | 1 - 2 - 4 - 2 - |
    {p}
    | 3 - - 3 5' - 7 - | 2^ - 7 - 5' - 0 0 |
}

Trans3_To_Gyusha:Cello@|0| {
    <8*>
    {mp}
    /* 大提琴低音線：G (1_) -> E (6__) -> A (2__) -> B (3__) 沉穩確立 E 大調屬音 */
    | 1_ - - 1_ 6__ - 3__ - | 2__ - - 2__ 7__ - 6__ - |
    {p}
    | 3__ - - 3__ 7__ - 3_ - | 3__ - - 3__ 3__ - 0 0 |
