/* =========================================================================
   【過場四 Transition 4】夕陽歸途・迎向長假 (4 小節, 由 E 大調轉回主調 D 大調, != 98)
   留在 E 大調記譜 (?= E) 進行實質轉調準備：
     - 第 1 小節：前半為 E 大調 [1]，後半將 D# (7) 降為還原 D♮ (`7,`) 形成 E7 (1 3 5 7, = E-G#-B-D♮)
     - 第 2 小節：前半解決至下屬調 A 大調 [4] (4_ 6_ 1 = A-C#-E)，後半將 G# (3) 降為還原 G♮ (`3,`)
     - 第 3-4 小節：確立 D 大調之屬七和弦 A7 (4_ 6_ 1 3, = A-C#-E-G♮)，
       以 C# (`6`) 與還原 G♮ (`3,`) 的三全音張力號角蓄力，光輝解決回母調 D 大調《ながいお休》！
   ========================================================================= */

Trans4_To_Oyasumi:Flute@|0| {
    <8*>
    {!= 98}
    {mf}
    /* E -> E7 (7,^ = D♮) -> A -> A7 (3,^ = G♮) */
    | 0 0 5^ 1^^ 7,^ - 5^ - | 4^ - 6^ 1^^ 6^ - 0 0 |
    {f}
    | 4^ - - 4^ 6^ - 1^^ - | 3,^^ 0 1^^ 0 6^ 0 4^ 0 |
}

Trans4_To_Oyasumi:Oboe@|0| {
    <8*>
    {mf}
    /* 雙簧管吹出 E -> E7 (7,) 與 A -> A7 (3,) 兩次關鍵半音轉折 */
    | 3 - 5 5 7, - 5 - | 6 - 4 6 3, - 0 0 |
    {f}
    | 4 - - 4 3, - 6 - | 6 0 4 0 3, 0 6 0 |
}

Trans4_To_Oyasumi:Clarinet@|0| {
    <8*>
    {mf}
    /* 單簧管強調 E7 的七音 D♮ (7,_) 與 A7 的七音 G♮ (3,) */
    | 1 - 3 - 7,_ - 2 - | 1 - 6_ - 1 - 3, - |
    {f}
    | 6_ - - 6_ 1 - 3, - | 3, 0 1 0 6_ 0 3,_ 0 |
}

Trans4_To_Oyasumi:Violin@|0| {
    <8*>
    {mf}
    | 5 - 5 1^ 2^ - 7, - | 6 - 1^ 4^ 3,^ - 0 0 |
    {f}
    | 6 - - 6 1^ - 3,^ - | 6^ 0 3,^ 0 1^ 0 6 0 |
}

Trans4_To_Oyasumi:Cello@|0| {
    <8*>
    {mf}
    /* 大提琴低音線：E (1_) -> B (5__) -> D♮ (7,__) -> C# (6__) -> A (4__) */
    | 1_ - 5__ - 7,__ - 5__ - | 6__ - 4__ - 4__ - 0 0 |
    {f}
    | 4__ 4__ 4__ 4__ 4__ 4__ 4__ 4__ | 4__ 0 4_ 0 4__ 0 4_ 0 |
}

Trans4_To_Oyasumi:Piano@|0| {
    <8*>
    {mf}
    | 1_ 5_ 1 3 7,__ 5_ 7,_ 2 | 6__ 4_ 6_ 1 4__ 1_ 3,_ 6_ |
    {f}
    /* 鋼琴強奏 A7 (A-C#-E-G♮ = 4__ 6_ 1 3,) */
    | 4__ 4_ 6_ 3, 4__ 4_ 6_ 3, | 6 0 3, 0 1 0 6_ 0 |
}

Trans4_To_Oyasumi:CHORD@|0| {
    <2*>
    | [1] [E7] | [4] [A7] |
    | [A7] [A7] | [A7] [A7] |
}

