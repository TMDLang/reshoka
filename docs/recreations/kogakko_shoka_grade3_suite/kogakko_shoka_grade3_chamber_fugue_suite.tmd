/* =========================================================================
   【終曲五主題大賦格 Grand Quintuple Fugue Finale】
   (共 32 小節, D 大調 ?= D, 4/4 拍)
   分為四個巴洛克／新古典對位階段：
     1. [Fugue_Exposition] (12 小節, != 112)：五主題賦格呈示部（利用 @|+N| 聲部依序疊加）
        - 第 1-2 小節 (Dux 1)：大提琴獨奏呈示主題 I《あをば》
        - 第 3-4 小節 (Comes 2)：單簧管進入呈示主題 II《だいしゃ》，大提琴轉為對題
        - 第 5-6 小節 (Dux 3)：雙簧管進入呈示主題 IV《牛車》，形成三聲部對位
        - 第 7-8 小節 (Comes 4)：小提琴與鋼琴進入呈示主題 III《村のかじや》，形成四聲部對位
        - 第 9-12 小節 (Dux 5)：長笛於最高音區呈示主題 V《ながいお休》，五聲部全體賦格齊鳴！
     2. [Fugue_Stretto] (8 小節, != 114)：賦格插句、關係小調轉調與緊接段 (Stretto + Dominant Pedal)
        - 第 1-4 小節：五首動機以半小節（2 拍）間距緊接追逐，經歷 Bm -> F#m -> Em -> A7
        - 第 5-8 小節：大提琴與鋼琴踩響長達 4 小節的屬音 A (`5__`) 持續音踏瓣，上方四聲部密集疊入五個主題動機
     3. [Fugue_Quintuple] (8 小節, != 112, {ff})：五主題同時對位大高潮 (Quintuple Counterpoint Apotheosis)
        - 長笛 (Flute)    ：完整吹奏《ながいお休》高音主題 (四分／附點號角)
        - 雙簧管 (Oboe)   ：完整吹奏《あをば》田園主旋律 (二分／四分寬廣線條)
        - 小提琴 (Violin) ：完整拉奏《村のかじや》打鐵主題 (八分／十六分火花音型)
        - 單簧管 (Clarinet)：完整吹奏《だいしゃ》台車主題 (十六分切分與跳躍音型)
        - 大提琴 (Cello)  ：完整拉奏《牛車》行進主題 (低音附點沉穩步伐)
        - 鋼琴 (Piano)    ：巴洛克數字低音與流動八分音符和聲支撐
     4. [Fugue_Grand_Coda] (4 小節, != 102, {ff})：巴洛克式變格—正格複合終止大華彩
   ========================================================================= */

/* -------------------------------------------------------------------------
   1. 五主題賦格呈示部 (Fugue_Exposition, 12 小節, != 112)
   使用 TMD 原生 @|+N| 偏移語法，展現五個聲部從單聲部獨奏逐步堆疊至五聲部賦格的過程
   ------------------------------------------------------------------------- */

Fugue_Exposition:Cello@|0| {
    <8*>
    {!= 112}
    {mf}
    /* [小節 1-2] 聲部一 (Dux 1)：大提琴獨奏呈示主題 I《あをば》 */
    | 3_ - 3_ - 2_ - - 1_ | 2_ - - - 5_ - 3_ - |
    /* [小節 3-4] 第一對題 (Countersubject 1)：巴洛克漫步低音應答單簧管的《だいしゃ》 */
    | 1_ - 3_ - 4_ - 2_ - | 1_ - 6__ - 5__ - 5_ - |
    /* [小節 5-6] 第二對題：流動八分音符襯托雙簧管的《牛車》 */
    | 1_ 2_ 3_ 1_ 6__ 1_ 3_ 6__ | 2_ 3_ 4_ 2_ 5__ - 5_ - |
    /* [小節 7-8] 第三對題：跳躍八度支撐小提琴的《村のかじや》 */
    {f}
    | 1_ 5__ 1_ 3_ 6__ 3__ 6__ 1_ | 2_ 6__ 5__ 5__ 1_ 5__ 1_ 0 |
    /* [小節 9-12] 第四對題：以《牛車》附點動機與漫步低音支撐長笛的《ながいお休》 */
    | 1_ - - 1_ 1_ - 3_ - | 4_ - - 2_ 5__ - 5_ - |
    | 1_ - - 6__ 1_ - 3_ - | 2_ - 5__ - 1_ - 5_ 0 |
}

