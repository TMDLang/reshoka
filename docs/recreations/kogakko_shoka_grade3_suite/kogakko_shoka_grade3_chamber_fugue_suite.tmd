    <16*>
    {mf}
    /* [小節 3-4] 聲部二 (Comes 2, 延遲 2 小節進入)：單簧管呈示主題 II《だいしゃ》 */
    | 5_ - - - 5_ - - - 1 - 1 - 1 - 0 - | 3 - - 3 3 - - 1 2 - 2 - 2 - 0 - |
