/* -------------------------------------------------------------------------
   3. 五主題同時對位大高潮 (Fugue_Quintuple, 8 小節, != 112, {ff})
   全曲最高潮！五首公學校唱歌的完整主題在同一時間、不同音區與不同節奏密度下五聲部同步演出，
   且經嚴密對位校準，每一拍均完全協和無半音碰撞：
     - 長笛 (Flute)    ：主題 V《ながいお休》（高音附點慶典旋律）
     - 雙簧管 (Oboe)   ：主題 I《あをば》（中音悠長田園主旋律）
     - 小提琴 (Violin) ：主題 III《村のかじや》（高音八分／十六分打鐵火花旋律）
     - 單簧管 (Clarinet)：主題 II《だいしゃ》（中音十六分音符台車疾馳旋律）
     - 大提琴 (Cello)  ：主題 IV《牛車》（低音沉穩附點車輪旋律）
   ------------------------------------------------------------------------- */

Fugue_Quintuple:Flute@|0| {
    <8*>
    {!= 112}
    {ff}
    /* 【同時主題 V：《ながいお休》】高音區輝煌領奏 */
    | 5^ - - 5^ 5^ - 5^ - | 1^^ - - 7^ 6^ - 6^ - |
    | 5^ - - 6^ 5^ - 3^ - | 2^ - 2^ - 3^ - 5^ 0 |
    | 1^ - - 2^ 3^ - 5^ - | 6^ - - 6^ 1^^ - 6^ - |
    | 5^ - 1^^ - 2^^ - - 7^ | 1^^ - - - - - 0 0 |
}

Fugue_Quintuple:Oboe@|0| {
    <8*>
    {ff}
    /* 【同時主題 I：《あをば》】穿透力十足的雙簧管吟唱原曲首尾樂句 */
    | 3 - 3 - 2 - - 1 | 2 - - - 4 - 4 - |
    | 1 - - 2 3 - 6 - | 5 - - - - - 0 0 |
    | 1 - - 2 3 - - - | 6 - - 6 5 - - - |
    | 2 - - - - - 5 - | 1 - - - - - 0 0 |
}

Fugue_Quintuple:Violin@|0| {
    <8*>
    {ff}
    /* 【同時主題 III：《村のかじや》】小提琴拉奏打鐵八分／十六分音符主旋律 */
    | 3^ 5^ 5^ 5^ 1^ 3^ 3^ 3^ | 2^ 5 6 5 1^ (1^ 2^)%(-) 4^ 0 |
    | 3^ 5^ 5^ 5^ 1^ 3^ 3^ 3^ | 2^ - 5^ 2^ 3^ (2^ 3^)%(-) 1^ 0 |
    | 3^ 5^ 5^ 5^ 1^ 3^ 3^ 3^ | 6^ 4^ 2^ 4^ 5^ (5^ 6^)%(-) 1^ 0 |
    | 2^ 5^ 5^ 5^ 2^ 4^ 5^ 2^ | 3^ (2^ 3^)%(-) 5^ 3^ 1^ - 0 0 |
}

Fugue_Quintuple:Clarinet@|0| {
    <16*>
    {ff}
    /* 【同時主題 II：《だいしゃ》】單簧管吹奏台車十六分音符推進旋律 */
    | 5_ - - - 5_ - - - 1 - 1 - 1 - 0 - | 3 - - 3 3 - - 1 2 - 2 - 2 - 0 - |
    | 5 - - - 6 - 6 - 3 - 3 - 2 - 1 - | 2 - 2 - 5_ - 5_ - 1 - 1 - 1 - 0 - |
    | 6_ - - - 1 - 1 - 5 - - 5 3 - 3 - | 6 - - 6 4 - - 4 1 - 3 - 5 - 0 - |
    | 5 - - - 2 - 2 - 7 - - 7 5 - 5 - | 1^ - 5 - 3 - 5 - 1 - - - - - 0 - |
}

Fugue_Quintuple:Cello@|0| {
    <8*>
    {ff}
    /* 【同時主題 IV：《牛車》】大提琴拉奏《牛車》附點低音旋律，穩固五聲部對位基石 */
    | 1_ - - 1_ 1_ - 2_ - | 3_ - - 2_ 4__ - 4__ - |
    | 5_ - - 6_ 5_ - 3_ - | 2_ - 5__ - 1_ - 5__ 0 |
    | 6__ - - 5__ 1_ - 3_ - | 4_ - - 2_ 1_ - 6__ - |
    | 5__ - - 5__ 5__ - 5__ - | 1_ - 5__ - 1_ - 0 0 |
}

Fugue_Quintuple:Piano@|0| {
    <8*>
    {ff}
    /* 鋼琴巴洛克式滿弓對位與低音八度支撐 */
    | 1_ 5_ 1 3 1_ 5_ 1 3 | 3_ 5_ 1 3 4__ 1_ 4_ 6_ |
    | 1_ 5_ 1 3 6__ 3_ 6_ 1 | 2_ 6_ 5__ 2_ 1_ 5_ 1 0 |
    | 6__ 3_ 6_ 1 1_ 5_ 1 3 | 4_ 6_ 1 4 1_ 5_ 6__ 3_ |
    | 5__ 2_ 5_ 7_ 5__ 2_ 5_ 7_ | 1_ 5_ 1 3 1^ - 0 0 |
}

Fugue_Quintuple:CHORD@|0| {
    <2*>
    | [1] [1] | [1] [4] |
    | [1] [6m] | [2m] [1] |
    | [6m] [1] | [4] [1] |
    | [5] [5] | [1] - |
}

/* -------------------------------------------------------------------------
   4. 大賦格終止華彩 (Fugue_Grand_Coda, 4 小節, != 102, {ff})
   巴洛克式莊嚴終止（I -> IV -> ii7 -> V7 -> I），六重奏輝煌齊鳴落幕！
   ------------------------------------------------------------------------- */

Fugue_Grand_Coda:Flute@|0| {
