    | 6 - 6 - 3 - - 3 | 4 - - 4 3 - 1 - |
    | 2 4 4 4 6_ 2 2 2 | 7_ 2 5 2 7_ - 0 0 |
    /* 小節 5-8：屬音踏瓣上吹奏《あをば》與《牛車》緊接動機 */
    {ff}
    | 3 - 3 - 1 - - 2 | 2 - 5 - 4 - 2 - |
    | 5 - 5 - 2 5 5 5 | 5 - 2 - 5 0 5 0 |
}

Fugue_Stretto:Clarinet@|0| {
    <8*>
    {f}
    /* 小節 1-4：單簧管以《村のかじや》與《だいしゃ》節奏緊接穿插 */
    | 0 0 1 1 7_ 7_ 1 7_ | 6_ 1 2 1 6_ - 0 0 |
    | 4 4 0 0 2 2 2 0 | 7_ 7_ 2 7_ 5_ - 0 0 |
    /* 小節 5-8：屬音踏瓣上吹奏《だいしゃ》「5_ 5_ 1 1 1 0」緊接呼應 */
    {ff}
    | 5_ - 5_ - 1 1 1 0 | 7_ - 7_ - 2 2 2 0 |
    | 7_ - 2 - 7_ 2 2 2 | 7_ - 7_ - 7_ 0 2 0 |
}

Fugue_Stretto:Violin@|0| {
