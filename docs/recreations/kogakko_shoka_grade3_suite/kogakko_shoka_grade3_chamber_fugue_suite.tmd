Fugue_Grand_Coda:Violin@|0| {
    <16*>
    {ff}
    /* 小提琴華麗巴洛克十六分音符琶音衝向最高音 */
    | 1 3 5 1^ 7_ 2 5 7 6_ 1 4 6 5_ 1 3 5 | 2 4 6 2^ 7_ 2 5 7 1 3 5 1^ 3 5 1^ 3^ |
    <8*>
    | 2^ - 7 - 5 - 7 - | 1^ - 5 - 1^ - 0 0 |
}

Fugue_Grand_Coda:Cello@|0| {
