Fugue_Grand_Coda:Piano@|0| {
    <16*>
    {ff}
    | 1_ 5_ 1 3 5__ 2_ 5_ 7_ 4__ 1_ 4_ 6_ 1_ 5_ 1 3 | 2__ 6__ 2_ 4_ 5__ 2_ 5_ 7_ 1_ 5_ 1 3 6__ 3_ 6_ 1 |
    <8*>
    | 5__ 2_ 5_ 7_ 2 5 7 2^ | 1_ 5_ 1 3 1^ - 0 0 |
}

Fugue_Grand_Coda:CHORD@|0| {
    <2*>
    | [1] [4] | [2m] [1] |
    | [5] [5] | [1] - |
