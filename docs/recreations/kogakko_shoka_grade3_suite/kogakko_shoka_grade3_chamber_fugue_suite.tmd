    | 5 7 7 7 5 7 7 7 | 5 2 7_ 2 5 0 5^ 0 |
}

Fugue_Stretto:Cello@|0| {
    <8*>
    {f}
    /* 小節 1-4：大提琴以《牛車》附點動機在小調上推進：Bm -> F#m -> G -> A -> Dm -> G -> G -> G */
    | 6__ - - 6__ 3__ - 3__ - | 4__ - - 4__ 6__ - 6__ - |
    | 2_ - - 2_ 4__ - 4__ - | 5__ - - 5__ 5__ - 5__ - |
    /* 小節 5-8：氣勢磅礴的 4 小節屬音持續音踏瓣 (Dominant Pedal on A = 5__)！ */
    {ff}
    | 5__ 5__ 5_ 5__ 5__ 5__ 5_ 5__ | 5__ 5__ 5_ 5__ 5__ 5__ 5_ 5__ |
    | 5__ 5__ 5_ 5__ 5__ 5__ 5_ 5__ | 5__ 5_ 2_ 5__ 5__ 0 5_ 0 |
}

Fugue_Stretto:Piano@|0| {
    <8*>
    {f}
    | 6__ 3_ 6_ 1 3__ 7__ 3_ 5_ | 4__ 1_ 4_ 6_ 6__ 3_ 6_ 1 |
    | 2_ 6_ 1 4 4__ 1_ 4_ 6_ | 5__ 2_ 5_ 7_ 5__ 2_ 5_ 7_ |
    {ff}
    /* 鋼琴左手與大提琴共鳴屬音踏瓣，右手疊加和聲 */
    | 5__ 5_ 1 3 5__ 5_ 1 3 | 5__ 5_ 2 5 5__ 5_ 2 4 |
    | 5__ 5_ 2 5 5__ 5_ 2 5 | 5__ 5_ 2 5 5 0 5_ 0 |
}

