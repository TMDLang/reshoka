    /* 二: こ ゑ は た か らか | う み の う へ | ひ ろ い い づ も の | く に   が で き */
    | 1 - - 2 3 - 2 - | 3 5 6 5 3 - 0 - | 1^ - - 1^ 6 - 6 - | 5 - - - - - 0 - |

    /* 一: こ い こ い く に よ | こ い く に よ | 来 い 来 い 國 よ   | 来 い   國 よ   */
    /* 二: さ か え る み よ と | な り ま し た | 榮 え る み 世 と   | な り ま し た   */
