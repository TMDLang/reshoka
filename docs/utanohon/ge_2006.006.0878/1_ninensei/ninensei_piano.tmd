    /* 二: コ   ト   リ ガ | モ   リ デ   | ウ   タ ッ テ | ル         */
    | 1 - - 1 5_ - 5_ - | 3 - - 3 1 - - - | 2 - - 2 2 - 3 - | 2 - - - 0 - - - |

    /* 一: ワ   タ ク シ | タ     チ ハ | ニ   ネ ン セ | イ         */
    /* 二: ワ   タ ク シ | タ     チ ハ | ニ   ネ ン セ | イ         */
    | 3 - - 3 1 - 3 - | 5 - - - 6 - 5 - | 3 - - 3 2 - 3 - | 5 - - - 0 - - - |

    /* 一: ウ   レ シ イ | ウ   レ シ イ | ニ   ネ ン セ | イ         */
    /* 二: ウ   レ シ イ | ウ   レ シ イ | ニ   ネ ン セ | イ         */
    | 6 - - 6 5 - 3 - | 1 - - 2 3 - 5 - | 3 - - 3 2 - 2 - | 1 - - - 0 - - - |
