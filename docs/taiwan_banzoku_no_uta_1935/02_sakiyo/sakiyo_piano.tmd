** サキヨ（伴奏版） **
!= 63
?= G
key= Em
<3/4>
~ "出處：竹中重雄《台灣蕃族の歌》（第一集・ツウオ族／阿里山鄒族，昭和十年／1935年9月發行，大阪不倒樂社）第二曲（第3–4頁）"
~ "採譜・編曲：竹中重雄（實地採集・記譜・原書鋼琴伴奏編曲）"
~ "國立臺灣圖書館典藏號 jpli2011-bk-sxt_0786_13_1935（索書號 0786-13，登錄號 31111004748560）掃描 P003.png, P004.png"

/* =========================================================================
   竹中重雄原書鋼琴伴奏忠實轉錄版（掃描 P003.png）
   - Main:Piano 為歌聲主旋律（純現代發音平假名，供 NEUTRINO 合成使用）
   - Main:Piano_RH 與歌聲齊奏，Main:Piano_LH 忠實還原原書對位低音與ホ短調和聲
   ========================================================================= */

Main:Piano@|0|{
    <16*>
    /* m.1 */
    | {mp} 1 - 1 -  6_ - 2 -  - - - - |
    L| さ - き -  よ - - -  - - - - |
    /* m.2 */
    | 1 - 1 -  1 7_ 6_ -  - - - - |
    L| か - ら -  ろ お お -  - - - - |
    /* m.3 */
    | - - - -  - - - -  - - {p} 1 - |
    L| - - - -  - - - -  - - お - |
    /* m.4 */
    | 6_ - 6_ -  1 - 1 -  - - 6_ - |
    L| う - み -  た - か -  - - あ - |
    /* m.5 */
    | 1 - 1 -  6_ - - -  - - - - |
    L| く - あ -  な - - -  - - - - |
    /* m.6 */
    | - - - -  - - - -  0 - - - |
    L| - - - -  - - - -  0 - - - |
}

Main:Piano_RH@|0|{
    <16*>
    /* m.1 */
    | {mp} 1 - 1 -  6_ - 2 -  - - - - |
    /* m.2 (dolce) */
    | 1 - 1 -  1 7_ 6_ -  - - - - |
    /* m.3 */
    | - - - -  - - - -  - - {p} 1 - |
    /* m.4 */
    | 6_ - 6_ -  1 - 1 -  - - 6_ - |
    /* m.5 (poco rit) */
    | 1 - 1 -  6_ - - -  - - - - |
    /* m.6 (fermata) */
    | - - - -  - - - -  0 - - - |
}

Main:Piano_LH@|0|{
    <16*>
    /* m.1: A3 8, A3 8, G#3 8 (tied), E3+G#3 dotted q (fermata) */
    | {mp} 2_ - 2_ -  1'_ - 6__+1'_ -  - - - - |
    /* m.2: A3 8, A3 8, A3 16, A#3 16, B3 8 (tied to quarter) */
    | 2_ - 2_ -  2_ 2'_ 3_ -  - - - - |
    /* m.3: (B3 A3 G3) 16th triplet + G3 8, A3 8, G3 8, G3 q (fermata) */
    | (3_ 2_ 1_)%(--) 1_ -  2_ - 1_ -  1_ - - - |
    /* m.4: Em triad dotted half (p, tied to m.5) */
    | {p} 6__+1_+3_ - - -  - - - -  - - - - |
    /* m.5: Em triad tied q + q (poco rit), then (B2 A2 G2) 8th triplet (pp) */
    | - - - -  - - - -  {pp} (3__ 2__ 1__)%(----) |
    /* m.6: E2 half (fermata) + quarter rest */
    | 6___ - - -  - - - -  0 - - - |
}

-> Main ->#
