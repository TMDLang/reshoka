** パタラン（伴奏版） **
!= 69
?= A
key= F#m
<4/4>
~ "出處：竹中重雄《台灣蕃族の歌》（第一集・ツウオ族／阿里山鄒族，昭和十年／1935年9月發行，大阪不倒樂社）第一曲（第1–2頁）"
~ "採譜・編曲：竹中重雄（實地採集・記譜・原書鋼琴伴奏編曲）"
~ "國立臺灣圖書館典藏號 jpli2011-bk-sxt_0786_13_1935（索書號 0786-13，登錄號 31111004748560）掃描 P001.png, P002.png"

/* =========================================================================
   竹中重雄原書鋼琴伴奏忠實轉錄版（掃描 P001.png）
   - Main:Piano 為歌聲主旋律（純現代發音平假名，供 NEUTRINO 合成使用）
   - Main:Piano_RH / Main:Piano_LH 忠實還原原書大譜表鋼琴伴奏（2 小節反覆音型 × 3）
   ========================================================================= */

Main:Piano@|0|{
    <16*>
    /* m.1–m.2: 2-bar piano intro */
    | 0 - - -  - - - -  - - - -  - - - - |
    | 0 - - -  - - - -  - - - -  - - - - |
    /* m.3 */
    | {mf} 6_ - - -  3 - 2 -  3 - - -  2 1 6_ - |
    L| た - - -  ぐ - う -  が - - -  て え え - |
    /* m.4 */
    | 1 - 6_ -  6_ - - -  6_ - - -  1 - 6_ - |
    L| ぱ - た -  らん - - -  た - - -  ま - え - |
    /* m.5 */
    | 6_ - - -  6_ - - -  1 - 6_ -  2 - 2 - |
    L| ちぇ - - -  ちぇ - - -  ま - え -  か - な - |
    /* m.6 */
    | 6_ - - -  6_ - - -  3_ - - -  0 - - - |
    L| な - - -  お - - -  ま - - -  0 - - - |
}

Main:Piano_RH@|0|{
    <16*>
    /* m.1 (Sempre mp) */
    | {mp} 0 1_ 2_ 3_  5_ - 6_ -  6_+1 - - -  5_+2 1 6_ - |
    /* m.2 (beat 4: 8va F#6 8th + 8th rest with fermata) */
    | 0 1 2 3  5 - 6 -  6 - - -  6^ - 0 - |
    /* m.3 */
    | 0 1_ 2_ 3_  5_ - 6_ -  6_+1 - - -  5_+2 1 6_ - |
    /* m.4 (beat 4: 8va F#6 quarter) */
    | 0 1 2 3  5 - 6 -  6 - - -  6^ - - - |
    /* m.5 */
    | 0 1_ 2_ 3_  5_ - 6_ -  6_+1 - - -  5_+2 1 6_ - |
    /* m.6 (beat 3: 8va F#6 staccato quarter, beat 4: quarter rest) */
    | 0 1 2 3  5 - 6 -  6^ - - -  0 - - - |
}

Main:Piano_LH@|0|{
    <16*>
    /* m.1 */
    | {mp} 6___+6__ - - -  3__+6__ - 3__+6__ -  6___+6__ - - -  3__+6__ - 3__+6__ - |
    /* m.2 (beat 3–4.0: dotted quarter F#2+F#3, beat 4.5: 8th rest with fermata) */
    | 6___+6__ - - -  3__+6__ - 3__+6__ -  6___+6__ - - -  - - 0 - |
    /* m.3 */
    | 6___+6__ - - -  3__+6__ - 3__+6__ -  6___+6__ - - -  3__+6__ - 3__+6__ - |
    /* m.4 */
    | 6___+6__ - - -  3__+6__ - 3__+6__ -  6___+6__ - - -  3__+6__ - 3__+6__ - |
    /* m.5 */
    | 6___+6__ - - -  3__+6__ - 3__+6__ -  6___+6__ - - -  3__+6__ - 3__+6__ - |
    /* m.6 */
    | 6___+6__ - - -  3__+6__ - 3__+6__ -  6___+6__ - - -  0 - - - |
}

