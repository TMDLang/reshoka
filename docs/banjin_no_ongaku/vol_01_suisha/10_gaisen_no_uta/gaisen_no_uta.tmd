** 凱旋ノ歌 **
!= 120
?= B,
<3/4>
~ "出處：臺灣教育會《蕃人ノ音樂 第一集・水社化蕃ノ歌》（大正十一年／1922年12月）第十曲（第10頁）"
~ "採譜：臺北師範學校教諭 張福興 實地採譜"
~ "國立臺灣圖書館典藏號 jpli2007-bk-sxt_0786_1_1922（索書號 0786 1）掃描 P010.png"

/* =========================================================================
   原書資訊與曲目說明（國臺圖 0786 1《水社化蕃ノ歌》第十曲，掃描 P010.png）：
   標題：凱旋ノ歌
   調性與拍號：變ロ調（B♭ 大調），第一行引子為 3/4 拍，第二至三行本曲轉為 2/4 拍（含三連音 Triplet）
   速度標記：愉快ニ速ク（Vivace / Allegro, 120 BPM）
   採譜：張福興
   歌意：（歌意）澤山ノ首 車一パイ 笊一パイ 出迎ヘヨ出迎ヘヨ
   說明：原書歌詞為水社化蕃邵語片假名音譯，附有發音添字（カ/パ下有イ、シ下有ヤ/キ、ウ/レ/ピ下有ン等）。
   ========================================================================= */

Main:Piano@|0|{
    <32*>
    /* ===== 第一行（P010.png） ===== */
    /* m.1 (3/4) サ ス パ ー レ オ ホ */
    | 5_ 5_ 7_ - - - - - - - - - 1 - 7_ - 5_ - - - - - - - |
    L| サ ス パ - - - - - - - - - レ - オ - ホ - - - - - - - |

    /* m.2 (3/4) サ ス パ ー レ オ ホ */
    | 1 5_ 7_ - - - - - - - - - 1 - 7_ - 5_ - - - - - - - ||
    L| サ ス パ - - - - - - - - - レ - オ - ホ - - - - - - - |

    /* ===== 第二行（P010.png） ===== */
    /* m.3 (2/4) ホ マ カ(イ) ヤ */
    {<2/4>}
    <12*>
    | 5_ 6_ 5_ 3_ - - |
    L| ホ マ カイ ヤ - - |

    /* m.4 (2/4) ホ マ カ(イ) シ(ヤ) */
    | 5_ 6_ 5_ 5_ - - |
    L| ホ マ カイ シヤ - - |

    /* m.5 (2/4) ウ(ン) シ(キ) ウ(ン) */
    | 7_ 7_ 5_ 0 - - |
    L| ウン シキ ウン _ - - |

    /* ===== 第三行（P010.png） ===== */
    /* m.6 (2/4) カ タ パ(イ) ヤ */
    | 5_ 6_ 5_ 3_ - - |
    L| カ タ パイ ヤ - - |

    /* m.7 (2/4) カ タ パ(イ) ヤ */
    | 5_ 6_ 5_ 3_ - - |
    L| カ タ パイ ヤ - - |

    /* m.8 (2/4) マ レ(ン) ピ(ン) */
    | 7_ 7_ 5_ 0 - - ||
    L| マ レン ピン _ - - |
}

-> Main ->#
