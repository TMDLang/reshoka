** 來遊ヲ誘フ歌 **
!= 88
?= C
<4/4>
~ "出處：臺灣教育會《蕃人ノ音樂 第一集・水社化蕃ノ歌》（大正十一年／1922年12月）第二曲（第2頁）"
~ "採譜：臺北師範學校教諭 張福興 實地採譜"
~ "國立臺灣圖書館典藏號 jpli2007-bk-sxt_0786_1_1922（索書號 0786 1）掃描 P002.png"

/* =========================================================================
   原書資訊與曲目說明（國臺圖 0786 1《水社化蕃ノ歌》第二曲，掃描 P002.png）：
   標題：來遊ヲ誘フ歌
   速度：愉快＝（徐々ノ速度）
   調性與拍號：ハ調（C 大調 / 傳統五聲音階）、四分之四拍（4/4）
   採譜：張福興（臺北師範學校教諭，大正十年至十一年間實地採集記譜）
   出版：臺灣教育會（大正十一年十二月廿五日發行）

   【原書說明】
   （歌意）「皆サン船ヲ漕イデ遊ビニイラッシャイ」
   （標題附註：●印ヲ附セルハ水社ニ残存セルモノナレドモ其他ハ卜吉並ニ頭社ニ存スルモノナリ）

   【原譜結構】
   原譜包含兩段唱法記錄：
   - 第一種唱法（前 3 行，m.1–m.8）：主唱形式
   - 第二種唱法（「（或ハ）」後 3 行，m.9–m.16）：異文變體形式
   ========================================================================= */

Main:Piano@|0|{
    <16*>
    /* === 本曲（第一種唱法） === */
    /* m.1 */
    | 1 - - - - - - - 5 - - 3 3 - 3 - |
    L| イ - - - - - - - ウ - - ク ラ - シ - |

    /* m.2 */
    | 2 - - - 1 - 6_ - 6_ - - - - - - - |
    L| パ - - - ロ - ー - ラ - - - - - - - |

    /* m.3 */
    | 1 - - - - - - - 5 - - 3 3 - 3 - |
    L| イ - - - - - - - ウ - - ク ラ - シ - |

    /* m.4 */
    | 2 - - - 1 - 6_ - 6_ - - - - - - - |
    L| パ - - - ロ - ー - ラ - - - - - - - |

    /* m.5 */
    | 3 - 5 - 3 - 2 - 3 - 5 - 1 - - - |
    L| カイ - ナイ - ナ - イ - ナ - ラ - ニ - - - |

    /* m.6 */
    | - - - - 5 - 3 - 2 - 5 - - - 3 - |
    L| - - - - オ - キ - イ - サ - - - マ - |

    /* m.7 */
    | 2 - 3 - 5 - 1 - 6_ - 2 - 3 - 3 - |
    L| リ - タ - パ - ト - オ - ク - サ - ニ - |

    /* m.8 */
    | 2 1 6_ - - - 3 - 6_ - 6_ - - - - - ||
    L| ト ア ア - - - ア - ナ - ニ - - - - - |

    /* === 變體（或ハ 第二種唱法） === */
    /* m.9 */
    | 1 - - - - - - - 2 - - 3 3 - 3 - |
    L| イ - - - - - - - ウ - - ク ラ - シ - |

    /* m.10 */
    | 2 - - - 1 - 6_ - 6_ - - - - - - - |
    L| パ - - - ロ - ー - ラ - - - - - - - |

    /* m.11 */
    | 1 - - - - - - - 2 - - 3 3 - 3 - |
    L| イ - - - - - - - ウ - - ク ラ - シ - |

    /* m.12 */
    | 2 - - - 1 - 6_ - 6_ - - - - - - - |
    L| パ - - - ロ - ー - ラ - - - - - - - |

    /* m.13 */
    | 5 - 5 - 3 - 2 - 5 - 5 - 1 - - - |
    L| カイ - ナイ - ナ - イ - ナ - ラ - ニ - - - |

    /* m.14 */
    | - - - - 5 - 3 - 2 - 5 - - - 3 - |
    L| - - - - オ - キ - イ - サ - - - マ - |

    /* m.15 */
    | 2 - 5 - 5 - 1 - 6_ - 2 - 3 - 3 - |
    L| リ - タ - パ - ト - オ - ク - サ - ニ - |

    /* m.16 */
    | 2 1 6_ - - - 3 - 6_ - 6_ - - - - - ||
    L| ト ア ア - - - ア - ナ - ニ - - - - - |
}

