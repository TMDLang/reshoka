** 船漕ギノ歌 **
!= 80
?= D
<4/4>
~ "出處：臺灣教育會《蕃人ノ音樂 第一集・水社化蕃ノ歌》（大正十一年／1922年12月）第三曲（第3頁）"
~ "採譜：臺北師範學校教諭 張福興 實地採譜"
~ "國立臺灣圖書館典藏號 jpli2007-bk-sxt_0786_1_1922（索書號 0786 1）掃描 P003.png"

/* =========================================================================
   原書資訊與曲目說明（國臺圖 0786 1《水社化蕃ノ歌》第三曲，掃描 P003.png）：
   標題：船漕ギノ歌（對話唱歌）
   調性與拍號：ニ長調（D 大調，二升記號 F#, C#），四分ノ四拍子（4/4 拍）
   採譜：張福興
   歌意：（歌意）浪風ハ靜カダ皆コノ間ニ船ノ上ニ出テ身ヲ乾カセ
   說明：原書為甲、乙對話唱歌，全曲 4 小節（每行 2 小節）。
         歌詞為水社化蕃邵語音譯片假名，部分字下附發音添字（ト下有ウ、カ下有ン、テ下有イ）。
         第 1 小節末拍 D4（ス）與第 2 小節首拍附點八分音符 D4（ー）以連結線相連。
   ========================================================================= */

Main:Piano@|0|{
    <48*>
    /* ===== 第一行（P003.png） ===== */
    /* m.1 [甲] */
    | 3 - - - - - - - - - - - - - - - - - 2 - - - - - 3 - - - - - 2 - - - - - 1 - - - - - - - - - - - |
    L| カ - - - - - - - - - - - - - - - - - ル - - - - - ピ - - - - - ー - - - - - ス - - - - - - - - - - - |

    /* m.2 [甲→乙] (首拍 D4 承接 m.1 連結線，換氣記號 V 後由乙接唱) */
    | - - - - - - - - - 2 - - 3 - - - - - - - - 2 - - 3 - - - - - 3 - - 3 - - 1 - - - - - - - - - - - |
    L| - - - - - - - - - マ - - トウ - - - - - - - - ス - - カン - - - - - カン - - カン - - ニ - - - - - - - - - - - |

    /* ===== 第二行（P003.png） ===== */
    /* m.3 [甲→乙] (第 4 拍後半換氣記號 V 後由乙接唱) */
    | 3 - - - - - - - - - - - - - - - - - 2 - - 2 - - 3 - - - - - - - - - - - - - - - - - 2 - - - - - |
    L| マ - - - - - - - - - - - - - - - - - トウ - - ス - - カン - - - - - - - - - - - - - - - - - パ - - - - - |

    /* m.4 [乙] (第 2 拍為八分音符三連音) */
    | 3 - - - - - - - - 2 - - 3 - - - 2 - - - 1 - - - 5_ - - - - - - - - - - - - - - - - - - - - - - - ||
    L| ワ - - - - - - - - リ - - テイ - - - ー - - - ヲ - - - ス - - - - - - - - - - - - - - - - - - - - - - - |
}

