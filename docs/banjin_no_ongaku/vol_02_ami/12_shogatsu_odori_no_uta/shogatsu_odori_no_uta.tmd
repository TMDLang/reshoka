    | 1 - 1 - 1 - 1 - | 6 - - - - - 6 - | 6 - - - 1^ - 7 - | 6 - - - - - 6 - | 6 - - - 1^ - - - | 3^ - - - (3^ 2^ 1^)%(----) |
    L| ア - イ - ヤ - イ - | ア - - - - - ア - | ア - - - ハ - イ - | ヤ - - - - - イ - | イ - - - ヤ - - - | ハ - - - (ハ ハ ハ) |

    /* ================= 齊唱：第六行 (6 小節, P012.jpg) ================= */
