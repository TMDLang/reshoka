    | 6 - - - 6 - - - | 6 - - - - - - - | 6 - - - 3^ - 2^ - | 3^ - - - (3^ 2^ 1^)%(----) | 6 - - - - - 6 - | 6 - - - - - - - |
    L| オ - - - イ - - - | ヨ - - - - - - - | エ - - - ハ - イ - | ヤ - - - (イ ヤ ハ) | オ - - - - - イ - | ヤ - - - - - - - |

    /* ================= 齊唱：第四行 (6 小節, P012.jpg) ================= */
