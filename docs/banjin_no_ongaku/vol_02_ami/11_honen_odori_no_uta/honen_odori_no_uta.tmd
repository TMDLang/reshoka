    | 1 - 2 - 3 - 2 - | 1 - 2 - 1 - - - | 3 - 1 - 7_ - 7_ - | 7_ - - - 6_ - 6_ - |
    L| ヘ - ー - ヤ - ー - | イ - ヨ - ホ - - - | エ - ー - ホ - イ - | ヤ - - - ハ - イ - |

    /* ================= 第二行 (4 小節, P011.jpg) ================= */
