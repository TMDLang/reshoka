** 老蕃粟刈祝の歌（紅座社） **
!= 80
?= B,
<2/4>
~ "出處：《蕃人ノ音樂》 第二集・アミ族蕃謠歌曲（大正14年／1925）第八首"
~ "採譜：一條愼三郎（臺北師範學校教諭）／出版：臺灣教育會"
~ "國立臺灣圖書館 索書號 0786 6 掃描頁 P008.jpg"

/* =========================================================================
   原書資訊與註解（國臺圖 0786 6《蕃人ノ音樂 第二集・アミ族蕃謠歌曲》第八首，掃描 P008.jpg）：
   曲名：老蕃粟刈祝の歌（紅座社）
   調性與拍號：降乙調（B♭ 大調）／變格移拍 2/4、3/4 與 4/4 拍子
   音樂形式：長老領唱（音頭／獨唱）與族人應和（齊唱）之二部應答與重疊合唱（Antiphony / Two-part chorus）

   原書頁底註記：
   「老蕃美聲ナル者音頭ヲナシ獨唱ノ部ヲ歌フ
     歌詞ナク上記ノ發音ノミヲ用フ」

   【中譯解說】
   阿美族紅座社部落之年老原住民中歌聲優美者擔任領唱（音頭），專責演唱「獨唱」聲部（Piano1），
   其餘族人則以「齊唱」應和（Piano2）。在 System 2 與末段 System 6–8，齊唱更與獨唱重疊發聲，
   形成壯麗的二部合唱。全曲無實質文義之歌詞，純粹以假名記錄之虛詞／襯字音節吟唱。
   ========================================================================= */

RobanAwakari:Piano1@|0|{
    <16*>
    /* ================= 第一段：音頭 (System 1–2, 降乙調 B♭, 2/4 拍) ================= */
    /* 【音頭】 m.1 | m.2 | m.3 */
    /* エ ヘ エ | ホ エ | ヨ オ ホ アィ */
    | 3 - - - 2 - 1 - | 3 - - - - - 2 - | 1 - 1 - 3 - 3 - |
    L| エ - - - ヘ - エ - | ホ - - - - - エ - | ヨ - オ - ホ - アィ - |

    /* 【音頭】 m.4 | m.5 | m.6 | m.7 */
    /* オ ホ オ | ー オ ホ | ハ ハ | ー イ */
    | 1 - - - 6_ - 1 - | 1 - 6_ - 6_ - - - | 6_ - - - 6_ - - - | 6_ - - - - - 6_ - |
    L| オ - - - ホ - オ - | ー - オ - ホ - - - | ハ - - - ハ - - - | ー - - - - - イ - |

    /* ================= 第二段：音頭獨唱與齊唱重疊 (System 2, 3/4 拍) ================= */
    /* 【音頭】 m.8 | m.9 | m.10 */
    /* オ ホ ア ア | オ ホ イ | ―― */
    {<3/4>}
    | 3 - - - - - 2 - 1 - 2 - | 3 - - - 2 - - - 1 - - - | 1 - - - - - - - - - - - |
    L| オ - - - - - ホ - ア - ア - | オ - - - ホ - - - イ - - - | ー - - - - - - - - - - - |

    /* ================= 第三段：獨唱與齊唱應答 (System 3, 2/4 拍 -> 3/4 拍) ================= */
    /* 【獨唱】 m.11 | m.12 | m.13 */
    /* エ ヘ エ | ホ エ | ヨ オ ホ アィ */
    {<2/4>}
    | 3 - - - 2 - 1 - | 3 - - - - - 2 - | 1 - 1 - 3 - 3 - |
    L| エ - - - ヘ - エ - | ホ - - - - - エ - | ヨ - オ - ホ - アィ - |

    /* 【獨唱休止／齊唱應和】 m.14 | m.15 */
    {<3/4>}
    | 0 - - - - - - - - - - - | 0 - - - - - - - - - - - |
    L| _ - - - - - - - - - - - | _ - - - - - - - - - - - |

    /* ================= 第四段：獨唱與齊唱應答 (System 4, F 調 2/4 拍) ================= */
    /* 【獨唱】 m.16 | m.17 */
    /* イ ヤ ハ | オ ホ ホ ホィ */
    {?= F}
    {<2/4>}
    | 1 - 2 - 3 - - - | 6 - 5 - 3 - 2 - |
    L| イ - ヤ - ハ - - - | オ - ホ - ホ - ホィ - |

    /* 【獨唱休止／齊唱應和】 m.18 | m.19 */
    | 0 - - - - - - - | 0 - - - - - - - |
    L| _ - - - - - - - | _ - - - - - - - |

    /* ================= 第五段：獨唱與齊唱 (System 5, B♭ 調 4/4 拍) ================= */
    /* 【獨唱】 m.20 */
    /* エ ヘ ヘ ヘ エ */
    {?= B,}
    {<4/4>}
    | 3 - - - - - 2 - 3 - - - 2 - 1 - |
    L| エ - - - - - ヘ - ヘ - - - ヘ - エ - |

    /* 【獨唱休止／f 齊唱應和】 m.21 | m.22 */
    | 0 - - - - - - - - - - - - - - - | 0 - - - - - - - - - - - - - - - |
    L| _ - - - - - - - - - - - - - - - | _ - - - - - - - - - - - - - - - |

    /* ================= 第六段：獨唱與二部合唱終曲 (System 6–8, F 調 3/4 拍) ================= */
    /* 【獨唱弱起】 m.23 */
    /* エッ */
    {?= F}
    {<3/4>}
    | 0 - - - - - - - 6 - - - |
    L| _ - - - - - - - エッ - - - |

    /* 【獨唱】 m.24 | m.25 */
    /* ヘ ー イ | ウ オ ホ */
    | 6 - - - - - - - 6 - 6 - | 1^ - - - 6 - - - 5 - - - |
    L| ヘ - - - - - - - ー - イ - | ウ - - - オ - - - ホ - - - |

    /* 【獨唱與齊唱二部合唱】 m.26 | m.27 | m.28 */
    /* ホ ー イ | ヘ | ー イ */
    | 6 - - - 5 - - - 6 - - - | 6 - - - - - - - - - - - | 6 - - - 6 - - - 0 - - - |
    L| ホ - - - ー - - - イ - - - | ヘ - - - - - - - - - - - | ー - - - イ - - - _ - - - |
}

RobanAwakari:Piano2@|0|{
    <16*>
    /* ================= 第一段：音頭獨唱時齊唱休止 (m.1–m.7) ================= */
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - |
    L| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - |

    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - |
    L| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - | _ - - - - - - - |

    /* ================= 第二段：齊唱進場與音頭二部合唱 (m.8–m.10) ================= */
    /* 【齊唱】 m.8 (休止) | m.9 | m.10 */
    /* ハー ツ | ヘ ー イ */
    {<3/4>}
    | 0 - - - - - - - - - - - | 0 - - - - - - - 6_ - - 6_ | 6_ - - - 6_ - - - 6_ - - - |
    L| _ - - - - - - - - - - - | _ - - - - - - - ハ - - ツ | ヘ - - - ー - - - イ - - - |

    /* ================= 第三段：齊唱應答 (m.11–m.15) ================= */
    /* 【齊唱休止】 m.11 | m.12 | m.13 */
    {<2/4>}
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - |
    L| _ - - - - - - - | _ - - - - - - - | _ - - - - - - - |

    /* 【齊唱應和】 m.14 | m.15 */
    /* ハ ハー ツ | ハ ー イ */
    {<3/4>}
    | 6_ - - - - - - - 6_ - - 6_ | 6_ - - - - - - - 6_ - 6_ - |
    L| ハ - - - - - - - ハ - - ツ | ハ - - - - - - - ー - イ - |

    /* ================= 第四段：齊唱應答 (m.16–m.19) ================= */
    /* 【齊唱休止】 m.16 | m.17 */
    {?= F}
    {<2/4>}
    | 0 - - - - - - - | 0 - - - - - - - |
    L| _ - - - - - - - | _ - - - - - - - |

    /* 【齊唱應和】 m.18 | m.19 */
    /* オ ハ ヘィ ハッ | ハ ー イ */
    | 2 - 2 - 3 - - 1 | 2 - - - 2 - 2 - |
    L| オ - ハ - ヘ - イ ハッ | ハ - - - ー - イ - |

    /* ================= 第五段：f 齊唱應答 (m.20–m.22) ================= */
    /* 【齊唱休止】 m.20 */
    {?= B,}
    {<4/4>}
    | 0 - - - - - - - - - - - - - - - |
    L| _ - - - - - - - - - - - - - - - |

    /* 【f 齊唱應和】 m.21 | m.22 */
    /* エ ハ ハ ア | ハ ー イ */
    | 6_ - - - 6_ - - - 6_ - - - 5_ - - - | 6_ - - - - - - - 6_ - 6_ - 0 - - - |
    L| エ - - - ハ - - - ハ - - - ア - - - | ハ - - - - - - - ー - イ - _ - - - |

    /* ================= 第六段：二部合唱終曲 (m.23–m.28) ================= */
    /* 【齊唱休止】 m.23 */
    {?= F}
    {<3/4>}
    | 0 - - - - - - - 0 - - - |
    L| _ - - - - - - - _ - - - |

    /* 【齊唱休止】 m.24 | m.25 */
    | 0 - - - - - - - - - - - | 0 - - - - - - - - - - - |
    L| _ - - - - - - - - - - - | _ - - - - - - - - - - - |

    /* 【齊唱與獨唱二部合唱】 m.26 | m.27 | m.28 */
    /* ハー ツ | ヘ | ー イ */
    | 0 - - - - - - - 2 - - 2 | 2 - - - - - - - - - - - | 2 - - - 2 - - - 0 - - - |
    L| _ - - - - - - - ハ - - ツ | ヘ - - - - - - - - - - - | ー - - - イ - - - _ - - - |
}

