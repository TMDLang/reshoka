    /* 5-7: エ ヤ ハ イ ヘ | エ イ ヤ ハ イ | エ エ ヨ イ ヨ イ エ */
    | 3 - - - - - 2 - 1 - 6_ - 6_ - - - | 6_ - 5_ - 3_ - - - 2_ - - - 3_ - - - | 6_ - - - 3_ - 6_ 6_ 6_ - - 6_ 6_ - - - |
    L| エ - - - - - ヤ - ハ - イ - ヘ - - - | エ - イ - ヤ - - - ハ - - - イ - - - | エ - - - エ - ヨ イ ヨ - - イ エ - - - |

