    L1| オ - ホ - オ - オ - | ヤ - ン - ア - - - | ヘ - - - - - - - | ン - - - - - ヒ - |

    /* 9-12 */
    | 5 - - - 6 - 5 - | 6 - 3 2 1 - 1 - | 6 - 5 - 3 - 2 - | 1 - - - - - 1 - |
    L1| ヨ - - - オ - ホ - | ヤ - ハ イ ハ - ン - | エ - ヘ - ヤ - ン - | ヘ - - - - - ン - |
