ChoToHarukaze:Piano@|0| {
    <8*>
    | 5 - 3 - 5 - 3 - | 6 - 1^ - 1^ - 0 - | 1^ - 6 - 6 - 6 - | 1^ - 5 - 5 - 0 - |
    | 5 - 3 - 5 - 3 - | 6 - 1^ - 1^ - 0 - | 1^ - 6 - 5 - 4 - | 3 - 2 - 1 - 0 - |
    | 2 - 3 - 4 - 2 - | 3 - 4 - 5 - 0 - | 2 - 3 - 4 - 2 - | 3 - 4 - 5 - 0 - |
