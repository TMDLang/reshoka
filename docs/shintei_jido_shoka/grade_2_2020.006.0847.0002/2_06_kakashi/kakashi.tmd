** かかし **
!= 112
?= F
<4/4>
~ "文部省"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第二學年用（2020.006.0847.0002）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P035.jpg，書頁 p. 20，第二學期第 6 首）：
   調性與拍號：ヘ調四拍子（F 大調 4/4 拍），「ゲンキヨク（♩＝112）」

   一
   山田のなかの　一ぽんあしの　かかし
   てんきがよいのに　みの笠着けて
   あさからばんまで　ただたちどほし
   あされないか　はなせないか
   山田のなかの　一ぽんあしの　かかし

   二
   山田のなかの　一ぽんあしの　かかし
   ゆみやでをどして　田を荒すなと
   よるからあさまで　ただたちどほし
   ねむくはないか　さびしくないか
   山田のなかの　一ぽんあしの　かかし
   ========================================================================= */

Kakashi:Piano@|0| {
    <16*>
    | 1 - - - - - 2 - 3 - - - 3 - - - | 2 - - - - - 1 - 2 - - - 3 - - - |
    | 5 - - 5 6 - 5 - 3 - - - 5 - - - | 1 - - - 2 - - - 3 - - - 0 - - - |
    | 1 - - - - - 2 - 3 - - - 3 - - - | 2 - - - - - 1 - 2 - - - 3 - - - |
    | 5_ - - - - - 1 - 3 - - - 5 - - - | 2 - - - 3 - - - 1 - - - 0 - - - |
    | 6 - - - - - 6 - 5 - - - 5 - - - | 1 - - - - - 2 - 3 - - - 3 - - - |
    | 5 - - 5 5 - 6 - 5 - - - 3 - - - | 2 - - - - - - - - - - - 0 - - - |
    | 5 - - - 6 - - - 5 - - - 5 - - - | 5 - - - - - 3 - 1 - - - 1 - - - |
    | 2 - - 2 3 - 4 - 5 - - - 5_ - - - | 1 - - - - - - - - - - - 0 - - - |
}

