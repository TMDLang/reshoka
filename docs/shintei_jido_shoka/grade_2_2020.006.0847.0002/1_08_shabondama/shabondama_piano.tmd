::SCORE::
** シヤボンダマ（鋼琴伴奏版） **
!= 108
?= C
<2/4>
~ "詞：濱岡泰夫"
~ "曲：井上武士"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第二學年用（2020.006.0847.0002）"

Shabondama:PianoRH@|0| {
    <16*>
    /* ================= 第一行 (4 小節, P026.jpg，含前奏 2 小節) ================= */
    | 0 - 3^ - 0 - 3^ - | 0 - 3^ - 3^ - 0 - | {p} 5 - 5 - 5 - 6 - | 5 - 5 - 5 - 0 - |

    /* ================= 第二行 (4 小節, P026.jpg) ================= */
    | {mp} 6 - - 6 5 - 3 - | 1 - 2 - 3 - 0 - | {mf} 1^ - - 1^ 6 - 5 - | 1^ - 1^ - 2^ - 0 - |

    /* ================= 第三行 (4 小節, P026.jpg) ================= */
    | {mf} 1^ - 3^ 2^ 1^ - 6 - | 5 - 5 - 1^ - 0 - | {p} 6 - 1^ 6 5 - 3 - | 5 - 3 2 1 - 0 - |
}

Shabondama:PianoLH@|0| {
    <4*>
    /* 輕盈泡泡飄浮左手伴奏 */
    | 1_ [1] | 1_ 0 | {p} 1_ [1] | 1_ 0 |
    | {mp} 4_ [4] | 1_ 0 | {mf} 4_ [4] | 1_ [5_] |
    | {mf} 1_ [4] | 1_ 0 | {p} 4_ [1] | 5__ [1] |
}

