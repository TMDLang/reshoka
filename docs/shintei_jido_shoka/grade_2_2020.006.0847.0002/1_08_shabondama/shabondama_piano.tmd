    L1| オホ - キ イ ノ - ハ - | サ - キ - ニ - _ - | チイ - サ イ ノ - ハ - | ア - ト - ニ - _ - |
    L2| オホ - キ イ ノ - ハ - | サ - キ - ニ - _ - | チイ - サ イ ノ - ハ - | ア - ト - ニ - _ - |
}

