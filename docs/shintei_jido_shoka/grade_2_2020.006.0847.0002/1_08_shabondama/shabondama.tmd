::SCORE::
** シヤボンダマ **
!= 108
?= C
<2/4>
~ "詞：濱岡泰夫"
~ "曲：井上武士"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第二學年用（2020.006.0847.0002）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P026.jpg，書頁 p. 11，第一學期第 8 首）：
   調性與拍號：ハ調二拍子（C 大調 2/4 拍），「ウレシゲニ」

   一
   シヤボンダマ　アガレ
   クモマデ　アガレ
   テンマデ　アガレ
   大キイノハサキニ
   小サイノハアトニ

   二
   シヤボンダマ　トンダ
   クモマデ　トンダ
   テンマデ　トンダ
   大キイノハ　サキニ
   小サイノハ　アトニ
   ========================================================================= */

Shabondama:Piano@|0| {
    <16*>
    /* ================= 第一行 (4 小節, P026.jpg，含前奏 2 小節) ================= */
    /* 階名: (前奏)            | (前奏)            | ソ   ソ   ソ   ラ   | ソ   ソ   ソ       */
    /* (一):                   |                   | シャ ボン ダ   マ   | ア   ガ   レ       */
    /* (二):                   |                   | シャ ボン ダ   マ   | ト   ン   ダ       */
    | 0 - 3^ - 0 - 3^ - | 0 - 3^ - 3^ - 0 - | {p} 5 - 5 - 5 - 6 - | 5 - 5 - 5 - 0 - |

    /* ================= 第二行 (4 小節, P026.jpg) ================= */
    /* 階名: ラ   ラ   ソ   ミ   | ド   レ   ミ       | ド   ド   ラ   ソ   | ド   ド   レ       */
    /* (一): ク   モ   マ   デ   | ア   ガ   レ       | テ   ン   マ   デ   | ア   ガ   レ       */
    /* (二): ク   モ   マ   デ   | ト   ン   ダ       | テ   ン   マ   デ   | ト   ン   ダ       */
    | {mp} 6 - - 6 5 - 3 - | 1 - 2 - 3 - 0 - | {mf} 1^ - - 1^ 6 - 5 - | 1^ - 1^ - 2^ - 0 - |

    /* ================= 第三行 (4 小節, P026.jpg) ================= */
    /* 階名: ド   ミ レ ド   ラ   | ソ   ソ   ド       | ラ   ド ラ ソ   ミ   | ソ   ミ レ ド       */
    /* (一): オ   ホ キ イ   ノ   | ハ   サ   キ   ニ  | チ   イ サ イ   ノ   | ハ   ア ト ー   ニ  */
    /* (二): オ   ホ キ イ   ノ   | ハ   サ   キ   ニ  | チ   イ サ イ   ノ   | ハ   ア ト ー   ニ  */
    | {mf} 1^ - 3^ 2^ 1^ - 6 - | 5 - 5 - 1^ - 0 - | {p} 6 - 1^ 6 5 - 3 - | 5 - 3 2 1 - 0 - |
}

