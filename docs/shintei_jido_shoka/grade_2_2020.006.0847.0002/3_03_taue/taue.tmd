    | 1 - - 2 3 - 2 - | 1 - 2 - 3 - 2 - | 1 - 2 - 3 - 5 - | 2 - - - - - 0 - |
    | 3 - - 5 6 - 5 - | 3 - 5 - 6 - 5 - | 3 - 5 - 6 - 1^ - | 5 - - - - - 0 - |
    | 1^ - - 2^ 2^ - 1^ - | 6 - 1^ - 1^ - 6 - | 5 - 6 - 5 - 2 - | 3 - - - - - 0 - |
    | 6 - - 1^ 1^ - 6 - | 5 - - 6 6 - 5 - | 3 - 5 - 5 - 3 2 | 1 - 2 - 3 - 0 - |
    | 1^ - - 2^ 2^ - 1^ - | 6 - - 1^ 1^ - 6 - | 5 - 3 - 2 - - 3 | 1 - - - - - 0 - |
