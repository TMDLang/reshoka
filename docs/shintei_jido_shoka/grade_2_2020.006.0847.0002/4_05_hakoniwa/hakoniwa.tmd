    | 5 - - - 6 - 5 - | 1^ - 1^ - 6 - 5 - | 3 - 3 - 2 - 2 - | 1 - - - - - 0 - |
    | 5 - 5 - 5 - 5 - | 6 - 6 - 5 - 5 - | 3 - 3 - 2 - 3 - | 5 - - - - - 0 - |
