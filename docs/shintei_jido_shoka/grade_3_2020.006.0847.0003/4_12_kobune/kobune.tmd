** 小舟 **
!= 96
?= Bb
<4/4>
~ "詞：若山牧水"
~ "曲：杉江秀"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P073.jpg，書頁 p. 50，補充教材第 12 首）：
   調性與拍號：變ろ調四拍子（Bb 大調 4/4 拍），♩=96

   一
   ぎいつこぎいつこ　お舟が通る
   濱にかげろふ　昇るとみれば
   波はさゞなみ　さらさらよせくる

   二
   ぎいつこぎいつこ　お舟が通る
   舟は小舟よ　こぎ手は小供
   どこへゆくのか　ぎいつこぎいつこ
   どこへ行くのか　ぎいつこぎいつこ
   ========================================================================= */

Kobune:Piano@|0|{
    <8*>
    /* 1-4: ぎいっこ ぎいっこ おふねが とほる */
    | 5_ - - 1 6_ - 0 - | 5_ - - 1 6_ - 0 - | 1 - - 1 2 - 3 - | 2 - 2 1 6_ - 0 - |
    L1| ギ - - ツ コ - _ - | ギ - - ツ コ - _ - | オ - - フ ネ - ガ - | ト - ホ - ル - _ - |
    L2| ぎ - - つ こ - _ - | ぎ - - つ こ - _ - | お - - ふ ね - が - | と - ほ - る - _ - |
    /* 5-8: はまに かげろふ のぼると みれば (ふねは こぶねよ こぎては こども) */
    | 5_ - - 5_ 1 - 3 - | 6_ - - 6_ 5_ - 3_ - | 5_ 5_ 3_ 1_ 2_ - 3_ - | 5_ - - - - - 0 - |
    L1| ハ - - - マ - ニ - | カ - - ゲ ロ - フ - | ノ ボ ル ト ミ - レ - | バ - - - - - _ - |
    L2| ふ - - - ね - は - | こ - - ぶ ね - よ - | こ ぎ て は こ - ど - | も - - - - - _ - |
    /* 9-12: なみは さざなみ さらさら よせくる (どこへ ゆくのか ぎいっこ ぎいっこ) */
    | 1 - - 1 3 - 2 - | 1 - - 1 6_ - 5_ - | 2 - 2 3 1 - 0 - | 2 - 2 3 1 - 0 - |
    L1| ナ - - - ミ - ハ - | サ - - ザ ナ - ミ - | サ - ラ サ ラ - _ - | ヨ - セ ク ル - _ - |
    L2| ど - - - こ - へ - | ゆ - - く の - か - | ぎ - い つ こ - _ - | ぎ - い つ こ - _ - |
    /* 13-16: どこへ ゆくのか ぎいっこ ぎいっこ */
    | 5_ - - 5_ 1 - 3 - | 6_ - - 6_ 5_ - 3_ - | 2 - 2 3 1 - 0 - | 2 - 2 3 1 - 0 - |
    L1| ナ - - - ミ - ハ - | サ - - ザ ナ - ミ - | サ - ラ サ ラ - _ - | ヨ - セ ク ル - _ - |
    L2| ど - - - こ - へ - | ゆ - - く の - か - | ぎ - い つ こ - _ - | ぎ - い つ こ - _ - |
}

