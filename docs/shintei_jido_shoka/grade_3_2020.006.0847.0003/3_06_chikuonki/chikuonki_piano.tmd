** 蓄音機（留聲機・鋼琴伴奏版） **
!= 108
?= C
<2/4>
~ "臺灣教育會公認『新定兒童唱歌』尋常科第三學年用（第三學期・第6首）"
~ "國立臺灣歷史博物館典藏（典藏號：2020.006.0847.0003）"

/* =========================================================================
   【曲目說明】
   ・出處：臺灣教育會公認、臺北新高堂發行《新定兒童唱歌》尋常科第三學年用（昭和6年／1931年），
     第三學期第 6 首〈蓄音機〉（留聲機），原書第 34 頁（掃描檔 P057.jpg）。
   ・詞曲：葛原齒（葛原しげる）作詞／梁田貞 作曲。
   ・調性與拍號：ハ調（C 大調），2/4 拍，速度 != 108。
   ・編曲說明（鋼琴伴奏版）：
     1. 前奏 (Intro, 4 小節)：引用第四段「だれが歌つてゐるのでせう」俏皮輕快的結尾樂句開場。
     2. 主歌伴奏 (Chikuonki, 16 小節 × 2 段)：右手演奏充滿童趣與彈性的旋律，左手以活潑的八分音符分解和弦伴奏。
   ========================================================================= */

Intro:PianoRH@|0| {
    <8*>
    | 5 - 3 5 | (1^ -- 5)%(--) 3 - | 5 4 3 2 | 1 - - 0 |
}

Intro:PianoLH@|0| {
    <8*>
    | 1_ [1] 5_ [1] | 1_ [1] 5_ [1] | 5_ [5] 5_ [5] | 1_ [1] [1] 0 |
}

Chikuonki:PianoRH@|0| {
    <8*>
    /* ================= 第一段 (4 小節) ================= */
    | (1 -- 2)%(--) 3 - | 5 5 6 5 | (1^ -- 7)%(--) (1^ -- 6)%(--) | 5 - - 0 |

    /* ================= 第二段 (4 小節) ================= */
    | 6 - 5 6 | (1^ -- 7)%(--) 1^ 6 | (2 -- 1)%(--) (2 -- 3)%(--) | 2 - - 0 |

    /* ================= 第三段 (4 小節) ================= */
    | 3 2 3 2 | 3 2 3 5 | 3 6 5 6 | 1^ 1^ 1^ 0 |

    /* ================= 第四段 (4 小節) ================= */
    | 5 - 3 5 | (1^ -- 5)%(--) 3 - | 5 4 3 2 | 1 - - 0 |
}

Chikuonki:PianoLH@|0| {
    <8*>
    /* ================= 第一段 (4 小節) ================= */
    | 1_ [1] 5_ [1] | 1_ [1] 4_ [4] | 1_ [1] 4_ [4] | 1_ [1] 5_ 0 |

    /* ================= 第二段 (4 小節) ================= */
    | 4_ [4] 1_ [1] | 4_ [4] 4_ [4] | 2_ [2m] 2_ [2m] | 5_ [5] 5_ 0 |

    /* ================= 第三段 (4 小節) ================= */
    | 1_ [1] 5_ [1] | 1_ [1] 5_ [1] | 6_ [6m] 4_ [4] | 1_ [1] [1] 0 |

    /* ================= 第四段 (4 小節) ================= */
    | 1_ [1] 5_ [1] | 1_ [1] 5_ [1] | 5_ [5] 5_ [5] | 1_ [1] [1] 0 |
}

