~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

/*
 * Reference Materials 22: 夏季休業 (Kaki Kyūgyō / Summer Vacation)
 * Source: 臺灣教育會公認 新定兒童唱歌 尋常科第三學年用 (1934), p. 64 (P087.jpg)
 * Key: A major (?= A), 4/4 (<4/4>), Quarter = 100 (!= 100)
 *
 * Lyrics:
 * 一、梅や櫻を惜しむ間に
 * 　　なく空蟬の夏ごろも
 * 　　きぬる月日はげにも世の
 * 　　人の進みにそはぬなり
 * 二、春のこなたの學びやを
 * 　　今日しも閉す窓の内
 * 　　夏のやすみのあらましを
 * 　　かたりあふこそたのしけれ
 */

Verse:Piano@|0| {
    <8*>
    /* 1-4: うめやさくらを をしむまに */
    | 5_ - 1 - - 1 3 - | 2 - 1 - - 1 6_ - | 5_ - 6_ - - 6_ 3 - | 1 - 2 - - - 0 - |
    /* 5-8: なくうつせみの なつごろも */
    | 1 - 2 - - 1 2 - | 3 - 1 - - 1 6_ - | 5_ - 6_ - - 6_ 3 - | 2 - 1 - - - 0 - |
    /* 9-12: きぬるつきひは げにもよの */
    | 3 4 5 - - 5 3 2 | 1 - 2 - - 1 6_ - | 5_ - 1 - - 1 3 - | 1 - 2 - - - 0 - |
    /* 13-16: ひとのすすみに そはぬなり */
    | 5_ - 1 - - 1 3 - | 2 - 1 - - 1 6_ - | 5_ - 1 - - 1 3 - | 2 - 1 - - - 0 - |
}

