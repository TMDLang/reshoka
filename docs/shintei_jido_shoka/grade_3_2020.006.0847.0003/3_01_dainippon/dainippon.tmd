    /* 一: 大   ニ ツ | 本         | 大   ニ ツ | 本         | カ   ミ ノ   */
    | 5_ - 1 2 | 3 - 0 - | 1 - 3 4 | 5 - 0 - | 5 - 5 5 |

    /* ================= 第二段 (5 小節, P052.jpg 第 2 行) ================= */
    /* 一: ミ ス ヱ ノ | テ   ン ノ ウ | 陛   下     | ワ   レ ラ   | コ ク ミ ン */
    | 6 5 4 3 | (2 -- 2)%(--) 1 2 | 3 3 5_ - | 5_ - 5_ 5_ | 6_ 5_ 7_ 1 |

    /* ================= 第三段 (4 小節, P052.jpg 第 3 行) ================= */
    /* 一: シ   チ セ ン | マ ン ヲ   | ワ ガ コ ノ | ヤ ウ ー ニ */
    | (2 -- 2)%(--) 2 2 | 1 2 3 0 | 5 5 3 2 | 1 6_ 6_ 6_ |

    /* ================= 第四段 (4 小節, P052.jpg 第 4 行) ================= */
