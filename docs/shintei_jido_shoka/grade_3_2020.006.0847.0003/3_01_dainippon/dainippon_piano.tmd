** 大日本（鋼琴伴奏版） **
!= 100
?= G
<2/4>
~ "臺灣教育會公認『新定兒童唱歌』尋常科第三學年用（第三學期・第1首）"
~ "國立臺灣歷史博物館典藏（典藏號：2020.006.0847.0003）"

/* =========================================================================
   【曲目說明】
   ・出處：臺灣教育會公認、臺北新高堂發行《新定兒童唱歌》尋常科第三學年用（昭和6年／1931年），
     第三學期第 1 首〈大日本〉，原書第 29 頁（掃描檔 P052.jpg）。
   ・詞曲：文部省國語讀本 作詞／山本壽 作曲。
   ・調性與拍號：ト調（G 大調），2/4 拍，速度 != 100。
   ・編曲說明（鋼琴伴奏版）：
     1. 前奏 (Intro, 4 小節)：取開頭「大日本」上行四度與大三和弦動機，以二分與四分音符和聲莊重起音。
     2. 主歌伴奏 (Dainippon, 18 小節 × 3 段)：右手演奏主旋律；左手在開頭與結尾長音處採用厚實的拍點和弦支撐，
        中段則以穩健的八分音符進行曲低音推展。
   ========================================================================= */

Intro:PianoRH@|0| {
    <8*>
    | 5_ - 1 2 | 3 - 5 - | 3 - 2 - | 1 - - 0 |
}

Intro:PianoLH@|0| {
    <8*>
    | 1_ - [1] - | 1_ - [1] - | 5_ - [5] - | 1_ - [1] 0 |
}

Dainippon:PianoRH@|0| {
    <8*>
    /* ================= 第一段 (5 小節) ================= */
    | 5_ - 1 2 | 3 - 0 - | 1 - 3 4 | 5 - 0 - | 5 - 5 5 |

    /* ================= 第二段 (5 小節) ================= */
    | 6 5 4 3 | (2 -- 2)%(--) 1 2 | 3 3 5_ - | 5_ - 5_ 5_ | 6_ 5_ 7_ 1 |

    /* ================= 第三段 (4 小節) ================= */
    | (2 -- 2)%(--) 2 2 | 1 2 3 0 | 5 5 3 2 | 1 6_ 6_ 6_ |

    /* ================= 第四段 (4 小節) ================= */
    | 5_ 5_ 1 2 | 3 - 2 - | 1 - - - | - - 0 - |
}

Dainippon:PianoLH@|0| {
    <8*>
    /* ================= 第一段 (5 小節) ================= */
    | 1_ - [1] - | 1_ [1] 5_ 0 | 1_ - [1] - | 5_ [5] 5_ 0 | 1_ [1] 5_ [1] |

    /* ================= 第二段 (5 小節) ================= */
    | 4_ [4] 1_ [1] | 5_ [5] 5_ [5] | 1_ [1] 5_ - | 5_ [5] 2_ [5] | 4_ [4] 1_ [1] |

    /* ================= 第三段 (4 小節) ================= */
    | 5_ [5] 5_ [5] | 1_ [1] [1] 0 | 1_ [1] 5_ [1] | 6_ [6m] 4_ [4] |

    /* ================= 第四段 (4 小節) ================= */
    | 1_ [1] 4_ [4] | 5_ - [5] - | 1_ - [1] - | [1] - 0 - |
}

