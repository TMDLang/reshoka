/*
 * Reference Materials 18: 雛菊 (Hinagiku / Daisy)
 * Source: 臺灣教育會公認 新定兒童唱歌 尋常科第三學年用 (1934), pp. 59-60 (P082.jpg-P083.jpg)
 * Lyricist: 松岸寛一 (Matsugishi Kan'ichi) / Composer: 永井幸次 (Nagai Kōji)
 * Key: G minor (relative major ?= Bb), 2/4 (<2/4>), ヤハラカニ Quarter = 96 (!= 96)
 *
 * Lyrics:
 * お庭に植ゑた　雛菊が
 * につこり笑つて　咲き出した
 * 一い二う三い四う　五つ　六つ
 * 頭そろへて　赤やしろ
 * 楽しいうれしい　美しい
 * お庭の雛菊　さき出した
 */

Verse:Piano@|0| {
    <8*>
    /* 1-8: おにはにうゑた ひなぎくが にっこりわらって さきだした */
    | 6_ 6_ 6_ 6_ | 7_ 7_ 7_ - | 1 7_ 6_ 6_ | 7_ - - 0 |
    | 3 - 1 7_ | 6_ 1 7_ 6_ | 7_ 7_ 3_ 3_ | 6_ - - 0 |
    /* 9-16: ひい ふう みい よう いつつ むっつ */
    | 6_ - - - | 7_ - - - | 1 - - - | 6_ - - - |
    | 3 - 1 7_ | 1 - 6_ - | 7_ - - - | 7_ - 0 - |
    /* 17-20: あたまそろへて あかやしろ */
    | 3 - 1 1 | 3 3 1 1 | 7_ 6_ 7_ 1 | 7_ - - 0 |
    /* 21-28: たのしい うれしい うつくしい */
    | 3_ - - 4_ | 3_ - 0 - | 6_ - - 1 | 7_ - 0 - |
    | 6_ - 7_ - | 1 - 2 - | 3 - - - | 3 - 0 - |
    /* 29-32: おにはのひなぎく さきだした */
    | 6_ 6_ 6_ 6_ | 7_ 1 7_ 6_ | 7_ 7_ 3_ 3_ | 6_ - - 0 |
}

