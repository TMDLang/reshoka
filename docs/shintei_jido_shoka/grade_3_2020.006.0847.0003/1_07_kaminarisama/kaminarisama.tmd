** かみなりさま **
!= 112
?= F
<2/4>
~ "詞：吉丸一昌"
~ "曲：永井幸次"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P032.jpg，書頁 p. 9，第一學期第 7 首）：
   調性與拍號：へ調二拍子（F 大調 2/4 拍），「ゲンキヨク」

   一
   大ぞら一めんかきくもり
   そろそろふきだす南風（ミナミカゼ）
   ゆふだちくるぞかみなりなるぞ
   ほしものいれよと大さわぎ

   二
   太郎ははだかではらつゞみ
   こわくはないぞといふうちに
   ごろ／＼ぴかりぴか／＼ごろり
   おへそをおさへてにげこんだ
   ========================================================================= */

Kaminarisama:Piano@|0| {
    <16*>
    /* ================= 第一行 (4 小節, P032.jpg) ================= */
    | 5_ - 5_ - 5_ - 5_ - | 1 - - 1 1 - 1 - | 2 - - 2 2 - 1 2 | 3 - - - - - 0 - |

    /* ================= 第二行 (4 小節, P032.jpg) ================= */
    | 4 - 4 - 3 - 6 - | 5 - 5 - 3 - 1 - | 2 - - 3 2 - 1 - | 1 - - - - - 0 - |

    /* ================= 第三行 (4 小節, P032.jpg) ================= */
    | 2 - - 2 5_ - 5_ - | 1 - 1 - 1 - 0 - | 2 2 2 2 3 - 6 - | 5 - - - - - 0 - |

    /* ================= 第四行 (4 小節, P032.jpg) ================= */
    | 6 - - 5 4 - 3 - | 4 - - 3 2 - 1 - | 2 - 3 - 2 - - 5_ | 1 - - - - - 0 - |
}

