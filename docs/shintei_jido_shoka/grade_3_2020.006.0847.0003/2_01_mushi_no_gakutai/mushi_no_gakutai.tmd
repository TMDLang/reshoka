    /* 二: こ ほ ろ ぎ | う   ま お ひ | か ね つ き | む し の   | ふ   ー し も */
    | 5 5 5 5 | (6 -- 6)%(--) 6 6 | 5 3 2 1 | 2 2 5_ 0 | (6_ -- 6_)%(--) 6_ 6_ |

    /* ================= 第三段 (5 小節, P036.jpg 第 3 行) ================= */
