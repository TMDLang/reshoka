** 八岐の大蛇（八岐大蛇・鋼琴伴奏版） **
!= 100
?= F
<4/4>
~ "臺灣教育會公認『新定兒童唱歌』尋常科第三學年用（第二學期・第2首）"
~ "國立臺灣歷史博物館典藏（典藏號：2020.006.0847.0003）"

/* =========================================================================
   【曲目說明】
   ・出處：臺灣教育會公認、臺北新高堂發行《新定兒童唱歌》尋常科第三學年用（昭和6年／1931年），
     第二學期第 2 首〈八岐の大蛇〉（八岐大蛇），原書第 15 頁（掃描檔 P038.jpg）。
   ・出處原曲：文部省唱歌。
   ・調性與拍號：ヘ調（F 大調），4/4 拍，速度 != 100。
   ・編曲說明（鋼琴伴奏版）：
     1. 前奏 (Intro, 2 小節)：引用第四段莊嚴敘事的結尾樂句作為前導。
     2. 主歌伴奏 (YamataNoOrochi, 8 小節 × 4 段)：右手演奏威武古樸的敘事旋律，
        左手以穩健的四拍子和弦進行支撐神話史詩氣氛。
   ========================================================================= */

Intro:PianoRH@|0| {
    <8*>
    | 5_ 5_ (6_ -- 5_)%(--) (5_ 1)%(-) (1 3)%(-) 5 0 | 6 6 (5 -- 3)%(--) 2 (3 2)%(-) 1 0 |
}

Intro:PianoLH@|0| {
    <8*>
    | 1_ - [1] - 1_ - [1] 0 | 4_ - 1_ - 5_ - 1_ 0 |
}

YamataNoOrochi:PianoRH@|0| {
    <8*>
    /* ================= 第一段 (2 小節) ================= */
    | 5_ 5_ (6_ -- 5_)%(--) (5_ 1)%(-) (1 2)%(-) 3 0 | (4 -- 3)%(--) 2 1 2 3 2 0 |

    /* ================= 第二段 (2 小節) ================= */
    | 5_ 5_ (6_ -- 5_)%(--) (5_ 1)%(-) (1 3)%(-) 2 0 | 5 5 (3 -- 1)%(--) 2 2 5_ 0 |

    /* ================= 第三段 (2 小節) ================= */
    | 5_ 5_ (5_ -- 3)%(--) 4 (4 6)%(-) 5 0 | (4 -- 4)%(--) 3 2 1 (2 3)%(-) 2 0 |

    /* ================= 第四段 (2 小節) ================= */
    | 5_ 5_ (6_ -- 5_)%(--) (5_ 1)%(-) (1 3)%(-) 5 0 | 6 6 (5 -- 3)%(--) 2 (3 2)%(-) 1 0 |
}

YamataNoOrochi:PianoLH@|0| {
    <8*>
    /* ================= 第一段 (2 小節) ================= */
    | 1_ - [1] - 1_ - [1] 0 | 4_ - 1_ - 5_ - [5] 0 |

    /* ================= 第二段 (2 小節) ================= */
    | 1_ - [1] - 1_ - 5_ 0 | 1_ - 6_ - 2_ - 5_ 0 |

    /* ================= 第三段 (2 小節) ================= */
    | 1_ - [1] - 4_ - 1_ 0 | 4_ - 1_ - 5_ - [5] 0 |

    /* ================= 第四段 (2 小節) ================= */
    | 1_ - [1] - 1_ - [1] 0 | 4_ - 1_ - 5_ - 1_ 0 |
}

-> Intro -> YamataNoOrochi -> YamataNoOrochi -> YamataNoOrochi -> YamataNoOrochi -> #

