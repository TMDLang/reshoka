    <8*>
    /* ================= 第一段 (4 小節, P042.jpg 第 1 行) ================= */
    /* 一: ミ   コ ト | コ   ソ     | タ ケ シ キ | キ ミ ヨ     */
    /* 二: つ   る ぎ | も   て     | く さ な ぎ | は ら ひ     */
    | 5_ - 3_ 5_ | 3 - 1 0 | (6_ -- 7_)%(--) 1 6_ | 5_ 3_ 5_ 0 |

    /* ================= 第二段 (4 小節, P042.jpg 第 2 行) ================= */
    /* 一: ニ   ツ ポ   | ン   イ チ   | ト   タ   ケ | ル ハ イ ヘ リ */
    /* 二: わ   た る   | あ   ら な   | み   を   さ | ま る え び す */
    | (5_ -- 5_)%(--) 5_ 5_ | 3_ 5_ 1 3 | (2 -- 1)%(--) (2 -- 1)%(--) |

    /* ================= 第三段 (4 小節, P042.jpg 第 3 行) ================= */
    /* 一: ヲ   ー ヲ   | シ         | ヲ ー ヲ ー ー | シ         */
    /* 二: を   ー を   | し         | を ー を ー ー | し         */
    | 2 3 1 0 | 5_ - (3 -- 4)%(--) | 3 (2 1)%(-) 2 0 |

    /* ================= 第四段 (4 小節, P042.jpg 第 4 行) ================= */
    /* 一: ヤ   マ ト   | タ ケ ル ノ | ミ コ   ト   */
    /* 二: や   ま と   | た け る の | み こ   と   */
    | 6_ - 6_ 6_ | 5_ 5_ 1 2 | 3 - 2 - | 1 - 0 - |
}

