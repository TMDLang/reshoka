** 鵯越（鋼琴伴奏版） **
!= 120
?= F
<4/4>
~ "文部省唱歌"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

Hiyodorigoe:PianoRH@|0| {
    <8*>
    /* System 1 (m.1-4): シカモヨツアシ ウマモヨツアシ */
    | {f} 3 - 5 - 5 - - 5 | 6 - 6 - 5 - 0 - | 3 - 5 - 5 - - 2 | 3 - 1 - 2 - 0 - |
    /* System 2 (m.5-8): シカノコエユク コノサカミーチ */
    | {mf} 1 - 3 - 3 - - 1 | 2 - 3 - 2 - 0 - | 1 - - 1 6_ - 1 - | 2 - - 2 5_ - 0 - |
    /* System 3 (m.9-12): ウマノコセナイ ダウリハナイト */
    | {f} 3 - 5 - 5 - - 5 | 6 - 6 - 5 - 0 - | 3 - 5 - 5 - - 2 | 3 - 1 - 2 - 0 - |
    /* System 4 (m.13-16): タイシヤウヨシツネ マツサキニ */
    | {ff} 5 - - 5 3 - 1 - | 5 - - 5 3 - 1 - | 5_ - - 5_ 2 - - 3 | 1 - - - - - 0 - |
}

Hiyodorigoe:PianoLH@|0| {
    <8*>
    /* System 1 (m.1-4) */
    | 1_ - 5__+1_+3_ - 1_ - 5__+1_+3_ - | 4__ - 4__+6__+1_ - 1_ - 5__+1_+3_ 0 | 1_ - 5__+1_+3_ - 5__ - 5__+7__+2_ - | 1_ - 6__+1_+3_ - 5__ - 5__+7__+2_ 0 |
    /* System 2 (m.5-8) */
    | 1_ - 5__+1_+3_ - 1_ - 5__+1_+3_ - | 5__ - 5__+7__+2_ - 5__ - 5__+7__+2_ 0 | 6__ - 6__+1_+3_ - 4__ - 4__+6__+1_ - | 2__ - 6__+2_+4_ - 5__ - 5__+7__+2_ 0 |
    /* System 3 (m.9-12) */
    | 1_ - 5__+1_+3_ - 1_ - 5__+1_+3_ - | 4__ - 4__+6__+1_ - 1_ - 5__+1_+3_ 0 | 1_ - 5__+1_+3_ - 5__ - 5__+7__+2_ - | 1_ - 6__+1_+3_ - 5__ - 5__+7__+2_ 0 |
    /* System 4 (m.13-16) */
    | 1_ - 5__+1_+3_ - 1_ - 5__+1_+3_ - | 1_ - 5__+1_+3_ - 6__ - 6__+1_+3_ - | 5__ - - 5__ 5__ - 5__+7__+2_ - | 1_ - 5__ - 1_+5__+1 - 0 - |
}

