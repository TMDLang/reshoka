** 鵯越 **
!= 120
?= F
<4/4>
~ "文部省唱歌"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P068.jpg，書頁 p. 45，補充教材第 8 首）：
   調性與拍號：へ調四拍子（F 大調 4/4 拍），元氣ヨク ♩=120
   （原書標題漢字印作「鴨越」，振假名標註「ひよどりごえ」）

   一
   鹿も四つ足馬も四つ足
   鹿の越えゆくこの坂道
   馬の越せない道理はないと
   大將義經眞先に

   二
   つづく勇士も一騎當千
   鵯越に着いて見れば
   平家の陣屋は眞下に見えて
   戰今や眞最中

   三
   油斷大敵裏の山より
   三千餘騎のさか落しに
   平家の一門驚きあわて
   屋島をさして落てゆく
   ========================================================================= */

Hiyodorigoe:Piano@|0| {
    <8*>
    /* System 1 (m.1-4): シカモヨツアシ ウマモヨツアシ */
    | 3 - 5 - 5 - - 5 | 6 - 6 - 5 - 0 - | 3 - 5 - 5 - - 2 | 3 - 1 - 2 - 0 - |
    /* System 2 (m.5-8): シカノコエユク コノサカミーチ */
    | 1 - 3 - 3 - - 1 | 2 - 3 - 2 - 0 - | 1 - - 1 6_ - 1 - | 2 - - 2 5_ - 0 - |
    /* System 3 (m.9-12): ウマノコセナイ ダウリハナイト */
    | 3 - 5 - 5 - - 5 | 6 - 6 - 5 - 0 - | 3 - 5 - 5 - - 2 | 3 - 1 - 2 - 0 - |
    /* System 4 (m.13-16): タイシヤウヨシツネ マツサキニ */
    | 5 - - 5 3 - 1 - | 5 - - 5 3 - 1 - | 5_ - - 5_ 2 - - 3 | 1 - - - - - 0 - |
}

-> Hiyodorigoe -> #
