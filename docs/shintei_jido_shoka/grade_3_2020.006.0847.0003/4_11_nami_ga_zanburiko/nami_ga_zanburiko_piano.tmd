::SCORE::
** 波がざんぶりこ（鋼琴伴奏版） **
!= 108
?= Bb
<2/4>
~ "詞：野口雨情"
~ "曲：佐々木のぼる"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

NamiGaZanburiko:PianoRH@|0| {
    <8*>
    /* 1-4: なみがざんぶりこ どんどとうてば */
    | {f} 2 2 2 3 | 2 (5_ 5_)%(-) 5_ 0 | 6_ 1 6_ - | 5_ (3_ 3_)%(-) 5_ 0 |
    /* 5-8: いはがむっくりこ かほをだした */
    | {mf} (3_ -- 3_)%(--) 2_ 1_ | 2_ 3_ 5_ 0 | {mp} 3 3 2 1 | 2 2 1 - |
    /* 9-12: なみはあとから またざんぶりこ */
    | {f} 3 3 - 1 | 2 (5_ 5_)%(-) 5_ 0 | 0 1 - 6_ | 5_ 3_ 5_ 0 |
    /* 13-16: おきのかもめも とんできた */
    | {mp} (3_ -- 3_)%(--) 2_ 1_ | 2_ 3_ 5_ 0 | 5_ 6_ - 5_ | 3 (2 2)%(-) 1 - |
}

NamiGaZanburiko:PianoLH@|0| {
    <4*>
    | 5__ [5_] | 5__ 0 | 4__ [4] | 1_ 0 |
    | 1_ [6_m] | 5__ 0 | 1_ [6_m] | 5__ 1_ |
    | 1_ [1] | 5__ 0 | 4__ [4] | 1_ 0 |
    | 1_ [6_m] | 5__ 0 | 1_ [4] | 5__ 1_ |
}

