::SCORE::
** 綱ひき（鋼琴伴奏版） **
!= 116
?= C
<2/4>
~ "教育唱歌集"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

Tsunahiki:PianoRH@|0| {
    <8*>
    /* 1-4: ひけひけつなを ひけひけつなを */
    | (5 -- 5)%(--) (1 -- 1)%(--) | (3 -- 3)%(--) 3 0 | (5 -- 5)%(--) (1 -- 1)%(--) | (3 -- 2)%(--) 2 0 |
    /* 5-8: こころをあはせ ちからのかぎり */
    | (5 -- 5)%(--) (1 -- 1)%(--) | (3 -- 3)%(--) 3 0 | (5 -- 6)%(--) (5 -- 4)%(--) | (3 -- 2)%(--) 1 0 |
    /* 9-12: このふとづなの ちぎるるまでは */
    | (5 -- 5)%(--) (1^ -- 1^)%(--) | (7 -- 6)%(--) 5 0 | (5 -- 5)%(--) (1^ -- 1^)%(--) | (7 -- 6)%(--) 5 0 |
    /* 13-16: かけごゑそろへて ひけひけいちに */
    | (3^ -- 2^)%(--) (1^ -- 7)%(--) | (6 -- 7)%(--) (1^ -- 6)%(--) | (5 -- 6)%(--) (5 -- 4)%(--) | (3 -- 2)%(--) 1 0 |
}

Tsunahiki:PianoLH@|0| {
    <4*>
    | 1_ [1] | 1_ 0 | 1_ [1] | 5__ 1_ |
    | 1_ [1] | 1_ 0 | 1_ [4] | 5__ 1_ |
    | 1_ [1] | 5__ 0 | 1_ [1] | 5__ 0 |
    | 1_ [1] | 4__ [4] | 5__ [1] | 5__ 1_ |
}

