::SCORE::
** 港（鋼琴伴奏版） **
!= 92
?= C
<3/4>
~ "臺灣教育會公認『新定兒童唱歌』尋常科第三學年用（第二學期・第9首）"
~ "國立臺灣歷史博物館典藏（典藏號：2020.006.0847.0003）"

/* =========================================================================
   【曲目說明】
   ・出處：臺灣教育會公認、臺北新高堂發行《新定兒童唱歌》尋常科第三學年用（昭和6年／1931年），
     第二學期第 9 首〈港〉，原書第 25 頁（掃描檔 P048.jpg）。
   ・詞曲：旗野士良 作詞／吉田信太 作曲。
   ・調性與拍號：ハ調（C 大調），3/4 拍，速度 != 92。
   ・編曲說明（鋼琴伴奏版）：
     1. 前奏 (Intro, 4 小節)：引用第四段「よせくる波も　こがねなり」優美流暢的波浪樂句揭開序幕。
     2. 主歌伴奏 (Minato, 16 小節 × 2 段)：右手演奏 3/4 拍海港旋律，左手以圓舞曲式低音與和弦（`1_ - [1] - [1] -`）
        營造港灣水波蕩漾的韻律。
   ========================================================================= */

Intro:PianoRH@|0| {
    <8*>
    | 1^ 1^ 7 - 6 - | 5 6 5 - 3 - | 3 3 2 - 2 - | 1 - - - 0 - |
}

Intro:PianoLH@|0| {
    <8*>
    | 4_ - [4] - [4] - | 1_ - [1] - [1] - | 5_ - [5] - [5] - | 1_ - [1] - 0 - |
}

Minato:PianoRH@|0| {
    <8*>
    /* ================= 第一段 (4 小節) ================= */
    | 1 2 3 - 3 - | 5 6 5 - 5 - | 3 2 1 - 2 - | 3 - - - 0 - |

    /* ================= 第二段 (4 小節) ================= */
    | 5 6 5 - 3 - | 1^ 7 6 - 5 - | 5 4 3 - 1 - | 2 - - - 0 - |

    /* ================= 第三段 (4 小節) ================= */
    | 3 2 1 - 1 - | 2 3 4 - 4 - | 4 3 2 - 1 - | 5 - - - 0 - |

    /* ================= 第四段 (4 小節) ================= */
    | 1^ 1^ 7 - 6 - | 5 6 5 - 3 - | 3 3 2 - 2 - | 1 - - - 0 - |
}

Minato:PianoLH@|0| {
    <8*>
    /* ================= 第一段 (4 小節) ================= */
    | 1_ - [1] - [1] - | 1_ - [1] - [1] - | 6_ - [6m] - 5_ - | 1_ - [1] - 0 - |

    /* ================= 第二段 (4 小節) ================= */
    | 1_ - [1] - [1] - | 4_ - [4] - 1_ - | 2_ - [2m] - 6_ - | 5_ - [5] - 0 - |

    /* ================= 第三段 (4 小節) ================= */
    | 1_ - [1] - [1] - | 4_ - [4] - [4] - | 2_ - [2m] - 4_ - | 5_ - [5] - 0 - |

    /* ================= 第四段 (4 小節) ================= */
    | 4_ - [4] - [4] - | 1_ - [1] - [1] - | 5_ - [5] - [5] - | 1_ - [1] - 0 - |
}

