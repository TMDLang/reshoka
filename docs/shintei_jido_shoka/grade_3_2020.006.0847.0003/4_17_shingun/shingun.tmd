** 進軍 **
!= 116
?= F
<2/4>
~ "葛原齒 作詞 / 梁田貞 作曲"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

/*
 * Reference Materials 17: 進軍 (Shingun / March)
 * Source: 臺灣教育會公認 新定兒童唱歌 尋常科第三學年用 (1934), pp. 57-58 (P080.jpg-P081.jpg)
 * Lyricist: 葛原齒 (Kuzuhara Shigeru) / Composer: 梁田貞 (Yanada Tadashi)
 * Key: F major (?= F), 2/4 (<2/4>), ゲンキニ Quarter = 116 (!= 116)
 *
 * Lyrics:
 * トトトトト、タタタ、テトテトタ、
 * タタタタタ、トテトト、タタタタタタ、
 * ラッパのおとはいさましい
 * むねには勳章ピカピカさせて
 * おててにサーベルギラギラさせて
 * あとから大將お馬でくるよ
 * トトトトト、タタタ、テトテトタ、
 * タタタタタ、トテトト、テトタトタ、
 */

Verse:Piano@|0| {
    <8*>
    /* 1-8: トトトトト タタタ テトテトタ タタタタタ トテトト タタタタタタ */
    | 5_ (5_ 5_)%(-) 5_ 5_ | 1 1 1 - | 3 1 3 1 | 5 - - 0 |
    | 5 (5 5)%(-) 5 5 | (3 5)%(-) 3 1 - | 5 (5 5)%(-) 5 5 | 5 - - 0 |
    /* 9-16: ラッパのおとは いさましい むねにはくんしゃう ピカピカさせて */
    | 5_ - 5_ 5_ | 1 - 1 1 | 3 3 3 3 | 5 - - 0 |
    | (5 -- 5)%(--) 5 5 | 3 - 3 - | 1 3 2 1 | 5_ 5_ 5_ - |
    /* 17-24: おててにサーベル ギラギラさせて あとからたいしゃう おうまでくるよ */
    | 6_ 6_ 6_ 6_ | 1 - 5_ - | 1 3 2 1 | 5 5 5 - |
    | (6 -- 6)%(--) 5 5 | 3 - 1 - | (5 -- 5)%(--) 5 5 | 5 - 3 1 |
    /* 25-32: トトトトト タタタ テトテトタ タタタタタ トテトト テトタトタ */
    | 5_ (5_ 5_)%(-) 5_ 5_ | 1 1 1 - | 3 1 3 1 | 5 - - 0 |
    | 5 (5 5)%(-) 5 5 | (3 5)%(-) 3 1 - | 5 3 1 5_ | 1 - - 0 |
}

