** けむり（鋼琴伴奏版） **
!= 138
?= F
<4/4>
~ "詞：三木露風"
~ "曲：山田耕作"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

Kemuri:PianoRH@|0| {
    <8*>
    /* System 1 (m.1-4): モクモクケムリ ドコヘユク */
    | 5_ - - 1 5_ - - 1 | 2 - - 2 2 - 0 - | 3 - - 1 2 - 3 - | 5 - - - - - 0 - |
    /* System 2 (m.5-8): エントツノ セマイ クチカラヌケダシテ */
    | 1 - 1 1 2 - 0 - | 3 - 2 - 1 - 0 - | 1 1 6_ 1 2 - 3 - | 2 - - 3 2 - 0 - |
    /* System 3 (m.9-12): ヒロイ オォキナ ソラヘユク */
    | 5 - - - 3 - 1 - | 6 - - - 5 - 3 - | 1 - 3 - 2 - 1 - | 5 - - - - - 0 - |
    /* System 4 (m.13-15): クモニ ナル ケムー */
    | 1 - - - 5_ - 1 - | 2 - - - 2 - 0 - | 3 - - - 4 - 3 - |
    /* System 5 (m.16-18): リ モク モク */
    | 5 - - - - - 0 - | {f} 6 - - - 5 - 0 - | {p} 5_ - - - 1 - 0 - |
}

Kemuri:PianoLH@|0| {
    <4*>
    /* System 1 (m.1-4) */
    | 1_ [1] 1_ [1] | 5__ [5_] 5__ 0 | 1_ [1] 5__ [1] | 5__ [5_] 5__ 0 |
    /* System 2 (m.5-8) */
    | 1_ [1] 5__ 0 | 1_ [5_] 1_ 0 | 6__ [6_m] 2__ [1] | 5__ [5_] 5__ 0 |
    /* System 3 (m.9-12) */
    | 1_ [1] 1_ [1] | 4__ [4_] 1_ [1] | 1_ [1] 2__ [2_m] | 5__ [5_] 5__ 0 |
    /* System 4 (m.13-15) */
    | 1_ [1] 1_ [1] | 5__ [5_] 5__ 0 | 1_ [1] 5__ [1] |
    /* System 5 (m.16-18) */
    | 5__ [5_] 5__ 0 | {f} 4__ [4_] 1_ 0 | {p} 5__ - 1_ 0 |
}

