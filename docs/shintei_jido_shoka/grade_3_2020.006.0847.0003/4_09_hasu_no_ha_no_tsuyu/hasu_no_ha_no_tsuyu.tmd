    L1| オ - - ニ (ハ - - -) ノ - | イ - - ケ ニ - - - | ウ - - イ テ - ヰ - | ル - - - - - _ - |
    L2| お - - い (け - - -) に - | か - - ぜ が - - - | ふ - - い て - き - | て - - - - - _ - |
    /* 5-8: ほんとにきれいな つゆのたま */
