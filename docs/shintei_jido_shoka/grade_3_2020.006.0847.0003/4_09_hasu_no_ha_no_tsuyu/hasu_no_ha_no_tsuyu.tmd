    L1| マ - - ン マ - ル - | マ - - ル イ - - - | ハ - - ス ノ - ハ - | ニ - - - - - _ - |
    L2| さ - - ざ な - み - | た - - て ば - - - | は - - す の - は - | の - - - - - _ - |
    /* 9-12: ちひさなたまが あつまって */
    | 5 - - 3 6 - - - | 1^ - 1^ - - - 1^ - | 2^ - 1^ 0 1^ - 6 0 | 5 - - - - - 0 - |
    L1| ツ - - ユ ガ - - - | タ - マツ - - - テ - | キ - ラ _ キ - ラ _ | ト - - - - - _ - |
    L2| な - - か で - - - | こ - ろが - - - る - | つ - ゆ _ の - た _ | ま - - - - - _ - |
    /* 13-16: おほきなたまに なりました */
