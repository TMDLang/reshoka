/*
 * Reference Materials 24: 始業式 (Shigyōshiki / Opening Ceremony)
 * Source: 臺灣教育會公認 新定兒童唱歌 尋常科第三學年用 (1934), p. 66 (P089.jpg)
 * Key: D major (?= D), 4/4 (<4/4>), 少シ早ク Quarter = 108 (!= 108)
 *
 * Lyrics:
 * 一、今日より開く學びやの
 * 　　わが師の君の導きに
 * 　　文の林のおくわけて
 * 　　花の色香やたづねまし
 * 二、朝夕みがかん我が心
 * 　　人のかゞみとなるまでに
 * 　　いざ諸共にいそしまん
 * 　　正しき道を一すぢに
 */

Verse:Piano@|0| {
    <8*>
    /* 1-4: けふよりひらく まなびやの */
    | 5 - - 5 3 - 1 - | 2 - - 2 1 - 6_ - | 2 - 5 - - 5 6 - | 5 - 3 - - - 0 - |
    /* 5-8: わがしのきみの みちびきに */
    | 1^ - - 1^ 5 - 5 - | 6 - - - 5 - 3 - | 2 - - 2 3 - 2 - | 1 - - - - - 0 - |
    /* 9-12: ふみのはやしの おくわけて */
    | 5 - - 5 3 - 1 - | 2 - - 2 1 - 2 - | 3 - - 3 2 - 3 - | 5 - - - - - 0 - |
    /* 13-16: はなのいろかや たづねまし */
    | 6 - - 6 1^ - 6 - | 5 - - 5 3 - 1 - | 2 - - 5 3 - 2 - | 1 - - - - - 0 - |
}

