::SCORE::
** ねむり人形 **
!= 96
?= F
<4/4>
~ "詞：葛原齒"
~ "曲：本居長世"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P062.jpg–P063.jpg，書頁 pp. 39–40，補充教材第 4 首）：
   調性與拍號：へ調四拍子（F 大調 4/4 拍），♩=96

   一
   私の人形　新しい
   西洋人形　大人形
   髪は金髪　眼は青眼
   赤い頬ぺた　丸い顔
   寝かすとキューツと泣きますの
   泣いて　お目々を閉ぢますの

   二
   夢にはイギリス　ロンドンの
   ショウヰンドウの中にゐた
   去年の秋を見てませうか
   私の仲よしのおばさまに
   買はれた時の夢でせうか
   私　おこして　やりませうか

   三
   それとも　お船に乗せられて
   遠い日本へ送られた
   長道中の夢でせうか
   淋しい淋しい夢でせうか
   それなら起してやりませう
   起して　遊んでやりませうか

   四
   それとも　おくにでロンドンで
   金髪　青眼で　丸顔で
   赤頬ぺたの友達と
   夢で遊んでゐませうか
   それなら　もつともつと寝かしませう
   寝かして　その夢　見せませう
   ========================================================================= */

NemuriNingyo:Piano@|0| {
    <8*>
    /* 1-4: わたしの にんぎやう あたらしい せいやう にんぎやう おほにんぎやう */
    | (5 -- 6)%(--) 5 6 5 - 3 - | (5 -- 6)%(--) 5 - 1 2 - 0 | (5 -- 6)%(--) 5 6 5 - 3 - | (5 -- 6)%(--) 5 - 1 2 - 0 |
    /* 5-8: かみはきんぱつ めはあをめ あかいほっぺた まるいかほ */
    | (3 -- 4)%(--) 3 1 2 (3 -- 2)%(--) 7_ | 1 2 1 6_ 5_ - 0 - | (3 -- 4)%(--) 3 1 2 (3 -- 2)%(--) 7_ | 1 2 1 6_ 5_ - 0 - |
    /* 9-12: ねかすと キューッと なきますの */
    | 3 - - 4 5 - 5 - | 6 - - - 5 - 5 - | 3 - - - - - 5 - | 3 - 1 - 2 - 0 - |
    /* 13-16: ないては おめめを とぢますの */
    | 3 - - 4 5 - 5 - | 6 - - 6 5 - 5 - | 3 - 5 - 3 - 2 - | 1 - - - - - 0 - |
}

-> NemuriNingyo -> #

