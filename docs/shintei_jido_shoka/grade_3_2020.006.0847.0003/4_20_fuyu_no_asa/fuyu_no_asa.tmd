** 冬の朝 **
!= 88
?= C
<2/4>
~ "三木露風 作詞 / 山田耕作 作曲"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第三學年用（2020.006.0847.0003）"

/*
 * Reference Materials 20: 冬の朝 (Fuyu no Asa / Winter Morning)
 * Source: 臺灣教育會公認 新定兒童唱歌 尋常科第三學年用 (1934), p. 62 (P085.jpg)
 * Lyricist: 三木露風 (Miki Rofū) / Composer: 山田耕作 (Yamada Kōsaku)
 * Key: C major (?= C), 2/4 (<2/4>), 面白ゲニ Quarter = 88 (!= 88)
 *
 * Lyrics:
 * 一、すゞめこぼれた　米拾ふ
 * 　　チュッ　チョン　チュッ　チョン　チュ
 * 　　山は紫　空晴れて
 * 　　顔を洗へばすがすがし
 * 二、すゞめとび立つ木の枝に
 * 　　チュッ　チョン　チュッ　チョン　チュ
 * 　　手拭さげて　さくさくと
 * 　　踏めばくだける　霜柱
 */

Verse:Piano@|0| {
    <16*>
    /* 1-4: すずめ こぼれた こめ ひろふ */
    | 3 - 5 - 5 - 0 - | 6 - - 6 5 - 3 - | 2 - - - - - 3 - | 1 - 2 - 3 - 0 - |
    /* 5-8: チュッ チョン チュッ チョン チュー ー */
    | 6 - 0 - 6 - - - | 6 - 0 - 6 - - - | 6 - - - - - - - | - 0 0 - 0 - - - |
    /* 9-12: やまは むらさき そら はれて */
    | 1^ - - - 2^ - 1^ - | 6 - - 6 5 - 5 - | 6 - - - 5 - - - | 3 - 2 1 2 - 0 - |
    /* 13-18: かほを あらへば すが すがー しー */
    | 1 - - - 2 - 3 - | 5 - 5 - 6 - 5 - | 1^ - - - - - 1^ - | 6 - - - 5 - 6 - | 1^ - - - - - - - | - - - - 0 - - - |
}

