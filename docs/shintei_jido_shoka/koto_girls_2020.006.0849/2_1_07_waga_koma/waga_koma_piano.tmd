::SCORE::
** 我が駒（鋼琴伴奏版） **
!= 104
?= F
<4/4>
~ "詞：安東正郎"
~ "曲：田中銀之助"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 1 - 2 - |

    /* 第一行 */
    | 3 - - - - - - - - - 2 - 1 - 2 - | 3 - - - - - - - 0 - - - 3 - 3 - | 6 - - - - - 1 - 2 - - 3 2 - 1 - |

    /* 第二行 */
    | 6_ - - - - - - - 0 - - - {mf} 6_ - 1 - | 2 - - - - - - - - - 3 - 4 - 5 - | 3 - - - - - - - 0 - - - {mp} 3 - - 1 | 6_ - - - - - 1 - 2 - - - 1 - - - |

    /* 第三行 */
    | 3_ - - - - - - - 0 - - - {mf} 6_ - 6_ - | 1 - - - - - - - - - 2 - 1 - 2 - | 6_ - - - - - - - 0 - {f} 6_ - 2 - 3 - |

    /* 第四行 */
    | 4 - - - - - 2 - 3 - 2 - 1 - 2 - | 3 - - - - - - - 0 - - - {f} 3 - 3 - | 6 - - - - - - - - - 5 - 3 - 5 - |

    /* 第五行 */
    | 3 - - - - - - - 0 - {mp} 3 - 2 - 1 - | 6_ - - - - - - - 1 - - - - - 2 - | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - |

    /* 第一行 */
    | {mp} 6__ 3_ 1_ 3_ 6__ 3_ 1_ 3_ | 6__ 3_ 1_ 3_ 6__ - 0 - | 2__ 6__ 4_ 6__ 5__ 2_ 5_ 2_ |

    /* 第二行 */
    | 6__ 3_ 6_ 3_ 6__ - 0 - | 5__ 2_ 5_ 2_ 5__ 2_ 5_ 2_ | 6__ 3_ 1_ 3_ 6__ - 0 - | 2__ 6__ 4_ 6__ 5__ 2_ 1_ 3_ |

    /* 第三行 */
    | 3__ 7__ 3_ 7__ 3__ - 0 - | 4__ 1_ 4_ 1_ 5__ 2_ 5_ 2_ | 2__ 6__ 2_ 6__ 2__ - 0 - |

    /* 第四行 */
    | 5__ 2_ 4_ 2_ 6__ 3_ 1_ 3_ | 6__ 3_ 1_ 3_ 6__ - 0 - | 2__ 6__ 4_ 6__ 6__ 3_ 1_ 3_ |

    /* 第五行 */
    | 6__ 3_ 1_ 3_ 6__ - 0 - | 2__ 6__ 2_ 6__ 4__ 1_ 5__ 2_ | 1_ 5_ 1_ - - - 0 - |
}

