::SCORE::
** 雁の叫び **
!= 72
?= C
key= Am
<4/4>
~ "詞：鳥居忱"
~ "曲：露國民歌"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P053.jpg，書頁 p. 18，高一第二學期第 7 首）：
   調性與拍號：イ短調（無升降記號）、4/4 拍（靜カニ優美ニ ♩=72）

   雁（かり）の叫（さけ）び霧立（きりた）つ空（そら）の
   雁の叫び何處（いづこ）をあての
   旅（たび）より旅に　まよひやすらん
   あはれなる其（そ）の聲（こゑ）よ　思（おも）ふか父（ちち）を
   雁の叫び偲（しの）ぶか母（はは）を
   雁の叫び燈火暗（ともしびくら）き
   假寢（かりね）の窓（まど）に月影（つきかげ）さして
   さなきだに寂（さ）びしきを　吾夢（わがゆめ）やぶる
   雁の叫び人家（ひとや）もねむる
   雁の叫び
   ========================================================================= */

Intro:Piano@|0| {
    <8*>
    /* 第一行 */
    | {pp} 6_ - 3 - 3 - 0 - | 6_ - 2 - 2 - 0 - | 3 - 4 3 2 - 1 - | 7_ - 6_ - 7_ - 0 - |
}

Body:Piano@|0| {
    <8*>
    /* 第二行 */
    | {pp} 6_ - 3 - 3 - 0 - | 6_ - 2 - 2 - 0 - | 3 - 4 3 2 - 1 - | 7_ - 6_ - 7_ - 0 - |

    /* 第三行 */
    | {mf} 1 - - 1 7_ - 5_ - | 6_ - 7_ - 1 - 0 - | {f} 3 - - 3 2 - 7_ - | 1 - 2 - 3 - 0 - |

    /* 第四行 */
    | 4 - 3 - 2 - 1 - | 7_ - 6_ - 7_ - 3 - | 4 - 3 2 1 - 7_ - | 6_ - 6_ - 6_ - 0 - | {pp} 6_ - 3 - 3 - 0 - |

    /* 第五行前半 */
    | 6_ - 2 - 2 - 0 - | 3 - 4 3 2 - 7_ - | 6_ - 6_ - 6_ - 0 - |
}

Coda:Piano@|0| {
    <8*>
    /* 第五行後半（終結尾） */
    | {pp} 6_ - 6_ - 6_ - 0 - | 6_ - 6_ - 6_ - 0 - |
}

-> Intro -> Body -> Body -> Coda -> #
