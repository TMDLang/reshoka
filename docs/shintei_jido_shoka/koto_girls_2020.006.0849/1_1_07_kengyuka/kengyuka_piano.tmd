::SCORE::
** 牽牛花（鋼琴伴奏版） **
!= 108
?= F
<4/4>
~ "曲：Mendelssohn（教育唱歌集）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 {mf} 5_ |

    /* 第一行 */
    | 3 - 2 1 1 - 0 1 | 2 6 5 4 3 - 0 1 | 6 - 5 4 3 2 3 4 |

    /* 第二行 */
    | 3 - - 2 2 - 0 5_ | 3 - 2 1 1 - - 3 | 5 - 4 2 1 - 7_ 1 |

    /* 第三行 */
    | 2 1 7_ 1 4 - 3 2 | 1 - 7_ - 6_ - 6_ 6_ | 6_ 4 2 6_ 5_ - 1 3 | 2 - - - 1 - 0 - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1_ - [1] - | 4_ - [1] - | 4_ - [1] - |

    /* 第二行 */
    | 5__ - [5_] 0 | 1_ - [1] - | 5__ - [1] - |

    /* 第三行 */
    | 5__ - [5_] - | 1_ 5__ 6__ - | 2_ - 5__ - | 5__ - [1] 0 |
}

-> Main -> Main -> #
