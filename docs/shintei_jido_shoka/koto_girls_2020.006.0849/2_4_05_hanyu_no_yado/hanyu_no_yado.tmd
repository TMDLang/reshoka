::SCORE::
** 埴生の宿 **
!= 88
?= E,
<4/4>
~ "詞：里見義"
~ "曲：Bishop"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P116–P117.jpg，書頁 pp. 39–40，高二重音第 5 首）：
   調性與拍號：變ホ長調（3 降記號）、4/4 拍（溫和ニ ♩=88，三部重音合唱，弱起第 4 拍進入）
   出處註記：（中等唱歌集）

   一
   埴生（はにふ）の宿もわが宿
   玉のよそひうらやまじ
   のどかなりや　春のそら
   花はあるじ　鳥は友
   オーわがやどよ
   たのしともたのもしや

   二
   ふみよむ窓も　わが窓
   瑠璃の床も　うらやまじ
   きよらなりや　秋の夜半
   月はあるじ　蟲は友
   オーわが窓よ
   たのしとも　たのもしや
   ========================================================================= */

Main:Part1@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {p} 1 - 2 - |

    /* 第一行 */
    | 3 - - - - - 4 - 4 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 3 - 2 - | 4 - - - - - 3 - 4 - - - 2 - - - | 3 - - - - - - - 0 - - - 1 - 2 - |

    /* 第二行 */
    | 3 - - - - - 4 - 4 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 3 - 2 - | 4 - - - - - 3 - 4 - - - 2 - - - | 1 - - - - - - - 0 - - - {f} 5 - - - |

    /* 第三行 */
    | 1^ - - - - - 7 - 6 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 3 - 2 - | 4 - - - - - 3 - 4 - - - 2 - - - | 3 - - - - - - - 0 - - - {f} 5 - - - |

    /* 第四行 */
    | 1^ - - - - - 7 - 6 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 5 - - - | 6 - - - 4 - - - 3 - - - 2 - - - | 1 - - - - - - - 0 - - - 0 - - - |

    /* 第五行（第 40 頁） */
    | {pp} 5 - - - - - - - - - - - 0 - - - | {p} 1^ - - - - - - - 7 - - - - - - - | {mf} 6 - - - - - - - 5 - - - - - - - | {f} 5 - - - - - - - 0 - - - {ff} 5 - - - |

    /* 第六行 */
    | 1^ - - - - - 7 - 6 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 5 - - - | 6 - 4 - 3 - 4 - 3 - - - 2 - - - | 1 - - - - - - - - - - - 0 - - - |
}

