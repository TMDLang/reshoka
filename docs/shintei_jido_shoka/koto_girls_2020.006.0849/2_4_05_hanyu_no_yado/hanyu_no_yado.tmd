    /* 第一行 */
    | 1 - - - - - 2 - 2 - - - - - 3 - | 3 - - - 1 - - - 0 - - - 1 - 7_ - | 2 - - - - - 1 - 2 - - - 7_ - - - | 1 - - - - - - - 0 - - - 1 - 1 - |

    /* 第二行 */
    | 1 - - - - - 2 - 2 - - - - - 3 - | 3 - - - 1 - - - 0 - - - 1 - 7_ - | 2 - - - - - 1 - 2 - - - 7_ - - - | 1 - - - - - - - 0 - - - {f} 3 - - - |

