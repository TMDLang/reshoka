::SCORE::
** 埴生の宿（鋼琴伴奏版） **
!= 88
?= E,
<4/4>
~ "詞：里見義"
~ "曲：Bishop"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {p} 1 - 2 - |

    /* 第一行 */
    | 3 - - - - - 4 - 4 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 3 - 2 - | 4 - - - - - 3 - 4 - - - 2 - - - | 3 - - - - - - - 0 - - - 1 - 2 - |

    /* 第二行 */
    | 3 - - - - - 4 - 4 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 3 - 2 - | 4 - - - - - 3 - 4 - - - 2 - - - | 1 - - - - - - - 0 - - - {f} 5 - - - |

    /* 第三行 */
    | 1^ - - - - - 7 - 6 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 3 - 2 - | 4 - - - - - 3 - 4 - - - 2 - - - | 3 - - - - - - - 0 - - - {f} 5 - - - |

    /* 第四行 */
    | 1^ - - - - - 7 - 6 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 5 - - - | 6 - - - 4 - - - 3 - - - 2 - - - | 1 - - - - - - - 0 - - - 0 - - - |

    /* 第五行 */
    | {pp} 5 - - - - - - - - - - - 0 - - - | {p} 1^ - - - - - - - 7 - - - - - - - | {mf} 6 - - - - - - - 5 - - - - - - - | {f} 5 - - - - - - - 0 - - - {ff} 5 - - - |

    /* 第六行 */
    | 1^ - - - - - 7 - 6 - - - - - 5 - | 5 - - - 3 - - - 0 - - - 5 - - - | 6 - 4 - 3 - 4 - 3 - - - 2 - - - | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {p} 1 - 1 - |

    /* 第一行 */
    | 1 - - - - - 2 - 2 - - - - - 3 - | 3 - - - 1 - - - 0 - - - 1 - 7_ - | 2 - - - - - 1 - 2 - - - 7_ - - - | 1 - - - - - - - 0 - - - 1 - 1 - |

    /* 第二行 */
    | 1 - - - - - 2 - 2 - - - - - 3 - | 3 - - - 1 - - - 0 - - - 1 - 7_ - | 2 - - - - - 1 - 2 - - - 7_ - - - | 1 - - - - - - - 0 - - - {f} 3 - - - |

    /* 第三行 */
    | 3 - - - - - 5 - 4 - - - - - 3 - | 3 - - - 1 - - - 0 - - - 1 - 7_ - | 2 - - - - - 1 - 2 - - - 7_ - - - | 1 - - - - - - - 0 - - - {f} 3 - - - |

    /* 第四行 */
    | 3 - - - - - 5 - 4 - - - - - 3 - | 3 - - - 1 - - - 0 - - - 3 - - - | 4 - - - 2 - - - 1 - - - 7_ - - - | 1 - - - - - - - 0 - - - 0 - - - |

    /* 第五行 */
    | {pp} 7_ - - - - - - - - - - - 0 - - - | {p} 1 - - - - - - - 5_ - - - - - - - | {mf} 4_ - - - - - - - 5_ - - - - - - - | {f} 7_ - - - - - - - 0 - - - {ff} 1 - - - |

    /* 第六行 */
    | 3 - - - - - 5 - 4 - - - - - 3 - | 3 - - - 1 - - - 0 - - - 3 - - - | 4 - 2 - 1 - 2 - 1 - - - 7_ - - - | 1 - - - - - - - - - - - 0 - - - |
}

