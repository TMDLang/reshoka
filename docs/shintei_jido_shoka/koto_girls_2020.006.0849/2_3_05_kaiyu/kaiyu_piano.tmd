::SCORE::
** 懷友（鋼琴伴奏版） **
!= 84
?= C
<4/4>
~ "詞：武島羽衣"
~ "曲：Tomer"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mp} 3 - - - 3 - 3 - 3 - 3 - 3 - 3 - | 5 - - 6 5 - - - 3 - - - 0 - - - | 1 - - - 1 - 1 - 1 - 1 - 1 - 1 - | {mf} 3 - - - - - - - 2 - - - 0 - - - |

    /* 第二行 */
    | {mp} 3 - - - 3 - 3 - 3 - 3 - 3 - 3 - | 5 - - - - - - - 3 - - - 0 - - - | 1 - - - 3 - 5 - 1^ - - 7 1^ - 6 - | 5 - - - 3 - - - 1 - - - - - 0 - |

    /* 第三行 */
    | 3 - - 4 5 - 1^ - {f} 2^ - - 1^ 7 - 6 - | 5 - - - 1^ - - - 1^ - - - - - 0 - | 7 - - 6 5 - 5 - 5 - - - 4 - 2 - | 3 - - - - - - - - - - - - - 0 - |

    /* 第四行 */
    | 3 - - 2 1 - 2 - 3 - - - {f} 1^ - - 6 | 5 - - - 3 - - - 2 - - - - - 0 - | 4 - - 5 {mf} 6 - 4 - 3 - 1 - 2 - - 1 | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | {p} 1_ [1] 1_ [1] | 1_ [1] 1_ 0 | 4__ [4_] 4__ [4_] | {mp} 1_ [1] 5__ 0 |

    /* 第二行 */
    | {p} 1_ [1] 1_ [1] | 1_ [1] 1_ 0 | 1_ [1] 4__ [4_] | 5__ [1] 1_ 0 |

    /* 第三行 */
    | 1_ [1] {f} 5__ [5_] | 1_ [1] 1_ 0 | 5__ [5_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第四行 */
    | 1_ [1] {f} 4__ [4_] | 1_ [1] 5__ 0 | {mf} 4__ [4_] 5__ [5_] | 1_ [1] 1_ 0 |
}

-> Main -> #

