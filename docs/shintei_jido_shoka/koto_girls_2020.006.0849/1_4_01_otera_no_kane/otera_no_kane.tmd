::SCORE::
** 御寺の鐘の音 **
!= 92
?= C
<4/4>
~ "出處：（小學唱歌集）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P070.jpg，書頁 p. 35，高一輪唱第 1 首）：
   調性與拍號：ハ長調（無升降記號）、4/4 拍（三部輪唱，快活ニ ♩=92）
   出處註記：（小學唱歌集）

   一
   みてらの鐘の音月よりおつる
   ふみよむ燈火かすかになりて
   一二三四五六七八

   二
   月影かたぶき霜さえわたり
   ねよとの鐘の音枕にひゞく
   一二三四五六七八

   三
   漁火しめりて霜天にみち
   姑蘇城外なる鐘かもきこゆ
   一二三四五六七八
   ========================================================================= */

Main:Part1@|0| {
    <8*>
    /* 第一行 (1) */
    | 1 - 7_ 6_ 5_ - - - | 5_ - 4_ 3_ 2_ - 5_ - | 0 - 5_ 5_ 6_ - 5_ - | 4_ - 3_ 2_ 3_ - - - |

    /* 第二行 (2) */
    | 3_ - 2_ 1_ 5_ - - - | 3_ - 2_ - 5_ - 5_ - | 0 - 3_ 3_ 4_ - 3_ - | 2_ - 1_ 7__ 1_ - - - |

    /* 第三行 (3) */
    | 1_ - - - 1_ - - - | 1_ - - - 1_ - - - | 1_ - - - 1_ - - - | 1_ - - - 1_ - - - |

    /* 等待第二、三部結束 (8 小節) */
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - |
    | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - | 0 - - - - - - - |
}

