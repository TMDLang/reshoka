::SCORE::
** 秋の聲（鋼琴伴奏版） **
!= 100
?= G
key= Em
<6/8>
~ "編：北村季晴（北村中等音樂教科書）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <8*>
    /* 第一行 */
    | {mf} 6_ 1 3 3 - 3 | 4 - - 3 - - | 2 1 2 3 - 4 | 3 - - - - 0 |

    /* 第二行 */
    | 6_ 1 3 3 - 6_ | 7_ - - 3_ - - | 6_ 7_ 1 2 - 1 | 7_ - - - - 0 |

    /* 第三行 */
    | {f} 3 2 3 4 - 3 | 6 - - 5 - 3 | 2 1 2 3 - 6 | 3 - - - - 0 |

    /* 第四行 */
    | {mf} 6_ 7_ 1 2 - 3 | 4 - - 3 - 6_ | 3 2 1 7_ - 1 | 6_ - - - - 0 |
}

Main:PianoLH@|0| {
    <8*>
    /* 第一行 */
    | 6__ - - [6_m] - - | 4_ - - [6_m] - - | 2_ - - [6_m] - - | 3_ - - [3_] - 0 |

    /* 第二行 */
    | 6__ - - [6_m] - - | 3_ - - [3_] - - | 6__ - - [2_m] - - | 3_ - - [3_] - 0 |

    /* 第三行 */
    | 6__ - - [6_m] - - | 4_ - - [1] - - | 5__ - - [6_m] - - | 3_ - - [3_] - 0 |

    /* 第四行 */
    | 6__ - - [2_m] - - | 4_ - - [6_m] - - | 3_ - - [3_] - - | 6__ - - [6_m] - 0 |
}

-> Main -> Main -> #
