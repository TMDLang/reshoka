::SCORE::
** 他郷の月（鋼琴伴奏版） **
!= 88
?= E,
<4/4>
~ "詞：中村秋香"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {p} 1 - - - - - 2 - 3 - 5 - 4 - 3 - | 3 - - - 2 - - - 0 - - - 0 - - - | 1 - - - - - 3 - 5 - 3 - 2 - 1 - | 7_ - - - - - - - - - - - 0 - - - |

    /* 第二行 */
    | {mp} 1 - - - - - 2 - 3 - 5 - 4 - 3 - | 6 - - - 5 - - - 0 - - - 0 - - - | {f} 1^ - - - - - 7 - 6 - 1^ - 5 - 3 - | 4 - - - - - - - 5 - - - - - - - |

    /* 第三行 */
    | {mf} 6 - - - - - 6 - 5 - 3 - 4 - 5 - | 4 - - - 3 - - - 0 - - - 0 - - - | {mp} 1^ - - - - - 7 - 6 - 5 - 4 - 3 - | 2 - - - - - - - - - - - 0 - - - |

    /* 第四行 */
    | 1 - - - - - 2 - 3 - 5 - 4 - 3 - | 6 - - - 2 - - - 0 - - - 0 - - - | 5 - - - - - 6 - 5 - 3 - 1 - 2 - | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <8*>
    /* 第一行 */
    | {p} 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 5__ 2_ 5_ 2_ 5__ - 0 - | 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 5__ 2_ 5_ 2_ 5__ - 0 - |

    /* 第二行 */
    | {mp} 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 4__ 1_ 4_ 1_ 1_ - 0 - | {f} 6__ 3_ 4__ 1_ 1_ 5_ 3_ 5_ | 2_ 6_ 4_ 6_ 5__ 2_ 5_ 2_ |

    /* 第三行 */
    | {mf} 4__ 1_ 4_ 1_ 1_ 5_ 3_ 5_ | 5__ 2_ 1_ 5_ 1_ - 0 - | {mp} 6__ 3_ 4__ 1_ 1_ 5_ 6__ 3_ | 5__ 2_ 5_ 2_ 5__ - 0 - |

    /* 第四行 */
    | 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 4__ 1_ 2_ 6_ 2_ - 0 - | 5__ 2_ 4__ 1_ 1_ 5_ 5__ 2_ | 1_ 5_ 1_ - - - 0 - |
}

