::SCORE::
** 愛らしき花（鋼琴伴奏版） **
!= 88
?= D
<3/4>
~ "出處：檢定唱歌集"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {mp} 3 - 3 - |

    /* 第一行 */
    | 5 - - - - - 3 - 1 - - - | 2 - - - 0 - - - {mf} 3 - 5 - | 1^ - - - 7 - - 6 5 - - - | 6 - - - - - - - {mp} 5 - 6 - |

    /* 第二行 */
    | 5 - - - - - 3 - 1 - 3 - | 2 - - - 0 - - - {mf} 3 - 5 - | 1^ - 3 - 2 - - - - - 7 - | 1^ - - - - - - - 2 - 2 - |

    /* 第三行 */
    | {f} 6 - - - - - - - 4 - 2 - | 5 - - - - - - - 3 - 1 - | {mf} 2 - - - 3 - - - 4 - - - | 5 - - - - - - - 2 - 2 - |

    /* 第四行 */
    | {f} 7 - - - - - - - 5 - 4 - | 3 - - - - - - - 1 - 1 - | {mf} 4 - - - 2 - - - {p} 7_ - - - | 1 - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - |

    /* 第一行 */
    | {mp} 1_ 5_ 3_ 5_ 3_ 5_ | 5__ 2_ 7__ 2_ 1_ 0 | 4__ 1_ 5__ 2_ 6__ 3_ | 5__ 2_ 7__ 2_ 5__ 0 |

    /* 第二行 */
    | 1_ 5_ 3_ 5_ 3_ 5_ | 5__ 2_ 7__ 2_ 1_ 0 | 4__ 1_ 5__ 2_ 5__ 2_ | 1_ 5_ 3_ 5_ 1_ 0 |

    /* 第三行 */
    | {mf} 5__ 2_ 7__ 2_ 7__ 2_ | 1_ 5_ 3_ 5_ 1_ 0 | 5__ 2_ 1_ 3_ 2_ 4_ | 5__ 2_ 5_ 2_ 5__ 0 |

    /* 第四行 */
    | {mf} 5__ 2_ 7__ 2_ 7__ 2_ | 1_ 5_ 3_ 5_ 1_ 0 | 2__ 6__ 5__ 2_ {p} 5__ 2_ | 1_ 5_ 1_ - 0 - |
}

-> Main -> #

