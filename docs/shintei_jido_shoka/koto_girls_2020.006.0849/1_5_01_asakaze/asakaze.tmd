::SCORE::
** 朝風 **
!= 84
?= F
<4/4>
~ "詞：桑田春風"
~ "曲：F. Silcher（シルヘル）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P072.jpg，書頁 p. 37，高一重音第 1 首）：
   調性與拍號：ヘ長調（1 降記號）、4/4 拍（二重音，氣持ヨク ♩=84）

   一
   霞（かす）める空　ほのぼのと
   櫻に吹く　朝の風

   二
   花にや寢（ね）し　小鳥啼く
   起きよや早や　夜は明（あ）けぬ

   三
   心地ぞよき　朝の風
   吹かせよ身に　疾（と）く起きて
   ========================================================================= */

Main:Part1@|0| {
    <8*>
    /* 第一行 */
    | {mf} 1 - 3 - - 4 3 - | 2 - - - 1 - 2 - | 3 - 4 - 5 - 3 - | 2 - - - 0 - - - |

    /* 第二行 */
    | 1 - 2 - 3 - 4 - | {f} 5 - - - 4 - {mf} 2 - | 1 - 3 - 2 - 4 - | 1 - - - 0 - - - |
}

Main:Part2@|0| {
    <8*>
    /* 第一行 */
    | {mf} 1 - 1 - - 2 1 - | 7_ - - - 5_ - 7_ - | 1 - 2 - 3 - 1 - | 7_ - - - 0 - - - |

    /* 第二行 */
    | 6_ - 7_ - 1 - 2 - | {f} 3 - - - 2 - {mf} 7_ - | 6_ - 1 - 7_ - 5_ - | 1 - - - 0 - - - |
}

