::SCORE::
** 臺灣の歌（鋼琴伴奏版） **
!= 120
?= B,
<4/4>
~ "詞：內田隆（昭和6年臺灣教育會選歌）"
~ "曲：信時潔"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

VerseBody:PianoRH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - {mf} 5_ - |

    /* 第一行 */
    | 3_ - - 5_ 1 - 2 - | 3 - - - 2 - 1 - | 6_ - - - 5_ - 6_ - | 5_ - - - - 0 {f} 5_ - |

    /* 第二行 */
    | 3_ - - 5_ 1 - 3 - | 5 - - - 3 - 1 - | 2 - - - 3 - 1 - | 6_ - - - - 0 {mf} 3_ - |

    /* 第三行 */
    | 4_ - - 5_ 6_ - 7_ 1 | 6_ - - 6_ 5_ - 6_ - | 4 - - - 3 - 6_ - | 2 - - - - 0 5_ - |

    /* 第四行 */
    | 3_ - - 5_ 1 - 3 - | 5 - - - 3 - 1 - | 2 - - - 6_ - 4_ - | 5_ - - - - 0 {mp} 3_ - |

    /* 第五行 */
    | 3_ - - - 6_ - 5_ - | 6_ - - 7_ 1 - 6_ - | 5_ - - - 2 - 1 - | 6_ - - - - 0 {mf} 4_ - |

    /* 第六行 */
    | 4_ - - 4_ 1 - 6_ - | 3 - - - 2 - {f} 3 - | 4 - - - 3 - 1 - | 2 - - - - 0 {mf} 3_ - |

    /* 第七行 */
    | 3_ - - 5_ 6_ - 5_ 4_ | 3_ - - 5_ 6_ - 7_ 1 | 2 - 1 - {f} 2 - 3 - | 5 - - - 3 - 1 - |

    /* 第八行前半 */
    | 2 - - 3 2 - 1 - |
}

VerseBody:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |
    /* 第一行 */
    | 1_ - [1] - | 1_ - [5_] - | 6__ - [6_m] - | 5__ - [5_] 0 |
    /* 第二行 */
    | 1_ - [1] - | 4_ - [1] - | 2_ - [5_] - | 6__ - [6_m] 0 |
    /* 第三行 */
    | 4_ - [4_] - | 6__ - [6_m] - | 2_ - [2_m] - | 5__ - [5_] 0 |
    /* 第四行 */
    | 1_ - [1] - | 4_ - [1] - | 2_ - [2_m] - | 5__ - [5_] 0 |
    /* 第五行 */
    | 6__ - [6_m] - | 4_ - [1] - | 2_ - [5_] - | 6__ - [6_m] 0 |
    /* 第六行 */
    | 4_ - [4_] - | 2_ - [5_] - | 4_ - [1] - | 5__ - [5_] 0 |
    /* 第七行 */
    | 6__ - [6_m] - | 3_ - [6_m] - | 2_ - [5_] - | 1_ - [1] - |
    /* 第八行前半 */
    | 2_ - [5_] - |
}

Ending123:PianoRH@|0| {
    <8*>
    | 2 - - - 3 - 1 - | 6_ - - - - 0 0 - |
}

Ending123:PianoLH@|0| {
    <4*>
    | 2_ - [5_] - | 6__ - [6_m] 0 |
}

Ending4:PianoRH@|0| {
    <8*>
    | 2 - - - 1 - 2 - | 3 - - - - - 0 - |
}

Ending4:PianoLH@|0| {
    <4*>
    | 2_ - [5_] - | 1_ - [1] 0 |
}

-> VerseBody -> Ending123 -> VerseBody -> Ending4 -> #
