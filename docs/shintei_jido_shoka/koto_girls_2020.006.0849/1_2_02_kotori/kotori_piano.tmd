~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mf} 5_ - - 5_ 5_ - - - 5_ - - - | 1 - - 2 3 - - - 2 - - - | 1 - - 6_ 5_ - - - 1 - - - | 5_ - - 5_ 5_ - - 5_ 1 - 2 - |

    /* 第二行 */
    | 3 - - 2 1 - - - 2 - - - | 3 - - 3 2 - - - 5 - - - | 3 - - 2 1 - - - 6_ - - - | 5_ - - 1 2 - - - 0 - - - |

    /* 第三行 */
    | 3 - - 3 2 - - - 5 - - - | 3 - - 2 1 - - - 6_ - - - | 5_ - - 1 7_ - - 6_ 5_ - - 0 | {p} 5_ - - 5_ 6_ - - 6_ 7_ - 7_ - |

    /* 第四行 */
    | 1 - - 1 2 - - - 3 - - - | 2 - - 3 4 - - - 2 - - - | {f} 5 - - 3 1 - - - 6_ - 2 - | 1 - - 7_ 2 - - 1 1 - - 0 |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 1_ [1] [1] | 1_ [1] [5_] | 1_ [1] [1] | 5__ [5_] [5_] |

    /* 第二行 */
    | 1_ [1] [5_] | 1_ [5_] [5_] | 1_ [1] [4_] | 5__ [5_] 0 |

    /* 第三行 */
    | 1_ [5_] [5_] | 1_ [1] [4_] | 5__ [5_] [1] | 5__ [4_] [5_] |

    /* 第四行 */
    | 1_ [5_] [1] | 5__ [5_] [5_] | 1_ [1] [4_] | 5__ [5_] [1] |
}

