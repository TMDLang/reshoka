::SCORE::
** 歸帆（鋼琴伴奏版） **
!= 92
?= G
<3/4>
~ "詞：杉谷代水"
~ "曲：Berg（德國曲）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <8*>
    /* 第一行 */
    | {p} 1 - 3 - - 5_ | 1 - - - 0 - | {mp} 1 - 4 - - 6 | 5 - - - 0 - |

    /* 第二行 */
    | {mp} 5 - 3 - - 1 | 2 - - - 0 - | 5 - 3 - - 1 | 7_ - - - 7,_ - | 6_ - 2 - - 1 |

    /* 第三行（復唱段第一次） */
    | 7_ - - 5_ - 1 | 2 - 1 - - 4 | 3 - - - 0 - | {f} 5 - 3 - 6 - | 5 - 1 - 0 - |

    /* 第四行（一括號） */
    | {mp} 5_ - 1 - - 2 | 7_ - - - 7,_ - | 6_ - 2 - - 1 |

    /* 第三行（復唱段第二次） */
    | 7_ - - 5_ - 1 | 2 - 1 - - 4 | 3 - - - 0 - | {f} 5 - 3 - 6 - | 5 - 1 - 0 - |

    /* 第四行（二括號） */
    | {p} 5_ - 1 - - 7_ | 1 - - - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 第一行 */
    | {p} 1_ 5_ 3_ 5_ 3_ 5_ | 1_ 5_ 3_ 5_ 1_ 0 | 4__ 1_ 4_ 1_ 4_ 1_ | 1_ 5_ 3_ 5_ 1_ 0 |

    /* 第二行 */
    | 1_ 5_ 3_ 5_ 3_ 5_ | 5__ 2_ 7__ 2_ 5__ 0 | 1_ 5_ 3_ 5_ 3_ 5_ | 2_ 6_ 4_ 6_ 2_ 0 | 6__ 3_ 2_ 6_ 4_ 0 |

    /* 第三行（復唱段第一次） */
    | 5__ 2_ 7__ 2_ 5__ 2_ | 5__ 2_ 1_ 5_ 4_ 0 | 1_ 5_ 3_ 5_ 1_ 0 | {mf} 5__ 3_ 1_ 3_ 4__ 1_ | 5__ 3_ 1_ 5_ 3_ 0 |

    /* 第四行（一括號） */
    | {mp} 5__ 2_ 1_ 5_ 3_ 5_ | 2_ 6_ 4_ 6_ 2_ 0 | 6__ 3_ 2_ 6_ 4_ 0 |

    /* 第三行（復唱段第二次） */
    | 5__ 2_ 7__ 2_ 5__ 2_ | 5__ 2_ 1_ 5_ 4_ 0 | 1_ 5_ 3_ 5_ 1_ 0 | {mf} 5__ 3_ 1_ 3_ 4__ 1_ | 5__ 3_ 1_ 5_ 3_ 0 |

    /* 第四行（二括號） */
    | {p} 5__ 2_ 5_ 2_ 5__ 2_ | 1_ 5_ 1_ - 0 - |
}

-> Main -> #

