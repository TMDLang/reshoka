::SCORE::
** 大和魂（鋼琴伴奏版） **
!= 108
?= C
<4/4>
~ "詞：佐々木信綱（女子音樂教科書）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {f} 5_ - 5_ 5_ 1 - 1 - |

    /* 第一行 */
    | 2 - - - 2 - - - 3 - - - 5 - 3 - | 2 - - - 1 - - - 6_ - - - 1 - - - | 5_ - - - - - - - 0 - - - 0 - 5_ - |

    /* 第二行 */
    | 5_ - 4'_ - 5_ - 6_ - 1 - - - 2 - - - | 3 - - - 2 - - - 1 - - - 0 - 5 - | 5 - 3 2 1 - 2 - 3 - 1 - 6_ - - - |

    /* 第三行 */
    | 6_ - - - 5_ - - - 0 - 5_ - 1 - 1 - | 1 - - - 7_ - 1 - 2 - 2 - 5_ - 1 2 | 3 - 3 - 2 - 2 - 1 - 3 - 2 - 1 7_ |

    /* 第四行 */
    | 6_ - - 7_ 1 - 6_ - 5_ - - - 1 - - 2 | 3 - - - 0 - - - 0 - - - 2 - - 1 | 6_ - - - 0 - - - 0 - - - 1 - - 1 |

    /* 第五行 */
    | 5_ - - - 1 - - - 2 - - - 3 - 2 - | 1 - - 2 3 - 4 - 5 - - - 6 - - 6 | 5 - - - - - - - 0 - - - 3 - - 2 |

    /* 第六行 */
    | 1 - - - - - - - 0 - - - 2 - - 1 | 7_ - - 1 2 - 3 - 4 - - - 6 - 4 - | 3 - - - 2 - - - 1 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 1_ [1] |

    /* 第一行 */
    | 5__ [5_] 1_ [1] | 5__ [1] 4_ [4_] | 5__ [5_] 5__ 0 |

    /* 第二行 */
    | 5__ [5_] 1_ [5_] | 1_ [5_] 1_ 0 | 1_ [1] 6__ [6_m] |

    /* 第三行 */
    | 4_ [5_] 0 1_ | 4_ [4_] 5__ [5_] | 1_ [5_] 6__ [5_] |

    /* 第四行 */
    | 4_ [4_] 1_ [1] | 1_ [1] 0 5__ | 6__ [6_m] 0 4_ |

    /* 第五行 */
    | 1_ [1] 5__ [5_] | 1_ [1] 1_ [4_] | 5__ [5_] 5__ 0 |

    /* 第六行 */
    | 1_ [1] 1_ 0 | 5__ [5_] 4_ [4_] | 5__ [5_] 1_ 0 |
}

