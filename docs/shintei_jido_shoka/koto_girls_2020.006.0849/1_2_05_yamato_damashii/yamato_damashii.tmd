::SCORE::
** 大和魂 **
!= 108
?= C
<4/4>
~ "詞：佐々木信綱（女子音樂教科書）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P050.jpg – P051.jpg，書頁 pp. 15–16，高一第二學期第 5 首）：
   調性與拍號：ハ長調（無升降記號）、4/4 拍（♩=108，弱起後半小節進入）

   一、
   大君（おほぎみ）のみ民（たみ）と生（うま）れしからは
   砲（つつ）こそは肩（かた）にせね太刀（たち）こそ佩（は）かね
   國思（くにおも）ふ心丈夫（こころますらを）におとらじな
   はげめはげめ誠（まこと）もてたゆみなく
   はげめはげめ國のため一（ひと）すぢに

   二、
   國につくす道（みち）さはにあれども
   わがつとめ怠（おこた）らで家（いへ）とゝのへよ
   これぞ國の名（な）を世（よ）にあげん基（もとゐ）なる
   はげめはげめ誠もてたゆみなく
   はげめはげめ家のため一すぢに
   ========================================================================= */

Main:Piano@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {f} 5_ - 5_ 5_ 1 - 1 - |

    /* 第一行 */
    | 2 - - - 2 - - - 3 - - - 5 - 3 - | 2 - - - 1 - - - 6_ - - - 1 - - - | 5_ - - - - - - - 0 - - - 0 - 5_ - |

    /* 第二行 */
    | 5_ - 4'_ - 5_ - 6_ - 1 - - - 2 - - - | 3 - - - 2 - - - 1 - - - 0 - 5 - | 5 - 3 2 1 - 2 - 3 - 1 - 6_ - - - |

    /* 第三行 */
    | 6_ - - - 5_ - - - 0 - 5_ - 1 - 1 - | 1 - - - 7_ - 1 - 2 - 2 - 5_ - 1 2 | 3 - 3 - 2 - 2 - 1 - 3 - 2 - 1 7_ |

    /* 第四行 */
    | 6_ - - 7_ 1 - 6_ - 5_ - - - 1 - - 2 | 3 - - - 0 - - - 0 - - - 2 - - 1 | 6_ - - - 0 - - - 0 - - - 1 - - 1 |

    /* 第五行 */
    | 5_ - - - 1 - - - 2 - - - 3 - 2 - | 1 - - 2 3 - 4 - 5 - - - 6 - - 6 | 5 - - - - - - - 0 - - - 3 - - 2 |

    /* 第六行 */
    | 1 - - - - - - - 0 - - - 2 - - 1 | 7_ - - 1 2 - 3 - 4 - - - 6 - 4 - | 3 - - - 2 - - - 1 - - - 0 - - - |
}

-> Main -> Main -> #
