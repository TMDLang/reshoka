::SCORE::
** 忠臣 **
!= 100
?= D
key= Bm
<3/4>
~ "出處：（小學唱歌集）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P074.jpg – P075.jpg，書頁 pp. 39–40，高一重音第 3 首）：
   調性與拍號：ロ短調（2 升記號）、3/4 拍（想ヲ込メテ ♩=100）
   出處註記：（小學唱歌集）

   一
   嗚呼香ぐはし　楠の二本（ふたもと）　あゝ絶（た）えせじ
   みなと川　浪の音も　身にぞしむなる
   そのあはれ　その功績（いさを）　忠臣　嗚呼忠臣
   兄弟の人　忠臣あゝ忠臣　たぐひなや

   二
   嗚呼かぐはし　花の二もと　あゝうるはし
   吉野やま　ちりはてゝ　世にこそのこれ
   そのうたと　そのまこと　忠臣あゝ忠臣
   兄弟の人　忠臣嗚呼忠臣　たぐひなや
   ========================================================================= */

Main:Part1@|0| {
    <16*>
    /* 第一行 */
    | {mf} 1 - - - - - 0 - 6_ - 7_ - | 3 - - - 3 - - - 0 - - - |
    | 2 - 2 - 3 - - - - - 2 - | 1 - 2 - 3 - - - 0 - - - |

    /* 第二行 */
    | 6 - - - - - 0 - 4 - 2 - | 1 - - - 7_ - - - 0 - - - |
    | {p} 2 - 2 - 6_ - - - 7_ - - - | 6_ - - - - - - - 0 - - - |

    /* 第三行 */
    | {mf} 1 - 1 - 3 - - - - - 4 - | 3 - - - 2 - - - 0 - - - |
    | {mp} 1 - 1 - 2 - - - - - 3 - | 2 - 1 - 7_ - - - 0 - - - |

    /* 第四行 */
    | {mf} 3 - 4 - 5 - - - - - 3 - | 4 - - - 3 - - - 0 - - - |
    | {p} 2 - 2 - 6_ - - - 7_ - - - | 6_ - - - - - - - 0 - - - |

    /* 第五行 */
    | {f} 1 - - - 1 - - - 1 - - - | 2 - - - 2 - - - 0 - - - |
    | 1 - - - 3 - - - - - 4 - | 3 - 2 - 3 - - - 0 - - - |

    /* 第六行 */
    | {p} 2 - - - 2 - - - 2 - - - | 3 - - - 3 - - - 0 - - - |
    | {mp} 2 - 2 - 6 - - - 3 - - - | 6_ - - - - - - - 0 - - - |
}

Main:Part2@|0| {
    <16*>
    /* 第一行 */
    | {mf} 6_ - - - - - 0 - 4_ - 5'_ - | 1 - - - 6_ - - - 0 - - - |
    | 7_ - 7_ - 1 - - - - - 7_ - | 6_ - 7_ - 1 - - - 0 - - - |

    /* 第二行 */
    | 1 - - - - - 0 - 2 - 7_ - | 6_ - - - 3_ - - - 0 - - - |
    | {p} 5_ - 5_ - 4_ - - - 3_ - - - | 6_ - - - - - - - 0 - - - |

    /* 第三行 */
    | {mf} 6_ - 6_ - 1 - - - - - 2 - | 1 - - - 7_ - - - 0 - - - |
    | {mp} 6_ - 6_ - 5_ - - - - - 5_ - | 4_ - 4_ - 3_ - - - 0 - - - |

    /* 第四行 */
    | {mf} 1 - 2 - 3 - - - - - 1 - | 2 - - - 1 - - - 0 - - - |
    | {p} 5_ - 5_ - 4_ - - - 3_ - - - | 6_ - - - - - - - 0 - - - |

    /* 第五行 */
    | {f} 4_ - - - 4_ - - - 4_ - - - | 5_ - - - 5_ - - - 0 - - - |
    | 6_ - - - 1 - - - - - 2 - | 1 - 7_ - 1 - - - 0 - - - |

    /* 第六行 */
    | {p} 7_ - - - 7_ - - - 7_ - - - | 1 - - - 1 - - - 0 - - - |
    | {mp} 5_ - 5_ - 1 - - - 7_ - - - | 6_ - - - - - - - 0 - - - |
}

