** 寧樂の都 **
!= 66
?= E,
<6/8>
~ "出處：小學唱歌集"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P098–P099.jpg，書頁 pp. 21–22，高二第二學期第 8 首）：
   調性與拍號：變ホ長調（3 降記號）、6/8 拍（優美ニ ♩.=66，弱起最後 1 八分音符進入）
   出處註記：（小學唱歌集）

   一
   ならのみやこのそのむかし
   みやびつくして宮（みや）びとの
   遊（あそ）びましけん龍田川原（たつたがはら）の紅葉（もみぢば）
   たつたがはらのもみぢば
   今（いま）もにほふ
   ちしほの色（いろ）にのこるかたみは
   千代（ちよ）もくちせず今かいまかと
   君（きみ）をまつらんその紅葉（もみぢ）

   二
   ふるきみやこのそのむかし
   櫻（さくら）かざしておほきみの
   あそびましけん滋賀（しが）の花園（はなぞの）
   はなさきしがの花ぞの
   花（はな）さき今もにほふ
   色香（いろか）をそへてゑめる姿（すがた）は
   千代もかはらず今や今やと
   行幸（みゆき）まつらんその花は
   ========================================================================= */

Main:Piano@|-1|{
    <16*>
    /* 弱起小節：ナ */
    | 0 - 0 - 0 - 0 - 0 - {mf} 1 - |
    L1| _ - _ - _ - _ - _ - ナ - |
    L2| _ - _ - _ - _ - _ - フ - |

    /* ================= 第一行 (4 小節, P098.jpg) ================= */
    /* ラ ノ ミ ー ヤ | コ ー ノ | ソ ノ ム カ | シ ー ミ */
    | 1 - - - 1 - 1 - 2 - 3 - | 5 - - - 6 - 5 - - - - - | {p} 1 - - - 1 - 2 - - - 3 - | 2 - - - - - - - - - {mf} 1 - |
    L1| ラ - - - ノ - ミ - ー - ヤ - | コ - - - ー - ノ - - - - - | ソ - - - ノ - ム - - - カ - | シ - - - - - - - - - ミ - |
    L2| ル - - - キ - ミ - ー - ヤ - | コ - - - ー - ノ - - - - - | ソ - - - ノ - ム - - - カ - | シ - - - - - - - - - サ - |

    /* ================= 第二行 (4 小節, P098.jpg) ================= */
    /* ヤ ビ ツ ー ク | シ ー テ | ミ ヤ ビ ト ー | ノ ー ア */
    | 1 - - - 1 - 1 - 2 - 3 - | 5 - - - 6 - 5 - - - - - | {p} 2 - 2 - 2 - 3 - - - 2 - | 1 - - - - - - - - - {f} 5 - |
    L1| ヤ - - - ビ - ツ - ー - ク - | シ - - - ー - テ - - - - - | ミ - ヤ - ビ - ト - - - ー - | ノ - - - - - - - - - ア - |
    L2| ク - - - ラ - カ - ー - ザ - | シ - - - ー - テ - - - - - | オ - ー - ホ - キ - - - ミ - | ノ - - - - - - - - - ア - |

    /* ================= 第三行 (4 小節, P098.jpg) ================= */
    /* ソ ビ マ シ | ケ ン タ | ツ タ ガ ー ハ | ラ ー ノ モ */
    | 6 - - - 6 - 6 - - - 1^ - | 5 - - - - - 5 - - - {mf} 3 - | 2 - - - 2 - 2 - 1 - 2 - | 3 - - - 4 - 5 - - - {f} 5 - |
    L1| ソ - - - ビ - マ - - - シ - | ケ - - - - - ン - - - タ - | ツ - - - タ - ガ - ー - ハ - | ラ - - - ー - ノ - - - モ - |
    L2| ソ - - - ビ - マ - - - シ - | ケ - - - - - ン - - - シ - | ガ - - - ノ - ハ - ー - ナ - | ゾ - - - ー - ノ - - - ハ - |

    /* ================= 第四行 (5 小節, P098.jpg) ================= */
    /* ミ ヂ | ハ ー タ | ツ タ ガ ー ハ | ラ ノ モ | ミ ヂ */
    | 6 - - - - - 1^ - - - - - | 5 - - - - - - - - - 3 - | 2 - - - 2 - 2 - 1 - 2 - | 3 - - - - - 1 - - - {f} 5 - | 6 - - - - - 1^ - - - - - |
    L1| ミ - - - - - ヂ - - - - - | ハ - - - - - - - - - タ - | ツ - - - タ - ガ - ー - ハ - | ラ - - - - - ノ - - - モ - | ミ - - - - - ヂ - - - - - |
    L2| ナ - - - - - サ - - - - - | キ - - - - - - - - - シ - | ガ - - - ノ - ハ - ー - ナ - | ゾ - - - - - ノ - - - ハ - | ナ - - - - - サ - - - - - |

    /* ================= 第五行 (4 小節, P098.jpg) ================= */
    /* バ ー イ | マ モ ニ ホ | フ ー | チ ー シ ホ */
    | 5 - - - - - - - - - {p} 3 - | 2 - - - 2 - 3 - - - 2 - | 1 - - - - - - - - - - - | {f} 1^ - - - - - - - 7 - 6 - |
    L1| バ - - - - - - - - - イ - | マ - - - モ - ニ - - - ホ - | フ - - - - - - - - - - - | チ - - - - - - - シ - ホ - |
    L2| キ - - - - - - - - - イ - | マ - - - モ - ニ - - - ホ - | フ - - - - - - - - - - - | イ - - - - - - - ロ - カ - |

    /* ================= 第六行 (4 小節, P098.jpg) ================= */
    /* ノ ー | イ ー ロ ー | ニ ー ノ | コ ル カ ー タ */
    | 5 - - - - - - - - - - - | 5 - - - - - 4' - 3 - 4' - | 5 - - - - - - - - - 3 - | 1 - - - 1 - 1 - 2 - 3 - |
    L1| ノ - - - - - - - - - - - | イ - - - - - ー - ロ - ー - | ニ - - - - - - - - - ノ - | コ - - - ル - カ - ー - タ - |
    L2| ヲ - - - - - - - - - - - | ソ - - - - - ー - ヘ - ー - | テ - - - - - - - - - ヱ - | メ - - - ル - ス - ー - ガ - |

    /* ================= 第七行 (4 小節, P099.jpg) ================= */
    /* ミ ー ハ チ | ヨ モ ク チ | セ ズ イ | マ カ イ ー マ */
    | 5 - - - 6 - 5 - - - 5 - | 6 - - - 6 - 6 - - - 1^ - | 5 - - - - - 5 - - - {p} 3 - | 1 - - - 1 - 1 - 2 - 3 - |
    L1| ミ - - - ー - ハ - - - チ - | ヨ - - - モ - ク - - - チ - | セ - - - - - ズ - - - イ - | マ - - - カ - イ - ー - マ - |
    L2| タ - - - ー - ハ - - - チ - | ヨ - - - モ - カ - - - ハ - | ラ - - - - - ズ - - - イ - | マ - - - ヤ - イ - ー - マ - |

    /* ================= 第八行 (5 小節, P099.jpg) ================= */
    /* カ ー ト | キ ミ ヲ マ ツ | ラ ン ソ | ノ モ ミ ー | ヂ ー */
    | 5 - - - 6 - 5 - - - - - | 3 - 3 - 3 - 2 - - - 2 - | 3 - - - - - 5 - - - 3 - | 2 - - - 2 - 3 - - - 2 - | 1 - - - - - - - - - 0 - |
    L1| カ - - - ー - ト - - - - - | キ - ミ - ヲ - マ - - - ツ - | ラ - - - - - ン - - - ソ - | ノ - - - モ - ミ - - - ー - | ヂ - - - - - - - - - _ - |
    L2| ヤ - - - ー - ト - - - - - | ミ - ユ - キ - マ - - - ツ - | ラ - - - - - ン - - - ソ - | ノ - - - ハ - ナ - - - ー - | ハ - - - - - - - - - _ - |
}

