::SCORE::
** 寧樂の都（鋼琴伴奏版） **
!= 66
?= E,
<6/8>
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - 0 - {mf} 5 - |

    /* 第一行 */
    | 5 - - - 3 - 5 - 4 - 2 - | 1 - - - - - 1 - - - {p} 1 - | 2 - - - 2 - 2 - 3 - 4 - | 5 - - - - - 5 - - - {mf} 5 - |

    /* 第二行 */
    | 5 - - - 3 - 5 - 4 - 2 - | 1 - - - - - 1 - - - {p} 1 - | 2 - 3 - 4 - 5 - - - 7_ - | 1 - - - - - 1 - - - {f} 1 - |

    /* 第三行 */
    | 6 - - - 6 - 5 - - - 1^ - | 7 - - - - - 6 - - - {mf} 6 - | 5 - - - 3 - 3 - 4 - 2 - | 1 - - - - - 5_ - - - {f} 5 - |

    /* 第四行 */
    | 6 - - - - - 1^ - - - - - | 1^ - - - - - 5 - - - 6 - | 5 - - - 3 - 3 - 4 - 2 - | 1 - - - 3 - 5 - - - 6 - |

    /* 第五行 */
    | 5 - - - - - 5 - - - {p} 5 - | 4 - - - 2 - 5 - - - 4 - | 3 - - - - - 1 - - - - - | {f} 6 - - - - - 6 - - - 5 - |

    /* 第六行 */
    | 4 - - - - - 2 - - - - - | 5 - - - - - 5_ - 6_ - 7_ - | 1 - - - - - 2 - - - 3 - | 4 - 3 - 2 - 1 - 7_ - 6_ - |

    /* 第七行 */
    | 5_ - - - - - 5 - - - 5 - | 4 - - - 2 - 5 - - - 4 - | 3 - - - - - 5 - - - {p} 5 - | 5 - - - 1 - 1 - 2 - 3 - |

    /* 第八行 */
    | 2 - - - - - 5_ - - - 5_ - | 1 - 2 - 3 - 4 - - - 6 - | 5 - - - 3 - 1 - 2 - - 3 | 1 - - - - - 1 - - - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 0 0 0 0 0 |

    /* 第一行 */
    | {mp} 1_ 5_ 3_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 0 | {p} 5__ 2_ 5_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 0 |

    /* 第二行 */
    | {mp} 1_ 5_ 3_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 0 | {p} 4__ 1_ 4_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 0 |

    /* 第三行 */
    | {f} 4__ 1_ 4_ 1_ 5_ 3_ | 5__ 2_ 5_ 4__ 1_ 4_ | {mf} 1_ 5_ 3_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 0 |

    /* 第四行 */
    | {f} 4__ 1_ 4_ 4__ 1_ 4_ | 1_ 5_ 3_ 1_ 5_ 4__ | 5__ 1_ 3_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 4__ |

    /* 第五行 */
    | 5__ 2_ 5_ 5__ - 0 | {p} 5__ 2_ 5_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ 5_ 1_ | {f} 4__ 1_ 4_ 4__ 1_ 1_ |

    /* 第六行 */
    | 5__ 2_ 5_ 5__ 2_ 5_ | 5__ 2_ 5_ 5__ - 0 | 1_ 5_ 3_ 5__ 2_ 1_ | 4__ 1_ 2_ 1_ 5__ 6__ |

    /* 第七行 */
    | 5__ 2_ 5_ 5__ - 0 | 5__ 2_ 5_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 0 | {p} 1_ 5_ 3_ 6__ 3_ 6_ |

    /* 第八行 */
    | 5__ 2_ 5_ 5__ - 0 | 1_ 5__ 1_ 4__ 1_ 4_ | 5__ 1_ 3_ 5__ 2_ 5_ | 1_ 5_ 1_ 1_ - 0 |
}

