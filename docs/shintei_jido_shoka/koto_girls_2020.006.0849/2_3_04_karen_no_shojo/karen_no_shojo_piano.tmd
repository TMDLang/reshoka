::SCORE::
** 可憐の少女（鋼琴伴奏版） **
!= 72
?= C
<6/8>
~ "詞：武島又次郎"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - 0 - {mp} 3_ - |

    /* 第一行 */
    | 6_ - - - 7_ - 1 - - - 2 - | 3 - 2 - 1 - 7_ - 6_ - 7_ - | 1 - - - 7_ - 6_ - 7_ - 1 - | 7_ - - - - - 3_ - - - 3_ - |

    /* 第二行 */
    | 6_ - - - 7_ - 1 - - - 2 - | 3 - 2 - 1 - 7_ - 6_ - 7_ - | 1 - - - 7_ - 6_ - - - 7_ - | 6_ - - - - - 6_ - - - 0 - |

    /* 第三行 */
    | {mf} 3 - 4 - 3 - 2 - - - 7_ - | 1 - - - 6_ - 3 - - - 3 - | 2 - 1 - 7_ - 1 - 2 - 3 - | 6_ - - - - - 6_ - - - 0 - |

    /* 第四行 */
    | {mp} 1 - 7_ - 6_ - 5_ - - - 6_ - | 7_ - - - 1 - 2 - - - 7_ - | 1 - 7_ - 6_ - 5'_ - 6_ - 7_ - | 6_ - - - - - 6_ - - - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 0 0 0 0 0 |

    /* 第一行 */
    | {p} 6__ 3_ 1_ 6__ 3_ 1_ | 3__ 7__ 3_ 6__ 3_ 1_ | 6__ 3_ 1_ 4__ 1_ 4_ | 3__ 7__ 3_ 3__ - 0 |

    /* 第二行 */
    | 6__ 3_ 1_ 6__ 3_ 1_ | 3__ 7__ 3_ 6__ 3_ 1_ | 4__ 1_ 4_ 3__ 7__ 3_ | 6__ 3_ 1_ 6__ - 0 |

    /* 第三行 */
    | {mp} 1_ 5_ 3_ 5__ 2_ 5_ | 6__ 3_ 1_ 6__ 3_ 1_ | 2_ 6_ 4_ 3__ 7__ 3_ | 6__ 3_ 1_ 6__ - 0 |

    /* 第四行 */
    | {p} 6__ 3_ 1_ 1_ 5_ 3_ | 5__ 2_ 5_ 5__ 2_ 5_ | 6__ 3_ 1_ 3__ 7__ 3_ | 6__ 3_ 6__ 6__ - 0 |
}

