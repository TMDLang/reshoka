::SCORE::
** 友の睦び（鋼琴伴奏版） **
!= 92
?= D
<4/4>
~ "出處：現代女子音樂"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 3 - 3 - |

    /* 第一段 */
    | 1 - - - - - 5_ - 5_ - 1 - 6 - - 5 | 5 - - - - - 3 - 4 - 2 - 1 - - 3 | 2 - - - 2 - 2 - 3 - - - 4 - - - | 3 - - - 2 - 2 - 1 - - - 5 - 5 - |

    /* 第二段 */
    | 5 - - - 6 - 1^ - 5 - - - 3 - - 5 | 5 - 3 - 4 - 2 - 3 - - - 3 - - 3 | 1 - - - 3 - 3 - 2 - - - 2 - 3 - | 4 - 6 - 5 - 4 - 3 - - - 3 - 3 - |

    /* 第三段（D.C. al Fine） */
    | 1 - - - - - 5_ - 5_ - 1 - 6 - - 5 | 5 - - - - - 3 - 4 - 2 - 1 - - 3 | 2 - - - 2 - 2 - 3 - - - 4 - - - | 3 - - - 2 - 2 - 1 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - |

    /* 第一段 */
    | {mp} 1_ 5_ 3_ 5_ 1_ 5_ 4_ 6_ | 1_ 5_ 3_ 5_ 5__ 2_ 1_ 3_ | 5__ 2_ 7__ 2_ 1_ 5_ 4_ 6_ | 5__ 3_ 5__ 2_ 1_ 5_ 1_ 0 |

    /* 第二段 */
    | 1_ 5_ 4_ 6_ 1_ 5_ 3_ 5_ | 1_ 5_ 5__ 2_ 6__ 3_ 6__ 0 | 1_ 5_ 3_ 5_ 5__ 2_ 7__ 2_ | 4__ 1_ 5__ 2_ 6__ 3_ 5__ 0 |

    /* 第三段（D.C. al Fine） */
    | 1_ 5_ 3_ 5_ 1_ 5_ 4_ 6_ | 1_ 5_ 3_ 5_ 5__ 2_ 1_ 3_ | 5__ 2_ 7__ 2_ 1_ 5_ 4_ 6_ | 5__ 3_ 5__ 2_ 1_ 5_ 1_ 0 |
}

