Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mf} 3 - - - 3 - 2 - | 1 - - - - - 6_ - | 5_ - - - 5_ - - - | 5_ - - - - - 1 - | 3 - - - 3 - 2 - | 1 - - - - - - - | 2 - - - - - - - | 3 - - - - - 1 - |

    /* 第二行 */
    | 1 - 2 - 3 - 4 - | 5 - - - 3 - - - | 1 - - - - - 1 - | 1 - 2 - 3 - 4 - | 5 - - - 3 - - - | 5_ - - - - - 5_ - |

    /* 第三行 */
    | 6_ - 7_ - 1 - 2 3 | 3 - - - - - 1 7_ | 6_ - 7_ - 1 - 2 3 | 2 - - - - - 7_ 6_ |

    /* 第四行 */
    | 5_ - - - 1 - - - | 3 - 2 - - - 1 - | 3 - - - 2 - - - | 1 - - - - - - - |
}

Main:PianoLH@|0| {
    <8*>
    /* 第一行 */
    | {mp} 1_ 5_ 3_ 5_ | 1_ 5_ 3_ 5_ | 5__ 2_ 7__ 2_ | 5__ 2_ 5_ 0 | 1_ 5_ 3_ 5_ | 6__ 3_ 1_ 3_ | 2_ 6_ 4_ 6_ | 5__ 2_ 5_ 0 |

    /* 第二行 */
    | 1_ 5_ 3_ 5_ | 1_ 5_ 3_ 5_ | 1_ 5_ 3_ 0 | 1_ 5_ 3_ 5_ | 1_ 5_ 3_ 5_ | 5__ 2_ 5_ 0 |

    /* 第三行 */
    | 3__ 7__ 5_ 7__ | 6__ 3_ 1_ 0 | 3__ 7__ 5_ 7__ | 5__ 2_ 5_ 0 |

    /* 第四行 */
    | 5__ 2_ 1_ 3_ | 4__ 1_ 4_ 0 | 5__ 3_ 5__ 2_ | 1_ 5_ 1_ - |
}

