::SCORE::
** 笛の音（鋼琴伴奏版） **
!= 72
?= B,
<3/4>
~ "詞：鳥居忱"
~ "出處：女子音樂教科書"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {p} 5_ - - - - - - - - - - - | 1 - - - - - - - 5_ - - - | 6_ - - - - - 7_ - 1 - 2 - | 3 - - - - - - - 1 - - - | 5_ - - - - - - - 5_ - - - |

    /* 第二行 */
    | 3 - - - - - - - 4 - - - | 2 - - - 5_ - 6_ - 7_ - 1 - | 2 - - - - - - - {f} 5_ - - - | 5 - - - - - - - 4 - - - | 3 - - - - - - - 3 - - - |

    /* 第三行 */
    | 2 - - - - - 2 - 3 - - 4 | 5 - - - - - 0 - {p} 5_ - - - | 6_ - - - - - - - 7_ - - - | 1 - - - - - - - 5 - - - | 3 - - - - - 2 - 3 - 4 - |

    /* 第四行 */
    | 2 - - - - - - - {f} 5_ - - - | 5 - - - - - - - 3 - - - | 2 - - - - - - - 7_ - - - | 1 - - - - - 2 - 3 - - 4' | 5 - - - - - 0 - {p} 5_ - - - |

    /* 第五行 */
    | 6_ - - - - - - - 7_ - - - | 3 - - - - - - - 6 - - - | 2 - - - - - 1 - 2 - 3 - | 1 - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <8*>
    /* 第一行 */
    | {p} 1_ 5_ 3_ 5_ 3_ 5_ | 1_ 5_ 3_ 5_ 1_ 0 | 4__ 1_ 4_ 1_ 4_ 1_ | 1_ 5_ 3_ 5_ 1_ 0 | 5__ 2_ 5_ 2_ 5__ 0 |

    /* 第二行 */
    | 1_ 5_ 3_ 5_ 4__ 1_ | 5__ 2_ 5_ 2_ 5__ 2_ | 5__ 2_ 5_ 2_ 5__ 0 | {mf} 1_ 5_ 3_ 5_ 4__ 1_ | 1_ 5_ 3_ 5_ 1_ 0 |

    /* 第三行 */
    | 5__ 2_ 5_ 2_ 1_ 3_ | 5__ 2_ 5_ 0 {p} 0 - | 4__ 1_ 4_ 1_ 5__ 2_ | 1_ 5_ 3_ 5_ 1_ 0 | 1_ 5_ 3_ 5_ 1_ 3_ |

    /* 第四行 */
    | 5__ 2_ 5_ 2_ 5__ 0 | {mf} 1_ 5_ 3_ 5_ 1_ 0 | 5__ 2_ 5_ 2_ 5__ 0 | 1_ 5_ 3_ 5_ 2_ 6_ | 5__ 2_ 5_ 0 {p} 0 - |

    /* 第五行 */
    | 4__ 1_ 4_ 1_ 5__ 2_ | 6__ 3_ 6_ 3_ 4__ 1_ | 5__ 2_ 5_ 2_ 5__ 2_ | 1_ 5_ 1_ - 0 - |
}

