::SCORE::
** 笛の音 **
!= 72
?= B,
<3/4>
~ "詞：鳥居忱"
~ "出處：女子音樂教科書"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P093.jpg，書頁 p. 16，高二第二學期第 4 首）：
   調性與拍號：變ロ長調（2 降記號）、3/4 拍（♩=72）

   一
   嗚呼笛よあはれ
   月影かすむこよひ
   盛りよ樹々の花
   あの音は誰のすさび
   花さへ散らふかや
   あの音はあはれふかし

   二
   あゝ笛よあはれ
   月影やどる萩に
   すがるよ露の玉
   あの音は誰のすさび
   玉さへ落つるかや
   あの音はあはれふかし
   ========================================================================= */

Main:Piano@|0| {
    <16*>
    /* 第一行：ア | ア フ | エ ヨ ア ハ | レ ツ | キ カ */
    | {p} 5_ - - - - - - - - - - - | 1 - - - - - - - 5_ - - - | 6_ - - - - - 7_ - 1 - 2 - | 3 - - - - - - - 1 - - - | 5_ - - - - - - - 5_ - - - |

    /* 第二行：ゲ カ | ス ム コ ヨ | ヒ サ | カ リ | ヨ キ */
    | 3 - - - - - - - 4 - - - | 2 - - - 5_ - 6_ - 7_ - 1 - | 2 - - - - - - - {f} 5_ - - - | 5 - - - - - - - 4 - - - | 3 - - - - - - - 3 - - - |

    /* 第三行：ギ ノ ハ ー | ナ ア | ノ ネ | ハ タ | レ ノ ス サ */
    | 2 - - - - - 2 - 3 - - 4 | 5 - - - - - 0 - {p} 5_ - - - | 6_ - - - - - - - 7_ - - - | 1 - - - - - - - 5 - - - | 3 - - - - - 2 - 3 - 4 - |

    /* 第四行：ビ ハ | ナ サ | ヘ チ | ラ フ カ ー | ヤ ア */
    | 2 - - - - - - - {f} 5_ - - - | 5 - - - - - - - 3 - - - | 2 - - - - - - - 7_ - - - | 1 - - - - - 2 - 3 - - 4' | 5 - - - - - 0 - {p} 5_ - - - |

    /* 第五行：ノ ネ | ハ ア | ハ レ フ カ | シ */
    | 6_ - - - - - - - 7_ - - - | 3 - - - - - - - 6 - - - | 2 - - - - - 1 - 2 - 3 - | 1 - - - - - - - 0 - - - |
}

-> Main -> #

