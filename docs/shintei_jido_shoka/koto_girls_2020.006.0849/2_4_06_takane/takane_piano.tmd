::SCORE::
** 高嶺（鋼琴伴奏版） **
!= 160
?= G
<4/4>
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <4*>
    /* 第一行 */
    | {mf} 3 - 3 - | 6_ 5_ 6_ 7_ | 1 - 7_ - | 6_ - - - | 7_ - 7_ - |

    /* 第二行 */
    | 1 7_ 1 2 | 7_ - 6_ 7_ | 1 - - - | 2 - 2 - | 1 - 7_ 1 |

    /* 第三行 */
    | 2 - 7_ - | 1 - 6_ - | 2 - 2 - | 3 - 2 - | 1 7_ 6_ 1 |

    /* 第四行 */
    | 2 - 7_ - | 6_ - 7_ - | 1 - 2 1 | 7_ - 6_ - | 6_ - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | {mf} 6_ - 6_ - | 6_ 5_ 6_ 7_ | 3_ - 3_ - | 6_ - - - | 6_ - 5_ - |

    /* 第二行 */
    | 4_ - 4_ - | 5_ - 5_ - | 6_ - - - | 5_ - 5_ - | 3_ - 3_ - |

    /* 第三行 */
    | 4_ - 5_ - | 6_ - - - | 5_ - 5_ - | 4_ - 5_ - | 3_ - 4_ - |

    /* 第四行 */
    | 3_ - - - | 6_ - 3_ - | 6_ - 4_ - | 3_ - 3_ - | 6_ - - - |
}

