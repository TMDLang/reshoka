    | 6_ - - 7_ 1 - - 7_ | 6_ - 6_ - 0 - 1 - | 3 - - 1 3 - - 2 | 1 - - - 0 - 1 - |
    L1| マ - - ク ラ - - ヤ | マ - ノ - _ - ク - | モ - - ヲ ハ - - ラ | ヒ - - - _ - ア - |
    L2| ツ - - ガ ハ - - ヨ | シ - ノ - _ - ナ - | ラ - - ヤ ク - - マ | ノ - - - _ - イ - |
    L3| ル - - ル ト - - ミ | エ - シ - _ - ヤ - | マ - - ノ ク - - モ | ハ - - - _ - フ - |

    /* ================= 第二行 (4 小節, P097.jpg) ================= */
