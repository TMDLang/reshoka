    | 1 - 1 - 3 - - 3 | 2 - 2 - 0 - 2 - | 5 - - 5 5 6 5 4 | 3 - - - 0 - 3 - |
    L1| マ - ツ - ヒ - - ア | フ - グ - _ - ト - | キ - - ハ イ - マ - | ト - - - _ - オ - |
    L2| ク - サ - ノ - - カ | ズ - ハ - _ - イ - | ク - - ソ タ - ビ - | ゾ - - - _ - ヒ - |
    L3| タ - タ - ビ - - ワ | キ - テ - _ - ヒ - | カ - - ゲ ク - ラ - | ク - - - _ - ア - |

    /* ================= 第三行 (5 小節, P097.jpg) ================= */
