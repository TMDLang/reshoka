::SCORE::
** 護良親王（鋼琴伴奏版） **
!= 144
?= E,
<4/4>
~ "詞：杉谷虎藏"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - {p} 6_ - |

    /* 第一行 */
    | 6_ - 7_ 1 2 - 6_ - | 3 - - - 0 - 3 - | 4 - 3 2 3 - 6 - | 3 - - - 0 - 6_ - |

    /* 第二行 */
    | 6_ - 7_ 1 2 - 6_ - | 3 - - - 0 - 3 - | 6 - 5 6 7 - 5' - | 6 - - - 0 - 3 - |

    /* 第三行 */
    | {f} 6 - 6 - 7 - 5' - | 6 - - 7 1^ - 6 - | 5 - 3 - 2 - 1 - | 3 - - - 0 - 3 3 |

    /* 第四行 */
    | 6 - - 5, 4 - 2 - | 3 - - 4 2 - 5' - | 6 - - - 0 - {pp} 3 - | 3 - - 4 2 - 7_ - | 6_ - - - 0 - 0 - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | {p} 6__ [6_m] 2_ [2_m] | 3_ [3_] 3_ 0 | 2_ [2_m] 6__ [6_m] | 3_ [3_] 3_ 0 |

    /* 第二行 */
    | 6__ [6_m] 2_ [2_m] | 3_ [3_] 3_ 0 | 6__ [6_m] 2_ [3_] | 6__ [6_m] 6__ 0 |

    /* 第三行 */
    | {f} 6__ [6_m] 3_ [3_] | 6__ [6_m] 4_ [4_] | 1_ [1] 5__ [5_] | 3_ [3_] 3_ 0 |

    /* 第四行 */
    | 6__ [6_m] 2_ [2_m] | 3_ [6_m] 3_ [3_] | 6__ [6_m] 6__ 0 | {pp} 3_ [6_m] 3_ [3_] | 6__ [6_m] 0 0 |
}

