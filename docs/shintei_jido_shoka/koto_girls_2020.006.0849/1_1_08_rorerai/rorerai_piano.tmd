::SCORE::
** ローレライ（鋼琴伴奏版） **
!= 60
?= C
<6/8>
~ "詞：近藤朔風"
~ "曲：Friedrich Silcher（大正女學唱歌）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - 0 - {mf} 5_ - |

    /* 第一行 */
    | 3 - - 4 3 - 5 - - 4 3 - | 2 - - - 1 - 6_ - - - 6_ - | 5_ - - - 5_ - 6_ - 5_ - 6_ - | 2 - - - - - - - - - 5_ - |

    /* 第二行 */
    | 3 - - 4 3 - 5 - - 4 3 - | 2 - - - 1 - 6_ - - - 6_ - | 5_ - - - 1 - 2 - - 3 2 - | 1 - - - - - - - - - 1 - |

    /* 第三行 */
    | 2 - - - 2 - 7_ - - 7_ 2 - | 5 - - - 4 - 3 - - - 3 - | 7_ - - - 7_ - 2 - - 1 6_ - | 5_ - - - - - - - - - 5_ - |

    /* 第四行 */
    | 3 - - 4 3 - 5 - - 4 3 - | 6 - - - 6 - 5 - - - 3 - | 5 - - - 4 - 2 - - 3 2 - | 1 - - - - - - - - - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 0 - 0 |

    /* 第一行 */
    | 1_ 5_ 3_ 1_ 5_ 3_ | 4__ 1_ 4_ 4__ 1_ 4_ | 1_ 5_ 3_ 1_ 5_ 3_ | 5__ 2_ 5_ 5__ - 0 |

    /* 第二行 */
    | 1_ 5_ 3_ 1_ 5_ 3_ | 4__ 1_ 4_ 4__ 1_ 4_ | 5__ 3_ 1_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 0 |

    /* 第三行 */
    | 5__ 2_ 5_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ 5_ 3_ | 2_ 6_ 4'_ 2_ 6_ 4'_ | 5__ 2_ 5_ 5__ - 0 |

    /* 第四行 */
    | 1_ 5_ 3_ 1_ 5_ 3_ | 4__ 1_ 4_ 1_ 5_ 3_ | 5__ 2_ 5_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 0 |
}

-> Main -> Main -> Main -> #
