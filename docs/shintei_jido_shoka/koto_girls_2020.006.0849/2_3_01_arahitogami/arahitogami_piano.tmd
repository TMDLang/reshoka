::SCORE::
** 現人神（鋼琴伴奏版） **
!= 88
?= G
<4/4>
~ "詞：鳥居忱"
~ "曲：アーン（英）（Arne）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - 0 - {mf} 5_ - |

    /* 第一行 */
    | 1 - - - 1 - - - 1 2 3 4 5 - 1 - | 2 - - - - - 4 5 3 - - - 0 - 5_ - |

    /* 第二行 */
    | 1 2 3 4 1 2 3 4 5 - 1^ - 7 - 6 - | 5 - 6 7 1^ - 2 - 5 - - - 0 - 2 - |

    /* 第三行 */
    | 5 - 3 - 1^ - 6 - {f} 5 - 4' 5 6 5 4' 3 | 2 - - - 6_ - - 6_ 5_ - - - 0 - - - |

    /* 第四行 */
    | {mf} 1 - - - 5_ - - 5_ 1 - 5_ - 0 - 1 - | 4 - - 4 3 - 1 - 2 - - - 0 - 2 - |

    /* 第五行 */
    | {f} 5 - - - 5 - - 5 3 5 1^ 4 3 - 2 - | 1 - - - 7_ - - - 1 - - - - - - - | 5 - - - 0 - {mf} 5 - 4 - 3 - 0 - 4 - |

    /* 第六行 */
    | 5 - - 4 3 - 2 - 1 - - - - - - - | {f} 5 - - - 1^ - - - 3 5 1^ 4 3 - 2 - | 1 - - - 7_ - - - 1 - - - - - 0 - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |
    /* 第一行 */
    | 1_ [1] 3_ [1] | 4_ [2_m] 5__ [5_] |
    /* 第二行 */
    | 1_ [1] 2_ [5_] | 3_ [1] 2_ [5_] |
    /* 第三行 */
    | 1_ [1] 6__ [6_m] | 2_ [2_] 5__ [5_] |
    /* 第四行 */
    | 1_ [1] 1_ [1] | 4_ [4_] 2_ [5_] |
    /* 第五行 */
    | 5__ [5_] 3_ [1] | 2_ [5_] 1_ [1] | 5__ [5_] 3_ [1] |
    /* 第六行 */
    | 2_ [5_] 1_ [1] | 5__ [5_] 4_ [1] | 2_ [5_] 1_ 0 |
}

-> Main -> #

