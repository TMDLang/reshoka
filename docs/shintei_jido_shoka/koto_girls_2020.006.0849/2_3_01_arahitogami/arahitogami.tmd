::SCORE::
** 現人神 **
!= 88
?= G
<4/4>
~ "詞：鳥居忱"
~ "曲：アーン（英）（Arne）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P101.jpg，書頁 p. 24，高二第三學期第 1 首）：
   調性與拍號：ト長調（1 升記號）、4/4 拍（威嚴ヲ以テ ♩=88，弱起最後半拍進入）

   天晴（あはれ）たふと、天皇（すめらぎ）、
   萬代（よろづよ）變（かは）らぬ、天（あま）つ日嗣（ひつぎ）。
   千早振（ちはやぶる）神（かみ）の子（こ）　かしこ。
   高御座（たかみくら）、光放（ひかりはな）つ、
   御稜威（みいつ）は輝（かがや）く帝（みかど）。
   嗟（あ）、たふと、現人神（あらひとがみ）
   嗚呼（ああ）かがよふ　御稜威（みいつ）。
   ========================================================================= */

Main:Piano@|0| {
    <16*>
    /* 弱起小節：ア */
    | 0 - - - 0 - - - 0 - - - 0 - {mf} 5_ - |

    /* 第一行 (2 小節)：ハ レ ター フー ト ス | メ ラー ギ ヨ */
    | 1 - - - 1 - - - 1 2 3 4 5 - 1 - | 2 - - - - - 4 5 3 - - - 0 - 5_ - |

    /* 第二行 (2 小節)：ロー ヅー ヨー カー ハ ラ ヌ ア | マ ツー ヒ ツ ギ チ */
    | 1 2 3 4 1 2 3 4 5 - 1^ - 7 - 6 - | 5 - 6 7 1^ - 2 - 5 - - - 0 - 2 - |

    /* 第三行 (2 小節)：ハ ヤ ブ ル カ ミー ノー コー | カ シー コ */
    | 5 - 3 - 1^ - 6 - {f} 5 - 4' 5 6 5 4' 3 | 2 - - - 6_ - - 6_ 5_ - - - 0 - - - |

    /* 第四行 (2 小節)：タ カ ミ ク ラ ヒ | カ リ ハ ナ ツ ミ */
    | {mf} 1 - - - 5_ - - 5_ 1 - 5_ - 0 - 1 - | 4 - - 4 3 - 1 - 2 - - - 0 - 2 - |

    /* 第五行 (3 小節)：イ ツ ハ カー ガー ヤ ク | ミ カ ド | ア タ フ ト ア */
    | {f} 5 - - - 5 - - 5 3 5 1^ 4 3 - 2 - | 1 - - - 7_ - - - 1 - - - - - - - | 5 - - - 0 - {mf} 5 - 4 - 3 - 0 - 4 - |

    /* 第六行 (3 小節)：ラ ヒ ト ガ ミ | ア ア カー ガー ヨ フ | ミ イ ツ */
    | 5 - - 4 3 - 2 - 1 - - - - - - - | {f} 5 - - - 1^ - - - 3 5 1^ 4 3 - 2 - | 1 - - - 7_ - - - 1 - - - - - 0 - |
}

-> Main -> #

