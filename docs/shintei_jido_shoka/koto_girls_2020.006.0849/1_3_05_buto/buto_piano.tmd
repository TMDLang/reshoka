::SCORE::
** 舞踏（鋼琴伴奏版） **
!= 96
?= G
<4/4>
~ "詞：吉丸一昌"
~ "出處：（北村中等音樂教科書）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - 0 - - {f} 5_ |

    /* 第一行 */
    | 3 - - 2 1 - - 2 3 - - - 0 - - 5_ | 3 - - 2 1 - - 2 3 - - - 0 - - 5_ | 5 - - 4 3 - - 4 5 - - 6 5 - - 4 |

    /* 第二行 */
    | 3 - - 4 3 - - 2 1 - - - 0 - - 1 | 3 - - 2 1 - - 2 3 - - - 0 - - 3 | 2 - - 1 7_ - - 1 2 - - - 0 - - 2 |

    /* 第三行 */
    | 3 - - 2 1 - - 2 3 - - 4 3 - - 2' | 3 - - 6_ 6_ - - 7_ 1 - - - {p} 0 - - 3 | 3 - - 3 3 - - 3 3 - - - 5 - - 3 |

    /* 第四行 */
    | 2 - - 1 2 - - 1 5_ - - - 0 - - 7_ | 1 - - 7_ 1 - - 2 3 - - - 3 - - 3 | 2 - - 1 2 - - 1 5_ - - - {f} 0 - - 5_ |

    /* 第五行 */
    | 3 - - 2 1 - - 2 3 - - - 0 - - 5_ | 3 - - 2 1 - - 2 3 - - - 0 - - 3 | 5 - - - - - - 3 1 - - - - - - 2 | 1 - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    | 0 0 0 0 |
    | 1_ [1] 1_ 0 | 1_ [1] 1_ 0 | 5__ [5_] 5__ [5_] |
    | 1_ [1] 1_ 0 | 1_ [1] 1_ 0 | 2_ [2] 5__ 0 |
    | 1_ [1] 3_ [3] | 6__ [6_m] 1_ 0 | 6__ [6_m] 3_ [3] |
    | 5__ [5_] 5__ 0 | 1_ [1] 3_ [3] | 2_ [2] 5__ 0 |
    | 1_ [1] 1_ 0 | 1_ [1] 1_ 0 | 5__ [5_] 5__ [5_] | 1_ [1] 0 0 |
}

-> Main -> Main -> #

