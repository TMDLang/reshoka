    L1| ア - - マ ヲ - - ト メ - - - _ - - コ | コ - - ニ オ - - リ テ - - - イ - - マ | タ - - チ マ - - フ カ - - - _ - - ク |
    L2| ふ - - き と - - ぢ て - - - _ - - と | め - - し も - - の か - - - こ - - の | ま - - ひ す - - が た - - - _ - - く |

