::SCORE::
** 子守歌（鋼琴伴奏版） **
!= 69
?= G
<4/4>
~ "詞：山口重樹"
~ "曲：Franz Schubert（女子音樂教科書）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {pp} 3 - - 4 3 - 2 - 3 - - 3 2 - - - | 1 2 3 4 5 - 4 3 3 - 2 - - - 0 - | {p} 3 - - 4 3 - 2 - 3 - - 3 2 - - - |

    /* 第二行 */
    | 1 - 3 5 1^ - 6 4 3 - 2 - 1 - 0 - | 2 - - - 2 - 3 4 5 - 3 - 1 - - - | 4 - 2 - 7_ - 5_ - 2 - 3 4 3 - - - |

    /* 第三行 */
    | {pp} 3 - - 4 3 - 2 - 3 - - 3 2 - - - | 1 - 3 5 1^ - 6 4 3 - 2 - 1 - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 第一行 */
    | 1_ 5_ 3_ 5_ 1_ 5_ 5__ 5_ | 1_ 5_ 3_ 5_ 5__ 5_ 2_ 5_ | 1_ 5_ 3_ 5_ 1_ 5_ 5__ 5_ |

    /* 第二行 */
    | 1_ 5_ 4_ 6_ 5__ 5_ 1_ 0 | 5__ 5_ 2_ 5_ 1_ 5_ 3_ 5_ | 5__ 5_ 2_ 5_ 5__ 5_ 1_ 5_ |

    /* 第三行 */
    | 1_ 5_ 3_ 5_ 1_ 5_ 5__ 5_ | 1_ 5_ 4_ 6_ 5__ 5_ 1_ 0 |
}

-> Main -> Main -> Main -> #
