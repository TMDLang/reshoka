::SCORE::
** 花（鋼琴伴奏版） **
!= 92
?= A
<2/4>
~ "詞：武島又次郎"
~ "曲：瀧廉太郎"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一段：第一行 */
    | {mf} 5_ - - 5_ 3_ - 0 5_ | 1 7_ 6_ 5_ 5_ - - - | 3_ 5_ 1 3 2 - - 7_ | 1 - - - 1 - 0 - |

    /* 第一段：第二行 */
    | 5_ - - 5_ 3_ - 0 5_ | 1 3 2 6_ 7_ - - - | 3 1 6_ 4 3 1 6_ 4_ | 5_ - - - 5_ - 0 - |

    /* 第一段：第三行 */
    | {f} 2 - - 2 3 - 0 1 | 2 - - 2 3 - 0 1 | 3 - - - 2 - - 1 | 5_ - - - 5_ - 0 - |

    /* 第一段：第四行 */
    | {mf} 5_ - - 5_ 1 - - 2 | 3 1 6_ 4_ 5_ - - - | 6_ - 1 6_ 5_ - 2 - | 1 - - - 1 - 0 - |

    /* 第二段（中音）：第五行 */
    | {p} 5_ - - 5_ 5_ - 0 5_ | 1 7_ 6_ 5_ 5_ - - - | 3_ 5_ 6_ 1 7_ - - 5_ | 6_ - - - 6_ - 0 - |

    /* 第二段（中音）：第六行 */
    | 3_ - - 3_ 4_ - 0 4_ | 6_ 5_ 4_ 3_ 3_ - - - | 6_ - 6_ 6_ 6_ - - 6_ | 5'_ - - - 5'_ - 0 - |

    /* 第二段（中音）：第七行 */
    | {f} 6_ - - 6_ 0 5'_ 0 5'_ | 6_ - 6_ 6_ 0 5'_ 0 5'_ | 6_ - - - 6_ - 1 - | 3_ - - - 3_ - 0 - |

    /* 第二段（中音）：第八行 */
    | {mf} 3_ - - 3_ 6_ - - 7_ | 1 6_ 3_ 4_ 3_ - - - | 4_ - 4_ 6_ 5_ - 5_ - | 5_ - - - 5_ - 0 - |

    /* 第三段：第九行 */
    | {f} 5_ - - 5_ 3_ - 0 5_ | 1 7_ 6_ 5_ 5_ - - - | 3_ 5_ 1 3 2 - - 7_ | 1 - - - 1 - 0 - |

    /* 第三段：第十行 */
    | {mf} 5_ - - 5_ 3_ - 0 5_ | 1 3 2 6_ 7_ - - - | {p} 3 1 6_ 4 3 1 6_ 4_ | 5_ - - - 5_ - 0 - |

    /* 第三段：第十一行 */
    | {f} 2 - - 2 3 - 0 1 | 2 - - 2 3 - 0 1 | 3 - - - 2 - - 1 | 5_ - - - 5_ - 0 - |

    /* 第三段：第十二行 */
    | {mf} 5_ - - 5_ 1 - - 2 | 3 5 6 {f} 4 2 - 0 - | 3 1 2 7_ 1 - 2 - | 1 - - - 1 - 0 - |
}

Main:PianoLH@|0| {
    <16*>
    /* 第一段：第一行 */
    | {mf} 3_ - - 3_ 1_ - 0 3_ | 3_ 5_ 4_ 3_ 3_ - - - | 1_ 3_ 3_ 5_ 5_ - - 5_ | 3_ - - - 3_ - 0 - |

    /* 第一段：第二行 */
    | 3_ - - 3_ 1_ - 0 3_ | 3_ 5_ 6_ 4_ 5_ - - - | 3_ - 6_ 6_ 5_ 3_ 4'_ 2_ | 7__ - - - 7__ - 0 - |

    /* 第一段：第三行 */
    | {f} 5_ - - 5_ 5_ - 0 5_ | 5_ - - 5_ 5_ - 0 5_ | 1_ - - - 6__ - 2'_ - | 7__ - - - 7__ - 0 - |

    /* 第一段：第四行 */
