::SCORE::
** 漁火（鋼琴伴奏版） **
!= 80
?= C
<2/4>
~ "詞：杉谷代水"
~ "曲：田村虎藏"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mf} 6_ - - - 6_ - - - | 7_ - 6_ - 7_ - - 0 | 6_ - - - 6_ - 5_ - | 3_ - 5_ - 6_ - - 0 |

    /* 第二行 */
    | 6_ - - - 6_ - 7_ - | 6_ - 7_ - 1 - - - | 7_ - 6_ - 7_ - 6_ - | 3_ - - - - - 0 - |

    /* 第三行 */
    | 1 - 2 - 3 - - - | 6 - 5 - 6 - 3 - | 5 - 3 - 5 - 3 - | 6_ - - - - - 0 - |

    /* 第四行 */
    | 1 - 2 - 1 - 6_ - | 5 - - - - - 0 - | 6 - - - 5 - 6 - | 3 - - - 5 - 3 - | 6_ - - - - - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 第一行 */
    | 6__ 3_ 6__ 3_ | 3__ 7__ 3_ 0 | 6__ 3_ 6__ 3_ | 3__ 7__ 6__ 0 |

    /* 第二行 */
    | 6__ 3_ 6__ 3_ | 6__ 3_ 6__ 3_ | 3__ 7__ 3__ 7__ | 3__ 7__ 3_ 0 |

    /* 第三行 */
    | 6__ 3_ 6__ 3_ | 4__ 1_ 6__ 3_ | 3__ 7__ 3__ 7__ | 6__ 3_ 6__ 0 |

    /* 第四行 */
    | 6__ 3_ 6__ 3_ | 3__ 7__ 3_ 0 | 4__ 1_ 6__ 3_ | 3__ 7__ 3__ 7__ | 6__ 3_ 6__ 0 |
}

