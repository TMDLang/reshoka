::SCORE::
** 野川のしらべ（鋼琴伴奏版） **
!= 84
?= C
<4/4>
~ "曲：成田為三"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {p} 3 - - - |

    /* 第一行 */
    | 3 - - - - - 2' - 3 - 6 - 5' - 6 - | 6 - - - - - 7 - 6 - - - 3 - - - | 4 - - - - - - - 3 - - - 2 - - - |

    /* 第二行 */
    | 3 - - - - - - - 0 - - - 3 - - - | 3 - - - - - 2' - 3 - 6 - 6 - 7 - | 1^ - - - - - 7 - 6 - - - 1^ - - - |

    /* 第三行 */
    | 2^ - - - - - - - 6 - - - 1^ - - - | 7 - - - - - - - 0 - - - 7 - - - | 3 - - - - - 4' - 5 - - - 6 - - - |

    /* 第四行 */
    | 7 - - - - - - - 3 - - - 7 - - - | 6 - - - - - - - 6 - - - 5' - 6 - | 7 - - - - - - - 0 - - - 3 - - - |

    /* 第五行 */
    | 3 - - - - - 2' - 3 - 6 - 6 - 7 - | 1^ - - - - - 7 - 6 - - - 6 - - - | 1^ - - - - - - - 7 - - - 7 - - - | 6 - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - |

    /* 第一行 */
    | {p} 6__ 3_ 1_ 3_ 6__ 3_ 1_ 3_ | 6__ 3_ 1_ 3_ 6__ 3_ 1_ 3_ | 2__ 6__ 4_ 6__ 3__ 7__ 5'_ 7__ |

    /* 第二行 */
    | 6__ 3_ 1_ 3_ 6__ - 0 - | 6__ 3_ 1_ 3_ 6__ 3_ 1_ 3_ | 6__ 3_ 1_ 3_ 6__ 3_ 1_ 0 |

    /* 第三行 */
    | 2__ 6__ 4_ 6__ 2__ 6__ 4_ 6__ | 3__ 7__ 5'_ 7__ 3__ - 0 - | 6__ 3_ 1_ 3_ 3__ 7__ 5_ 7__ |

    /* 第四行 */
    | 3__ 7__ 5'_ 7__ 3__ 7__ 5'_ 0 | 6__ 3_ 1_ 3_ 6__ 3_ 1_ 3_ | 3__ 7__ 5'_ 7__ 3__ - 0 - |

    /* 第五行 */
    | 6__ 3_ 1_ 3_ 6__ 3_ 1_ 3_ | 6__ 3_ 1_ 3_ 6__ 3_ 1_ 0 | 3__ 6__ 3_ 6__ 3__ 7__ 5'_ 7__ | 6__ 3_ 6_ - 0 - 0 - |
}

