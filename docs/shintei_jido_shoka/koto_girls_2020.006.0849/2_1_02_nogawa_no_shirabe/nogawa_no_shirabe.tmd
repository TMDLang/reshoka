::SCORE::
** 野川のしらべ **
!= 84
?= C
<4/4>
~ "曲：成田為三"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P079.jpg，書頁 p. 2，高二第一學期第 2 首）：
   調性與拍號：イ短調（無升降記號）、4/4 拍（Andantino，弱起第 4 拍進入）

   一、
   野川の水のさゝやきに
   春を喜ぶ調べあり
   水（み）の面（も）に浮ぶ花びらは
   音なく靜（しづ）かに流れ行く

   二、
   花の行へは遠けれど
   川の調べにつれられて
   岸邊の草とかたらひつ
   音なく靜かに流れゆく
   ========================================================================= */

Main:Piano@|0| {
    <16*>
    /* 弱起小節：ノ */
    | 0 - - - 0 - - - 0 - - - {p} 3 - - - |

    /* 第一行：ガ ー ハ ー ノ ー | ミ ヅ ノ サ | サ ヤ キ */
    | 3 - - - - - 2' - 3 - 6 - 5' - 6 - | 6 - - - - - 7 - 6 - - - 3 - - - | 4 - - - - - - - 3 - - - 2 - - - |

    /* 第二行：ニ ハ | ル ヲ ヨ ー ロ ー | コ ー ブ シ */
    | 3 - - - - - - - 0 - - - 3 - - - | 3 - - - - - 2' - 3 - 6 - 6 - 7 - | 1^ - - - - - 7 - 6 - - - 1^ - - - |

    /* 第三行：ラ ベ ア | リ ミ | ノ モ ニ ウ */
    | 2^ - - - - - - - 6 - - - 1^ - - - | 7 - - - - - - - 0 - - - 7 - - - | 3 - - - - - 4' - 5 - - - 6 - - - |

    /* 第四行：カ ブ ハ | ナ ビ ラ ー | ハ オ */
    | 7 - - - - - - - 3 - - - 7 - - - | 6 - - - - - - - 6 - - - 5' - 6 - | 7 - - - - - - - 0 - - - 3 - - - |

    /* 第五行：ト ナ ク ー シ ー | ヅ カ ニ ナ | ガ レ ユ | ク */
    | 3 - - - - - 2' - 3 - 6 - 6 - 7 - | 1^ - - - - - 7 - 6 - - - 6 - - - | 1^ - - - - - - - 7 - - - 7 - - - | 6 - - - - - - - 0 - - - 0 - - - |
}

-> Main -> #

