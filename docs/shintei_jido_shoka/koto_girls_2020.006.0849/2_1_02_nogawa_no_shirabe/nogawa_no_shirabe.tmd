    L1| ラ - - - - - - - ベ - - - ア - - - | リ - - - - - - - _ - - - ミ - - - | ノ - - - - - モ - ニ - - - ウ - - - |
    L2| れ - - - - - - - ら - - - れ - - - | て - - - - - - - _ - - - き - - - | し - - - - - べ - の - - - く - - - |

