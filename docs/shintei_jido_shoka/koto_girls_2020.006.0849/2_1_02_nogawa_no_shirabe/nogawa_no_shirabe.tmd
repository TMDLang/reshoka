** 野川のしらべ **
!= 84
?= C
key= Am
<4/4>
~ "曲：成田為三"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P079.jpg，書頁 p. 2，高二第一學期第 2 首）：
   調性與拍號：イ短調（無升降記號）、4/4 拍（Andantino，弱起第 4 拍進入）

   一、
   野川の水のさゝやきに
   春を喜ぶ調べあり
   水（み）の面（も）に浮ぶ花びらは
   音なく靜（しづ）かに流れ行く

   二、
   花の行へは遠けれど
   川の調べにつれられて
   岸邊の草とかたらひつ
   音なく靜かに流れゆく
   ========================================================================= */

Main:Piano@|-1|{
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {p} 3 - - - |
    L1| _ - - - _ - - - _ - - - ノ - - - |
    L2| _ - - - _ - - - _ - - - は - - - |

    /* 第一行 */
    | 3 - - - - - 2' - 3 - 6 - 5' - 6 - | 6 - - - - - 7 - 6 - - - 3 - - - | 4 - - - - - - - 3 - - - 2 - - - |
    L1| ガ - - - - - ー - ハ - ー - ノ - ー - | ミ - - - - - ヅ - ノ - - - サ - - - | サ - - - - - - - ヤ - - - キ - - - |
    L2| な - - - - - ー - の - ー - ゆ - ー - | く - - - - - へ - は - - - と - - - | ほ - - - - - - - け - - - れ - - - |

    /* 第二行 */
    | 3 - - - - - - - 0 - - - 3 - - - | 3 - - - - - 2' - 3 - 6 - 6 - 7 - | 1^ - - - - - 7 - 6 - - - 1^ - - - |
    L1| ニ - - - - - - - _ - - - ハ - - - | ル - - - - - ヲ - ヨ - ー - ロ - ー - | コ - - - - - ー - ブ - - - シ - - - |
    L2| ど - - - - - - - _ - - - か - - - | は - - - - - の - し - ー - ら - ー - | べ - - - - - ー - に - - - つ - - - |

