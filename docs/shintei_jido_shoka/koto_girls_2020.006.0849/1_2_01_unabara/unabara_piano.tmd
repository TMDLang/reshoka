** 海原（鋼琴伴奏版） **
!= 76
?= D
<4/4>
~ "詞：大和田建樹（田村檢定唱歌集）"
~ "曲：A. Lwoff（露國國歌）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <8*>
    /* 第一行 */
    | {f} 5 - - - 6 - 5 - | 3 - - 1 5 - - - | 4 - - - 3 - 2 - | 1 - - - 5 - - - |

    /* 第二行 */
    | {mf} 3 - - - 4 - 5 - | 4 - - 2 5 - 4' - | 5 - - - 4' - - - | 5 - - - - - - - |

    /* 第三行 */
    | {mp} 3 - - - 2 - 3 - | 4 - 3 - 2 - 1 - | {mf} 6 - 5 - 4' - 5 - | 1^ - - - 4 - - - |

    /* 第四行 */
    | {f} 6 - - - 5 - 4 - | 3 - - 1 5 - - - | {mp} 4 - - 3 2 - - - | 1 - - - - - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 1_ - [6_m] [1] | 1_ - [6_m] - | 2_ - [1] [5_] | 1_ - [5_] - |

    /* 第二行 */
    | 1_ - [2_m] [1] | 2_ - [3_] - | 5__ - [3_] - | 5__ - [5_] - |

    /* 第三行 */
    | 1_ - [5_] [1] | 4_ [1] 5__ [1] | 3_ - [3_] [6_m] | 2_ - [5_] - |

    /* 第四行 */
    | 4_ - [1] [4_] | 1_ - [6_m] - | 2_ - [5_] - | 1_ - [1] - |
}

