::SCORE::
** 牧童（鋼琴伴奏版） **
!= 108
?= G
<3/4>
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {p} 5_ - - - |

    /* 第一行 */
    | 1 - - - 1 - - - 2 - - - | 3 - - 4 3 - - - 2 - - - | 5 - - - 1 - - - 2 - 3 - | 6_ - - - - - - - 5_ - - - |

    /* 第二行 */
    | 1 - - - 1 - - - 2 - - - | 3 - - 4 3 - - - 2 - - - | 5 - - - 3 - - - 2 - 3 - | 1 - - - - - - - {mf} 1 - 2 - |

    /* 第三行 */
    | 3 - - - 2 - - - 4 - - - | 3 - 2 - 1 - - - 7_ - - - | 1 - - - - - 2 - 1 - 7_ - | 2 - - - - - - - 5_ - - - |

    /* 第四行 */
    | 1 - - - 1 - - - 2 - - - | 3 - - 4 3 - - - 2 - - - | 5 - - - 3 - - - 2 - 3 - | 1 - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {p} 5_ - - - |

    /* 第一行 */
    | 3_ - - - 3_ - - - 4_ - - - | 5_ - - 6_ 5_ - - - 5_ - - - | 7_ - - - 6_ - - - 4_ - - - | 5_ - - - - - - - 5_ - - - |

    /* 第二行 */
    | 3_ - - - 3_ - - - 4_ - - - | 5_ - - 6_ 5_ - - - 5_ - - - | 7_ - - - 1 - - - 6_ - - - | 1 - - - - - - - {mf} 3_ - 4_ - |

    /* 第三行 */
    | 5_ - - - 5_ - - - 6_ - - - | 5_ - 4_ - 3_ - - - 5_ - - - | 3_ - - - - - 4_ - 3_ - 2_ - | 5_ - - - - - - - 5_ - - - |

    /* 第四行 */
    | 3_ - - - 3_ - - - 4_ - - - | 5_ - - 6_ 5_ - - - 5_ - - - | 7_ - - - 1 - - - 6_ - - - | 3_ - - - - - - - 0 - - - |
}

