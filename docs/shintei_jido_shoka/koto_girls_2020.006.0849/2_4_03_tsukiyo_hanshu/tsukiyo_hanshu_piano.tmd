::SCORE::
** 月夜泛舟（鋼琴伴奏版） **
!= 138
?= B,
<6/8>
~ "詞：天谷秀"
~ "曲：ウエーベル（獨）（Weber）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - 0 - {p} 5_ - |

    /* 第一行 */
    | 3 - - - 3 - 2 - - - 2 - | 1 - - - 1 - 5_ - - - 5_ - | 2 - - - 3 - 4 - - - 2 - | 1 - - - 2 - 3 - - - 5_ - |

    /* 第二行 */
    | 3 - - - 3 - 2 - - - 2 - | 1 - - - 1 - 5_ - - - 5_ - | 2 - - - 3 - 4 - - - 2 - | 1 - - - - - 1 - 0 - {mf} 1 - |

    /* 第三行 */
    | 6 - - - 6 - 5 - - - 5 - | 4 - - - 4 - 3 - - - 3 - | 2 - - - 2 - 3 - - - 2 - | 1 - - - 7_ - 1 - - - 1 - |

    /* 第四行 */
    | 6 - - - 6 - 5 - - - 5 - | 4 - - - 4 - 3 - - - 3 - | 2 - - - 2 - 3 - - - 2 - | 1 - - - - - 1 - - - 0 - |
}

Main:PianoLH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - 0 - {p} 5_ - |

    /* 第一行 */
    | 1 - - - 1 - 5_ - - - 5_ - | 3_ - - - 3_ - 5_ - - - 5_ - | 5_ - - - 5_ - 5_ - - - 5_ - | 3_ - - - 4_ - 5_ - - - 5_ - |

    /* 第二行 */
    | 1 - - - 1 - 5_ - - - 5_ - | 3_ - - - 3_ - 5_ - - - 5_ - | 5_ - - - 5_ - 5_ - - - 5_ - | 3_ - - - - - 3_ - 0 - {mf} 1 - |

    /* 第三行 */
    | 4 - - - 4 - 3 - - - 3 - | 2 - - - 2 - 1 - - - 1 - | 5_ - - - 5_ - 5_ - - - 5_ - | 3_ - - - 2_ - 3_ - - - 1 - |

    /* 第四行 */
    | 4 - - - 4 - 3 - - - 3 - | 2 - - - 2 - 1 - - - 1 - | 5_ - - - 5_ - 5_ - - - 5_ - | 3_ - - - - - 3_ - - - 0 - |
}

