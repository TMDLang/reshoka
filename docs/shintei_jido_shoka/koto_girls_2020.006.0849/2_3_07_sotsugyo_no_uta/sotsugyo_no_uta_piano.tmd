::SCORE::
** 卒業の歌（鋼琴伴奏版） **
!= 84
?= E,
<4/4>
~ "詞：蘆田惠之助"
~ "曲：Schulz"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mp} 5_ - - - |

    /* 第一行 */
    | 1 - - - 2 - - - 3 - - - 4 - - - | 5 - - - - - - - 6 - 5 - 4 - 3 - | 2 - - - 3 - - - 4 - - - 2 - - - | 3 - - - - - - - 0 - - - {mf} 5_ - - - |

    /* 第二行 */
    | 1 - - - 2 - - - 3 - - - 4 - - - | 5 - - - - - - - 6 - 5 - 4' - 3 - | 2 - - - 3 - 4' - 5 - - - 4' - - - | 5 - - - - - - - 0 - - - {p} 5_ - - - |

    /* 第三行 */
    | 2 - - - 2 - - - 4 - - - 4 - - - | 4 - - - - - - - 3 - - - 5 - - - | 5 - - - 4 - - - 3 - - - 2 - - - | 2 - - - 1 - - - - - - - {mf} 5_ - - - |

    /* 第四行 */
    | 1 - - - 3 - - - 5 - - - 6 - 7 - | 1^ - - - - - 7 - 1^ - - - {mp} 5 - - - | 6 - - - 5 - - - 4 - - - 3 - - - |

    /* 第五行 */
    | 1 - - - - - - - 2 - - - - - - - | 3 - - - 0 - - - {f} 5 - - - - - - - | 3 - - - 5 - - - 6 - - - 7 - 1^ - | 7 - - - - - - - 2^ - - - - - - - |

    /* 第六行 */
    | 1^ - - - - - - - - - - - {mf} 5_ - - - | 1 - - - 2 - - - 3 - - - 4 - - - | 5 - - - - - - - 5_ - - - - - - - | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | {p} 1_ [1] 1_ [1] | 1_ [1] 4__ [1] | 5__ [5_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第二行 */
    | {mp} 1_ [1] 1_ [1] | 1_ [1] 6__ [6_m] | 2_ [2_] 2_ [2_] | 5__ [5_] 5__ 0 |

    /* 第三行 */
    | {p} 5__ [5_] 5__ [5_] | 1_ [1] 1_ [1] | 5__ [5_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第四行 */
    | {mp} 1_ [1] 1_ [1] | 4__ [4_] 1_ [1] | 4__ [4_] 1_ [1] |

    /* 第五行 */
    | 4__ [4_] 5__ [5_] | 1_ 0 {f} 5__ [5_] | 1_ [1] 4__ [4_] | 5__ [5_] 5__ [5_] |

    /* 第六行 */
    | 1_ [1] 1_ 0 | {mp} 1_ [1] 4__ [4_] | 5__ [1] 5__ [5_] | 1_ [1] 1_ 0 |
}

-> Main -> #

