::SCORE::
** 卒業の歌 **
!= 84
?= E,
<4/4>
~ "詞：蘆田惠之助"
~ "曲：Schulz"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P109–P110.jpg，書頁 pp. 32–33，高二第三學期第 7 首）：
   調性與拍號：變ホ長調（3 降記號）、4/4 拍（感ヲ込メテ ♩=84，弱起第 4 拍進入）
   出處註記：（田村檢定唱歌集）

   一
   過ぎ來し八年（やとせ）　研（みが）きし德
   過ぎ來し　八年學びし藝
   思へば高し　恩師の惠（めぐみ）
   別るゝおもひは悲（かな）しきうちにも
   勉めて進めん　この德この藝

   二
   過ぎ來し八年　遊びし庭
   過ぎこし八年　睦（むつ）びし友
   別るゝ今日の　思ひは悲し
   悲しきうちにも　また逢（あ）ふ時をば
   待ちてぞ暮さん　この庭この友
   ========================================================================= */

Main:Piano@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mp} 5_ - - - |

    /* 第一行 */
    | 1 - - - 2 - - - 3 - - - 4 - - - | 5 - - - - - - - 6 - 5 - 4 - 3 - | 2 - - - 3 - - - 4 - - - 2 - - - | 3 - - - - - - - 0 - - - {mf} 5_ - - - |

    /* 第二行 */
    | 1 - - - 2 - - - 3 - - - 4 - - - | 5 - - - - - - - 6 - 5 - 4' - 3 - | 2 - - - 3 - 4' - 5 - - - 4' - - - | 5 - - - - - - - 0 - - - {p} 5_ - - - |

    /* 第三行 */
    | 2 - - - 2 - - - 4 - - - 4 - - - | 4 - - - - - - - 3 - - - 5 - - - | 5 - - - 4 - - - 3 - - - 2 - - - | 2 - - - 1 - - - - - - - {mf} 5_ - - - |

    /* 第四行 */
    | 1 - - - 3 - - - 5 - - - 6 - 7 - | 1^ - - - - - 7 - 1^ - - - {mp} 5 - - - | 6 - - - 5 - - - 4 - - - 3 - - - |

    /* 第五行 */
    | 1 - - - - - - - 2 - - - - - - - | 3 - - - 0 - - - {f} 5 - - - - - - - | 3 - - - 5 - - - 6 - - - 7 - 1^ - | 7 - - - - - - - 2^ - - - - - - - |

    /* 第六行 */
    | 1^ - - - - - - - - - - - {mf} 5_ - - - | 1 - - - 2 - - - 3 - - - 4 - - - | 5 - - - - - - - 5_ - - - - - - - | 1 - - - - - - - - - - - 0 - - - |
}

-> Main -> #

