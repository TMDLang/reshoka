::SCORE::
** 豐太閤（鋼琴伴奏版） **
!= 69
?= C
<6/8>
~ "詞：武島又次郎"
~ "曲：Campbell"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - 0 - {mf} 5_ - |

    /* 第一行 */
    | 1 - - - 7_ - 1 - - - - - | 2 - - - 3 - 4 - - - 5 - | 6 - 5 - 4 - 3 - 2 - 1 - |

    /* 第二行 */
    | 7_ - 1 - 2 - 3 - 4 - 2 - | 3 - - - - - 3 - 0 - 3 4 | 5 - 3 - 6 - 5 - 1^ - - 7 |

    /* 第三行 */
    | 7 - 6 - 5 - 6 - 7 - 5 - | 1^ - 5 - 3 - 1 - 4 - 2 - | 1 - - - - - 1 - - - 5_ 5_ | 1 - - - - - 1 - - - 2 3 |

    /* 第四行 */
    | 4 - 2 - 3 - 4 - 5 - 6 - | 7 - 5 - 3 - 1 - 2 - 3 - | 2 - - - - - 2 - 0 - 5_ - | 1 - - - 1 - 3 - 3 - 5 5 |

    /* 第五行 */
    | 5 - 3 - 5 - 1 - - - 3 3 | 4 - 3 - 4 - 5 - 6 - 7 - | 1^ - - - - - 1^ - - - 6 4 | 3 - - - - - 2 - - - 5 4 |

    /* 第六行 */
    | 1 - - - - - 1 - 3 - 5 - | 1^ - - 7 6 - 5 - 3 - 2 - | 1 - - - - - 1 - - - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 0 0 0 0 0 |

    /* 第一行 */
    | {mp} 1_ 5_ 3_ 1_ 5_ 3_ | 5__ 2_ 5_ 5__ 2_ 5_ | 4__ 1_ 4_ 1_ 5__ 1_ |

    /* 第二行 */
    | 5__ 2_ 5_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ 0 0 | 1_ 5_ 3_ 1_ 5_ 3_ |

    /* 第三行 */
    | 5__ 2_ 5_ 5__ 2_ 5_ | 1_ 5_ 3_ 4__ 5__ 5__ | 1_ 5_ 3_ 1_ - 0 | 1_ 5_ 3_ 1_ - 0 |

    /* 第四行 */
    | 5__ 2_ 5_ 1_ 5_ 3_ | 5__ 2_ 5_ 6__ 2_ 6__ | 5__ 2_ 5_ 5__ 0 0 | 1_ 5_ 3_ 1_ 5_ 3_ |

    /* 第五行 */
    | 1_ 5_ 3_ 1_ 5_ 3_ | 4__ 1_ 4_ 5__ 2_ 5_ | 1_ 5_ 3_ 1_ - 4__ | 5__ 1_ 3_ 5__ 2_ 5_ |

    /* 第六行 */
    | 1_ 5_ 3_ 1_ - 0 | 4__ 1_ 4_ 5__ 2_ 5_ | 1_ 5_ 1_ 1_ - 0 |
}

