::SCORE::
** 岩戸開きの曲（鋼琴伴奏版） **
!= 96
?= A
<1/4>
~ "詞：杉谷代水"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行（3/4 拍 × 4 小節） */
    | {mf} 1 - - - | 1 - - - | 1 - - - |
    | 3 - - 2 | 1 - 2 - | 3 - - - |
    | 2 - 3 - | 5 - - - | 2 - - - |
    | 2 - 1' - | 2 - 3 - | - - 0 - |

    /* 第二行（3/4 拍 × 4 小節） */
    | 1 - - - | 1 - - - | 1 - - - |
    | 3 - - 2 | 1 - 2 - | 6_ - - - |
    | 1 - 2 - | 3 - - - | - - 2 - |
    | 1 - 6_ - | 5_ - 6_ - | - - 0 - |

    /* 第三行（轉 4/4 拍） */
    | 5_ - - - | 5_ - - - | 6_ - - - |
    | 1 - - - | - - 2 - | 1 - - - | 6_ - - - |
    | 2 - - - | - - 3 - | 3 - 2 - | 1 - - - |
    | 5 - - - | 3 - - - | 5 - - - | 3 - 2 - |
    | 1 - - - | - - - - | - - - - | 1 - - - |

    /* 第四行（4/4 拍） */
    | 3 - - - | 7_ - - - | 1 - - - |
    | 6_ - - - | - - - - | 6_ - 6_ - | 5_ - 6_ - |
    | 1 - - - | - - - - | 1 - 1 - | 2 - 1 - |
    | 6_ - - - | 4_ - - - | 5_ - - - | 1 - 2 - |
    | 1 - - - | - - - - | - - - - | 1 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | {mp} 1_ | [1] | [1] |
    | 1_ | [1] | 6__ |
    | 5__ | [5_] | [5_] |
    | 3_ | 6__ | 0 |

    /* 第二行 */
    | 1_ | [1] | [1] |
    | 1_ | [1] | 4__ |
    | 1_ | [1] | 5__ |
    | 6__ | [6_m] | 0 |

    /* 第三行 */
    | 3_ | [3_] | 4__ |
    | 1_ | [1] | 4__ | [4_] |
    | 5__ | [5_] | 1_ | [1] |
    | 1_ | [1] | 5__ | [5_] |
    | 1_ | [1] | 1_ | 0 |

    /* 第四行 */
    | 1_ | 3_ | 6__ |
    | 4__ | [4_] | 4__ | [4_] |
    | 1_ | [1] | 1_ | [1] |
    | 4__ | 2_ | 5__ | [5_] |
    | 1_ | [1] | 1_ | 0 |
}

-> Main -> #

