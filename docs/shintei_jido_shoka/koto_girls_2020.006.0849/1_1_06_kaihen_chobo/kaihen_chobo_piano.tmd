::SCORE::
** 海邊眺望（鋼琴伴奏版） **
!= 80
?= F
<6/8>
~ "詞：佐々木信綱（女子音樂教科書）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 0 - {mf} 5_ |

    /* 第一行 */
    | 1 - 1 1 - 2 | 3 - - 1 - 1 | 2 - 2 5_ - 5_ | 1 - - - - 1 |

    /* 第二行 */
    | 6_ - 6_ 7_ - 7_ | 1 - - 5_ - {mp} 5_ | 6_ - 2 7_ 6_ 7_ | 5_ - - - - {mf} 5_ |

    /* 第三行 */
    | 5_ - 1 1 - 2 | 3 - - 1 - 3 | 2 - 4 3 - 2 | 1 - - - - 1 |

    /* 第四行 */
    | 4 - 4 3 - 3 | 2 - 2 1 - {mp} 1 | 7_ - 2 5_ - 7_ | 1 - - - - 0 |

    /* 第五行 */
    | {f} 5_ 1 2 3 - 0 | {p} 5_ 1 2 3 - 0 | {f} 4 3 4 2 1 7_ | 1 - - - - 0 |

    /* 第六行 */
    | {f} 5_ 1 2 3 - 0 | {p} 1 2 3 4 - 0 | 3 2 1 2 3 2 | 1 - - - - 0 |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 0 - 0 |

    /* 第一行 */
    | 1_ - - [1] - - | 1_ - - [1] - - | 5__ - - [5_] - - | 1_ - - [1] - 0 |

    /* 第二行 */
    | 4_ - - [5_] - - | 1_ - - [1] - - | 2_ - - [2_m] - - | 5__ - - [5_] - 0 |

    /* 第三行 */
    | 1_ - - [1] - - | 1_ - - [1] - - | 5__ - - [5_] - - | 1_ - - [1] - 0 |

    /* 第四行 */
    | 4_ - - [1] - - | 5__ - - [1] - - | 5__ - - [5_] - - | 1_ - - [1] - 0 |

    /* 第五行 */
    | 1_ - - [1] - 0 | 1_ - - [1] - 0 | 4_ - - 5__ - - | 1_ - - [1] - 0 |

    /* 第六行 */
    | 1_ - - [1] - 0 | 4_ - - [4_] - 0 | 5__ - - [5_] - - | 1_ - - [1] - 0 |
}

-> Main -> Main -> #
