::SCORE::
** 吉野山 **
!= 92
?= F
key= Dm
<4/4>
~ "（教育唱歌集）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P038.jpg – P039.jpg，書頁 pp. 3–4，高一第一學期第 3 首）：
   調性與拍號：ニ短調（1 降記號）、前段 4/4 拍，後段轉 2/4 拍

   一
   空（そら）にすみゆく　琴（こと）の音（ね）に
   ひかれてあそぶ　少女子（をとめご）が
   袖（そで）をいつたび　かへしつゝ
   舞（ま）ひしはこゝよ　この山（やま）よ
   たちかへり　またも來（こ）ん
   み吉野（よしの）の　花（はな）のかげ

   二
   亂（みだ）れゆく世（よ）の　かなしさは
   皇居（くわうきよ）をしばし　山かげに
   遷（うつ）したまひて　まつりごと
   きかせましゝも　こゝなれや
   塔（たふ）の尾（を）の　みさゝぎは
   松（まつ）ふるく　風（かぜ）かなし
   ========================================================================= */

PartA:Piano@|0| {
    <8*>
    /* 第一行 */
    | {mf} 6_ - - - 6_ - 6_ - | 2 - - 3 2 - 1 - | 6_ - 6_ - 5_ - - 6_ | 6_ - - - - - 0 - |

    /* 第二行 */
    | 1 - 1 - 6_ - 1 - | 5 - - - 3 - 5 - | 2 - 2 - 1 - - 2 | 3 - - - - - 0 - |

    /* 第三行 */
    | 5 - - - 6 - 5 - | 3 - 3 - 2 - 1 - | 2 - 2 - 1 - - 2 | 3 - - - - - 0 - |

    /* 第四行 */
    | 6_ - 6_ - 5_ - 6_ - | 1 - - - 2 - 3 - | 6_ - 6_ - 2 - - 3 | 2 - - - - - 0 - |
}

PartB:Piano@|0| {
    <8*>
    /* 第五行（轉 2/4 拍） */
    | {<2/4>} 6_ - - 6_ | 2 - - 3 | 5 - 3 - | 2 - 1 - | 6_ - 5_ - |

    /* 第六行 */
    | 0 - 6_ 6_ | 2 - - 3 | 2 - 1 - | 2 - 3 - | 5 - - - | 6_ - - - |
}

-> PartA -> PartB -> PartA -> PartB -> #
