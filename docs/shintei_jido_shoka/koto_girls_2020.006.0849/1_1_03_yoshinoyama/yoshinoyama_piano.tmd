::SCORE::
** 吉野山（鋼琴伴奏版） **
!= 92
?= F
key= Dm
<4/4>
~ "（教育唱歌集）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

PartA:PianoRH@|0| {
    <8*>
    /* 第一行 */
    | {mf} 6_ - - - 6_ - 6_ - | 2 - - 3 2 - 1 - | 6_ - 6_ - 5_ - - 6_ | 6_ - - - - - 0 - |

    /* 第二行 */
    | 1 - 1 - 6_ - 1 - | 5 - - - 3 - 5 - | 2 - 2 - 1 - - 2 | 3 - - - - - 0 - |

    /* 第三行 */
    | 5 - - - 6 - 5 - | 3 - 3 - 2 - 1 - | 2 - 2 - 1 - - 2 | 3 - - - - - 0 - |

    /* 第四行 */
    | 6_ - 6_ - 5_ - 6_ - | 1 - - - 2 - 3 - | 6_ - 6_ - 2 - - 3 | 2 - - - - - 0 - |
}

PartA:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 6__ - [6_m] - | 2_ - [2_m] - | 6__ - [3_m] - | 6__ - [6_m] 0 |

    /* 第二行 */
    | 1_ - [1] - | 1_ - [1] - | 2_ - [2_m] - | 3_ - [3_] 0 |

    /* 第三行 */
    | 1_ - [1] - | 6__ - [6_m] - | 2_ - [2_m] - | 3_ - [3_] 0 |

    /* 第四行 */
    | 6__ - [6_m] - | 1_ - [1] - | 6__ - [6_m] - | 2_ - [2_m] 0 |
}

PartB:PianoRH@|0| {
    <8*>
    /* 第五行 */
    | {<2/4>} 6_ - - 6_ | 2 - - 3 | 5 - 3 - | 2 - 1 - | 6_ - 5_ - |

    /* 第六行 */
    | 0 - 6_ 6_ | 2 - - 3 | 2 - 1 - | 2 - 3 - | 5 - - - | 6_ - - - |
}

PartB:PianoLH@|0| {
    <4*>
    /* 第五行 */
    | {<2/4>} 6__ [6_m] | 2_ [2_m] | 1_ [1] | 2_ [2_m] | 6__ [3_m] |

    /* 第六行 */
    | 6__ [6_m] | 2_ [2_m] | 2_ [2_m] | 2_ [2_m] | 3_ [3_m] | 6__ - |
}

-> PartA -> PartB -> PartA -> PartB -> #
