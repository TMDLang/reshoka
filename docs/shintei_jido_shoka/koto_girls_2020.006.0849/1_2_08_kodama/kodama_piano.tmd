::SCORE::
** 木靈（鋼琴伴奏版） **
!= 80
?= F
<4/4>
~ "曲：Carl Maria von Weber（北村中等音樂教科書）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {f} 1 - - - |

    /* 第一行 */
    | 1 - - - {pp} 1 - - - 1 - - - {f} 3 - - - | 5 - - - 3 - - - {pp} 5 - - - 3 - - - |
    | {f} 1 - 1 - 2 - 2 - 3 - 1 - 2 - 7_ - | 1 - - - - - - - 0 - - - 3 - - - |

    /* 第二行 */
    | 2 - - - - - {pp} 3 - 2 - - - 0 - {f} 1 - | 4 - - - 4 - 4 - 3 - - - 0 - {pp} 1 - |
    | 4 - - - 4 - 4 - 3 - - - 0 - {f} 5 - |

    /* 第三行 */
    | 4 - - 4 3 - 3 - 2 - 2 - 5_ - - - | 0 - - - {pp} 5 - - - 4 - - 4 3 - 3 - |
    | 2 - 2 - 5_ - - - 0 - - - 0 - - - |

    /* 第四行 */
    | {f} 1 - 7_ - 1 - 2 - 3 - 2 - 3 - 4 - | 5 - - - 5_ - - - {f} 1 - 7_ - 1 - 2 - |
    | 3 - 2 - 3 - 4 - 5 - - - 5_ - - - |

    /* 第五行 */
    | {f} 6 - - - 4 - - - {p} 6 - - - 4 - - - | {f} 5 - - - 3 - - - {p} 5 - - - 3 - - - |
    | {ff} 2 - - - 5 - - - 5 - 5 - 5 - 5 - | 5 - - - {pp} 5_ - 5_ - 5_ - 5_ - 5_ - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1_ [1] [1] 1_ | 1_ [1] 1_ [1] |
    | 1_ [5_] 1_ [5_] | 1_ [1] 1_ 0 |

    /* 第二行 */
    | 5__ [5_] 5__ 0 | 4_ [4_] 1_ 0 |
    | 4_ [4_] 1_ 0 |

    /* 第三行 */
    | 5__ [1] 5__ [5_] | 0 1_ 5__ 1_ |
    | 5__ [5_] 5__ 0 |

    /* 第四行 */
    | 1_ [1] 1_ [1] | 5__ [5_] 1_ [1] |
    | 1_ [1] 5__ [5_] |

    /* 第五行 */
    | 4_ [4_] 4_ [4_] | 1_ [1] 1_ [1] |
    | 5__ [5_] 1_ [1] | 1_ 0 [1] - |
}

-> Main -> Main -> #
