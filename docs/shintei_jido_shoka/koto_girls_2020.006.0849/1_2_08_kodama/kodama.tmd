** 木靈 **
!= 80
?= C
<4/4>
~ "曲：Carl Maria von Weber（北村中等音樂教科書）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P054.jpg – P055.jpg，書頁 pp. 19–20，高一第二學期第 8 首）：
   調性與拍號：ハ長調（無升降記號）、4/4 拍（緩除ニ ♩=80，弱起第 4 拍進入，甲乙反響應答）

   一
   やよやよ　おーいおーい
   森（もり）のあなた　やよやよ
   いざこよ　いざこよ
   やよやよこよ　やよやよこよ
   わが呼（よ）ばふ　まに／＼
   誰（たれ）が呼ばふ　聲（こゑ）ぞや
   あなあやし怪（あや）しの
   奥山（おくやま）の木靈（こだま）や
   やよやよ　來（こ）よ來よ
   ひゞくこだま　ひゞくこだま

   二
   來よ來よ　行（ゆ）け行け
   谷（たに）のはざま　こよこよ
   いざこよ　いざこよ
   來よ來よ往（ゆ）け　こよこよゆけ
   わが呼ばふこゑごゑ
   遠近（をちこち）に應（こた）へて
   あなあやし怪しの
   谷々のこだまや
   こよこよ　ゆけゆけ
   ひゞく木靈　ひゞくこだま
   ========================================================================= */

Main:Piano@|-1|{
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {f} 5 - - - |
    L1| _ - - - _ - - - _ - - - ヤ - - - |
    L2| _ - - - _ - - - _ - - - こ - - - |

    /* 第一行 */
    | 1^ - - - - - - - - - - - {pp} 5 - - - | 1^ - - - - - - - - - - - {f} 5 - - - | 2^ - - - - - - - - - - - 5 - - - | 2^ - - - - - - - - - - - {f} 1^ - - - | 7 - 6 - 5 - 4 - 3 - - - 6 - - - |
    L1| ヨ - - - - - - - - - - - ヤ - - - | ヨ - - - - - - - - - - - オ - - - | オ―イ - - - - - - - - - - - オ - - - | オ―イ - - - - - - - - - - - モ - - - | リ - ノ - ア - ナ - タ - - - ヤ - - - |
    L2| よ - - - - - - - - - - - こ - - - | よ - - - - - - - - - - - ゆ - - - | け - - - - - - - - - - - ゆ - - - | け - - - - - - - - - - - た - - - | に - の - は - ざ - ま - - - こ - - - |

    /* 第二行 */
    | 5 - - - - - - - - - - - {pp} 6 - - - | 5 - - - - - - - - - - - 0 - {f} 5 - | 5 - - - 1^ - - - 2^ - - - 0 - {pp} 5 - | 5 - - - 1^ - - - 2^ - - - 0 - {f} 5 - |
    L1| ヨ - - - - - - - - - - - ヤ - - - | ヨ - - - - - - - - - - - _ - イ - | ザ - - - コ - - - ヨ - - - _ - イ - | ザ - - - コ - - - ヨ - - - _ - ヤ - |
    L2| よ - - - - - - - - - - - こ - - - | よ - - - - - - - - - - - _ - い - | ざ - - - こ - - - よ - - - _ - い - | ざ - - - こ - - - よ - - - _ - こ - |

    /* 第三行前半 */
    | 1^ - - 1^ 7 - 5 - 1^ - - - 0 - {pp} 5 - | 1^ - - 1^ 7 - 5 - 1^ - - - 0 - {f} 5 - |
    L1| ヨ - - ヤ ヨ - コ - ヨ - - - _ - ヤ - | ヨ - - ヤ ヨ - コ - ヨ - - - _ - ワ - |
    L2| よ - - こ よ - ゆ - け - - - _ - こ - | よ - - こ よ - ゆ - け - - - _ - わ - |

    /* 第三行後半～第四行前半（合唱反覆展開） */
    | 5 - 5 - 5 5 5 - 5 - 7 - 5 - {f} 5 - | 5 - 5 5 5 - 5 - 1^ - 5 - 5 - {f} 5 - |
    L1| ガ - ヨ - バ フ マ - ニ - マ - ニ - タ - | ガ - ヨ バ フ - コ - ヱ - ゾ - ヤ - ア - |
    L2| が - よ - ば ふ こ - ゑ - ご - ゑ - を - | ち - こ ち に - こ - た - へ - て - あ - |

    | 5 - 5 - 5 5 5 - 5 - 7 - 5 - {f} 5 - | 5 - 5 5 5 - 5 - 1^ - 5 - 5 - {f} 3^ - |
    L1| ナ - ア - ヤ シ ア - ヤ - シ - ノ - オ - | ク - ヤ マ ノ - コ - ダ - マ - ヤ - ヤ - |
    L2| な - あ - や し あ - や - し - の - た - | に - だ に の - こ - だ - ま - や - こ - |

    /* 第四行後半 */
    | 1^ - - - - - {p} 1^ - 5 - - - - - {f} 3^ - | 1^ - - - - - {p} 1^ - 5 - - - - - {ff} 1^ - | 1^ - - 1^ 1^ - - 1^ 4^ - - - - - {pp} 1^ - | 1^ - - 1^ 1^ - - 1^ 1^ - - - 0 - - - |
    L1| ヨ - - - - - ヤ - ヨ - - - - - コ - | ヨ - - - - - コ - ヨ - - - - - ヒ - | ビ - - ク コ - - ダ マ - - - - - ヒ - | ビ - - ク コ - - ダ マ - - - _ - - - |
    L2| よ - - - - - こ - よ - - - - - ゆ - | け - - - - - ゆ - け - - - - - ひ - | び - - く こ - - だ ま - - - - - ひ - | び - - く こ - - だ ま - - - _ - - - |
}

