** 秋の湖上（鋼琴伴奏版） **
!= 54
?= A
<3/8>
~ "出處：特選樂譜"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mp} 5_ - 1 - 2 - | 1+3 - 3+5 - 0 - | 7_+5 - 2 - 7_+5 - | 1+3 - - - 0 - | 5_ - 1 - 2 - | 1+3 - 3+5 - 0 - |

    /* 第二行 */
    | 7_+5 - 7_+2 - 7_+3 - | 5_+1 - - - 0 - | {mf} 1+3 - 1+3 - 1+3 - | 1+6 - - 3 1+3 - | 1+3 - 1+3 - 5'_+2 - | 6_+1 - - - 0 - |

    /* 第三行 */
    | {f} 7_+2 - 7_+2 - 7_+2 - | 7_+5 - 7_+2 - 0 2 | 6'_+2 - 6'_+1 - 6_ - | 2_+5_ - - - 0 - | {mp} 5_ - 1 - 2 - | 1+3 - 3+5 - 0 5 |

    /* 第四行 */
    | 7_+5 - 2 - 7_+5 - | 1+3 - - - 0 - | {p} 5_ - 1 - 2 - | 1+3 - 3+5 - 0 - | {pp} 7_+5 - 7_+2 - 7_+3 - | 5_+1+3 - - - 0 - |
}

Main:PianoLH@|0| {
    <16*>
    /* 第一行 */
    | {p} 1_ - 5__ - 5__ - | 1_ - 5__ - 1_ - | 5__ - 2_ - 5__ - | 1_ - 5__ - 1_ - | 1_ - 5__ - 5__ - | 1_ - 5__ - 1_ - |

    /* 第二行 */
    | 5__ - 2_ - 5__ - | 1_ - 5__ - 1_ - | {mp} 6__ - 3_ - 6__ - | 4__ - 1_ - 6__ - | 3__ - 6__ - 3__ - | 6__ - 3__ - 6___ - |

    /* 第三行 */
    | {mf} 5__ - 2_ - 5__ - | 5__ - 2_ - 5__ - | 2__ - 6__ - 2_ - | 5__ - 2_ - 0 - | {p} 1_ - 5__ - 5__ - | 1_ - 5__ - 1_ - |

    /* 第四行 */
    | 5__ - 2_ - 5__ - | 1_ - 5__ - 1_ - | {pp} 1_ - 5__ - 5__ - | 1_ - 5__ - 1_ - | 5__ - 2_ - 5__ - | 1_ - - - 0 - |
}

