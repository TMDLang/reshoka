::SCORE::
** 秋夜懷友（鋼琴伴奏版） **
!= 96
?= G
<3/4>
~ "詞：犬童球溪"
~ "曲：Wrighton（美國曲）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {mp} 5_ - 5_ - |

    /* 第一行 */
    | 3 - - - - - 4 3 2 - 1 - | 5_ - - - - - - - 1 - 2 - | 3 - - - - - 3 - 3 - 4 - | 2 - - - - - - - 5_ - 5_ - |

    /* 第二行 */
    | 3 - - - - - 4 3 2 - 1 - | 6_ - - - - - - - 6_ - 7_ - | 1 - - - - - 6_ - 1 - 2 - | 1 - - - - - - - {mf} 3 - 4 - |

    /* 第三行 */
    | 5 - - - - - 3 - 5 - 4 - | 3 - - - - - - - 1 - 1 - | 2 - - - - - 2 - 7_ - 1 - | 2 - - - - - - - 3 - 4 - |

    /* 第四行 */
    | 5 - - - - - 3 - 6 - 5 - | 4 - - - - - - - 2 - 2 - | 3 - - - - - 3 - 2 - 1' - | 2 - - - - - - - 5 - 4 - |

    /* 第五行 */
    | 3 - - - - - 4 3 2 - 1 - | 5_ - - - - - - - 1 - 2 - | 3 - - - - - 3 - 3 - 4 - | 2 - - - - - - - 3 - 4 - |

    /* 第六行 */
    | 5 - - - - - 4 - 3 - 2 - | 6 - - - - - - - 1 - 2 - | 3 - - - - - 5_ - 3 - 2 - | 1 - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - |

    /* 第一行 */
    | {p} 1_ 5_ 3_ 5_ 3_ 5_ | 5__ 2_ 5_ 2_ 5__ 0 | 1_ 5_ 3_ 5_ 6__ 3_ | 5__ 2_ 5_ 2_ 5__ 0 |

    /* 第二行 */
    | 1_ 5_ 3_ 5_ 3_ 5_ | 4__ 1_ 4_ 1_ 4__ 0 | 5__ 3_ 1_ 3_ 5__ 2_ | 1_ 5_ 3_ 5_ 1_ 0 |

    /* 第三行 */
    | {mp} 5__ 2_ 7__ 2_ 7__ 2_ | 1_ 5_ 3_ 5_ 1_ 0 | 5__ 2_ 7__ 2_ 5__ 2_ | 2_ 6_ 4_ 6_ 2_ 0 |

    /* 第四行 */
    | 1_ 5_ 3_ 5_ 1_ 3_ | 4__ 1_ 4_ 1_ 4__ 0 | 3__ 7__ 5_ 7__ 3__ 0 | 5__ 2_ 5_ 2_ 5__ 0 |

    /* 第五行 */
    | {p} 1_ 5_ 3_ 5_ 3_ 5_ | 5__ 2_ 5_ 2_ 5__ 0 | 1_ 5_ 3_ 5_ 6__ 3_ | 5__ 2_ 5_ 2_ 5__ 0 |

    /* 第六行 */
    | 1_ 5_ 3_ 5_ 3_ 5_ | 4__ 1_ 4_ 1_ 4__ 0 | 5__ 3_ 1_ 3_ 5__ 2_ | 1_ 5_ 1_ - 0 - |
}

