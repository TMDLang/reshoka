** 世界の平和（鋼琴伴奏版） **
!= 108
?= B,
<4/4>
~ "曲：成田爲三"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 5_ - 1 - |

    /* 第一行 */
    | 2 - - - 5_ - 2 - 3 - - - 5_ - 3 - | 4 - - - 0 - - - 0 - - - 3 - 2 - | 1 - - 2 3 - 5 - 2 - - - 3 - - - | 5 - - - - - - - - - - - 5_ - 1 - |

    /* 第二行 */
    | 2 - - - 5_ - 2 - 3 - - - 2 - 3 - | 4 - - - 0 - - - 0 - - - 2 - 3 - | 4 - - 4 4 - 7_ - 3 - - - 2 - - - | 1 - - - - - - - 5_ - - - 5_ - 5 - |

    /* 第三行 */
    | 5 - - - 3 - - - 1 - - - 2 - 3 - | 2 - - - - - - - - - - - 0 - - - | 6_ - - - 7_ - - - 1 - - - 6_ - - - | 2 - - - 1 - - - 6_ - - - 4_ - - - |

    /* 第四行 */
    | 5_ - - - 1 - - - 7_ - - 1 2 - - - | 3, - - 2 1 - 7_ - 1 - - - 6_ - - - | 5_ - - - - - - - 0 - - - 6_ - 5_ - | 3_ - - - - - - - 4'_ - - - 2_ - - - |

    /* 第五行 */
    | 5_ - - - 5_ - 6_ - 7_ - - - 7_ - 1 - | 2 - - - - - - - 5_ - - - 2 - 2 - | {f} 6 - - 5 4 - 2 - 1 - - - 7_ - - - | 1 - - - - - - - - - - - 0 - - - |

    /* 第六行 */
    | 0 - - - 5_ - 1 - 2 - - - - - - - | 0 - - - 6_ - 2 - 3 - - - - - - - | 0 - - - 5 - 3 - 1 - - - 2 - 7_ - | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | {mp} 5__ [5_] 1_ [1] | 4__ [4_] 4__ 0 | 1_ [1] 2_ [2_] | 5__ [5_] 5__ 0 |

    /* 第二行 */
    | 5__ [5_] 1_ [1] | 4__ [4_] 4__ 0 | 4__ [4_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第三行 */
    | 1_ [1] 6__ [6_m] | 2_ [2_m] 2_ 0 | 6__ [6_m] 6__ [6_m] | 2_ [2_m] 4__ [4_] |

    /* 第四行 */
    | 5__ [5_] 5__ [5_] | 6__ [6_m] 2_ [2_m] | 5__ [5_] 5__ 0 | 1_ [1] 2_ 6__ |

    /* 第五行 */
    | 5__ [5_] 5__ [5_] | 5__ [5_] 5__ 0 | {f} 4__ [4_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第六行 */
    | 5__ [5_] 5__ [5_] | 6__ [6_m] 6__ [6_m] | 5__ [1] 5__ [5_] | 1_ [1] 1_ 0 |
}

