::SCORE::
** 世界の平和 **
!= 108
?= B,
<4/4>
~ "曲：成田爲三"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P108.jpg，書頁 p. 31，高二第三學期第 6 首）：
   調性與拍號：變ロ長調（2 降記號）、4/4 拍（弱起第 4 拍進入）

   一
   祝へ祝へ祝へ　仇なす黑雲
   今しも去りて　世界の平和を
   もたらす女神　黃金のみ車
   音とどろかす　まがつみ去りにし
   光のけふを　祝へ祝へ人々祝へ

   二
   歌へ歌へ歌へ　自由のつるぎは
   勝利ををさめ　人類平和の
   理想の光　海にも陸にも
   輝き初めぬ　世界の國民
   聲をそろへて　歌へ歌へとどろに歌へ
   ========================================================================= */

Main:Piano@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 5_ - 1 - |

    /* 第一行 */
    | 2 - - - 5_ - 2 - 3 - - - 5_ - 3 - | 4 - - - 0 - - - 0 - - - 3 - 2 - | 1 - - 2 3 - 5 - 2 - - - 3 - - - | 5 - - - - - - - - - - - 5_ - 1 - |

    /* 第二行 */
    | 2 - - - 5_ - 2 - 3 - - - 2 - 3 - | 4 - - - 0 - - - 0 - - - 2 - 3 - | 4 - - 4 4 - 7_ - 3 - - - 2 - - - | 1 - - - - - - - 5_ - - - 5_ - 5 - |

    /* 第三行 */
    | 5 - - - 3 - - - 1 - - - 2 - 3 - | 2 - - - - - - - - - - - 0 - - - | 6_ - - - 7_ - - - 1 - - - 6_ - - - | 2 - - - 1 - - - 6_ - - - 4_ - - - |

    /* 第四行 */
    | 5_ - - - 1 - - - 7_ - - 1 2 - - - | 3, - - 2 1 - 7_ - 1 - - - 6_ - - - | 5_ - - - - - - - 0 - - - 6_ - 5_ - | 3_ - - - - - - - 4'_ - - - 2_ - - - |

    /* 第五行 */
    | 5_ - - - 5_ - 6_ - 7_ - - - 7_ - 1 - | 2 - - - - - - - 5_ - - - 2 - 2 - | {f} 6 - - 5 4 - 2 - 1 - - - 7_ - - - | 1 - - - - - - - - - - - 0 - - - |

    /* 第六行 */
    | 0 - - - 5_ - 1 - 2 - - - - - - - | 0 - - - 6_ - 2 - 3 - - - - - - - | 0 - - - 5 - 3 - 1 - - - 2 - 7_ - | 1 - - - - - - - - - - - 0 - - - |
}

-> Main -> #

