** 祝歌 **
!= 112
?= C
<4/4>
~ "詞：大和田建樹"
~ "曲：V. Bellini（ベリニー）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P068.jpg – P069.jpg，書頁 pp. 33–34，高一第三學期第 7 首）：
   調性與拍號：ハ長調（無升降記號）、4/4 拍（快活ニ元氣ヨク ♩=112，弱起第 4 拍進入）

   萬歲（バンザイ）　萬歲（バンザイ）　萬歲（バンザイ）。
   百鳥（モモトリ）鳴（ナ）き花（ハナ）も咲（サ）き出（イ）で、
   春（ハル）の聲（コエ）、空（ソラ）に充（ミ）ち、
   春（ハル）の色（イロ）、四方（ヨモ）に滿（ミ）つ、
   思（オモ）へば嬉（ウレ）しや、
   今日（ケフ）の日（ヒ）の　友（トモ）の譽（ホマレ）。
   思（オモ）へば樂（タノ）しや、
   業（ワザ）終（ヲ）へし　友（トモ）の幸（サチ）。
   祝（イハ）へ、月（ツキ）の、桂（カツラ）の冠（カムリ）、
   光（ヒカリ）、高（タカ）く、戴（イタダ）く君（キミ）を。
   ア、ア、ア、ア、ア、
   萬（バン）　萬（バン）　歲（ザイ）。
   ========================================================================= */

Main:Piano@|-1|{
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {f} 5 - - 5 |
    L1| _ - - - _ - - - _ - - - バ - - ン |

    /* 第一行 */
    | 1^ - - - 5 - - 5 3^ - - - 1^ - - 1^ | 5^ - - - - - - - - - - - 3^ - - 3^ | 4^ - - 3^ 2^ - - 1^ 7 - - 1^ 2^ - - 7 | 5 - - - - - 3 - 3 - 0 - {mf} 3 - - 3 |
    L1| ザイ - - - バ - - ン ザイ - - - バ - - ン | ザイ - - - - - - - - - - - モ - - モ | ト - - リ ナ - - キ ハ - - ナ モ - - サ | キ - - - - - イ - デ - _ - ハ - - ル |

    /* 第二行 */
    | 4 - - - 4 - - - 4 - - 3 4 - - 5 | 6 - - - - - - - 3 - 0 - 4 - - 3 | 2 - - 1 2 - - 3 4 - - 5 6 - - 7 | 5 - - - - - - - 0 - - - 3 - - 3 |
    L1| ノ - - - コ - - - エ - - ソ ラ - - ニ | ミ - - - - - - - チ - _ - ハ - - ル | ノ - - ー イ - - ロ ヨ - - モ ニ - - ミ | ツ - - - - - - - _ - - - オ - - モ |

    /* 第三行 */
    | 4 - - - 4 - - - 4 - - 2' 4 - - 5 | 6 - - - - - - - 3 - 0 - 4 - - 3 | 2 - - 1 2 - - 3 4 - - 5 6 - - 7 | 1^ - - - - - - - 5 - 0 - 3 - - 3 |
    L1| ヘ - - - バ - - - ウ - - ー レ - - ー | シ - - - - - - - ヤ - _ - ケ - - フ | ノ - - ー ヒ - - ノ ト - - モ ノ - - ホ | マ - - - - - - - レ - _ - オ - - モ |

    /* 第四行 */
    | 4 - - - 4 - - - 4 - - 2' 4 - - 5 | 6 - - - - - - - 3 - 0 - 4 - - 3 | 2 - - 1 2 - - 3 4 - - 5 6 - - 7 | 1^ - - - - - - - 0 - - - {f} 1^ - - 1^ |
    L1| ヘ - - - バ - - - タ - - ー ノ - - ー | シ - - - - - - - ヤ - _ - ワ - - ザ | ヲ - - ー ヘ - - シ ト - - モ ノ - - サ | チ - - - - - - - _ - - - イ - - ハ |

    /* 第五行 */
    | 1^ - - - - - - - 0 - - - 1^ - - 1^ | 2^ - - - - - - - 0 - - - 2^ - - 2^ | 3^ - - - 1^ - - - 2^ - - - 7 - - - | 1^ - - - - - - - 0 - - - 1^ - - 1^ | 1^ - - - - - - - 0 - - - 1^ - - 1^ | 2^ - - - - - - - 0 - - - 2^ - - 2^ |
    L1| ヘ - - - - - - - _ - - - ツ - - キ | ノ - - - - - - - _ - - - カ - - ツ | ラ - - - ノ - - - カ - - - ム - - - | リ - - - - - - - _ - - - ヒ - - カ | リ - - - - - - - _ - - - タ - - カ | ク - - - - - - - _ - - - イ - - タ |

    /* 第六行 */
    | 3^ - - - 1^ - - - 2^ - - - 7 - - - | 1^ - - - 0 - - - 1^ - - - 0 - - - | 1^ - - - 0 - - - 7 - - - 0 - - - | 1^ - - - 0 - - - 1^ - - - 0 - - - | {ff} 5^ - - - - - - - 2^ - - - - - - - | 1^ - - - - - - - 0 - - - 0 - - - |
    L1| ダ - - - ク - - - キ - - - ミ - - - | ヲ - - - _ - - - ア - - - _ - - - | ア - - - _ - - - ア - - - _ - - - | ア - - - _ - - - ア - - - _ - - - | バン - - - - - - - バン - - - - - - - | ザイ - - - - - - - _ - - - _ - - - |
}

