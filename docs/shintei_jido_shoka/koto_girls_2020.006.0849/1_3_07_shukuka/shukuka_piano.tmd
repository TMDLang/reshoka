::SCORE::
** 祝歌（鋼琴伴奏版） **
!= 112
?= C
<4/4>
~ "詞：大和田建樹"
~ "曲：V. Bellini（ベリニー）"
~ "臺灣教育會公認《新定兒童唱歌》高等科女子用（2020.006.0849）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {f} 5_ - - 5_ |

    /* 第一行 */
    | 5_ - - - 5_ - - 5_ 6_ - - 7_ 1 - - 2 | 3 - - - - - - - - - - - 3 - - 3 |
    | 2 - - 1 7_ - - 6_ 5_ - - 4_ 3_ - - 2_ | 5_ - - - - - - - 5_ - 5_ - {mf} 3_ - - 4_ |

    /* 第二行 */
    | 5_ - - - 5_ - - - 6_ - - 7_ 1 - - 2 | 3 - - - - - 2 - 1 - - - 1 - - 1 |
    | 2 - - 2 3 - - 2 1 - - 7_ 6_ - - 7_ | 1 - - - - - - - 0 - - - 3_ - - 4_ |

    /* 第三行 */
    | 5_ - - - 5_ - - - 6_ - - 7_ 1 - - 2 | 3 - - - - - - - 5_ - 0 - 5_ - - 5_ |
    | 4_ - - 3_ 4_ - - 5_ 6_ - - 7_ 1 - - 2 | 3 - - - - - - - 2 - 0 - 3_ - - 4_ |

    /* 第四行 */
    | 5_ - - - 5_ - - - 6_ - - 7_ 1 - - 2 | 3 - - - - - - - 5_ - 0 - 5_ - - 5_ |
    | 4_ - - 3_ 4_ - - 5_ 6_ - - 7_ 1 - - 2 | 1 - - - - - - - 0 - - - {f} 1 - - 1 |

    /* 第五行 */
    | 1 - - - - - - - 0 - - - 1 - - 1 | 1 - - - - - - - 0 - - - 1 - - 1 |
    | 2 - - - 2 - - - 2 - - - 2 - - - | 7_ - - - - - - - 0 - - - 5_ - - 5_ |
    | 1 - - - - - - - 0 - - - 5_ - - 5_ | 3 - - - - - - - 0 - - - 3 - - 3 |

    /* 第六行 */
    | 4 - - - 3 - - - 2 - - - 1 - - - | 7_ - - - 0 - - - 5_ - - - 0 - - - |
    | 1 - - - 0 - - - 5_ - - - 0 - - - | 3 - - - 0 - - - 1 - - - 0 - - - |
    | {ff} 5 - - - - - - - 5_ - - - - - - - | 1 - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    | 0 0 0 0 |
    | 1_ [1] 4_ [1] | 1_ [1] [1] 0 |
    | 5__ [5_] 5__ [5_] | 1_ [5_] 5__ 0 |
    | 1_ [1] 4_ [1] | 1_ [1] 6__ [6_m] |
    | 5__ [5_] 5__ [5_] | 1_ [1] 0 0 |
    | 1_ [1] 4_ [1] | 1_ [1] 5__ 0 |
    | 5__ [5_] 5__ [5_] | 1_ [1] 5__ 0 |
    | 1_ [1] 4_ [1] | 1_ [1] 5__ 0 |
    | 5__ [5_] 5__ [5_] | 1_ [1] 0 0 |
    | 1_ [1] 0 0 | 6__ [6_m] 0 0 |
    | 2_ [2_m] 2_ [2_m] | 5__ [5_] 0 0 |
    | 1_ [1] 0 0 | 1_ [1] 0 0 |
    | 4_ [1] 5__ [1] | 5__ 0 5__ 0 |
    | 1_ 0 5__ 0 | 1_ 0 1_ 0 |
    | 5__ - 5__ - | 1_ - 0 0 |
}

