/* =========================================================================
   原書資訊與歌詞全文（對應 P084.jpg，書頁 p. 61，參考教材第 19 首）：
   速度與表情：♩=100
   調性與拍號：は長調四分之四拍子（C 大調 4/4 拍）

   春の朝（あした）　花の下（もと）に
   共に楽しく　親しみ合ひし
   秋の夕（ゆふべ）　月の影に
   共に嬉しく　語らひ合ひし
   日頃（ひごろ）の交（まじは）り　忘れぬ程に
   惜（を）しき別（わか）れを　告げなんさらば
   ========================================================================= */

Wakare:Piano@|0| {
    <16*>
    /* ================= 第一行 (4 小節, P084.jpg) ================= */
    /* ハ ル ノ ハ ル ノ | ア ー シ タ | ハ ー ナ ノ | モ ー ト ニ ト モ */
    /* あ き の あ き の | ゆ ー ふ べ | つ ー き の | か ー げ に と も */
    | {p} 0 - - - 0 - - - 0 - - - 1 - - 2 | 3 - - - {mp} 2 - - 3 4 - - - 4 - - 5 | 3 - - - 2 - - - 1 - - 2 3 - - 4 | 2 - - - 2 - - 5_ 1 - - - {mf} 1 - - 2 |

    /* ================= 第二行 (3 小節, P084.jpg) ================= */
    /* ニ ト モ ニ | タ ノ シ ク | シ タ シ ミ | ア ー ヒ ー シ ひ ご */
    /* に と も に | う れ し く | か た ら ひ | あ ー ひ ー し */
    | 3 - - - 2 - - 3 4 - - - 4 - - 5 | 3 - - - 2 - - - 5 - - 4 3 - - 2 | 1 - - - 2 - - 3 1 - - - {p} 5_ - - 5_ |

    /* ================= 第三行 (3 小節, P084.jpg) ================= */
    /* ろ の ま じ | は り わ す | れ ぬ ほ ど | に を し */
    | 3 - - 3 2 - - - 1 - - 1 6_ - - 6_ | 5_ - - - 5_ - - 1 7_ - - 1 2 - - 3 | 4 - - - 6 - - - 5 - - - {mf} 1 - - 2 |

    /* ================= 第四行 (3 小節, P084.jpg) ================= */
    /* き わ か れ | を つ げ な | ん さ ら ば */
    | 3 - - 4 2 - - - 5 - - - 3 - - - | 2 - - - {p} 1 - - 2 3 - - 4 2 - - - | 2 - - 5_ 1 - - - - - - - 0 - - - |
}

