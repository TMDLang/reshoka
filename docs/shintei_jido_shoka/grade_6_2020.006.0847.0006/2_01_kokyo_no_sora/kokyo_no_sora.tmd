** 故郷の空 **
!= 88
?= G
<2/4>
~ "明治唱歌"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第六學年用（2020.006.0847.0006）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P036.jpg，書頁 p. 13，第二學期第 1 首）：
   調性與拍號：と長調四分之二拍子（G 大調 2/4 拍）

   一、
   夕空晴れて秋風吹き
   月影落ちて鈴虫なく
   思へば遠し故郷の空
   あゝわが父母いかに在（おは）す

   二、
   澄（す）みゆく水に秋萩たれ
   玉なす露はすゝきにみつ
   想へば似たり故郷の野邊
   あゝわが同胞（はらから）たれと遊ぶ
   ========================================================================= */

KokyoNoSora:Piano@|0| {
    <16*>
    /* ================= 第一行 (4 小節, P036.jpg) ================= */
    | 5_ - - 5_ 5_ - - 3 | 2 - - 3 5 - - 3 | 2 - - 1 6_ - - 5_ | 6_ - - - 0 - - - |

    /* ================= 第二行 (4 小節, P036.jpg) ================= */
    | 5_ - - 5_ 5_ - - 3 | 2 - - 3 5 - - 3 | 2 - - 1 2 - - 3 | 1 - - - 0 - - - |

    /* ================= 第三行 (4 小節, P036.jpg) ================= */
    | 6 - - 5 3 - - 5 | 3 - - 2 1 - - 2 | 3 - - 5 6 - - 5 | 3 - - - 0 - - 6 |

    /* ================= 第四行 (4 小節, P036.jpg) ================= */
    | 5 - - 3 3 - - 5 | 3 - - 2 1 - - 2 | 5_ - - 5_ 6_ - - 5_ | 1 - - - 0 - - - |
}

