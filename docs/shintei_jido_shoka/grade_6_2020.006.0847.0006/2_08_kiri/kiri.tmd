::SCORE::
** 霧 **
!= 76
?= G
<4/4>
~ "曲：山本壽"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第六學年用（2020.006.0847.0006）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P046.jpg–P047.jpg，書頁 pp. 23–24，第二學期第 8 首）：
   調性與拍號：と長調四分之四拍子（G 大調 4/4 拍，中段轉同主音 G 小調），♩=76

   一、
   しら〲と朝霧、野山をこめて
   月のごと日輪（にちりん）、ほのかに浮ぶ
   野路（のぢ）を行く人影、直ちにきえて
   けたゝましもずの音、梢はいづこ
   谷間よりはひ出て、木の幹ぬらし
   しら〲とおぼろに、朝霧流る

   二、
   しめやかに夜の霧ちまたをつゝみ
   立並ぶ家々、燈火うるむ
   影のごと人去り、人來る大路
   ほろ〲と聞ゆる笛の音いづこ
   窓ぎはにはひよりガラス戸ぬらし
   しめやかにひそかに夜の霧流る
   ========================================================================= */

Kiri:Piano@|0| {
    <16*>
    /* ================= 第一行 (3 小節, P046.jpg) ================= */
    | 5_ - - 5_ 5_ - - - - - 5_ - 1 - - 2 | 3 - - - - - 5 - 5 - - - 5 - 3 - | 2 - - 2 3 - 2 - 1 - - - 0 - - - |

    /* ================= 第二行 (3 小節, P046.jpg) ================= */
    | 5_ - - 5_ 5_ - - - - - 6_ - 1 - 3 - | 3 - - - - - - - 5 - - - 3 - - - | 2 - - 3 2 - 7_ - 5_ - - - 0 - - - |

    /* ================= 第三行 (3 小節, 轉と短調, P046.jpg) ================= */
    | 1 - - 1 1 - - 1 1 - 3, - 2 - - - | 1 - - - 5_ - - - - - - - 1 - 2 - | 3, - - 3, 2 - 1 - 5 - - - 0 - - - |

    /* ================= 第四行 (3 小節, と短調, P046.jpg) ================= */
    | 5 - - 5 5 - - - - - 5 - 4 - 3, - | 2 - - - 5 - - - - - - - 5_ - 6,_ - | 1 - - 1 2 - 3, - 2 - - - 0 - - - |

    /* ================= 第五行 (3 小節, 返と長調, P046.jpg) ================= */
    | 5_ - - 5_ 5_ - - - - - 6_ - 1 - 3 - | 2 - - - 5 - - - - - - - 3 - 1 - | 2 - - 2 5_ - 7_ - 1 - - - 0 - - - |

    /* ================= 第六行 (3 小節, P046.jpg) ================= */
    | 5_ - - 5_ 5_ - - - - - 5_ - 1 - 3 - | 2 - - - 5 - - - - - - - 3 - 1 - | 6_ - - 1 2 - 3 - 1 - - - 0 - - - |
}

