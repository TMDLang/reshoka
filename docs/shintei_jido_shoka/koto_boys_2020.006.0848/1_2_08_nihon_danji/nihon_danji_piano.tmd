    | 5__ [1] 5__ [5_] | 1_ [1] 5__ 0 |
}

Refrain:PianoRH@|0| {
    <16*>
    /* 第四行 (復唱) */
    | {f} 3 - - 2 1 - 7_ - 6_ - - 7_ 1 - 2 - | 3 - - - 2 - - - 0 - 1 - 2 - 3 - |
    | {ff} 4 - - 3 2 - 1 - 5 - - - 5_ - - - | 1 - - - - - - - - - - - 0 - - - |
}

Refrain:PianoLH@|0| {
