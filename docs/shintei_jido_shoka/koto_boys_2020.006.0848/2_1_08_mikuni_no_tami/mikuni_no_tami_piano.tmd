::SCORE::
** 御國の民（鋼琴伴奏版） **
!= 116
?= G
<4/4>
~ "詞：東京音樂學校編《中等唱歌》"
~ "曲：東京音樂學校編《中等唱歌》"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {f} 5_ - - - |

    /* 第一行 */
    | 1 - - - 2 - - 3 4 - - - 3 - - - | 2 - - - 0 - - - 3 - - 4 5 - - 5 |
    | 5 - - - 3 - - - 5 - - - 0 - - - |

    /* 第二行 */
    | 5 - - - 3 - - 1 6 - - - 5 - - - | 4 - 2 - 3 - 1 - 2 - - - 5_ - - - |
    | 1 - - - 2 - - 3 4 - - - - - - - |

    /* 第三行 */
    | 3 - 1 - 2 - 7_ - 1 - - - - - - - | 3 - - - 3 - - 3 3 - - - 1 - - - |
    | 6 - - - 5 - - - 4' - - - 5 - - - |

    /* 第四行 */
    | (5 4' 5)%(----) (6 5 4')%(----) 5 - - - 2 - - - | 3 - - - 1 - - - 2 - - - 0 - 5_ - |
    | 1 - - - 3 - - - 5 - - - 3 - - - |

    /* 第五行 */
    | 2 - 3 - 4 - - - 3 - - - 0 - - - | 2 - - 3 4 - 2 - 3 - 1 - 2 - 0 - |
    | {mf} 5 - - - 3 - - - 1 - - - 3 - - - |

    /* 第六行 */
    | 2 - 3 - 4 - - - 3 - - - 0 - - - | 2 - - 3 4 - 2 - 3 - 1 - 2 - 0 - |
    | {mf} 5 - - - - - - - 3 - - 1 1 - - - |

    /* 第七行 */
    | 6_ - 7_ - 1 - 6_ - 5_ - - - - - - - | 1 - - 2 3 - - 4 5 - - - - - - - |
    | 6 - 5 - 4 - 3 - 2 - - - 5 - - - | {ff} 1^ - - - 5 - - - 3 - - - 1 - - 3 |

    /* 第八行 */
    | 2 - - 1 6_ - 1 - 5 - - - - - - - | (6 5 4)%(----) (3 2 1)%(----) 5 - - - 7_ - - - |
    | 1 - - - 1 - - - 1 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1_ [1] 4_ [1] | 5__ [5_] 1_ [1] |
    | 1_ [1] 1_ 0 |

    /* 第二行 */
    | 1_ [1] 4_ [1] | 2_ [1] 5__ 0 |
    | 1_ [5_] 4_ [4_] |

    /* 第三行 */
    | 5__ [5_] 1_ [1] | 3_ [3_m] 6__ [6_m] |
    | 2_ [2_] 2_ [5_] |

    /* 第四行 */
    | 2_ [2_] 2_ [2_] | 1_ [1] 5__ 0 |
    | 1_ [1] 1_ [1] |

    /* 第五行 */
    | 5__ [5_] 1_ 0 | 5__ [5_] 1_ 0 |
    | 1_ [1] 1_ [1] |

    /* 第六行 */
    | 5__ [5_] 1_ 0 | 5__ [5_] 1_ 0 |
    | 1_ [1] 1_ [1] |

    /* 第七行 */
    | 4_ [1] 5__ [5_] | 1_ [1] 5__ [5_] |
    | 4_ [1] 5__ [5_] | 1_ [1] 1_ [1] |

    /* 第八行 */
    | 2_ [2_m] 5__ [5_] | 4_ [1] 5__ [5_] |
    | 1_ [1] 1_ 0 |
}

-> Main -> #

