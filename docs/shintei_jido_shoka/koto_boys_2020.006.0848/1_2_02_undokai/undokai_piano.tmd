::SCORE::
** 運動會（鋼琴伴奏版） **
!= 96
?= G
<2/4>
~ "詞：大和田建樹（松邑三松堂發行檢定唱歌集）"
~ "曲：R. Wagner（ワグナー）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {f} 5_ - - - 1 - - 2 | 3 - - - - - 0 - | 5_ - - - 2 - - 3 | 4 - - - - - 0 - |
    | 5_ - - - 3 - - 4 | 5 - 3 - 2 - 1 - |

    /* 第二行 */
    | 6_ - - - 4 - - 2 | 7_ - - - - - 0 - | 5_ - - - 1 - - 2 | 3 - - - - - 0 - |
    | 5_ - - - 2 - - 3 | 4 - - - - - 0 - |

    /* 第三行 */
    | 5_ - - - 3 - - 4 | 5 - - - 3 - - 1 | 5_ - - - 2 - - 7_ | 1 - - - - - 0 - |
    | {mf} 5 - - - 3 - - 1 | 6_ - - - 4 - - - |

    /* 第四行 */
    | 2 - - - 7_ - - 5_ | 1 - - - - - 0 - | 4 - - - 2 - - 7_ | 6_ - - - 7_ - - - |
    | 1 - - - 3 - - 1 | 2 - - - - - 0 - |

    /* 第五行 */
    | {f} 5_ - - - 1 - - 2 | 3 - - - - - 0 - | 5_ - - - 2 - - 3 | 4 - - - - - 0 - |

    /* 第六行 */
    | 5_ - - - 3 - - 4 | 5 - - - 3 - - 1 | 5_ - - - 2 - - 7_ | 1 - - - - - 0 - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 1_ [1] | 1_ [1] | 5__ [5_] | 1_ [4_] |
    | 1_ [1] | 1_ [1] |

    /* 第二行 */
    | 4_ [2_m] | 5__ [5_] | 1_ [1] | 1_ [1] |
    | 5__ [5_] | 1_ [4_] |

    /* 第三行 */
    | 1_ [1] | 1_ [1] | 5__ [5_] | 1_ 0 |
    | 1_ [1] | 4_ [4_] |

    /* 第四行 */
    | 5__ [5_] | 1_ [1] | 2_ [5_] | 6__ [2_m] |
    | 1_ [1] | 5__ [5_] |

    /* 第五行 */
    | 1_ [1] | 1_ [1] | 5__ [5_] | 1_ [4_] |

    /* 第六行 */
    | 1_ [1] | 1_ [1] | 5__ [5_] | 1_ 0 |
}

