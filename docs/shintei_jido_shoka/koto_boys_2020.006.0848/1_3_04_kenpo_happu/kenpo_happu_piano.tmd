::SCORE::
** 憲法發布（鋼琴伴奏版） **
!= 80
?= E,
<4/4>
~ "詞：旗野士良"
~ "曲：F. J. Haydn（ハイドン）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

A:PianoRH@|0| {
    <8*>
    /* 第一行 */
    | {mp} 1 - - 2 3 - 2 - | 4 - 3 - 2 7_ 1 - | 6 - 5 - 4 - 3 - | 2 - 3 1 5 - - - |

    /* 第二行 */
    | 1 - - 2 3 - 2 - | 4 - 3 - 2 7_ 1 - | 6 - 5 - 4 - 3 - | 2 - 3 1 5 - - - |

    /* 第三行 */
    | {p} 2 - 3 - 2 7_ 5_ - | {mp} 4 - 3 - 2 7_ 5_ - | 5 - 4 - {mf} 3 - - 3 | 4' - 4' 5 5 - - - |
}

A:PianoLH@|0| {
    <4*>
    | 1_ - [1] [5_] | 4_ [1] [5_] [1] | 4_ [1] [5_] [1] | 2_ [1] [5_] - |
    | 1_ - [1] [5_] | 4_ [1] [5_] [1] | 4_ [1] [5_] [1] | 2_ [1] [5_] - |
    | 5__ - [5_] - | 5__ - [5_] - | 5__ [5_] 1_ [1] | 2_ [2_] [5_] - |
}

Refrain:PianoRH@|0| {
    <16*>
    | {f} 1^ - - - - - 7 - 6 - 5 - 4 - - - | 5 - - - - - 4 - 3 - 2 - 1 - - - |
    | {mf} 7_ - - - 1 - 2 - 3 - 4 - 5 - 6 - | {p} 2 - - - - - 3 2 1 - - - - - - - |
}

Refrain:PianoLH@|0| {
    <4*>
    | 1_ - [4] - | 5__ - [1] - | 5__ [1] [4] [4] | 5__ [5_] [1] - |
}

-> A -> Refrain -> Refrain -> #

