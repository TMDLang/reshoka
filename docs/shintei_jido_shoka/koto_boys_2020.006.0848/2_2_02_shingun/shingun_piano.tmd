    | 3 - - - 3 - - - 3 - - - 3 - - - | 5 - - - - - - - - - - - 3 - - 1 | 7_ - - - 1 - - - 2 - - - 3 - - - | 2 - - - - - - - 7_ - 1 - 2 - - 5_ |

