Verse:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | {f} 1_ [1] 5__ [1] | 1_ [1] 5__ [1] | 5__ [5_] 5__ [5_] | 2_ [5_] 5__ 0 |

