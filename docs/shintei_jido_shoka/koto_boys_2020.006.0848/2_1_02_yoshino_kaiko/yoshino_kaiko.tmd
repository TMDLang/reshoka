** 吉野懷古 **
!= 80
?= Eb
<3/4>
~ "詞：杉谷代水"
~ "曲：シユーベルト（F. Schubert，獨國）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P080.jpg，書頁 p. 3，高二第一學期第 2 首）：
   調性與拍號：變ホ長調（3 降記號）、3/4 拍（想ヲ込メテ熱心ニ ♩=80，弱起第 3 拍後半進入）
   原曲：舒伯特《冬之旅》〈菩提樹〉（Der Lindenbaum）
   出處註記：（松邑三松堂發行檢定唱歌集）

   一
   花（はな）にかくれし　鎧（よろひ）姿（すがた）
   ありし武士（もののふ）　影（かげ）や何處（いづこ）
   雲（くも）よ白雲（しらくも）　雪（ゆき）よ吹雪（ふぶき）
   跡（あと）は埋（うづ）めど　消（き）えぬ忠誠（まこと）
   消（き）えぬ懷（おも）ひ。

   二
   君（きみ）が御衣（みけし）に　露（つゆ）ぞ重（おも）き
   假（かり）の宮居（みやゐ）の　長（なが）き夢路（ゆめぢ）
   春（はる）は語（かた）らず　花（はな）は言（い）はず
   誰（たれ）が殘（のこ）りて　昔（むかし）告ぐる
   昔（むかし）語（かた）る。
   ========================================================================= */

Main:Piano@|-1|{
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - {p} 5 - |
    L1| _ - - - _ - - - _ - ハ - |
    L2| _ - - - _ - - - _ - キ - |

    /* 第一行 */
    | 5 - - - - - 3 - 3 - 3 - | 3 - - - 1 - - - 0 - 1 - |
    L1| ナ - - - - - ニ - カ - ク - | レ - - - シ - - - _ - ヨ - |
    L2| ミ - - - - - ガ - ミ - ケ - | シ - - - ニ - - - _ - ツ - |

    | 2 - - - - - 3 - 5 4 2 - | 3 - - - - - - - 0 - 5 - |
    L1| ロ - - - - - ヒ - ス ー ガ - | タ - - - - - - - _ - ア - |
    L2| ユ - - - - - ゾ - オ ー モ - | キ - - - - - - - _ - カ - |

    /* 第二行 */
    | 5 - - - - - 3 - 3 - 3 - | 3 - - - 1 - - - 0 - 1 - |
    L1| リ - - - - - シ - モ - ノ - | ノ - - - フ - - - _ - カ - |
    L2| リ - - - - - ノ - ミ - ヤ - | ヰ - - - ノ - - - _ - ナ - |

    | 2 - - - - - 3 - 5 4 2 - | 1 - - - - - - - 0 - {mp} 1 - |
    L1| ゲ - - - - - ヤ - イ ー ヅ - | コ - - - - - - - _ - ク - |
    L2| ガ - - - - - キ - ユ ー メ - | ヂ - - - - - - - _ - ハ - |

    /* 第三行 */
    | 2 - - - - - 2 - 2 - 2 - | 3 - - 4 5 - - - - - {mf} 5 - |
    L1| モ - - - - - ヨ - シ - ラ - | ク - - ー モ - - - - - ユ - |
    L2| ル - - - - - ハ - カ - タ - | ラ - - ー ズ - - - - - ハ - |

    | 6 - - - - - 5 - 3 - 1 - | 2 - - - - - - - 0 - 2 - |
    L1| キ - - - - - ヨ - フ - ブ - | キ - - - - - - - _ - ア - |
    L2| ナ - - - - - ハ - イ - ハ - | ズ - - - - - - - _ - タ - |

    | 2 - - - - - 2 - 2 - 2 - |
    L1| ト - - - - - ハ - ウ - ヅ - |
    L2| レ - - - - - ガ - ノ - コ - |

    /* 第四行 */
    | 3 - - 4 5 - - - {mf} 0 - 5 - | 6 - - - 5 - 3 - 4 - 2 - |
    L1| メ - - ー ド - - - _ - キ - | エ - - - ー - ヌ - マ - コ - |
    L2| リ - - ー テ - - - _ - ム - | カ - - - ー - シ - ツ - グ - |

    | 5 - - - - - - - 0 - {f} 5 - | 6 - - - 5 - 3 - 5 4 2 - |
    L1| ト - - - - - - - _ - キ - | エ - - - ー - ヌ - オ ー モ - |
    L2| ル - - - - - - - _ - ム - | カ - - - ー - シ - カ ー タ - |

    | 1 - - - - - - - 0 - 0 - |
