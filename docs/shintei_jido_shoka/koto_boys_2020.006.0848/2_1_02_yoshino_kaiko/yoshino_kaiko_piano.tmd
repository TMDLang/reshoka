::SCORE::
** 吉野懷古（鋼琴伴奏版） **
!= 80
?= E,
<3/4>
~ "詞：杉谷代水"
~ "曲：シユーベルト（F. Schubert，獨國）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {p} 5 - 3 - |

    /* 第一行 */
    | 3 - - - - - - - 1 - 1 - | 1 - - - 3 - - - 0 - 5 5 |
    | 5 - - 3 4 - - 3 (2 4 2)%(----) | 3 - - - - - 0 - 5 - 3 - |

    /* 第二行 */
    | 3 - 3 - 1 - 1 - 1 - - - | 1 - - - 3 - - - 0 - 5 - |
    | 5 - - 3 4 - - 3 (2 4 2)%(----) | 1 - - - - - 0 - {mp} 5 - 5 - |

    /* 第三行 */
    | 4 - 3 - 2 - 1 - 7_ - - 2 | {mf} 5 - 5 - 6 - - - 4 - - 2 |
    | 3 - - - - - 0 - 2 - 2 - | 3 - - - 2 - 1 - 7_ - 1 - |

    /* 第四行 */
    | 4 - - 2 7_ - 0 - {mf} 0 - 5 5 | 3 - - - 4 - - - 2 - 5 - |
    | 3 - - - - - 0 - {f} 0 - 5 5 | 5 - - 3 4 - - 3 (2 4 2)%(----) |
    | 1 - - - - - 0 - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 |

    /* 第一行 */
    | 1_ [1] [1] | 1_ [1] [1] |
    | 5__ [5_] [5_] | 1_ [1] 0 |

    /* 第二行 */
    | 1_ [1] [1] | 1_ [1] [1] |
    | 5__ [5_] [5_] | 1_ [1] 0 |

    /* 第三行 */
    | 5__ [5_] [5_] | 1_ [4_] [5_] |
    | 1_ [1] [5_] | 1_ [1] [5_] |

    /* 第四行 */
    | 2_ [5_] 0 | 1_ [4_] [5_] |
    | 1_ [1] 0 | 5__ [4_] [5_] |
    | 1_ [1] 0 |
}

-> Main -> #

