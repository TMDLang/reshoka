::SCORE::
** 遊獵（鋼琴伴奏版） **
!= 120
?= G
<6/8>
~ "出處：文部省編《小學唱歌集》"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - 0 - {f} 5_ - |

    /* 第一行 */
    | 1 - - - 1 - 2 - - 1 7_ - | 6_ - - - 4_ - 5_ - - - 1 - |
    | 3 - - - 3 - 4 - - - 3 - | 2 - - - - - - - - - 5_ - |

    /* 第二行 */
    | 2 - - - 2 - 3 - - - 4 - | 5 - - - 3 - 1 - - - 3 - |
    | 5 - - - 5 - 6 - - 5 4 - | 3 - - - - - 2 - - - 5_ - |

    /* 第三行 */
    | 1 - - - 1 - 2 - - - 2 - | 3 - - - 1 - 6_ - - - 2 - |
    | 3 - - - 3 - 4 - - 3 2 - | 5 - - - - - 4 - - - 3 - |

    /* 第四行 */
    | 3 - - - 3 - 4 - - 3 2 - | 1 - - - 5_ - 6_ - - - 1 - |
    | 3 - - - 5 - 2 - - - 7_ - | 1 - - - - - 1 - - - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 0 0 0 0 0 |

    /* 第一行 */
    | 1_ - - [5_] - - | 6__ - - [5_] - - |
    | 1_ - - [4_] - - | 5__ - - [5_] - 0 |

    /* 第二行 */
    | 5__ - - [5_] - - | 1_ - - [1] - - |
    | 1_ - - [4_] - - | 5__ - - [5_] - 0 |

    /* 第三行 */
    | 1_ - - [5_] - - | 6__ - - [6_m] - - |
    | 3_ - - [2_m] - - | 5__ - - [5_] - 0 |

    /* 第四行 */
    | 1_ - - [5_] - - | 1_ - - [6_m] - - |
    | 5__ - - [5_] - - | 1_ - - [1] - 0 |
}

-> Main -> Main -> #

