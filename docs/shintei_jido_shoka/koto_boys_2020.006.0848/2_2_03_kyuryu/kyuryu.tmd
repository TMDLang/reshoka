::SCORE::
** 急流 **
!= 108
?= G
<2/4>
~ "詞：大和田建樹"
~ "曲：獨國風歌"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P092.jpg – P093.jpg，書頁 pp. 15–16，高二第二學期第 3 首）：
   調性與拍號：ト長調（G Major，1 升記號）轉ハ長調（C Major，無升降記號）、2/4 拍（爽快ニ ♩=108）
   出處註記：（松邑三松堂發行檢定唱歌集）

   一
   泡立てゝ行く　水の流れ
   千軍の叫か　萬馬の蹄か
   雪の如く　空に飛び
   雷の響は　巖を打つ
   愉快に踊り　愉快に舞踏して
   いつまでも飽かず　遊べや遊べや

   二
   矢を射るに似て　早き流れ
   鋒を揃へて　落ちくる瀧つ瀨
   膽も冷えて　夏さむく
   まろび散る白玉　皷の聲
   嬉しく歌ひ　楽しく唱歌して
   足ぶみも高く　遊べや遊べや
   ========================================================================= */

PartA:Piano@|0| {
    <16*>
    /* 弱起小節（後半拍進入） */
    | 0 - - - 0 - {mf} 5 - |

    /* 第一行（5 小節） */
    /* ワ ダ テ テ | ユ ク ミ | ヅ ノ ナ ガ | レ セ | ン グ ン ノ */
    | 3 - 3 - 3 - 3 - | 5 - 3 - 0 - 5 - | 2 - - 3 4 - 2 - | 3 - - - 0 - 3 - | 3 - 3 - 3 - 3 - |

    /* 第二行（5 小節） */
    /* サ ケ ビ カ | バ ン バ ノ | ヒ ヅ メ カ | ユ キ ノ | ゴ ト ク */
    | 1 - 3 - 5 - 3 - | 2 - - 3 2 - 1 - | 7_ - 6_ - 7_ - 1 - | 5_ - 5 - - - 4 - | 5_ - 5 - - - 4 - |

    /* 第三行（6 小節） */
    /* ソ ラ ニ ト | ビ イ | カ ヅ チ ノ | ヒ ビ キ ハ | イ ハ ホ ヲ | ウ ツ */
    | 3 - 2 - 3 - 4 - | 5 - - - 0 - 5 - | 5 - 4 - 3 - 5 - | 6 - 5 - 4 - 3 - | 2 - 1 - 2 - 3 - | 1 - 0 - 1 - 0 - |
}

PartB:Piano@|0| {
    <16*>
    {?= C}
    /* 第四行（5 小節，轉ハ長調） */
    /* ユ カ イ ニ ヲ ド | リ | ユ カ | イ ニ | ブ ト ー シ */
    | {f} 3_ - 3_ - 4_ 3_ 4_ 5_ | 6_ - - - - - - - | 0 - - - 5_ - 5_ - | 1 - - - - - 7_ - | 6_ - 5_ - 4_ - 3_ - |

    /* 第五行（5 小節） */
    /* テ | イ ツ マ | デ モ | ア カ | ズ */
    | 2_ - - - - - - - | 0 - 5_ - 5_ - 5_ - | 1 - - - 5_ - - - | 2 - - - 5_ - - - | 3 - - - - - - - |

    /* 第六行（5 小節） */
    /* ア ソ ベ | ヤ ア | ソ ベ | ヤ | ー */
    | 0 - 5_ - 5_ - 5_ - | 6_ - - - 2 - - - | 1 - - - 7_ - - - | 1 - - - - - - - | 1 - - - 0 - - - |
}

-> PartA -> PartB -> #

