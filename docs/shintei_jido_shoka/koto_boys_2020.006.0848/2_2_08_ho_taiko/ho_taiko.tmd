::SCORE::
** 豐太閤 **
!= 100
?= F
<4/4>
~ "詞：桑田春風"
~ "曲：ドニツェッチイ（伊）（Gaetano Donizetti）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P102.jpg – P103.jpg，書頁 pp. 25–26，高二第二學期第 8 首）：
   調性與拍號：ヘ長調（F Major，1 降記號）、4/4 拍（威嚴ヲ以テ ♩=100）
   出處註記：（松邑三松堂發行檢定唱歌集）

   一
   卑賤より起りて、軈て名を揚げ、
   利達をば極めて、關白となる。
   海外の征伐、國威遠く振ひ、
   一代の功績、古來稀に見る。
   果敢なしや聚樂の、榮華こそ夢、
   身亡びて世亂る、されどあはれ丈夫。
   ========================================================================= */

Verse:Piano@|0| {
    <16*>
    /* 第一行（4 小節，P102.jpg） */
    /* ヒ セ ン ヨ リ | オ コ リ テ | ヤ ガ テ ナ ヲ | ア ゲ */
    | {f} 5_ - - 1 3 - - 1 5 - - - - - - - | 6 - - 4 2 - - 5 3 - - - - - - - | 2 - - 3 4 - - 7__ 1 - - - 3 - - - | 3 - - - - - - - 2 - - - - - - - |

    /* 第二行（4 小節，P102.jpg） */
    /* リ タ ツ ヲ バ | キ ハ メ テ | カ ン パ ク ト | ナ ル */
    | 5_ - - 1 3 - - 1 5 - - - - - - - | 6 - - 4 2 - - 5 3 - - - - - - - | 2 - - - 1' - - 2 6 - - 5 7__ - - - | 2 - - - - - - - 1 - - - - - - - |

    /* 第三行（4 小節，P102.jpg） */
    /* カ イ ガ イ ノ | セ イ バ ツ | コ ク イ ト ホ ク | フ ル ヒ */
    | {mf} 2 - - 2 5 - - 2 4 - - - 3 - - - | 2 - - - - - 1 - 7__ - - 1 2 - - - | {f} 3 - - 3 6 - - 5 4 - - 3 2 - - - | 1 - - - - - 3 - 5_ - - - - - - - |

    /* 第四行（4 小節，P102.jpg） */
    /* イ チ ダ イ ノ | イ サ ヲ シ | コ ラ イ マ レ ニ | ミ ル */
    | {mf} 2 - - 2 5 - - 2 4 - - - 3 - - - | 2 - - - - - 1 - 7__ - - 1 2 - - - | {f} 3 - - 6 5 - - 4 3 - - 2 1 - - - | 2 - - - - - - - 5 - - - - - - - |

    /* 第五行（4 小節，P102.jpg） */
    /* ハ カ ナ シ ヤ | ジュ ラ ク ノ | エ イ ガ コ ソ | ユ メ */
    | 5_ - - 1 3 - - 1 5 - - - - - - - | 6 - - 4 2 - - 5 3 - - - - - - - | 2 - - 3 4 - - 7__ 1 - - - 3 - - - | 3 - - - - - - - 2 - - - - - - - |

    /* 第六行（4 小節，P102.jpg） */
