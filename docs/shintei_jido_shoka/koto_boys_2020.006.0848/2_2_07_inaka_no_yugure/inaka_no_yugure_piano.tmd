::SCORE::
** 田舍の夕暮（鋼琴伴奏版） **
!= 96
?= E,
<3/4>
~ "曲：北村季晴"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Verse:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {mp} 5_ - - 5_ |

    /* 第一行 */
    | 5_+1 - - - 5_+1 - - - 3 2 1 3 | 1+5 - - - 1+5 - - - (6 5 4)%(----) | 1+3 - - - 7_+2 - - - - - 3 1 |

    /* 第二行 */
    | 5_ - - - 2_+5_ - - - 5_ - - 5_ | 5_+1 - - - 5_+1 - - - 3 2 1 3 | 1+5 - - - 1+5 - - - (6 5 4)%(----) | 1+3 - - - 7_+2 - - - - - 3 2 |

    /* 第三行 */
    | 5_+1 - - - 5_+1 - - - {mf} (5 3 5)%(----) | 3+1^ - - - 3+1^ - - - (6 1^ 6)%(----) | 1+5 - - - 1+3 - - - (2 1 2)%(----) | 1+3 - - - 1+4 - - - 1+6 - - - |

    /* 第四行 */
    | 7_+2+5 - - - 7_+2+5 - - - (5 3 5)%(----) | 3+1^ - - - 3+1^ - - - (6 1^ 6)%(----) | 1+5 - - - 1+3 - - - (2 1 2)%(----) | 1+3 - - - - - - - 7_+2 - - - |

    /* 第五行 */
    | 5_+1 - - - 5_+1 - - - {mp} 1^ - - 5 | 1+6 - - - 1+5 - - - 1^ - - 5 | 1+6 - - - 1+5 - - - (6 5 4)%(----) | 1+3 - - - - - - - 7_+2 - - - |

    /* 第六行 */
    | 5_ - - - 2_+5_ - - - {mf} 5_ - - 5_ | 5_+1 - - - 5_+1 - - - 3 2 1 3 | 1+5 - - - 1+5 - - - (6 5 4)%(----) | 1+3 - - - - - - - 5_+7_+2 - - - | 5_+1+3 - - - - - - - 0 - - - |
}

Verse:PianoLH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - |

    /* 第一行 */
    | {p} 1_ - 5__ - 3_ - 5__ - 1_ - - - | 1_ - 5__ - 3_ - 5__ - 4_ - - - | 1_ - - - 5__ - 2_ - 5__ - - - |

    /* 第二行 */
    | 5__ - 2_ - 5__ - - - 0 - - - | 1_ - 5__ - 3_ - 5__ - 1_ - - - | 1_ - 5__ - 3_ - 5__ - 4_ - - - | 5_ - - - 5__ - 2_ - 5__ - - - |

    /* 第三行 */
    | 1_ - 5__ - 1_ - - - {mp} 0 - - - | 1_ - 5_ - 1_ - 5_ - 4_ - - - | 1_ - 5__ - 1_ - 5__ - 5__ - - - | 1_ - - - 4_ - - - 4__ - - - |

    /* 第四行 */
    | 5__ - 2_ - 5__ - - - 0 - - - | 1_ - 5_ - 1_ - 5_ - 4_ - - - | 1_ - 5__ - 1_ - 5__ - 5__ - - - | 5_ - 3_ - 1_ - - - 5__ - - - |

    /* 第五行 */
    | 1_ - 5__ - 1_ - - - {p} 0 - - - | 4_ - 1_ - 1_ - 5__ - 1_ - - - | 4_ - 1_ - 1_ - 5__ - 4__ - - - | 5__ - 1_ - 3_ - - - 5__ - - - |

    /* 第六行 */
    | 5__ - 2_ - 5__ - - - {mp} 0 - - - | 1_ - 5__ - 3_ - 5__ - 1_ - - - | 1_ - 5__ - 3_ - 5__ - 4_ - - - | 5_ - 3_ - 1_ - - - 5__ - - - | 1_ - 5__ - 1__ - - - 0 - - - |
}

