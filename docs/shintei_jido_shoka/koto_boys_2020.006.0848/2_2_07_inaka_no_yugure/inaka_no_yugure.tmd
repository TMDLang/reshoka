** 田舍の夕暮 **
!= 96
?= E,
<3/4>
~ "曲：北村季晴"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P100.jpg – P101.jpg，書頁 pp. 23–24，高二第二學期第 7 首）：
   調性與拍號：變ホ長調（E♭ Major，3 降記號）、3/4 拍（沈靜ニ ♩=96，弱起第 3 拍進入）
   出處註記：（弘樂社發行中等音樂教科書）

   一
   端山のみ空の雲の旗手
   黃金の色にぞかはり行きて
   入日も山邊に急ぎゆく
   畷の並木に風寒く
   辿るや馬子のうたごゑも
   黃昏れ初めたる夕かな

   二
   夕空辿る旅鳥
   後や先なる聲々や
   ふりさけ見れば山寺の
   塔のいらかの影黑く
   ひとり靜かに暮れ殘る
   野路の里わのゆふべかな
   ========================================================================= */

Verse:Piano@|0| {
    <16*>
    /* 弱起小節（前 2 拍休止，第 3 拍進入） */
    | 0 - - - 0 - - - {mp} 5_ - - 5_ |

    /* 第一行（3 小節，P100.jpg） */
    /* マ ノ ミ ー ソ ー | ラ ノ ク ー モ | ノ ハ タ ー */
    | 1 - - - 1 - - - 3 2 1 3 | 5 - - - 5 - - - (6 5 4)%(----) | 3 - - - 2 - - - - - 3 1 |

    /* 第二行（4 小節，P100.jpg） */
    /* テ コ ガ | ネ ノ イ ー ロ ー | ニ ゾ カ ー ハ | リ ユ キ ー */
    | 5_ - - - - - - - 5_ - - 5_ | 1 - - - 1 - - - 3 2 1 3 | 5 - - - 5 - - - (6 5 4)%(----) | 3 - - - 2 - - - - - 3 2 |

    /* 第三行（4 小節，P100.jpg） */
    /* テ イ ー リ | ヒ モ ヤ ー マ | ベ ニ イ ー ソ | ギ ー ユ */
    | 1 - - - - - - - {mf} (5 3 5)%(----) | 1^ - - - 1^ - - - (6 1^ 6)%(----) | 5 - - - 3 - - - (2 1 2)%(----) | 3 - - - 4 - - - 6 - - - |

    /* 第四行（4 小節，P100.jpg） */
    /* ク ナ ー ハ | テ ノ ナ ー ミ | キ ニ カ ー ゼ | サ ム */
    | 5 - - - - - - - (5 3 5)%(----) | 1^ - - - 1^ - - - (6 1^ 6)%(----) | 5 - - - 3 - - - (2 1 2)%(----) | 3 - - - - - - - 2 - - - |

    /* 第五行（4 小節，P100.jpg） */
    /* ク タ ド | ル ヤ マ ー | ゴ ノ ウ ー タ | ゴ エ */
    | 1 - - - - - - - {mp} 1^ - - 5 | 6 - - - 5 - - - 1^ - - 5 | 6 - - - 5 - - - (6 5 4)%(----) | 3 - - - - - - - 2 - - - |

    /* 第六行（5 小節，P100.jpg） */
    /* モ タ ソ | ガ レ ソ ー メ ー | タ ル ユ ー フ | ベ カ | ナ */
    | 5_ - - - - - - - {mf} 5_ - - 5_ | 1 - - - 1 - - - 3 2 1 3 | 5 - - - 5 - - - (6 5 4)%(----) | 3 - - - - - - - 2 - - - | 1 - - - - - - - 0 - - - |
}

