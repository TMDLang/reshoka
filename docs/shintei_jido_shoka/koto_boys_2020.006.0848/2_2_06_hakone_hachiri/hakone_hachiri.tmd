::SCORE::
** 箱根八里 **
!= 108
?= C
<4/4>
~ "詞：土井晩翠"
~ "曲：瀧廉太郎"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P098.jpg – P099.jpg，書頁 pp. 21–22，高二第二學期第 6 首）：
   調性與拍號：ハ長調（C Major，無升降記號）、4/4 拍（爽快ニ ♩=108）
   出處註記：（東京音樂學校編中等唱歌）

   一（昔の箱根）
   箱根の山は天下の嶮　函谷關も物ならず
   萬丈の山　千伋の谷　前に聳え後にさゝふ
   雲は山をめぐり　霧は谷をとざす
   晝猶闇き　杉の並木　羊腸の小徑は　苔滑か
   一夫關に當るや　萬夫も開くなし
   天下に旅する　剛毅の武士
   大刀腰に足駄がけ　八里の岩ね踏み鳴す
   斯くこそありしか往時の武士

   二（今の箱根）
   箱根の山は天下の岨　蜀の棧道數ならず
   萬丈の山　千伋の谷　前に聳え後にさゝふ
   雲は山をめぐり　霧は谷をとざす
   晝猶闇き　杉の並木　羊腸の小徑は　苔滑か
   一夫關にあたるや　萬夫も開くなし
   山野に狩する　剛毅の健兒
   獵銃肩に草鞋がけ　八里の岩ね踏み破る
   斯くこそあるなれ當時の健兒
   ========================================================================= */

Verse:Piano@|0| {
    <16*>
    /* 第一行（4 小節，P098.jpg） */
    /* ハ コ ネ ノ ヤ マ ハ | 天 下 ノ 嶮 | カ ン コ ク 關 モ | モ ノ ナ ラ ズ */
    | {f} 1_ - - 2_ 3_ - - 4_ 5_ - - 6_ 5_ - - - | 1 - - 5_ 6_ - 5_ - 3_ - - - 0 - - - | 2_ - - 2_ 3_ - - 5_ 6_ - - - 5_ - - - | 3_ - - 5_ 2_ - - 3_ 1_ - - - 0 - - - |

    /* 第二行（4 小節，P098.jpg） */
    /* 萬 丈 ノ ヤ マ | 千 伋 ノ タ ニ | マ ヘ ニ ソ ビ エ | シ リ ヘ ニ サ サ フ */
    | {ff} 1 - - - 1 - - - 3 - - 2 1 - 0 - | 6_ - - - 6_ - - - 1 - - 6_ 5_ - 0 - | {f} 6_ - - 6_ 5_ - - 3_ 5_ - - 5_ 6_ - 1 - | 5_ - - 6_ 5_ - - 3_ 2_ - - 1_ 2_ - - - |

    /* 第三行（3 小節，P098.jpg） */
    /* ク モ ハ ヤ マ ヲ メ グ リ | キ リ ハ タ ニ ヲ ト ザ ス | ヒ ル ナ ホ */
    | (1_ 2_ 3_)%(----) (5_ 6_ 5_)%(----) 3_ - - 2_ 1_ - - - | (3_ 5_ 6_)%(----) (1 2 1)%(----) 6_ - - 5_ 6_ - - - | {ff} 1 - - - - - 2 - 3 - - - 1 - - - |

    /* 第四行（4 小節，P098.jpg） */
    /* ク ラ キ | ス ー ギ ノ ナ ミ キ | 羊 腸 ー ノ | 小 徑 ハ */
    | 6_ - - - 5_ - - - 6_ - - - 0 - - - | 3_ - - 5_ 6_ - - 1 5_ - - 6_ 5_ - - - | 3_ - - - 0 - - - {mf} 2 - - 3 2 - - - | 1 - - - 6_ - - - 5_ - - - 0 - - - |

    /* 第五行（4 小節，P098.jpg） */
    /* コ ケ | ナ メ ラ カ | 一 夫 關 ニ | ア タ ル ヤ */
    | 3_ - - - - - - - 5_ - - - - - - - | 3_ - - - 5_ - - 3_ 2_ - - - 0 - - - | 5_ - - - - - 3_ - 2_ - - 1_ 2_ - - - | 5_ - - - - - 6_ - 5_ - - - 3_ - - - |

    /* 第六行（4 小節，P098.jpg） */
    /* 萬 夫 モ | ヒ ラ ク ナ シ | 天 下 ニ タ ビ ス ル | ゴ ウ キ ノ モ ノ ノ フ */
    | 2 - - - - - - - 5_ - - - 5_ - - - | 3_ - - 2_ 1_ - - 2_ 3_ - - - 0 - - - | {f} 1 - - 5_ 3_ - - 5_ 1 - - 5_ 3_ - 5_ - | 6_ - - 6_ 6_ - - 7_ 1 - - 1 1 - - 2 |

    /* 第七行（4 小節，P099.jpg） */
    /* 大 タ ウ コ シ ニ | ア シ ダ ガ ケ | ハ チ リ ノ イ ハ ネ | フ ミ ナ ラ ス */
    | 3 - - - 2 - - 1 2 - - 1 6_ - - - | 1 - - - 6_ - - 5_ 3_ - 2_ - 1_ - - - | {f} 2 - - 2 1 - - 6_ 5_ - - 6_ 1 - - - | 6_ - - - 5_ - - 3_ 2_ - - - 5_ - - - |

    /* 第八行（4 小節，P099.jpg） */
    /* カ ク コ ソ | ア リ シ カ | 往 時 ノ | モ ノ ノ フ */
    | 3 - - - - - - - 2 - - 1 6_ - - - | 1 - - 2 3 - - - 2 - - - - - - - | 1 - - - - - - - 6_ - - - 5_ - - - | 3_ - - 5_ 2_ - 3_ - 1_ - - - 0 - - - |
}

