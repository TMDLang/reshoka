::SCORE::
** 海國男子（鋼琴伴奏版） **
!= 96
?= F
<4/4>
~ "詞：桑田春風"
~ "曲：國風歌（獨）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 5_ - 1 - |

    /* 第一行 */
    | 3 - - - - - 1 - 1 - - - 6_ - - - | 5_ - - - - - - - - - - - 1 - 2 - |
    | 3 - - - 4 - - - 5 - - - 6 - - - | 5 - - - - - - - - - - - 5_ - 1 - |

    /* 第二行 */
    | 3 - - - - - 1 - 1 - - - 6_ - - - | 5_ - - - - - - - - - - - 3 - 1 - |
    | 2 - - - 5_ - - - 3 - - - 2 - - - | 1 - - - - - - - 0 - - - 0 - - - |

    /* 第三行 */
    | {f} 6_ - - - - - 7_ - 1 - - - - - - - | 2 - - - - - - - 3 - - - 3 - 4 - |
    | 5 - - - - - - - 6 - - - - - - - | 7 - - - - - - - - - - - - - - - |

    /* 第四行 */
    | {ff} 1^ - - - - - 5 - 3 - - - - - - - | 6 - - - - - 5 - 4 - - - - - - - |
    | 2 - - - 5 - - - 3 - - - 6 - - - | 5 - - - - - - - 7_ - - - - - - - |
    | 1 - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1_ [1] 1_ [6_m] | 5__ [5_] [5_] 0 |
    | 1_ [4_] 1_ [2_m] | 5__ [5_] [5_] 0 |

    /* 第二行 */
    | 1_ [1] 1_ [6_m] | 5__ [5_] [5_] 0 |
    | 5__ [5_] 1_ [5_] | 1_ [1] 0 0 |

    /* 第三行 */
    | 2_ [2_m] 1_ [1] | 5__ [5_] 1_ [1] |
    | 1_ [1] 4_ [4_] | 5__ [5_] [5_] [5_] |

    /* 第四行 */
    | 1_ [1] 1_ [1] | 4_ [4_] 4_ [4_] |
    | 5__ [1] 6__ [2_m] | 5__ [1] 5__ [5_] |
    | 1_ [1] 0 0 |
}

