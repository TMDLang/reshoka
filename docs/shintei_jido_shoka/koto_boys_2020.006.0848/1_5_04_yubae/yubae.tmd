::SCORE::
** 夕映 **
!= 84
?= G
<3/4>
~ "詞：佐々木信綱"
~ "曲：J. G. Nägeli（ネーゲリ）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P076.jpg，書頁 p. 41，高一重音第 4 首）：
   調性與拍號：ト長調（1 升記號）、3/4 拍（優美ニ ♩=84）
   出處註記：（松邑三松堂發行檢定唱歌集）

   一
   夕日の山、もみぢ葉は、
   紅ひとしほ、匂ふ。

   二
   夕日の海、行く船は、
   白帆も赤くぞ、見ゆる。

   三
   夕映こそ、いろ／＼の、
   中にも優れし、色よ。
   ========================================================================= */

Main:Part1@|0| {
    <16*>
    /* 第一行 */
    | {mp} 3 - - - - - 4 - 3 - 2 - | 1 - - - 5_ - - - 0 - - - |
    | 6_ - - - - - 6_ - 7_ - 1 - | 2 - - - - - - - 0 - - - |

    /* 第二行 */
    | {mf} 3 - - - - - 4 - 3 - 2 - | 5 - - - - - 4 - 3 - 2 - |
    | {mp} 1 - - - 3 - - - 2 - - - | 1 - - - - - - - 0 - - - |
}

Main:Part2@|0| {
    <16*>
    /* 第一行 */
    | {mp} 1 - - - - - 2 - 1 - 7_ - | 1 - - - 5_ - - - 0 - - - |
    | 1_ - - - - - 1_ - 5_ - 5_ - | 5_ - - - - - - - 0 - - - |

    /* 第二行 */
    | {mf} 1 - - - - - 2 - 1 - 7_ - | 7_ - - - - - 2 - 1 - 5_ - |
    | {mp} 3_ - - - 5_ - - - 4_ - - - | 1_ - - - - - - - 0 - - - |
}

