::SCORE::
** 夕映（鋼琴伴奏版） **
!= 84
?= G
<3/4>
~ "詞：佐々木信綱"
~ "曲：J. G. Nägeli（ネーゲリ）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mp} 3 - - - - - 4 - 3 - 2 - | 1 - - - 5_ - - - 0 - - - |
    | 6_ - - - - - 6_ - 7_ - 1 - | 2 - - - - - - - 0 - - - |

    /* 第二行 */
    | {mf} 3 - - - - - 4 - 3 - 2 - | 5 - - - - - 4 - 3 - 2 - |
    | {mp} 1 - - - 3 - - - 2 - - - | 1 - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    | 1_ [1] [5_] | 1_ [1] 0 | 4_ [4_] [1] | 5__ [5_] 0 |
    | 1_ [1] [5_] | 5__ [5_] [5_] | 1_ [1] [5_] | 1_ [1] 0 |
}

