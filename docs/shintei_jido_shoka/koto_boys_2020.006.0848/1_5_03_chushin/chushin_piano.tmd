::SCORE::
** 忠臣（鋼琴伴奏版） **
!= 100
?= D
key= Bm
<3/4>
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mf} 1 - - - - - 0 - 6_ - 7_ - | 3 - - - 3 - - - 0 - - - |
    | 2 - 2 - 3 - - - - - 2 - | 1 - 2 - 3 - - - 0 - - - |

    /* 第二行 */
    | 6 - - - - - 0 - 4 - 2 - | 1 - - - 7_ - - - 0 - - - |
    | {p} 2 - 2 - 6_ - - - 7_ - - - | 6_ - - - - - - - 0 - - - |

    /* 第三行 */
    | {mf} 1 - 1 - 3 - - - - - 4 - | 3 - - - 2 - - - 0 - - - |
    | {mp} 1 - 1 - 2 - - - - - 3 - | 2 - 1 - 7_ - - - 0 - - - |

    /* 第四行 */
    | {mf} 3 - 4 - 5 - - - - - 3 - | 4 - - - 3 - - - 0 - - - |
    | {p} 2 - 2 - 6_ - - - 7_ - - - | 6_ - - - - - - - 0 - - - |

    /* 第五行 */
    | {f} 1 - - - 1 - - - 1 - - - | 2 - - - 2 - - - 0 - - - |
    | 1 - - - 3 - - - - - 4 - | 3 - 2 - 3 - - - 0 - - - |

    /* 第六行 */
    | {p} 2 - - - 2 - - - 2 - - - | 3 - - - 3 - - - 0 - - - |
    | {mp} 2 - 2 - 6 - - - 3 - - - | 6_ - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    | 6__ [6_m] [6_m] | 6__ [6_m] 0 | 3__ [3_] [3_] | 6__ [6_m] 0 |
    | 6__ [6_m] [2_m] | 3__ [3_] 0 | 2__ [6_m] [3_] | 6__ [6_m] 0 |
    | 6__ [6_m] [6_m] | 3__ [3_] 0 | 6__ [5_] [5_] | 4__ [3_] 0 |
    | 1_ [5_] [1] | 4__ [1] 0 | 2__ [6_m] [3_] | 6__ [6_m] 0 |
    | 4__ [4_] [4_] | 5__ [5_] 0 | 6__ [6_m] [6_m] | 3__ [6_m] 0 |
    | 3__ [3_] [3_] | 6__ [6_m] 0 | 2__ [6_m] [3_] | 6__ [6_m] 0 |
}

