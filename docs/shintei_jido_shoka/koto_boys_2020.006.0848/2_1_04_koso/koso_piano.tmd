::SCORE::
** 皇祖（鋼琴伴奏版） **
!= 104
?= F
<4/4>
~ "詞：大和田建樹"
~ "曲：シユトウンツ（J. H. Stuntz，獨國）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {f} 5_ - 5_ - |

    /* 第一行 */
    | 5_ - - - 1 - - - 3 - - - 5 - - 3 | 1 - - - - - - - 1 - - - 7_ - 1 - |
    | 2 - - - - - 7_ - 1 - - - 3 - - - | 2 - - - - - - - 0 - - - 5_ - 5_ - |

    /* 第二行 */
    | 5_ - - - 1 - - - 3 - - - 5 - - - | 6 - - - - - - - - - - - 5 - 5 - |
    | 6 - - - - - 6 - 4' - - - 5 - - - | 5 - - - - - - - 0 - - - 5 - - 5 |

    /* 第三行 */
    | 3 - - - 1 - - - 4 - - - 2 - - - | 7_ - - - 1 - - - 2 - - - 3 - 2 - |
    | 1 - - 1 7_ - 6_ - 2 - - - - - 7_ - | 5_ - - - - - - - 0 - - - {mf} 5 - - 3 |

    /* 第四行 */
    | 1 - - - 2 - - - 3 - - - 4 - - 2 | 3 - - - - - - - 2 - - - 5 - - 3 |
    | 1 - - - 2 - - - 3 - - - 4 - - 2 | 3 - - - - - - - 0 - - - 1 - 1 - |

    /* 第五行 */
    | 7_ - - - - - 7_ - 7_ - - - 1' - - - | 2 - - - - - 1' - 2 - - - - - - - |
    | 6_ - 7_ - 1 - 2 - 3 - - - 4' - - - | 5 - - - - - - - 0 - - - 0 - - - |

    /* 第六行 */
    | {f} 4 - - 3 2 - - - 5 - - 4 3 - - - | 6 - - - - - 6 - 4 - - - - - - - |
    | 2 - - - - - - - 5_ - - - 5_ - - - | {mf} 1 - 2 - 3 - 4 - 3 - - - 2 - - - |
    | 1 - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1_ [1] 1_ [1] | 4_ [1] 1_ [1] |
    | 5__ [5_] 1_ [1] | 5__ [5_] 0 0 |

    /* 第二行 */
    | 1_ [1] 1_ [1] | 2_ [2_m] [2_m] [1] |
    | 2_ [2_m] 5__ [1] | 1_ [1] 0 0 |

    /* 第三行 */
    | 1_ [1] 2_ [5_] | 1_ [1] 5__ [5_] |
    | 4_ [4_] 5__ [5_] | 1_ [1] 0 0 |

    /* 第四行 */
    | 1_ [5_] 1_ [5_] | 1_ [1] 5__ 0 |
    | 1_ [5_] 1_ [5_] | 1_ [1] 0 0 |

    /* 第五行 */
    | 3_ [3_] 3_ [2_] | 5__ [5_] 5__ [5_] |
    | 2_ [2_m] 5__ [5_] | 1_ [1] 0 0 |

    /* 第六行 */
    | 2_ [5_] 1_ [1] | 2_ [2_m] 4_ [4_] |
    | 5__ [5_] 5__ [5_] | 1_ [4_] 5__ [5_] |
    | 1_ [1] 0 0 |
}

-> Main -> #

