::SCORE::
** 同窓會（鋼琴伴奏版） **
!= 104
?= F
<4/4>
~ "詞：旗野士良"
~ "曲：モツアルト（獨）（Wolfgang Amadeus Mozart）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Verse:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - {mf} 5_ - 5_ - 5_ - |

    /* 第一行 */
    | 1 - - - 1 - - - 2 - 3 - 4 - 2 - | 3 - - - - - - - 0 - 3 - 4 - 5 - | 6 - - - 1^ - - - 5 - 3 - 4 - 2 - |

    /* 第二行 */
    | 3 - 1 - 5_ - - - 0 - 5_ - 6_ - 7__ - | 1 - - - - - 2 - 3 - 4 - 5 - 6 - | 5 - - - 2 - - - 0 - 2 - 3 - 4 - |

    /* 第三行 */
    | 3 - - - 1 - - - 4 - 3 - 2 - 1 - | 2 - - - 1 - - - 0 - {p} 3 - 3 - 3 - | 5 - - - 4 - - - 2 - 3 - 4 - 2 - |

    /* 第四行 */
    | 1 - - - - - - - 0 - 2 - 2 - 2 - | 4 - - - 3 - - - 1 - 2 - 3 - 1 - | 3 - 2 - 2 - - - 0 - {f} 5 - 5 - 5 - |

    /* 第五行（含復唱反覆） */
    | 6_ - 7__ - 1 - 2 - 3 - 4 - 5 - 6 - | 5 - - 4 3 - - - 0 - 6 - 6 - 6 - | 5 - - - 1 - - - 4 - 3 - 2 - 3 - | 1 - - - - - - - 0 - {f} 5 - 5 - 5 - |
    | 6_ - 7__ - 1 - 2 - 3 - 4 - 5 - 6 - | 5 - - 4 3 - - - 0 - 6 - 6 - 6 - | 5 - - - 1 - - - 4 - 3 - 2 - 3 - | 1 - - - - - - - 0 - - - 0 - - - |
}

Verse:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | {mf} 1_ [1] 5__ [5_] | 1_ [1] 1_ 0 | 4_ [4_] 1_ [5_] |

    /* 第二行 */
    | 1_ [1] 5__ 0 | 1_ [1] 4_ [4_] | 5__ [1] 5__ 0 |

    /* 第三行 */
    | 1_ [1] 4_ [4_] | 5__ [5_] 1_ 0 | {p} 5__ [5_] 5__ [5_] |

    /* 第四行 */
    | 1_ [1] 1_ 0 | 5__ [5_] 1_ [1] | 5__ [5_] 5__ 0 |

    /* 第五行（含復唱反覆） */
    | {f} 4_ [4_] 1_ [1] | 5__ [5_] 1_ 0 | 1_ [1] 5__ [5_] | 1_ [1] 1_ 0 |
    | 4_ [4_] 1_ [1] | 5__ [5_] 1_ 0 | 1_ [1] 5__ [5_] | 1_ - [1] 0 |
}

