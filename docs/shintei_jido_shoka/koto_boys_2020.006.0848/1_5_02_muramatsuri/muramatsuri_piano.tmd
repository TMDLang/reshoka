::SCORE::
** 村祭（鋼琴伴奏版） **
!= 112
?= G
<4/4>
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 - {mf} 5_ - |

    /* 第一行 */
    | 1 - - 2 1 - 2 - | 3 - 4 3 2 - 5_ - | 3 - 3 - 4 - 5 - | 6 - - - 5 - 5 - |

    /* 第二行 */
    | 6 - - 7 1^ - 5 - | 4 - 3 2 1 - 2 - | 3 - 2 - 3 - 5 - | 4 - 2 - 1 - 0 - |
}

Main:PianoLH@|0| {
    <4*>
    | 0 0 0 0 |
    | 1_ - [1] - | 1_ - [5_] - | 1_ - [4] [5_] | 4_ - [1] [5_] |
    | 4_ - [1] - | 4_ - [1] [2_m] | 1_ [5_] [1] [5_] | 4_ [5_] [1] 0 |
}

-> Main -> #

