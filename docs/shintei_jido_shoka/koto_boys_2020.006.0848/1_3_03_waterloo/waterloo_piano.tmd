::SCORE::
** ヲーターロー（鋼琴伴奏版） **
!= 100
?= G
key= Em
<2/4>
~ "詞：土井林吉"
~ "曲：山田源一郎"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 (5 小節) */
    | {f} 6_ - 6_ - 6_ - 6_ - | 1 - - - - - 7_ - | 1 - 7_ - 1 - 2 - | 3 - - - - - 3 - | 3 - - - 3 - - - |

    /* 第二行 (5 小節) */
    | 6 - 5 - 4 - 3 - | 7_ - 6_ - 2'_ - 6_ - | 7_ - 7_ - 3_ - - - | {mp} 6_ - - - 5_ - - - | 4_ - - - 3_ - - - |

    /* 第三行 (5 小節) */
    | 2_ - 2_ - 3_ - 4_ - | 3_ - - 2_ 3_ - - - | {f} 6_ - - - 2 - - - | 4 - - 3 2 - - - | 1 - - - 2 - - 1 |

    /* 第四行 (5 小節) */
    | 7_ - 6_ - 3_ - 0 - | {mf} 3_ - - - 6_ - - - | 1 - - 7_ 6_ - - - | {f} 3 - - - 7_ - - 1 | {p} 2 - - 7_ 6_ - - - |
}

Main:PianoLH@|0| {
    <4*>
    | 6__ [6_m] | 6__ [6_m] | 6__ [6_m] | 3_ [6_m] | 3_ [3_] |
    | 2_ [2_m] | 6__ [6_m] | 3_ [3_] | 6__ [6_m] | 4__ [3_] |
    | 2__ [2_m] | 3__ [3_] | 6__ [2_m] | 2_ [2_m] | 1_ [1] |
    | 3_ [3_] | 6__ [6_m] | 6__ [6_m] | 3_ [3_] | 3_ [6_m] |
}

-> Main -> #

