::SCORE::
** 行軍（鋼琴伴奏版） **
!= 104
?= G
<4/4>
~ "詞：桑田春風"
~ "曲：シューマン（獨）（Schumann）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mf} 3 - - - 3 - 3 - 2 - - - 2 - - - | 1 - - - 2 - 3 - 4 - 2 - 3 - 1 - | 7_ - 1 - 2 - 7_ - 1 - - - 3 - - - |

    /* 第二行 */
    | 5 - - - 2 - - - - - 3 - 1 - 5_ - | 6_ - - - - - 1 - 7_ - 5_ - 1 - - - | 2 - - - - - 4 - 3 - 1 - 2 - 3 - |

    /* 第三行 */
    | 4 - - - - - 2 - 5 - 4 - 3 - - - | 2 - - - 3 - - - 4 - - 2 7_ - 5_ - | 6_ - - - - - 1 - 7_ - - - 2 - - - |

    /* 第四行 */
    | 5 - 4 - 3 - - - 2 - - - 5 - - - | 1 - - - - - 3 - 2 - 4 - 3 - - - | 5 - - - 4 - 3 - 2 - - - 1 - - - | 6_ - - - - - 7_ - 1 - - 2 3 - - - |

    /* 第五行 */
    | 2 - - - 5 - - - 3 - 1 - 5_ - - 5_ | 1 - - - - - 2 - 3 - 4 - - - 3 - | 2 - - - 5_ - - 5_ 1 - - - - - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 1_ [1] 2_ [5_] | 3_ [1] 4_ [1] | 2_ [5_] 1_ [1] |
    /* 第二行 */
    | 5__ [5_] 1_ [1] | 4_ [4_] 2_ [1] | 2_ [5_] 1_ [1] |
    /* 第三行 */
    | 2_ [5_] 5__ [5_] | 2_ [5_] 2_ [5_] | 6__ [6_m] 2_ [5_] |
    /* 第四行 */
    | 1_ [1] 2_ [5_] | 3_ [1] 5__ [5_] | 1_ [1] 2_ [1] | 4_ [4_] 3_ [1] |
    /* 第五行 */
    | 2_ [5_] 1_ [1] | 3_ [1] 4_ [4_] | 2_ [5_] 1_ [1] |
}

