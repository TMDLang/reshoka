::SCORE::
** 如意輪堂（鋼琴伴奏版） **
!= 84
?= C
key= Am
<3/4>
~ "詞：松谷代水（杉谷代水）"
~ "曲：田村虎藏"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <8*>
    /* 第一行 */
    | {p} 3_ - 6_ - - 6_ | 7_ - - 6_ 7_ - | {mp} 1 - - - 7_ 6_ | 1 - - 7_ 6_ - |

    /* 第二行 */
    | 3 - - - 3 2 | 1 - 7_ 6_ 5'_ - | 6_ - 7_ - 1 6_ | 7_ - - 3_ 3_ - |

    /* 第三行 */
    | {mf} 1 - - 7_ 6_ 6_ | 2 - - 1 7_ 6_ | 5'_ - 6_ - 7_ 1 | {f} 2 - - 4 3 - |

    /* 第四行 */
    | {mp} 3_ - 6_ 6_ 7_ - | 1 - - 7_ 6_ 5'_ | 6_ 7_ 1 - 2 - | {mf} 3 - - - 7_ - | 6_ - - - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 6__ [6_m] [6_m] | 3_ [3_] [3_] | 6__ [6_m] [6_m] | 6__ [6_m] [6_m] |
    /* 第二行 */
    | 6__ [6_m] [6_m] | 3_ [3_] [3_] | 6__ [6_m] [4_] | 3_ [3_] [3_] |
    /* 第三行 */
    | 6__ [6_m] [6_m] | 2_ [2_m] [2_m] | 3_ [3_] [6_m] | 2_ [2_m] 3_ |
    /* 第四行 */
    | 6__ [6_m] [6_m] | 6__ [6_m] 3_ | 4_ [4_] 2_ | 3_ [6_m] [3_] | 6__ [6_m] 0 |
}

