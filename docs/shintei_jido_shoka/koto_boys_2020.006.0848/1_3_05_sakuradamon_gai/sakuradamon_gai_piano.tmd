::SCORE::
** 櫻田門外（鋼琴伴奏版） **
!= 92
?= F
key= Dm
<4/4>
~ "詞：大和田建樹"
~ "曲：佛國風曲"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - 0 - 0 - 0 - {f} 6_ - 6_ - |

    /* 第一行 */
    | 3 - - - 3 - 4 - 3 - - - 2 - 1 - | 7_ - - - 0 - 7_ - 1 - 2 - 3 - - 2 |
    | 1 - - - 7_ - 6_ - 3 - - - - - 3 - | 6_ - - - - - - - 0 - - - 6_ - 6_ - |

    /* 第二行 */
    | 2 - - - 2 - 3 - 2 - - - 1 - 7_ - | 1 - - - 0 - 1 - 2 - 3 - 4 - - 3 |
    | 2 - - - 1 - 7_ - 5 - - - - - 5 - | 3 - - - - - - - 0 - - - {mf} 3 - - 3 |

    /* 第三行 */
    | 6 - - - 5 - 4 - 3 - - - 2 - 1 - | 2 - - - 0 - 2 - 3 - 4 - 5 - - 4 |
    | 3 - - - 2 - 1 - 7_ - 6_ - 5'_ - - 6_ | 7_ - - - - - - - 0 - - - 3 - - 3 |

    /* 第四行 */
    | 1 - - - 2 - 3 - 4 - - - 2 - 7_ - | 3 - - - 0 - 3 - 6 - - - - - 5 - |
    | {f} 4 - - - 3 - 2 - 3 - - - - - 3 - | 6_ - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    | 0 0 0 0 |
    | 6__ - [6_m] - | 3__ - [3_] - | 6__ - [3_] - | 6__ [6_m] 0 0 |
    | 2_ - [2_m] - | 6__ - [6_m] - | 2_ - [3_] - | 6__ [6_m] 0 0 |
    | 6__ - [6_m] - | 5__ - [1] - | 6__ - [3_] - | 3__ [3_] 0 0 |
    | 6__ - [2_m] - | 3__ - [6_m] - | 2_ - [3_] - | 6__ [6_m] 0 0 |
}

-> Main -> #

