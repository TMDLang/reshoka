::SCORE::
** 足柄山（鋼琴伴奏版） **
!= 104
?= G
<4/4>
~ "詞：國定高等小學讀本"
~ "曲：西洋曲"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 5_ - - 1 |

    /* 第一行 */
    | 3 - - - 3 - - - - - - - 1 - - 2 | 3 - - - 1 - - - - - - - 3 - - 1 |
    | 6_ - - - - - 5_ - 6_ - - - 2 - - 5 | 2 - - - - - - - - - - - 2 - - 3 |

    /* 第二行 */
    | 5 - - - 5 - - - - - 3 - 2 - - 1 | 2 - - - - - - - - - - - 3 - - 1 |
    | 6_ - - - - - 5_ - 6_ - - - 1 - - 3 | 1 - - - - - - - - - - - 5_ - - 1 |

    /* 第三行 */
    | 3 - - - 3 - - - - - 1 - 3 - - 1 | 2 - - - - - - - - - - - 7_ - - 1 |
    | 2 - - - - - 7_ - 5_ - - - 6_ - - 7_ | 1 - - - - - - - - - - - 2 - - 3 |

    /* 第四行 */
    | 5 - - - 5 - - - - - 3 - 1 - - 6_ | 1 - - - - - - - - - - - 3 - - 5 |
    | 6 - - - - - 5 - 3 - - - 6_ - - 7_ | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1_ [1] 1_ [1] | 1_ [1] 1_ [1] |
    | 4_ [4_] 4_ [2_m] | 5__ [5_] 5__ 0 |

    /* 第二行 */
    | 1_ [1] 1_ [1] | 5__ [5_] 1_ [1] |
    | 4_ [4_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第三行 */
    | 1_ [1] 1_ [1] | 5__ [5_] 5__ [5_] |
    | 5__ [5_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第四行 */
    | 1_ [1] 1_ [1] | 1_ [1] 1_ [1] |
    | 4_ [4_] 5__ [5_] | 1_ [1] 1_ 0 |
}

-> Main -> Main -> #

