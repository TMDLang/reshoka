::SCORE::
** 軍艦マーチ **
!= 116
?= G
<2/4>
~ "詞：鳥山啓"
~ "曲：瀨戶口藤吉"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P068.jpg – P069.jpg，書頁 pp. 33–34，高一第三學期第 7 首）：
   調性與拍號：ト長調（1 升記號）、2/4 拍（元氣ヨク ♩=116）

   一
   守るも攻むるも鋼鐵の
   浮べる城ぞ頼みなる
   浮べるその城日の本の
   皇國の四方を守るべし
   まかねの其艦日の本に
   仇なす國を攻めよかし

   二
   石炭の烟は渡津海の
   龍かとばかり靡くなり
   彈丸打つひびきは雷の
   聲かとばかりどよむなり
   萬里の波濤を乗り越えて
   御國の光　輝かせ
   ========================================================================= */

Verse:Piano@|0| {
    <16*>
    /* 第一行 (5 小節) */
    | {f} 5_ - 5_ 5_ 1 - 2 - | 3 - 1 1 5 - 3 - | 2 - 3 2 1 - 6_ - | 5_ - - - 0 - - - | 5_ - 1 2 3 - 5 - |

    /* 第二行 (5 小節) */
    | 6 - 5 - 3 - 1 - | 2 - 5_ - 2 - 3 - | 1 - - - 0 - - - | 5_ - 1 2 3 - 5 - | 6 - 5 - 3 - 1 - |

    /* 第三行 (5 小節) */
    | 2 - - 3 2 - 6_ - | 2 - - - 0 - - - | 7 - - 6 7 - 5 - | 6 - - 5 3 - 1 - | 2 - - 3 4 - 2 - |

    /* 第四行 (5 小節) */
    | 3 - 0 5_ 5_ - 5_ - | 3 - - - - - - - | 3 - 6_ - 7_ - 1 - | 2 - - - - - - - | 2 - 5_ - 6_ - 7_ - |

    /* 第五行 (5 小節) */
    | 1 - - - - - 2 - | 3 - - - - - - - | 3 - 0 3 3 - 4' - | 5 - - - 6 - - 5 | 4 - - - 3 - - - |

    /* 第六行 (5 小節) */
    | 3 - 0 5_ 2 - - 1 | 6_ - - - - - - - | 5 - - - - - 7_ - | 1 - - - - - - - | 1 - 0 - 0 - - - |
}

