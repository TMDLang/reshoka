::SCORE::
** 夏げしき（鋼琴伴奏版） **
!= 92
?= D
<4/4>
~ "出處：金港堂發行《大正女學唱歌》"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | 3 - - - 3 - - 2 1 - - - 3 - - - |
    | 5 - - - - - - - 3 - - - - - - - |
    | 2 - - - 2 - - 3 5 - - - 3 - - - |
    | 2 - - - - - - - - - - - 0 - - - |

    /* 第二行 */
    | 3 - - - 3 - - 2 1 - - - 3 - - - |
    | 5 - - - - - - - 6 - - - - - - - |
    | 5 - - - 6 - - 1^ 5 - - - 3 - - - |
    | 5 - - - - - - - - - - - 0 - - - |

    /* 第三行 */
    | 1^ - - - 1^ - - 6 5 - - - 6 - - - |
    | 5 - - - - - - - 3 - - - 0 - - - |
    | 2 - - - 2 - - 3 5 - - - 6 - - - |
    | 5 - - - - - - - - - - - 0 - - - |

    /* 第四行 */
    | 3 - - - 5 - - 5 6 - - - 1^ - - 6 |
    | 5 - - - 3 - - - 1 - - - - - - - |
    | 2 - - - 2 - - 5 3 - - - 2 - - - |
    | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 1_ [1] 1_ [1] | 1_ [1] 1_ [1] | 5__ [5_] 5__ [5_] | 5__ [5_] 5__ 0 |

    /* 第二行 */
    | 1_ [1] 1_ [1] | 1_ [1] 6__ [6_m] | 1_ [1] 1_ [1] | 5__ [5_] 5__ 0 |

    /* 第三行 */
    | 4_ [4_] 1_ [1] | 1_ [1] 1_ 0 | 2_ [2_m] 6__ [6_m] | 5__ [5_] 5__ 0 |

    /* 第四行 */
    | 1_ [1] 6__ [6_m] | 1_ [1] 1_ [1] | 5__ [5_] 5__ [5_] | 1_ [1] 1_ 0 |
}

