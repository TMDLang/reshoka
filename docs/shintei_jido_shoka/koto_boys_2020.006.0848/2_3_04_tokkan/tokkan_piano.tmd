::SCORE::
** 突貫（鋼琴伴奏版） **
!= 116
?= G
<4/4>
~ "詞：大和田建樹"
~ "曲：リール（佛）（Lisle，佛國國歌）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - {f} 5_ - 5_ - - 5_ |

    /* 第一行 */
    | 1 - - - 1 - - - 2 - - - 2 - - - | 5 - - - - - 3 - 1 - - 1 3 - - 1 | 6_ - - - 4 - - - - - - - 2 - - 7_ | 1 - - - - - - - 0 - - - {mf} 1 - - 2 |

    /* 第二行 */
    | 3 - - - - - 3 - 3 - - - 4 - - 3 | 3 - - - 2 - - - 0 - - - 2 - - 3 | 4 - - - - - 4 - 4 - - - 5 - - 4 | 3 - - - - - - - 0 - - - {f} 5 - - 5 |

    /* 第三行 */
    | 5 - - - 3 - - 1 5 - - - 3 - - 1 | 5_ - - - - - - - {mf} 0 5_ 5_ 5_ 1 - - - | 3 - - - 5 - - 3 1 - 2 - 3 - 1 - | 2 - - - - - 2 - 4 - - - 3 - - 2 |

    /* 第四行 */
    | 1 - - - - - - - 0 - - - {p} 0 - 1 - | 3, - - - - - 3, - 3, - 3, - 4 - 5 - | 2 - - - - - - - - - - - 3, - - 2 | 1 - - - - - 3, - 2 - - 1 3, - - 2 | 1 - - - 7_ - - - 0 - - - 0 - {f} 5 - |

    /* 第五行 */
    | 5 - - - - - - - - - 3 - 1 - - 2 | 3 - - - - - - - 0 - - - 0 - 5 - | 5 - - - - - - - - - 3 - 1 - - 2 | 2 - - - - - - - 0 - - - 5_ - - - | 1 - - - - - - - 0 - - - 2 - - - |

    /* 第六行 */
    | 3 - - - - - - - - - - - 0 - - - | 4 - - - - - - - 5 - - - 6 - - - | 2 - - - - - - - - - - - {ff} 7 - - - | 1^ - - - - - - - - - 6 - 4 - - 2 | 1 - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |
    /* 第一行 */
    | 1_ [1] 2_ [5_] | 3_ [1] 1_ [1] | 6__ [6_m] 2_ [5_] | 1_ [1] 1_ 0 |
    /* 第二行 */
    | 1_ [1] 1_ [1] | 5__ [5_] 5__ 0 | 2_ [5_] 2_ [5_] | 1_ [1] 1_ 0 |
    /* 第三行 */
    | 1_ [1] 3_ [1] | 5__ [5_] 1_ 0 | 1_ [1] 3_ [1] | 2_ [5_] 2_ [5_] |
    /* 第四行 */
    | 1_ [1] 0 0 | 1_ [1_m] 1_ [1_m] | 2_ [5_] 2_ [5_] | 1_ [1_m] 2_ [5_] | 5__ [5_] 0 0 |
    /* 第五行 */
    | 1_ [1] 3_ [1] | 1_ [1] 0 0 | 1_ [1] 3_ [1] | 5__ [5_] 0 5__ | 1_ [1] 0 2_ |
    /* 第六行 */
    | 3_ [1] 1_ 0 | 4_ [4_] 3_ [1] | 2_ [5_] 5__ [5_] | 1_ [1] 4_ [2_m] | 1_ [1] 0 0 |
}

-> Main -> #

