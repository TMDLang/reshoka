::SCORE::
** 俊寛僧都（鋼琴伴奏版） **
!= 132
?= G
key= Em
<2/4>
~ "詞：大和田建樹"
~ "曲：民歌（瑞典）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {f} 6_ - 6_ - 6_ - 3 - | 1 - - 7_ 6_ - - - | 2 - 2 - 2 - 4 - | 3 - - 2 3 - - - |

    /* 第二行 */
    | {mf} 4 - 2 - 3 - - 1 | 7_ - 5'_ - 6_ - - 7_ | 1 - 3 - 2 - - 1 | 7_ - 5'_ - 6_ - - - |

    /* 第三行 */
    | {f} 3 - - 4 5 - 3 - | 6 - - 5 4 - - - | 2 - - 3 4 - 2 - | 3 - - 2 3 - - - |

    /* 第四行 */
    | {mf} 4 - 2 - 3 - - 1 | 7_ - 5'_ - 6_ - - 7_ | {mp} 1 - 3 - 2 - - 1 | 7_ - 5'_ - 6_ - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 6__ [6_m] | 6__ [6_m] | 2_ [2_m] | 3_ [3_] |

    /* 第二行 */
    | 2_ [6_m] | 3_ [6_m] | 1_ [2_m] | 3_ [6_m] |

    /* 第三行 */
    | 3_ [3_m] | 6__ [2_m] | 2_ [2_m] | 3_ [3_] |

    /* 第四行 */
    | 2_ [6_m] | 3_ [6_m] | 1_ [2_m] | 3_ [6_m] |
}

-> Main -> #

