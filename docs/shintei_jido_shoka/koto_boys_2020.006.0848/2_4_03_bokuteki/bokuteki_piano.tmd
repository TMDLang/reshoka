::SCORE::
** 牧笛（鋼琴伴奏版） **
!= 92
?= G
<3/4>
~ "詞：杉谷代水"
~ "曲：グロース（獨）（Groos）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 {mf} 5_ |

    /* 第一行 */
    | 1 - 3 | 5 - 3 | 5 - 3 | 2 - 5_ |

    /* 第二行 */
    | 1 - 3 | 4 3 2 | 5 4 3 | 2 - 5_ |

    /* 第三行 */
    | 3 2 1 | 5 - 3 | 2 1 7_ | 1 - 5_ |

    /* 第四行 */
    | 3 2 1 | 5 - 3 | 2 1 7_ | 5 - {f} 5_ |

    /* 第五行 */
    | 1 - 3 | 4 3 2 | 2 - - | 1 - 0 |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 {mf} 5_ |

    /* 第一行 */
    | 1 - 1 | 3 - 1 | 2 - 1 | 5_ - 5_ |

    /* 第二行 */
    | 1 - 1 | 2 1 7_ | 3 2 1 | 5_ - 5_ |

    /* 第三行 */
    | 1 7_ 6_ | 1 - 1 | 7_ 6_ 2_ | 1 - 5_ |

    /* 第四行 */
    | 1 7_ 6_ | 1 - 1 | 7_ 6_ 2_ | 5_ - {f} 5_ |

    /* 第五行 */
    | 1 - 1 | 2 1 7_ | 5_ - - | 3__ - 0 |
}

-> Main -> #

