::SCORE::
** 故郷（鋼琴伴奏版） **
!= 92
?= G
<4/4>
~ "詞：鳥居忱"
~ "曲：G. Hanitsch（ハニツチユ）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {mf} 5_ - - - 1 - 3 - |

    /* 第一行（第一遍） */
    | 1 - - - 3 - - - 5 - - 6 5 - 4 - |
    | 3 - 2 - 1 - 0 - 3 - 2 - 1 - - - |
    | 5_ - - - - - 6_ - 7_ - - - 2 - - - |
    | 1 - - - - - 0 - 5_ - - - 1 - 3 - |

    /* 第一行（反覆第二遍） */
    | 1 - - - 3 - - - 5 - - 6 5 - 4 - |
    | 3 - 2 - 1 - 0 - 3 - 2 - 1 - - - |
    | 5_ - - - - - 6_ - 7_ - - - 2 - - - |
    | 1 - - - - - 0 - 7_ - - - 1 - 2 - |

    /* 第二行 */
    | 3 - - - 1 - - - 3 - - 5 4 - 3 - |
    | 2 - 1 - 7_ - 0 - 5_ - 6_ - 7_ - - - |
    | 1 - - - - - 2 - 3 - - - 4' - - - |
    | 5 - - - - - 0 - 5_ - - - 1 - 3 - |

    /* 第三行 */
    | 1 - - - 3 - - - 5 - - 6 5 - 4 - |
    | 3 - 2 - 1 - 0 - {f} 4 - 3 - 2 - - - |
    | 5 - - - - - 3 - 1 - - - 3 - 2 - |
    | 1 - - - - - 0 - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行（第一遍） */
    | 1_ [1] 1_ [1] | 5__ [1] 1_ [1] | 5__ [5_] 5__ [5_] | 1_ [1] 0 0 |

    /* 第一行（反覆第二遍） */
    | 1_ [1] 1_ [1] | 5__ [1] 1_ [1] | 5__ [5_] 5__ [5_] | 1_ [1] 0 0 |

    /* 第二行 */
    | 1_ [1] 1_ [1] | 5__ [5_] 5__ [5_] | 1_ [1] 6__ [6_] | 2_ [2_] 0 0 |

    /* 第三行 */
    | 1_ [1] 1_ [1] | 5__ [1] 4_ [5_] | 1_ [1] 5__ [5_] | 1_ [1] 0 0 |
}

-> Main -> #

