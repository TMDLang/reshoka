::SCORE::
** 誠實（鋼琴伴奏版） **
!= 112
?= F
<4/4>
~ "詞：犬童球溪"
~ "曲：Lowell Mason（メーソン）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | 1 - - - 1 - - 2 3 - - - 1 - - - |
    | 5 - - - - - - - 3 - - - - - - - |
    | 2 - - - 2 - 2 - 2 - - - 3 - - - |
    | 2 - - - - - - - - - - - 0 - - - |

    /* 第二行 */
    | 1 - - - 1 - - 2 3 - - - 1 - - - |
    | 5 - - - - - - - 3 - - - - - - - |
    | 3 - - - 3 - - - 2 - - - 2 - - - |
    | 1 - - - - - - - - - - - 0 - - - |

    /* 第三行 */
    | 2 - - - 2 - - 3 4 - - - 2 - - - |
    | 3 - - - - - - - 3 - - - 5 - - - |
    | 6 - - - 6 - 5 - 4' - - - 4' - - - |
    | 5 - - - - - - - - - - - 0 - - - |

    /* 第四行 */
    | 1 - - - 1 - - 2 3 - - - 1 - - - |
    | 5 - - - - - - - 3 - - - - - - - |
    | 3 - - - 3 - - - 2 - - - 2 - - - |
    | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 1_ [1] 1_ [1] | 1_ [1] 6__ [6_m] | 5__ [5_] 5__ [1] | 5__ [5_] 5__ 0 |

    /* 第二行 */
    | 1_ [1] 1_ [1] | 1_ [1] 4_ [4_] | 1_ [1] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第三行 */
    | 5__ [5_] 5__ [5_] | 1_ [1] 1_ [1] | 2_ [2_m] 5__ [2_] | 1_ [5_] 5__ 0 |

    /* 第四行 */
    | 1_ [1] 1_ [1] | 1_ [1] 4_ [4_] | 1_ [1] 5__ [5_] | 1_ [1] 1_ 0 |
}

