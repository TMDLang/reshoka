::SCORE::
** 心の力（鋼琴伴奏版） **
!= 104
?= G
<4/4>
~ "編：北村季晴"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | {mf} 1 - - 6_ 5_ - - - - - - - 1 - - - | 1 - - - 3 - - - 2 - - - 1 - - - | 6 - - - 5 - - - 3 - - - 1 - - - | 2 - - - 2 - - - 3 - - - 2 - - - |

    /* 第二行 */
    | 1 - - 6_ 5_ - - - - - - - 1 - - - | 1 - - - 3 - - - 2 - - - 1 - - - | 6 - - 5 3 - - - - - - - 2 - - - | 1 - - - - - - - - - - - 0 - - - |

    /* 第三行 */
    | 3 - - 1 6_ - - - - - - - 2 - - - | 3 - - - 6 - - - 0 - - - - - - - | 7 - - 5 3 - - - - - - - 5 - - - | 6 - - - 7 - - - 0 - - - 5 - - 6 |

    /* 第四行 */
    | 7 - - 5 3 - - - - - - - 5 - - - | 6 - - 5 3 - - - - - - - 3 - - 4' | 5 - - 6 7 - - 5 3 - - 4' 5 - - 6 | 5 - - - 5 - - - 0 - - - - - - - |

    /* 第五行 */
    | {f} 5 - - - 3 - - - 4 - - - 5 - - - | 3 - - - 1 - - - 2 - - - 3 - - - | 4 - - - 2 - - 3 4 - - - 5 - - - | 6 - - - 5 - - - 4 - - - 3 - - - |

    /* 第六行 */
    | 1 - - 6_ 5_ - - - - - - - 1 - - - | 1 - - - 3 - - - 2 - - - 1 - - - | 6 - - - - - - - 3 - - 5 2 - - - | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 1_ [1] 5__ [1] | 1_ [1] 2_ [1] | 4_ [4_] 1_ [1] | 2_ [5_] 5__ [5_] |
    /* 第二行 */
    | 1_ [1] 5__ [1] | 1_ [1] 2_ [1] | 4_ [4_] 2_ [5_] | 1_ [1] 1_ 0 |
    /* 第三行 */
    | 6__ [6_m] 6__ [6_m] | 3_ [6_m] 0 0 | 3_ [3_m] 3_ [3_m] | 2_ [5_] 0 0 |
    /* 第四行 */
    | 3_ [3_m] 3_ [3_m] | 6__ [6_m] 6__ [6_m] | 2_ [2_] 2_ [2_] | 5__ [5_] 0 0 |
    /* 第五行 */
    | 1_ [1] 2_ [5_] | 1_ [1] 5__ [1] | 2_ [5_] 2_ [5_] | 4_ [4_] 5__ [1] |
    /* 第六行 */
    | 1_ [1] 5__ [1] | 1_ [1] 2_ [1] | 4_ [4_] 2_ [5_] | 1_ [1] 0 0 |
}

