::SCORE::
** 麗はしき我國（鋼琴伴奏版） **
!= 108
?= A
<4/4>
~ "曲：獨國風曲"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - {mf} 5_ - 6_ - 7_ - |

    /* 第一行 */
    | 1 - - - - - 3 - 2 - - 1 7_ - - 1 | 6_ - - - - - - - 0 - - - 6_ - - - | 2 - - 3 4 - - 4' 5 - - 3 1 - - 6 | 5_ - - - - - - - 0 - 5_ - 6_ - - 7_ |

    /* 第二行 */
    | 1 - - - - - 3 - 2 - - 1 7_ - - 1 | 6_ - - - - - - - 0 - 6_ - 6_ - - 6_ | 2 - - - - - - - 5 - - - - - - - | 3 - - - - - - - 0 - - - 5_ - - - |

    /* 第三行 */
    | 1 - - - - - 3 - 2 - 1 - 7_ - - 1 | 6_ - - - - - - - 0 - 6_ - 6_ - 6_ - | 2 - 3 - 4 - - 4' 5 - - 3 1 - - 6 | 5_ - - - - - - - 0 - {f} 5_ - 3_ - 5_ - |

    /* 第四行 */
    | 1 - - - - - - - 0 - 1 - 5_ - 1 - | 3 - - - - - - - 0 - 3 - 1 - 3 - | {ff} 5 - - - - - 3 - 2 - - 3 4 - - 2 | 1 - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |
    /* 第一行 */
    | 1_ [1] 5__ [5_] | 4__ [4_] 4_ 0 | 2_ [2_m] 2_ [2_] | 5__ [5_] 5__ 0 |
    /* 第二行 */
    | 1_ [1] 5__ [5_] | 4__ [4_] 4_ 0 | 2_ [2_m] 5__ [5_] | 1_ [1] 1_ 0 |
    /* 第三行 */
    | 1_ [1] 5__ [5_] | 4__ [4_] 4_ 0 | 2_ [2_m] 2_ [2_] | 5__ [5_] 5__ 0 |
    /* 第四行 */
    | 1_ [1] 1_ 0 | 1_ [1] 1_ 0 | 3_ [1] 5__ [5_] | 1_ [1] 0 0 |
}

-> Main -> #

