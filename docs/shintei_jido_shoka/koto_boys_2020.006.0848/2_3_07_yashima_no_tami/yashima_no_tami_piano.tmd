::SCORE::
** 八洲の民（鋼琴伴奏版） **
!= 108
?= G
<4/4>
~ "詞：稻垣千頴"
~ "曲：小山作之助"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <8*>
    /* 弱起小節 */
    | 0 - 0 - 0 {mf} 5_ 5_ 5_ |

    /* 第一行 */
    | 1 - - - 2 3 4 3 | 5 - - - - - 3 1 | 2 - 2 3 4 - 2 - | 3 - - - 0 5_ 5_ 5_ |

    /* 第二行 */
    | 1 - - - 2 3 4 3 | 5 - - - - - 3 1 | 2 - 1 2 3 - 2 - | 1 - - - 0 - 2 - |

    /* 第三行 */
    | 2 - - 3 4 5 4 3 | 2 - 5 - - - 2 - | 5 - - - 4 - 3 - | 2 - - - - - 2 - |

    /* 第四行 */
    | 2 - - 3 4 5 4 3 | 2 - 5 - - - 4 - | 3 - - - 2 - 1 - | 5_ - - - 0 {f} 5_ 5_ 5_ |

    /* 第五行 */
    | 1 - - - 2 3 4 3 | 5 - - - - - 3 1 | 2 - 2 3 4 - 2 - | 3 - - - 0 5_ 5_ 5_ |

    /* 第六行 */
    | 1 - - - 2 3 4 3 | 5 - - - - - 3 1 | 2 - 1 2 3 - 2 - | 1 - - - 0 - 0 - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |
    /* 第一行 */
    | 1_ [1] 3_ [1] | 5__ [5_] 1_ [1] | 2_ [5_] 2_ [5_] | 1_ [1] 1_ 0 |
    /* 第二行 */
    | 1_ [1] 3_ [1] | 5__ [5_] 1_ [1] | 4_ [2_m] 5__ [5_] | 1_ [1] 1_ 0 |
    /* 第三行 */
    | 2_ [5_] 2_ [5_] | 2_ [5_] 1_ [1] | 5__ [5_] 1_ [1] | 2_ [5_] 2_ 0 |
    /* 第四行 */
    | 2_ [5_] 2_ [5_] | 2_ [5_] 1_ [1] | 3_ [1] 6__ [6_m] | 5__ [5_] 5__ 0 |
    /* 第五行 */
    | 1_ [1] 3_ [1] | 5__ [5_] 1_ [1] | 2_ [5_] 2_ [5_] | 1_ [1] 1_ 0 |
    /* 第六行 */
    | 1_ [1] 3_ [1] | 5__ [5_] 1_ [1] | 4_ [2_m] 5__ [5_] | 1_ [1] 0 0 |
}

