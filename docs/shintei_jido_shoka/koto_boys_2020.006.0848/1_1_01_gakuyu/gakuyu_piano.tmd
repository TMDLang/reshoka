::SCORE::
** 學友（鋼琴伴奏版） **
!= 92
?= C
<4/4>
~ "詞：大和田建樹"
~ "曲：Lewis（リユーイス）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 1 - - - |

    /* 第一行 */
    | 3 - - - - - - - 2 - 1 - 1 - - - |
    | 3 - - - - - 4 - 5 - - - 1 - - - |
    | 2 - - - - - - - 1 - - - 2 - - - |
    | 3 - - - - - - - 0 - - - {f} 5 - - - |

    /* 第二行 */
    | 1^ - - - - - - - 7 - 6 - 5 - - - |
    | 4 - - - 3 - - - 2 - - - {mf} 5 - - - |
    | 6 - - - - - - - 4 - - - 5 - - - |
    | 3 - - - - - - - 2 - - - 1 - - - |

    /* 第三行 */
    | 3 - - - - - - - 2 - 1 - 1 - - - |
    | 3 - - - 4 - - 5 5 - - - 1 - - - |
    | 2 - - - - - - - 3 - - - 2 - - - |
    | 1 - - - - - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1_ [1] 5__ [1] | 1_ [1] 3_ [1] | 5__ [5_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第二行 */
    | 1_ [1] 3_ [1] | 4_ [1] 5__ [5_] | 4_ [4_] 2_ [5_] | 1_ [1] 5__ 0 |

    /* 第三行 */
    | 1_ [1] 5__ [1] | 1_ [4_] 5__ [1] | 4_ [2_m] 5__ [5_] | 1_ [1] 1_ 0 |
}

-> Main -> #

