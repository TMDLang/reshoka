::SCORE::
** 出陣（鋼琴伴奏版） **
!= 80
?= F
<3/4>
~ "曲：シルヘル（獨）（Silcher）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - {p} 5_ - |

    /* 第一行 */
    | 1 - 2 - 3 - 4 - 5 - - - | 6 - - 5 4 - 3 - 0 - {mp} 5 - | 5 - 4 - 3 - 2 - 1 - - - | 3 - 2 - - 3 2 - 0 - {mf} 5_ - |

    /* 第二行 */
    | 2 - 2 - 3 - 4 - 4 - 3 - | 3 - - 2 2 - 5 - 0 - 5 - | 4 - 2 - 1 - 7_ - 1 - 4 - |

    /* 第三行 */
    | 3 - 2 - - 2 1 - 0 - {f} 5_ - | 3 - 4 - 5 - 6 - 5 - 4 - | 3 - 2 - - 3 1 - 0 - - - |
}

Main:PianoLH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - {p} 5_ - |

    /* 第一行 */
    | 1 - 7_ - 1 - 2 - 3 - - - | 4 - - 3 2 - 1 - 0 - {mp} 3 - | 3 - 2 - 1 - 7_ - 1 - - - | 1 - 7_ - - 1 7_ - 0 - {mf} 5_ - |

    /* 第二行 */
    | 7_ - 7_ - 1 - 2 - 2 - 1 - | 1 - - 7_ 7_ - 3 - 0 - 3 - | 2 - 7_ - 6_ - 5_ - 6_ - 2 - |

    /* 第三行 */
    | 1 - 7_ - - 7_ 1 - 0 - {f} 5_ - | 1 - 2 - 3 - 4 - 3 - 2 - | 1 - 7_ - - 1 1 - 0 - - - |
}

-> Main -> #

