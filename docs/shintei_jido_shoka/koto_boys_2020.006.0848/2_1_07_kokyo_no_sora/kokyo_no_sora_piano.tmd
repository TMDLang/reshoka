::SCORE::
** 故郷の空（鋼琴伴奏版） **
!= 96
?= C
<4/4>
~ "詞：旗野士良"
~ "曲：ルート（G. F. Root，米國）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 5 - - 5 |

    /* 第一行 */
    | 5 - - 3^ 2^ - - 1^ 1^ - - - 7 - - 6 | 5 - - 6 5 - - 3 5 - - - 5 - - 5 |

    /* 第二行 */
    | 5 - - 3^ 2^ - - 1^ 1^ - - 7 6 - - 7 | 1^ - - - - - - - - - - - 2^ - - 2^ |
    | 2^ - - 5 7 - - 2^ 2^ - - - 1^ - - 7 |

    /* 第三行 */
    | 1^ - - 5 3^ - - 2^ 1^ - - - 7 - - 1^ | 2^ - - 2^ 2^ - - 5 7 - - 1^ 2^ - - 7 |
    | 1^ - - - - - - - - - - - 0 - - - |

    /* 第四行 */
    | 1^ - - - 1^ - - - 1^ - - 7 6 - - 5 | 6 - - - - - - - - - - - 1^ - - - |
    | 7 - - - 7 - - - 7 - - 6 7 - - 1^ | 2^ - - - - - - - 0 - - - 5 - - 5 |

    /* 第五行 */
    | 5 - - 3^ 2^ - - 1^ 1^ - - - 7 - - 6 | 5 - - - - - 3 - 5 - - 6 5 - - 5 |
    | 5 - - 3^ 2^ - - 1^ 7 - - 1^ 2^ - - 7 | 1^ - - - - - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1 [1] 4 [5] | 1 [1] 1 0 |

    /* 第二行 */
    | 1 [1] 4 [5] | 1 [1] [1] 0 |
    | 5_ [5] 5_ [5] |

    /* 第三行 */
    | 1 [1] 1 [1] | 5_ [5] 5_ [5] |
    | 1 [1] [1] 0 |

    /* 第四行 */
    | 6_ [6m] 6_ [3m] | 4_ [4] [4] [4] |
    | 5_ [5] 5_ [5] | 5_ [5] 0 0 |

    /* 第五行 */
    | 1 [1] 4 [5] | 1 [1] 1 0 |
    | 1 [1] 5_ [5] | 1 [1] 0 0 |
}

-> Main -> #

