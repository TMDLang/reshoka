::SCORE::
** 凱旋（鋼琴伴奏版） **
!= 84
?= G
<4/8>
~ "出處：弘樂社發行《中等音樂教科書》"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | 5_ - 5_ - - 6_ 7_ - | 1 - 2 - 3 - 0 - |
    | 5 - - 6 5 - 3 - | 4 - 3 - 2 - 0 - |
    | 3 - - 2 1 - 3 - |

    /* 第二行 */
    | 2 - - - 7_ - 5_ - | 6_ - 7_ 1 2 - 1 7_ |
    | 5 - - - 0 - - - | 7_ - 1 2 3 - 2 1 |
    | 2 - 3 4 5 - 0 - |

    /* 第三行 */
    | 1 - 2 3 4 - 3 2 | 1 - 7_ 6_ 5_ - 0 - |
    | 5 - - 6 5 4 3 2 | 1 - - 2 3 - 4 - |

    /* 第四行 */
    | 5 - 3 - 1 - 6_ - | 5_ 1 3 2 1 - 0 - |
    | 5 - - 6 5 4 3 2 | 1 - - 2 3 - 4 - |

    /* 第五行 */
    | 5 - 3 - 1 - 6_ - | 5_ 1 3 2 1 - 5_ - |
    | 1 - - 2 3 - 4 3 | 1 - - - - - 0 - |
}

Main:PianoLH@|0| {
    <8*>
    /* 第一行 */
    | 5__ [5_] 5__ [5_] | 1_ [1] 1_ 0 |
    | 1_ [1] 3_ [1] | 4_ [4_] 5__ 0 |
    | 1_ [1] 3_ [1] |

    /* 第二行 */
    | 5__ [5_] 5__ [5_] | 2_ [2_] 2_ [2_] |
    | 5__ [5_] 0 - | 5__ [5_] 1_ [1] |
    | 5__ [5_] 5__ 0 |

    /* 第三行 */
    | 1_ [1] 4_ [4_] | 1_ [1] 5__ 0 |
    | 1_ [1] 5__ [5_] | 1_ [1] 3_ [1] |

    /* 第四行 */
    | 1_ [1] 6__ [6_m] | 5__ [5_] 1_ 0 |
    | 1_ [1] 5__ [5_] | 1_ [1] 3_ [1] |

    /* 第五行 */
    | 1_ [1] 6__ [6_m] | 5__ [5_] 1_ 0 |
    | 1_ [1] 5__ [5_] | 1_ [1] [1] 0 |
}

