** 朝風（鋼琴伴奏版） **
!= 84
?= F
<4/4>
~ "詞：桑田春風"
~ "曲：F. Silcher（シルヘル）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <8*>
    /* 第一行 */
    | {mf} 1 - 3 - - 4 3 - | 2 - - - 1 - 2 - | 3 - 4 - 5 - 3 - | 2 - - - 0 - - - |

    /* 第二行 */
    | 1 - 2 - 3 - 4 - | {f} 5 - - - 4 - {mf} 2 - | 1 - 3 - 2 - 4 - | 1 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    | 1_ - [1] - | 5__ - [1] [5_] | 1_ [5_] [1] - | 5__ - [5_] 0 |
    | 4_ [5_] [1] [4] | 1_ - [5_] - | 4_ [1] [5_] - | 1_ - [1] 0 |
}

