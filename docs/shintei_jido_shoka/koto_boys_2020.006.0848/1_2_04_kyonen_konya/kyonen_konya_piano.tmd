::SCORE::
** 去年今夜（鋼琴伴奏版） **
!= 76
?= F
key= Dm
<4/4>
~ "出處：東京音樂學校編《中學唱歌》"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <8*>
    /* 第一行 */
    | {mp} 6_ - 1 - 7_ - 5'_ - | 2 - - 3 1 - - - | 3 - 3 - 2 - 1 - | 3 - - - - - 0 - |

    /* 第二行 */
    | 6_ - 1 - 7_ - 5'_ - | 2 - - 1 7_ - - - | 4 - 3 - 2 - 2' - | 3 - - - - - 0 - |

    /* 第三行 */
    | {mf} 3 - 3 - 6 - 5 - | 4 - - 3 2 - - - | 2 - 2 - 5 - 4 - | 3 - - - - - 0 - |

    /* 第四行 */
    | {mp} 6_ - 1 - 7_ - 5'_ - | 2 - - 3 4 - - - | 3 - 6_ - 1 - - 7_ | 6_ - - - - - 0 - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 6__ - [3_] - | 2_ - [6_m] - | 3_ - [2_m] - | 3_ - [3_] 0 |

    /* 第二行 */
    | 6__ - [3_] - | 2_ - [7_m7-5] - | 4_ [6_m] 7__ [7_] | 3_ - [3_] 0 |

    /* 第三行 */
    | 3_ - [6_m] - | 2_ - [2_m] - | 5__ - [5_] - | 1_ - [3_] 0 |

    /* 第四行 */
    | 6__ - [3_] - | 2_ - [4_] - | 3_ [6_m] 3_ [3_] | 6__ - [6_m] 0 |
}

-> Main -> Main -> #

