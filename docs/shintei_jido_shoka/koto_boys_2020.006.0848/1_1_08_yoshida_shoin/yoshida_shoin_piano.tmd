::SCORE::
** 吉田松陰（鋼琴伴奏版） **
!= 96
?= C
<3/4>
~ "詞：土井林吉（土井晩翠）"
~ "曲：小山作之助"
~ "出處：東京音樂學校編《中等唱歌》"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - {mp} 3 - - 3 |

    /* 第一行 */
    | 6 - - - - - 7 - 1^ - 6 - |
    | 7 - 6 - 3 - - - 6 - - 7 |
    | 1^ - - - - - 2^ - 7 - - - |
    | 6 - - - - - 0 - {mf} 3^ - - 3^ |

    /* 第二行 */
    | 3 - - - 6 - 7 - 1^ - 7 - |
    | 6 - - - 3 - - - 6 - - 7 |
    | 1^ - - - 2^ - 1^ - 7 - - - |
    | 6 - - - - - 0 - {f} 3^ - - 3^ |
    | 3^ - - - 2^ - - - 1^ - - 7 |

    /* 第三行 */
    | 6 - - - 7 - 1^ - 2^ - - - |
    | 5' - - 6 7 - - - - - - - |
    | 3 - - - - - 0 - 6 - - 6 |
    | 1^ - 7 - 6 - - - 5' - - - |
    | 6 - - - 3 - - - 6 - - 7 |

    /* 第四行 */
    | 1^ - - - - - 7 - 6 - 5' - |
    | 6 - - - 0 - - - {p} 3 - - - |
    | 6 - - - 0 - - - 7 - - 7 |
    | 1^ - - - 0 - - - {f} 2^ - - 2^ |
    | 3^ - - - 6 - - - 1^ - - 7 |
    | 6 - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 |

    /* 第一行 */
    | 6__ [6_m] [6_m] | 3_ [6_m] [6_m] | 6__ [6_m] 3_ | 6__ [6_m] 0 |

    /* 第二行 */
    | 6__ [6_m] [6_m] | 6__ [6_m] [6_m] | 6__ [6_m] 3_ | 6__ [6_m] 0 | 1_ [1] 5__ |

    /* 第三行 */
    | 6__ [6_m] 2_ | 3_ [3_] [3_] | 6__ [6_m] 0 | 6__ [6_m] 3_ | 6__ [6_m] [6_m] |

    /* 第四行 */
    | 6__ [6_m] 3_ | 6__ 0 0 | 6__ 0 3_ | 6__ 0 2_ | 3_ [6_m] 3_ | 6__ [6_m] 0 |
}

-> Main -> #

