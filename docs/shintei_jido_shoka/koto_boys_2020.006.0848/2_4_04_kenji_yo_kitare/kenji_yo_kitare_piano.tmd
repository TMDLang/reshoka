::SCORE::
** 健兒よ來れ（鋼琴伴奏版） **
!= 112
?= F
<3/4>
~ "詞：久保田宵二"
~ "曲：原田比古士良"
~ "（日本男兒の歌）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一段 */
    | {f} 1 - - 5_ 1 - - - 3 - - - | 4 - - 3 2 - - - - - 0 - | 5 - - 5 6 - - - 5 - - - | 3 - - - - - - - 0 - - - |

    /* 第二段 */
    | 1 - - 5_ 1 - - - 3 - - - | 2 - - 1 7_ - - - - - 0 - | 2 - - 3 4 - - - 7_ - - - | 1 - - - - - - - 0 - - - |

    /* 第三段 */
    | 6 - - 6 6 - - - 5 - - - | 6 - - 6 6 - - - - - 0 - | 7_ - - 1 2 - - - 3 - - - | 5 - - - - - - - 0 - - - |

    /* 第四段 */
    | 1 - - 5_ 1 - - - 3 - - - | 4 - - 3 2 - - - - - 0 - | 5 - - 3 1 - - - 2 - - - | 1 - - - - - - - 0 - - - |
}

Main:PianoLH@|0| {
    <16*>
    /* 第一段 */
    | {mp} 5_ - - 5_ 5_ - - - 1 - - - | 7_ - - 1 7_ - - - - - 0 - | 5_ - - 5_ 6_ - - - 5_ - - - | 5_ - - - - - - - 5_ - - - |

    /* 第二段 */
    | 5_ - - 5_ 5_ - - - 1 - - - | 6_ - - 6_ 5_ - - - - - 0 - | 5_ - - 5_ 5_ - - - 5_ - - - | 1 - - - - - - - 1 - - - |

    /* 第三段 */
    | 1 - - 1 1 - - - 1 - - - | 1 - - 1 1 - - - - - 0 - | 5_ - - 5_ 5_ - - - 5_ - - - | 1 - - - - - - - 1 - - - |

    /* 第四段 */
    | 6_ - - 6_ 6_ - - - 6_ - - - | 6_ - - 6_ 7_ - - - - - 0 - | 1 - - 1 5_ - - - 5_ - - - | 1 - - - - - - - 0 - - - |
}

