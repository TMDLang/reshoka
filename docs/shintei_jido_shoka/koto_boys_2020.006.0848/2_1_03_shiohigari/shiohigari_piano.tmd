::SCORE::
** 汐干狩（鋼琴伴奏版） **
!= 92
?= E,
<4/4>
~ "詞：大和田建樹"
~ "曲：英國風曲"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - - - 0 - - - 0 - - - {mf} 5_ - - - |

    /* 第一行 */
    | 1 - - - 1 - - 2 3 - - 4 5 - 3 - | 2 - - - 5 - - 6 5 - - - - - - - |
    | 3 - - - 2 - - 3 4 - - 2 3 - - - | 3 - - - 2 - - - - - - - 5_ - - - |

    /* 第二行 */
    | 1 - - - 1 - - 2 3 - - 4 5 - 3 - | 2 - - - - - - - 5 - - 4 3 - - - |
    | 2 - - - 3 - - 4 3 - - 2 1 - - - | 1 - - - - - - - 0 - - - 2 - 2 - |

    /* 第三行 */
    | 2 - 0 - 3 - - 4 5 - 3 - 1 - 0 - | 5 - - - - - 3 - 1^ - - 7 6 - - 5 |
    | 6 - - - - - - - 5 - - - 5_ - - - |

    /* 第四行 */
    | 1 - - - 1 - - 2 3 - - 4 5 - 6 - | 3 - - - {f} 1^ - - - - - 5 - 3 - - - |
    | 2 - - - 1 - - 2 3 - - 4 3 - - - | 2 - - - 1 - - - 0 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 0 0 |

    /* 第一行 */
    | 1_ [1] 1_ [1] | 5__ [5_] 5__ [5_] |
    | 1_ [5_] 4_ [1] | 5__ [5_] [5_] 0 |

    /* 第二行 */
    | 1_ [1] 1_ [1] | 5__ [5_] 1_ [1] |
    | 5__ [5_] 5__ [1] | 1_ [1] 0 0 |

    /* 第三行 */
    | 5__ [5_] 1_ [1] | 1_ [1] 1_ [4_] |
    | 4_ [4_] 5__ 0 |

    /* 第四行 */
    | 1_ [1] 1_ [4_] | 1_ [1] 1_ [1] |
    | 5__ [1] 1_ [1] | 5__ [1] 0 0 |
}

-> Main -> #

