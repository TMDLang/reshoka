::SCORE::
** 騎馬旅行 **
!= 100
?= F
<2/4>
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P096.jpg – P097.jpg，書頁 pp. 19–20，高二第二學期第 5 首）：
   調性與拍號：ヘ長調（F Major，1 降記號）、2/4 拍（輕快ニ ♩=100）
   出處註記：（開成館發行教育唱歌集）

   一
   肥えたるわが馬　手なれしわが鞭
   千里の旅行も　おもへばやすし
   いざいざすゝまん　山こえて
   いざいざ進まん　河を渡りて
   花あり月ある　孤村の夕
   いづこに繋がん　栗毛のわが駒

   二
   けはしき山路も　はてなき野原も
   蹄にかけ行く　わが旅たのし
   いざいざすゝまん　里すぎて
   いざいざ進まん　橋を渡りて
   わが馬立てつゝ　見かへるあなた
   白雲ゆふべの　宿をぞへだつる
   ========================================================================= */

Verse:Piano@|0| {
    <16*>
    /* 第一行（5 小節，P096.jpg） */
    /* コ エ | タ | ル ワ ガ | ウ | マ テ ナ レ */
    | {mf} 5 - - - 5 - - 6 | 5 - - - - - - - | 1 - - - 3 - - 2 | 1 - - - - - - - | 1 - 5_ - 1 - 3 - |

    /* 第二行（6 小節，P096.jpg） */
    /* シ ワ | ガ ム チ | ー セ ン | リ | ノ 旅 カ | ウ */
    | 2 - - - - - 1 - | 7__ - 1 - 2 - - - | - - - - 5 - - 6 | 5 - - - - - - - | 3 - - - 1 - - 2 | 1 - - - - - - - |

    /* 第三行（6 小節，P096.jpg） */
    /* モ オ モ ヘ | バ ヤ | ス ー | シ | ー イ ザ | イ */
    | 1 - 5_ - 1 - 3 - | 2 - - - - - 3 - | 4 - - - 7__ - - - | 1 - - - - - - - | - - - - {f} 5 - - 6 | 5 - - - - - - - |

    /* 第四行（6 小節，P096.jpg） */
    /* ザ ス ス | マ | ン ヤ マ | コ エ | テ | ー イ ザ */
    | 3 - - - 1 - - 2 | 5 - - - - - - - | - - - - 6 - - 7 | 1^ - - - - - 6 - | 5 - - - - - - - | - - - - 5_ - - 6_ |

    /* 第五行（5 小節，P096.jpg） */
    /* イ | ザ ス ス | マ | ン カ ハ | ヲ ワ */
    | 5_ - - - - - - - | 5_ - - - 1 - - 2 | 3 - - - - - - - | - - - - 6 - - 6 | 5 - - - - - 3 - |

    /* 第六行（5 小節，P096.jpg） */
    /* タ リ テ | ー ハ ナ | ア | リ ツ キ | ア */
    | 1 - - 2 3 - - - | - - - - {mf} 5 - - 6 | 5 - - - - - - - | 3 - - - 1 - - 2 | 3 - - - - - - - |

    /* 第七行（5 小節，P097.jpg） */
    /* ル コ ソ ン | ノ ユ | フ ー ベ | ー イ ヅ | コ */
    | 1 - 1 - 7__ - 1 - | 2 - - - - - 3 - | 4 - - 2 7__ - - - | - - - - 1 - - 2 | 3 - - - - - - - |

    /* 第八行（6 小節，P097.jpg） */
    /* ニ ツ ナ | ガ | ン ク リ ゲ | ノ ワ | ガ コ マ | ー */
    | 3 - - - 4 - - 5 | 6 - - - - - - - | 6 - 5 - 4 - 3 - | 2 - - - - - 1 - | 7__ - - 2 1 - - - | - - - - 0 - - - |
}

