::SCORE::
** 川中島（鋼琴伴奏版） **
!= 80
?= F
<2/4>
~ "詞：大和田建樹（松邑三松堂發行檢定唱歌集）"
~ "曲：歐洲曲"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 弱起小節 */
    | 0 - 0 - 0 - {mf} 5_ - |

    /* 第一行 */
    | 1 - - 2 3 - 4 5 | 6 - 5 - 3 - 0 - |
    | 2 - 2 - 2 - 5 - | 3 - 1 - 2 - {f} 6_ - |

    /* 第二行 */
    | 6_ - - 1 2 - 4 - | 3 - 2 1 2 - 0 - |
    | 3 - 3 4 5 - 3 - | 2 - 3 2 1 - {mf} 5_ - |

    /* 第三行 */
    | 1 - - 2 3 - 4 5 | 5 - 4 - 3 - {f} 3 - |
    | 4 - 5 - 6 - - 5 | 5 - 4 - 3 - {mf} 5_ - |

    /* 第四行 */
    | 2 - - 3 4 - 3 2 | 1 - 6 - 5 - 0 - |
    | 6 - 6 - 6 - 0 - | 5 - 5 - 5 - 5_ - |

    /* 第五行 */
    | 1 - - 2 3 - 4 5 | 6 5 4 - 3 - 0 - |
    | 2 - - 2 3 - - 2 | 1 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 弱起小節 */
    | 0 0 |

    /* 第一行 */
    | 1_ [1] | 4_ [1] |
    | 5__ [5_] | 1_ [5_] |

    /* 第二行 */
    | 2_ [2_m] | 5__ [5_] |
    | 1_ [1] | 5__ [1] |

    /* 第三行 */
    | 1_ [1] | 5__ [1] |
    | 4_ [4_] | 5__ [1] |

    /* 第四行 */
    | 5__ [5_] | 1_ [1] |
    | 4_ [4_] | 5__ [5_] |

    /* 第五行 */
    | 1_ [1] | 4_ [1] |
    | 5__ [5_] | 1_ 0 |
}

-> Main -> Main -> #

