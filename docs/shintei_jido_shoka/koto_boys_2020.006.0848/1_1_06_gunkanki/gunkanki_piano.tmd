::SCORE::
** 軍艦旗（鋼琴伴奏版） **
!= 104
?= G
<4/4>
~ "詞：旗野士良"
~ "曲：Henry Clay Work（ウオーク）"
~ "臺灣教育會公認《新定兒童唱歌》高等科男子用（2020.006.0848）"

Main:PianoRH@|0| {
    <16*>
    /* 第一行 */
    | 3 - - 4 3 - 1 - 6_ - - 7_ 1 - 6_ - |
    | 5_ - 1 - 1 - 2 - 3 - - - - - - - |
    | 5_ - - 6_ 7_ - 1 - 2 - 2 - 1 - 2 - |
    | 3 - - 4 3 - 2 - 5 - - - - - - - |

    /* 第二行 */
    | {mf} 3 - - 4 3 - 1 - 6_ - - 7_ 1 - 6_ - |
    | 5_ - 1 - 1 - 2 - 3 - - - - - - - |
    | 2 - - 3 4 - - - 3 - - 1 2 - - - |
    | 1 - - - - - - - 1 - - - 0 - - - |

    /* 第三行 */
    | 1 - - - 3 - - - 5 - - - 5 - - 3 |
    | 4 - 6 - 5 - 4 - 3 - - - - - - - |
    | 1 - - - 3 - - - 5 - - - 5 - - 3 |
    | 2 - 3 - 4 - 3 - 2 - - - - - - - |

    /* 第四行 */
    | {mf} 3 - - 4 3 - 1 - 6_ - - 7_ 1 - 6_ - |
    | 5_ - 1 - 1 - 2 - 3 - - - - - - - |
    | 2 - - 3 4 - - - 3 - - 1 2 - - - |
    | 1 - - - - - - - 1 - - - 0 - - - |
}

Main:PianoLH@|0| {
    <4*>
    /* 第一行 */
    | 1_ [1] 6__ [6_m] | 5__ [5_] 1_ [1] | 5__ [5_] 2_ [2_m] | 3_ [1] 5__ [5_] |

    /* 第二行 */
    | 1_ [1] 6__ [6_m] | 5__ [5_] 1_ [1] | 4_ [4_] 5__ [5_] | 1_ [1] 1_ 0 |

    /* 第三行 */
    | 1_ [1] 3_ [1] | 4_ [4_] 1_ [1] | 1_ [1] 3_ [1] | 5__ [5_] 2_ [5_] |

    /* 第四行 */
    | 1_ [1] 6__ [6_m] | 5__ [5_] 1_ [1] | 4_ [4_] 5__ [5_] | 1_ [1] 1_ 0 |
}

