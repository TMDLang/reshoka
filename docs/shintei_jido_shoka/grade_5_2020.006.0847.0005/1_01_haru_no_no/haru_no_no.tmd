    | 3 - - 2 1 - - 6_ | 5_ - 6_ - 1 - - - | 2 - - 2 3 - 2 - | 1 - - - - - 0 - |

    /* ================= 第三行 (4 小節, P024.jpg) ================= */
    /* (一): イ    ヅ レ  カ  | ラ  ヌ          | タ  ノ  シ  サ  | ヲ          */
    | 5 - - 3 5 - 3 - | 2 - 1 - 6_ - - - | 5_ - 1 - 2 - 3 - | 2 - - - - - 0 - |

