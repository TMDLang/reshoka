    | 1_ [1] [1] | 1_ [1] 0 | 1_ 2_ 6__ | 2_ [2] 0 |
    | {mf} 1_ [1] [1] | 4_ 5__ 0 | 1_ [1] [1] | 2_ 6__ 0 |
    | {f} 1_ [1] [1] | 1_ 5__ 0 | {p} 1_ [1] 5__ | 1_ [1] 0 |
}

