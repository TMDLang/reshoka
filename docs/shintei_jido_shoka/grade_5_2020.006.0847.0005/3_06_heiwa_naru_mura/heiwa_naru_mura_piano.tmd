    /* ================= 第四行 (4 小節, P055.jpg) ================= */
    | 5_ 1 1 - - 2 | 3 4 2 - 0 {p} 5 | 3 2 1 - 6_ 5_ | 1 - - - 0 - |
}

HeiwaNaruMura:PianoLH@|0| {
    <4*>
    /* 溫馨祥和之田園三拍子左手伴奏 */
