/* =========================================================================
   原書資訊與歌詞全文（對應 P055.jpg，書頁 p. 32，第三學期第 6 首）：
   調性與拍號：變ろ長調四分之三拍子（Bb 大調 3/4 拍），♩= 80
   作詞：三木露風　作曲：山田耕作

   一　平和なる村、我等の村よ
   　　耕（たがや）し蠶飼（こが）ひ、雞（とり）をかひ
   　　魚を養ひ　模範（もはん）を示し
   　　村人すべて　樂しみ暮す

   二　平和なる村、我等の村よ
   　　村長（むらをさ）よくして師弟（してい）は愛し
   　　青年團は、植林（しよくりん）をなす
   　　我等の村は　彌榮（いやさか）ゆなり
   ========================================================================= */

HeiwaNaruMura:Piano@|0| {
    <8*>
    /* ================= 弱起與第一行 (P055.jpg) ================= */
    /*             {p} ヘ | イ ワ ナ    ル  | ム ー ラ      ワ | レ ラ ノ    ム ラ | ヨ          タ */
    | 0 - - - - {p} 5_ | 1 1 1 - 2 - | 3 2 1 - 0 1 | 2 2 3 - 2 1 | 2 - - - 0 5_ |

    /* ================= 第二行 (4 小節, P055.jpg) ================= */
    /* ガ ヤ シ      コ | ガ ー ヒ      ニ | ハ ト リ    ヲ カ | ヒ        {mf} ウ */
    | 1 1 1 - - 2 | 3 2 1 - 0 3 | 5 3 2 - 6_ - | 2 - - - 0 {mf} 2 |

    /* ================= 第三行 (4 小節, P055.jpg) ================= */
    /* ヲ ヲ ヤ      シ | ナ ー ヒ      モ | ハ    ン      ヲ シ | メ ー シ    {f} ム */
    | 3 3 3 - - 3 | 4 3 2 - 0 2 | 5 - 5 - - 3 | 2 1 6_ - 0 {f} 6_ |

    /* ================= 第四行 (4 小節, P055.jpg) ================= */
