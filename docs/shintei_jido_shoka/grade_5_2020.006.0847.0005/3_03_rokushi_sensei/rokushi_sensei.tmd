::SCORE::
** 六氏先生 **
!= 96
?= B,
key= Gm
<4/4>
~ "臺灣教育會公認《新定兒童唱歌》尋常科第五學年用（2020.006.0847.0005）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P052.jpg，書頁 p. 29，第三學期第 3 首）：
   調性與拍號：と短調四分之四拍子（G 小調 4/4 拍），♩= 96

   一　やよや兒等　はげめやよ
   學べこら　こどもらよ
   したへしたへ
   たふれてやみし先生を

   二　うたへ兒等　思へやよ
   進めこら　國のため
   おもへおもへ
   遭難六氏の先生を
   ========================================================================= */

RokushiSensei:Piano@|0| {
    <8*>
    /* ================= 第一行 (4 小節, P052.jpg) ================= */
    /* (一): ヤ      ヨ  ヤ  | コ      ラ      | ハ  ゲ  メ  ヤ  | ヨ          */
    | 3 - - - 3 - 3 - | 6 - - - 6 - - - | 7 - 7 - 1^ - 7 - | 6 - - - - - 0 - |

    /* ================= 第二行 (4 小節, P052.jpg) ================= */
    /* (一): マ      ナ  ベ  | コ      ラ      | コ  ド  モ  ラ  | ヨ          */
    | 1^ - - - 1^ - 1^ - | 6 - - - 6 - - - | 7 - 6 - 5 - 6 - | 3 - - - - - 0 - |

    /* ================= 第三行 (4 小節, P052.jpg) ================= */
    /* (一): シ          タ  | ヘ          | シ          タ  | ヘ          */
    | 3 - - - - - 6 - | 6 - - - - - 0 - | 3^ - - - - - 1^ - | 6 - - - - - 0 - |

    /* ================= 第四行 (4 小節, P052.jpg) ================= */
    /* (一): タ    フ レ  テ  | ヤ  ミ  シ      | セ  ン  セ    イ | ヲ          */
    | 6 - - 7 1^ - 6 - | 7 - 7 - 1^ - - - | 3 - 6 - 7 - - 7 | 6 - - - - - 0 - |
}

