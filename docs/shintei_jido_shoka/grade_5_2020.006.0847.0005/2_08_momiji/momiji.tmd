/* =========================================================================
   原書資訊與歌詞全文（對應 P045.jpg，書頁 p. 22，第二學期第 8 首）：
   調性與拍號：變ほ長調四分之二拍子（Eb 大調 2/4 拍）
   作詞：平尾白暮　作曲：室崎琴月

   一　もみぢの枝に
   ブランコさげて
   一つゆすれば
   ホロホロホロ
   二つゆすれば
   チラチラチラ
   あれあれ赤い葉が散るよ
   ひいふうみいよ
   いつむうななや

   二　もみぢの下で
   御本（ごほん）をよめば
   右の方でも
   ホロホロホロ
   左の方でも
   チラチラチラ
   あれあれ赤い葉が散るよ
   ひいふうみいよ
   いつむうななや
   ========================================================================= */

Momiji:Piano@|0| {
    <16*>
    /* ================= 弱起與第一行 (P045.jpg) ================= */
    /*           {mf} モ | ミ  ヂ  ノ  エ  | ダ  ニ          | ブ  ラ  ン  コ  | サ  ゲ テ       */
    | 0 - - - 0 - {mf} 5 - | 6 - 5 0 3 0 5 - | 6 - 5 - - - 0 - | 6 - 5 - 3 - 5 - | 2 - 3 2 1 - 0 - |

    /* ================= 第二行 (4 小節, P045.jpg) ================= */
    /* {mp} ヒ ト ー ツ ユ | ス    レ バ  ホ  | ロ  ホ  ロ  ホ  | ロ              */
    | {mp} 2 - 2 3 4 0 6 - | 5 - - 6 5 - 3 0 | 5 0 3 0 5 0 3 0 | 2 - - - - - 0 - |

    /* ================= 第三行 (4 小節, P045.jpg) ================= */
    /* {mf} フ タ ー ツ ユ | ス    レ バ {p} チ | ラ  チ  ラ  チ  | ラ              */
    | {mf} 3 - 3 4 5 0 1^ - | 7 - - 6 7 - {p} 5 0 | 6 0 5 0 6 0 5 0 | 1^ - - - - - 0 - |

    /* ================= 第四行 (4 小節, P045.jpg) ================= */
    /* {mf} ア    レ      | {f} ア     レ      | {mp} ア カ イ ハ ガ | チ  ル  ヨ      */
    | {mf} 6 - - - 1 - 0 - | {f} 7 - - - 2 - 0 - | {mp} 1^ - 7 6 5 - 3 - | 4 - 2 - 1 - 0 - |

    /* ================= 第五行 (4 小節, P045.jpg) ================= */
    /* ヒ    ー フ      | ミ    ー ヨ      | イ  ツ ム ナ  ナ  | ヤ      ー      */
    | 3 - - 4 5 - - - | 6 - - 7 1^ - - - | 5 - 3 1 2 - 5 - | 1 - - - - - 0 - |
