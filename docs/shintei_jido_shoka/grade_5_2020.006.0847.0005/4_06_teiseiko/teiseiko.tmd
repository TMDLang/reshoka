    | 1 - - 1 2 - - 3 | 5 - - 5 3 - - 3 | 2 - - 2 6_ - - 1 | 2 - - - - - 0 - |

    /* ================= 第二行 (4 小節, P062.jpg) ================= */
    /* (一): テ    イ セ    ウ | コ    ウ ノ    ー | イ    サ ヲ    シ | ヨ              */
    | 3 - - 3 2 - - 1 | 2 - - 2 1 - - 6_ | 5_ - - 1 6_ - - 1 | 5_ - - - - - 0 - |

    /* ================= 第三行 (4 小節, P062.jpg) ================= */
    /* (一): キ    ー ミ    ガ | チ    チ オ    ヤ | ナ    ハ シ    リュ | ウ              */
    | 5 - - 3 3 - - 3 | 5 - - 6 5 - - 3 | 2 - - 2 6_ - - 1 | 2 - - - - - 0 - |

    /* ================= 第四行 (4 小節, P062.jpg) ================= */
    /* (一): ハ    ー ハ    ハ | ヒ    ラ ド    ノ | タ    ガ ハ    ウ | ジ              */
    | 3 - - 5 6 - - 5 | 3 - - 2 1 - - 3 | 5_ - - 5_ 6_ - - 2 | 1 - - - - - 0 - |
