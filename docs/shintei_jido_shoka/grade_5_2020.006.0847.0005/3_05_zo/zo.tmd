/* =========================================================================
   原書資訊與歌詞全文（對應 P054.jpg，書頁 p. 31，第三學期第 5 首）：
   調性與拍號：は長調四分之四拍子（C 大調 4/4 拍）
   作詞：松岸寬一　作曲：永井幸次

   一　印度（いんど）の國（くに）は暑い（あつ）國（くに）
   　　大（おほ）きなからだの腹（はら）の下（した）
   　　象は子供の守をする
   　　小（ちひ）さい眼（め）をばニコ／＼と

   二　大（おほ）きな桶（をけ）に人（ひと）のせて
   　　脊（せな）に上げたり下ろしたり
   　　象は自慢（じまん）の力わざ
   　　長い鼻をばぶら／＼と

   三　ごばんの上に太（ふと）い足
   　　四つ揃（そろ）へてちよと立ちて
   　　象はすなほに喇叭吹（らつぱふ）く
   　　箕（み）のやうな耳をふは／＼と
   ========================================================================= */

Zo:Piano@|0| {
    <8*>
    /* ================= 第一行 (4 小節, P054.jpg) ================= */
    /* イ    ン ド  ノ  ー  | ク    ニ    ハ    ー  | ア    ツ    イ    ク ー | ニ              */
    | 3 - 3 3 5 - 5 - | 6 - 6 - 5 - 3 - | 5 - 5 - 6 - 6 6 | 5 - - - - - 0 - |

    /* ================= 第二行 (4 小節, P054.jpg) ================= */
    /* オ    ホ キ  ナ  ー  | カ    ラ    ダ    ノ ー | ハ    ラ    ノ    シ  | タ              */
    | 3 - 3 3 5 - 5 - | 6 - 6 - 5 - 3 3 | 2 - 2 - 3 - 2 - | 1 - - - - - 0 - |

    /* ================= 第三行 (4 小節, P054.jpg) ================= */
    /* ゾ        ウ    ハ  | コ    ド    モ    ノ  | モ    リ    ヲ    ス  | ル              */
    | 2 - - - 2 - 3 - | 4 - 4 - 3 - 2 - | 3 - 3 - 5 - 6 - | 5 - - - - - 0 - |

    /* ================= 第四行 (4 小節, P054.jpg) ================= */
    /* チ        サ    イ  | メ    ー    ヲ    バ  | ニ    コ    ニ    コ  | ト              */
    | 1^ - - - 6 - 5 - | 3 - 5 - 6 - 5 - | 2 - 3 - 5 - 6 - | 1^ - - - - - 0 - |
}

