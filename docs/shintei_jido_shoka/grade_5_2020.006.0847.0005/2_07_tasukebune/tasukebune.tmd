/* =========================================================================
   原書資訊與歌詞全文（對應 P044.jpg，書頁 p. 21，第二學期第 7 首）：
   調性與拍號：變ろ長調八分之六拍子（Bb 大調 6/8 拍），情ヲ込メテ ♪= 120
   作詞：佐々木信綱　曲：（英國風曲）

   一　はげしき雨風　天地くらく
   山なすあら波たけり狂ふ
   見よ見よかしこにあはれ小舟
   生死のさかひと救もとむ

   二　救を求むる　聲はすれど
   この風この波誰もゆかず
   見よ見よこぎづるすくひ小舟
   けなげのをのこら守れ神よ
   ========================================================================= */

Tasukebune:Piano@|0| {
    <8*>
    /* ================= 弱起與第一行 (P044.jpg) ================= */
    /*             {mf} ハ | ゲ    シ キ    ア | メ  ー カ    ゼ テ | ン    チ ク  ー ラ | ク        ー    ヤ */
    | 0 - - - - {mf} 5_ | 3 - 3 2 - 2 | 1 2 3 - 2 5_ | 4 - 4 3 2 1 | 2 - - - - 5_ |

    /* ================= 第二行 (4 小節, P044.jpg) ================= */
    /* マ    ナ ス    ア | ラ  ー ナ ミ    タ | ケ    リ ク  ー ル | フ        ー {mp} ミ */
    | 3 - 3 2 - 2 | 1 2 3 2 - 5_ | 4 - 4 7_ 1 2 | 1 - - - - {mp} 1 |

    /* ================= 第三行 (4 小節, P044.jpg) ================= */
    /* ヨ    ミ ヨ    カ | シ    コ ニ {mf} ア | ハ    レ ヲ  ー ブ | ネ        ー {mf} シヨ */
    | 7_ - 7_ 1 - 1 | 2 - 2 7_ - {mf} 5_ | 5 - 4 3 2 1 | 2 - - - - {mf} 5_ |

    /* ================= 第四行 (4 小節, P044.jpg) ================= */
    /* ー    シ ノ    サ | カ  ー ヒ ト    ス | ク    ヒ モ  ー ト | ム        ー    */
    | 3 - 3 2 - 2 | 1 2 3 2 - 5_ | 4 - 4 7_ 1 2 | 1 - - - - 0 |
}

