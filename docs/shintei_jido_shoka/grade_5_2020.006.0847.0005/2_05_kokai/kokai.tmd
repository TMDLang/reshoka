** 航海 **
!= 108
?= F
<3/4>
~ "臺灣教育會公認《新定兒童唱歌》尋常科第五學年用（2020.006.0847.0005）"
~ "葛原齒 作詞"
~ "小松耕輔 作曲"

/* =========================================================================
   原書資訊與歌詞全文（對應 P042.jpg，書頁 p. 19，第二學期第 5 首）：
   調性與拍號：へ長調四分之三拍子（F 大調 3/4 拍）
   作詞：葛原齒　作曲：小松耕輔

   一　港は遙（はる）かに松原も見えず
   マストにうなつて
   風の音（おと）つよし海原（うなばら）とほく
   波路（なみぢ）をこえ行く
   潮吹（しほふ）く鯨（くぢら）を飛魚（とびうを）を友に

   二　朝日に夕日に金色（こんじき）の波を
   月夜にかゞやく
   銀色の波をくだきて進む
   船路（ふなぢ）はおもしろ
   明（あ）けても暮れても水のみを友に
   ========================================================================= */

Kokai:Piano@|0| {
    <8*>
    /* ================= 第一行 (6 小節, P042.jpg) ================= */
    /* ミ      ナ  | ト      ハ  | ハ      ル  | カ      ニ  | マ  ツ  バ  | ラ      モ  */
    | 5_ - - - 5_ - | 1 - - - 1 - | 2 - - - 2 - | 3 - - - 1 - | 3 - 5 - 5 - | 6 - - - 5 - |

    /* ================= 第二行 (6 小節, P042.jpg) ================= */
    /* ミ      エ  | ズ      マ  | ス      ト  | ニ      ウ  | ナ      リ  | テ      カ ゼ ノ */
    | 3 - - - 2 - | 1 - 0 - 5_ - | 1 - - - 2 - | 3 - - - 4 - | 5 - - - 3 - | 2 - - - 3 4 |

    /* ================= 第三行 (5 小節, P042.jpg) ================= */
    /* オ      ト  | ツ      ヨ  | シ      {f} ウ | ナ      バ  | ラ  ト  ホ  */
    | 3 - - - 2 - | 1 - - - 2 - | 3 - - - {f} 1^ - | 7 - - - 5 - | 6 - 5 - 3 - |

    /* ================= 第四行 (6 小節, P042.jpg) ================= */
    /* ク          | ナ      ミ  | ヂ      ヲ  | コ  エ  ユ  | ク          | シ      ホ  */
    | 5 - - - 0 - | 6 - - - 7 - | 1^ - - - 5 - | 4 - 3 - 2 - | 5 - - - 0 - | 3 - - - 1 - |

    /* ================= 第五行 (6 小節, P042.jpg) ================= */
