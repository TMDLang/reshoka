    /* (二): ふ    な あ    し | は    や い       | え    ん や ら    | や       ー       */
    | 6_ - - - 6_ - 2 - - - 2 - | 3 - - - 5 - 3 - - - 0 - | 6_ - - - 6_ - 2 - 3 - 2 - | 6 - - - - - 6 - 0 - 0 - |

    /* ================= 第二行 (4 小節, P073.jpg) ================= */
    /* (一): カ    ツ ヲ    ハ | タ    イ レ ョ ダ | エ ツ    サ ツ    | サ       ー       */
    /* (二): お    し き    れ | こ    ぎ ぬ    け | え つ    さ つ    | さ       ー       */
    | 5 - - - 6 - 5 - - - 3 - | 2 - - - 3 - 5 - 3 - 2 - | 6_ - 6_ - 0 - 3_ - 3_ - 0 - | 3_ - - - - - 3_ - 0 - 0 - |

    /* ================= 第三行 (4 小節, P073.jpg) ================= */
