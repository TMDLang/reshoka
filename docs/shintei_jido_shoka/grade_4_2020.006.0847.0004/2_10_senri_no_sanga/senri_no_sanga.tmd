    | 1 - - 1 1 - 2 - | 3 - 1 2 5_ - - - | 6_ - - 3 2 - 1 - | 2 1 2 3 5 - - - |

    /* ================= 第二行 (4 小節, P046.jpg) ================= */
    /* ハ   ト ウ ー   | バ ン ー リ     | モ   ノ ト モ   | セ ヌ フ ー ネ     */
    | 5 - - 6 5 - 3 - | 3 - 1 2 3 - - - | 6_ - - 6_ 1 - 3 - | 2 1 7_ 2 1 - - - |

    /* ================= 第三行 (4 小節, P046.jpg) ================= */
    /* キ   カ イ ノ   | チ カ ラ       | セ   カ イ ヲ   | チ ヂ メ         */
    | 2 - - 2 3 - 5 - | 6 - 6 - 5 - - - | 6_ - - 1 2 - 5 - | 3 - 3 - 2 - - - |

    /* ================= 第四行 (4 小節, P046.jpg) ================= */
