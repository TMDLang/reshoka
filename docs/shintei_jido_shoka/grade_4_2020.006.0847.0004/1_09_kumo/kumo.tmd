    /* (二): と   り   の   は ー | ね               | う   ー   を   の   | う   ろ   こ   と   | く   さ   ぐ   さ ー */
    | 1 - 2 - 3 - 4 3 | 2 - - - - - 0 - | 3 - 3 - 4 - 3 - | 2 - 5 - 3 - 1 - | 6_ - 7_ - 1 - 3 2 |

    /* ================= 第四行 (5 小節, P032.jpg) ================= */
