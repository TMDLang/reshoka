    /* (二): と   き に ー は   | つ   ら な ー る   | み   ね   と   な   | り               | と   き に ー は   */
    | {mf} 5_ - 1 2 3 2 1 - | 2 - 2 3 4 2 3 - | 5_ - 6_ - 7_ - 1 - | 5_ - - - - - 0 - | 5_ - 1 2 3 2 1 - |

    /* ================= 第二行 (5 小節, P032.jpg) ================= */
    /* (一): ハ   ユ レ ー バ   | ニ     シ キ   ニ   | テ               | ハ   レ   タ   ル ー | ソ       ラ   ノ   */
    /* (二): か   さ な ー る   | な     み と   み   | え               | あ   る   ひ   は ー | け       も   の   */
    | 2 - 2 3 4 2 3 - | 6 - - 5 3 - 2 - | 1 - - - - - 0 - | {f} 5 - 5 - 6 - 5 3 | 4 - - - 3 - 2 - |

    /* ================= 第三行 (5 小節, P032.jpg) ================= */
