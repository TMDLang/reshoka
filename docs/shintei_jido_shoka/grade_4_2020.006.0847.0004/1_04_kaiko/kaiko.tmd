!= 112
?= C
<4/4>
~ "文部省唱歌"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第四學年用（2020.006.0847.0004）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P027.jpg，書頁 p. 4，第一學期第 4 首）：
   調性與拍號：は調四拍子（C 大調 4/4 拍，「優美ニ（♩=112）」，文部省）

   一
   風（かぜ）あたたかき五月（ごぐゎつ）のはじめ
   里（さと）のおとめがとるや羽（は）ばうき
   はきおろしたる春（はる）のかひこ
   さながら黒（くろ）きちりのごとく

   二
   四たびのねむりいつしかすぎて
   はしの太（ふと）さは小（こ）ゆびとなりぬ
   きそひきそひてくははむ音（おと）
   この葉（は）に雨（あめ）のそそぐごとく

   三
   かみもむすばず夜（よる）さへいねず
   心（こゝろ）つくして　一月（ひとつき）あまり
   つとめしかひの見（み）えたる今日（けふ）
   うれしやまゆは山（やま）のごとく
   ========================================================================= */

Kaiko:Piano@|0| {
    <8*>
    /* ================= 第一行 (4 小節, P027.jpg) ================= */
    /* (一): カ   ゼ   ア   タ   | タ     カ キ       | ゴ   グワ ツ ー ノ ー | ハ   ジ   メ       */
    /* (二): よ   た   び   の   | ね     む り       | い   つ   し ー か ー | す   ぎ   て       */
    | {mf} 1 - 1 - 3 - 5 - | 6 - - 5 6 - - - | 5 - 3 - 2 1 2 3 | 2 - 2 - 2 - 0 - |

    /* ================= 第二行 (4 小節, P027.jpg) ================= */
    /* (一): サ   ト   ノ   オ   | ト     メ ガ       | ト   ル   ヤ     ハ | バ   ウ   キ       */
    /* (二): は   し   の   ふ   | と     さ は       | こ   ゆ   び     と | な   り   ぬ       */
    | 1 - 1 - 3 - 5 - | 6 - - 1^ 6 - - - | 5 - 3 - 2 - - 3 | 1 - 1 - 1 - 0 - |

    /* ================= 第三行 (4 小節, P027.jpg) ================= */
    /* (一): ハ   キ   オ   ロ ー | シ   タ ー ル       | ハ       ル   ノ   | カ   ヒ   コ       */
    /* (二): き   そ   ひ   き ー | そ   ひ ー て       | く       は   は   | む   お   と       */
    | {f} 5 - 5 - 5 - 1^ 7 | 6 - 6 6 5 - - - | 6 - - - 1^ - 6 - | 5 - 5 - 5 - 0 - |

    /* ================= 第四行 (4 小節, P027.jpg) ================= */
    /* (一): サ   ナ ー ガ   ラ   | ク   ロ ー キ       | チ     ー リ   ノ ー | ゴ   ト   ク       */
    /* (二): こ   の ー は   に   | あ   め ー の       | そ     ー そ   ぐ ー | ご   と   く       */
    | {mf} 3 - 3 3 2 - 3 - | 5 - 6 1^ 2^ - - - | 3 - - 5 2 - 3 2 | 1 - 1 - 1 - 0 - |
}

