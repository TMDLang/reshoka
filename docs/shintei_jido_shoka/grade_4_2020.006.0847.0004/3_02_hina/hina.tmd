/* =========================================================================
   原書資訊與歌詞全文（對應 P050.jpg，書頁 p. 27，第三學期第 2 首）：
   調性與拍號：は調二拍子（C 大調 2/4 拍）
   速度指示：爽快ニ稍早ク
   出處註記：（西洋曲）

   一
   コケ　ココ　ココ
   コッケッコ　コッケッコ　東がしらむ
   コッケッコ　コッケッコ　夜があけた
   ねぐらをいでゝ朝餌（あさげ）のしたく
   コッケッコ　コッケッコ　いそがしや

   二
   コケ　ココ　ココ
   コッケッコ　コッケッコ　朝日がのぼる
   コッケッコ　コッケッコ　皆起きた
   太郎さん次郎さん學校のしたく
   コッケッコ　コッケッコ　おくれるな
   ========================================================================= */

Hina:Piano@|0| {
    <16*>
    /* ================= 第一行 (5 小節, P050.jpg) ================= */
    /* (一): コケ ココ ココ     | コッ ケッ     コ | コッ ケッ     コ | ヒ ガ シ ガ     | シ ラ ム         */
    /* (二): こけ ここ ここ     | こっ けっ     こ | こっ けっ     こ | あ さ ひ が     | の ぼ る         */
    | {mf} 5 - 5 5 0 - - - | {f} 1^ - 3^ - - - 1^ - | 5 - 1^ - - - 5 - | 4 - 4 - 3 - 3 - | 2 - 2 - 5 - - - |

    /* ================= 第二行 (4 小節, P050.jpg) ================= */
    /* (一): コッ ケッ     コ | コッ ケッ     コ | ヨ ガ ア ケ     | タ               */
    /* (二): こっ けっ     こ | こっ けっ     こ | み な お き     | た               */
    | {f} 6 - 1^ - - - 6 - | 5 - 1^ - - - 5 - | {mf} 4 - 3 - 2 - 5 - | 1 - - - 0 - - - |

    /* ================= 第三行 (4 小節, P050.jpg) ================= */
    /* (一): ネ グ ラ ヲ     | イ デ テ         | ア サ ゲ ノ     | シ タ ク         */
    /* (二): た ろ さ ん     | じ ろ さん       | がっ こ の      | し た く         */
    | {mf} 4 - 4 - 3 - 3 - | 2 - 2 - 5 - - - | 1^ - 7 - 6 - 5 - | 4 - 2 - 5 - - - |

    /* ================= 第四行 (4 小節, P050.jpg) ================= */
    /* (一): コッ ケッ     コ | コッ ケッ     コ | イ ソ ガ シ     | ヤ               */
    /* (二): こっ けっ     こ | こっ けっ     こ | お く れ る     | な               */
    | {f} 6 - 1^ - - - 6 - | 5 - 3^ - - - 5 - | {mf} 4 - 3 - 2 - 5 - | 1 - - - 0 - - - |
