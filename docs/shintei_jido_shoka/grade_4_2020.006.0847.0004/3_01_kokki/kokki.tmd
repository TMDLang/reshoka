    /* (三):                 ミ ク | ニ         ノ タ ミ | ノ       ス       メ       | ル         カ ド ゴ | ト               イ ハ | ヒ         カ カ グ */
    | 0 - - - 0 - - - 5_ - 5_ - | 1 - - - - - 2 - 1 - 2 - | 3 - - - 5 - - - 6 - - - | 5 - - - - - 3 - 2 - 1 - | 2 - - - - - - - 5_ - 5_ - | 1 - - - - - 2 - 1 - 2 - |

    /* ================= 第二行 (6 小節, P048.jpg) ================= */
