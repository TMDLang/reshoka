    /* (二): ぞ               わ れ | ら       の       こ っ | き               な       | る               ひ   ら | め       け       ひ   ら */
    | 5 - - - 0 - - - 6 - 6 - | 5 - - - 3 - - - 1 - 1 - | 2 - - - - - - - 4' - - - | 5 - - - - - - - 5 - - 5 | 6 - - - 5 - - - 3 - - 3 |

