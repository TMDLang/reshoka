    /* (二): の       ひ       の       | ま         る の は | た               こ   れ | ぞ               こ   れ | ぞ               に っ | ぽ ん の       こ れ */
    | 3 - - - 5 - - - 6 - - - | 5 - - - - - 3 - 1 - 2 - | 1 - - - - - - - 2 - - 2 | 2 - - - 0 - - - 3 - - 3 | 3 - - - 0 - - - 4 - 4 - | 3 - 2 - 1 - - - 5 - 5 - |

