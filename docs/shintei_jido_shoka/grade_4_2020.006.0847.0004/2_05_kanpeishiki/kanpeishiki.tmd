::SCORE::
** 觀兵式 **
!= 100
?= G
<2/4>
~ "詞：小田深藏"
~ "曲：小山作之助"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第四學年用（2020.006.0847.0004）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P040.jpg，書頁 p. 17，第二學期第 5 首）：
   調性與拍號：標題註記「と調四拍子」，譜面拍號為 2/4 拍（G 大調 2/4 拍）
   速度指示：元氣ヨク（♩=100）

   列（なら）べるほづゝは　林（はやし）なし
   つらなるつるぎは　霜寒（しもさむ）し
   隊伍（たいご）正しき　あなたより
   ふりさけ見（み）れば　大君（おほぎみ）の
   錦（にしき）のみはた　まばゆくも
   吹（ふ）きひるがへす　朝風（あさかぜ）に
   いなゝく馬（うま）ぞ　勇（いさ）ましき
   ========================================================================= */

Kanpeishiki:Piano@|0| {
    <16*>
    /* ================= 第一行 (6 小節, P040.jpg) ================= */
    /* ナ ラ ベ ル | ホ ヅ ツ ハ | ハ ヤ シ ナ | シ       | ツ ラ ナ ル | ツ ル ギ ハ */
    | 5_ - 1 - 1 - 2 - | 3 - 2 - 1 - 6_ - | 5_ - 1 - 2 - 3 - | 2 - - - - - 0 - | 3 - 5 - 5 - 3 - | 6 - 5 - 3 - 5 - |

    /* ================= 第二行 (7 小節, P040.jpg) ================= */
    /* シ モ サ ム | シ       | タ       | イ   ゴ   | タ ダ シ キ | ア ナ タ ヨ | リ       */
    | 2 - 3 - 2 - 6_ - | 1 - - - - - 0 - | {f} 3 - - - - - - - | 3 - - - 4 - - - | 5 - 5 - 6 - 5 - | 5 - 3 - 5 - 3 - | 2 - - - - - 0 - |

    /* ================= 第三行 (6 小節, P040.jpg) ================= */
    /* フ リ サ ケ | ミ   レ バ | オ ホ ギ ミ | ノ       | ニ シ キ ノ | ミ   ハ タ */
    | {p} 2 - 2 - 1 - 2 - | 3 - 2 - 1 - 6_ - | 1 - 2 - 2 - 3 - | 2 - - - - - 0 - | {f} 5 - 5 - 5 - 5 - | 6 - - - 5 - 3 - |

    /* ================= 第四行 (6 小節, P040.jpg) ================= */
    /* マ バ ユ ク | モ       | フ キ ヒ ル | ガ ヘ ス   | ア サ カ ゼ | ニ       */
    | 5 - 3 - 2 - 1 - | 6_ - - - - - 0 - | 5_ - 5_ - 6_ - 5_ - | 1 - 1 - 2 - - - | 2 - 2 - 1 - 2 - | 3 - - - - - 0 - |

    /* ================= 第五行 (5 小節, P040.jpg) ================= */
    /* イ ナ ナ ク | ウ マ ゾ   | イ     サー | マ     シ | キ       */
    | 3 - 5 - 5 - 3 - | 2 - 1 - 2 - - - | 5 - - - - - 6 5 | 3 - - - - - 2 - | 1 - - - - - 0 - |
}

