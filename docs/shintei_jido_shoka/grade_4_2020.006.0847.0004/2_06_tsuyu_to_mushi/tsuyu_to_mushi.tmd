::SCORE::
** つゆと虫 **
!= 96
?= E,
<6/8>
~ "臺灣教育會公認《新定兒童唱歌》尋常科第四學年用（2020.006.0847.0004）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P041.jpg，書頁 p. 18，第二學期第 6 首）：
   調性與拍號：變ほ調六拍子（Eb 大調 6/8 拍）
   速度指示：優美ニ

   一
   つゆが散（ち）る　つゆが散る
   月（つき）の光（ひかり）のてる庭（には）に
   きらきらきらと露（つゆ）が散る
   さやさやゆれる葉（は）かげでは
   露の散るのがうれしいか
   ころころころと虫（むし）が鳴（な）く

   二
   虫がなく　虫が鳴く
   月の光のてる庭に
   ころころころと虫が鳴く
   さやさやゆれる葉末（はずゑ）から
   虫の鳴くのがうれしいか
   きらきらきらと露が散る
   ========================================================================= */

TsuyuToMushi:Piano@|0| {
    <8*>
    /* ================= 第一段前半 (8 小節，含一房結尾, P041.jpg) ================= */
    /* ツ   ユ ガ   チ | ル         | ツ   ユ ガ   チ | ル         */
    | 5 - 5 6 - 6 | 5 - - - - 0 | 5 - 5 3 - 5 | 2 - - - - 0 |
    /* ツ   キ ノ   ヒ | カ   リ ノ   | テ   ル ニ   ハ | ニ         */
    | 3 - 3 5 - 5 | 6 - 6 5 - - | 3 - 5 6 - 5 | 2 - - - - 0 |
    /* キ ラ   キ ラ   | キ   ラ ト   | (1.) ツ ユ ガ チ | ル       */
    | 3 5 0 3 5 0 | 6 - 6 5 - - | 3 - 3 2 - 2 | 1 - - - - 0 |

    /* ================= 第一段後半 (8 小節，反覆後進入二房結尾, P041.jpg) ================= */
    /* さ   や さ   や | ゆ   れ る   | は   か げ   で | は         */
    | 5 - 5 6 - 6 | 5 - 5 5 - 0 | 5 - 5 3 - 5 | 2 - - - - 0 |
    /* つ   ゆ の   ち | る   の が   | う   れ し   い | か         */
    | 3 - 3 5 - 5 | 6 - 6 5 - - | 3 - 5 6 - 5 | 2 - - - - 0 |
    /* こ ろ   こ ろ   | こ   ろ と   | (2.) む し が な | く       */
    | 3 5 0 3 5 0 | 6 - 6 5 - - | 3 - 5 2 - 3 | 1 - - - - 0 |
}

