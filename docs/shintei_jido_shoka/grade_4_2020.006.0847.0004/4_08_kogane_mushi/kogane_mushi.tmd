?= F
<2/4>
~ "詞：西條八十"
~ "曲：室崎琴月"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第四學年用（2020.006.0847.0004）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P065.jpg，書頁 p. 42，參考教材第 8 首）：
   調性與拍號：へ調二拍子（F 大調，主段 2/4 拍，中段轉 4/4 拍，末段 D.C. 返始至 Fine）

   あつちへ行（い）つちやパツタパタ
   こつちへ行つちやパツタパタ
   ガラスたゝきの黃金虫（こがねむし）
   お前（まへ）はお家（うち）を忘（わす）れたか
   それとも遊（あそ）んで夜（よ）がふけて
   母（かあ）さんがお家（うち）へ入（い）れないか
   おもては小雨（こさめ）がふつてるに
   どこでも靜（しづ）かにねてゐるに
   あつちへ行つちやパツタパタ
   こつちへ行つちやパツタパタ
   ガラスたゝきの黃金虫
   ========================================================================= */

KoganeMushi:Piano@|0| {
    <16*>
    /* ================= 第一段（2/4 拍，8 小節，P065.jpg） ================= */
    /* アッ チ ヘ イッ チャ | パッ タ パ タ 0 | コッ チ ヘ イッ チャ | パッ タ パ タ 0 */
    | 3 - 3 3 2 - 1 - | 2 2 1 - 3 - 0 - | 2 - 2 2 1 - 6_ - | 6_ 6_ 1 - 6_ - 0 - |
    /* ガ ー ラ ス | タ タ キ ノ | コ ガ ネ ム | シ ー ー 0 */
    | 5_ - - 6_ 1 - 1 - | 2 - 2 - 3 - 5 - | 6 - 6 - 5 - 3 - | 1 - - - - - 0 - |

    /* ================= 第二段（轉 4/4 拍，反覆兩次，每次 8 小節，P065.jpg） ================= */
    {<4/4>}
    /* 第一次: オ ー マ ヘ ハ | オ ー ウ チ ヲ | ワ ス レ タ | カ ー ー 0 */
    | 3 - - - - - 3 - 3 - - - 3 - - - | 5 - - - - - 6 - 5 - - - 3 - - - | 2 - - - 2 - - - 3 - - - 2 - - - | 3 - - - - - - - - - - - 0 - - - |
    /* 第一次: ソ ー レ ト モ | ア ー ソ ン デ | ヨ ー ガ フ ケ | テ ー ー 0 */
    | 1 - - - - - 1 - 1 - - - 1 - - - | 2 - - - - - 3 - 2 - - - 1 - - - | 6_ - - - - - 6_ - 1 - - - 2 - - - | 3 - - - - - - - - - - - 0 - - - |

    /* 第二次: か ー あ さん が | お ー う ち へ | い れ な い | か ー ー 0 */
    | 3 - - - - - 3 - 3 - - - 3 - - - | 5 - - - - - 6 - 5 - - - 3 - - - | 2 - - - 2 - - - 3 - - - 2 - - - | 3 - - - - - - - - - - - 0 - - - |
    /* 第二次: お ー も て は | こ ー さ め が | ふ つ ー て る | に ー ー 0 */
    | 1 - - - - - 1 - 1 - - - 1 - - - | 2 - - - - - 3 - 2 - - - 1 - - - | 6_ - - - - - 6_ - 1 - - - 2 - - - | 3 - - - - - - - - - - - 0 - - - |

    /* ================= 第三段（4/4 拍，4 小節，P065.jpg） ================= */
    /* ド ー コ デ モ | シ ヅ ー カ ニ | ネ テ ー ヰ ル | ニ ー ー 0 */
    | 1 - - - - - 1 - 1 - - - 1 - - - | 2 - - - 3 - 5 - 6 - - - 5 - - - | 3 - - - 2 - 3 - 2 - - - 1 - - - | 6_ - - - - - - - - - - - 0 - - - |

    /* ================= D.C. 返始段（回 2/4 拍，8 小節，P065.jpg） ================= */
    {<2/4>}
    /* あっ ち へ いっ ちゃ | ぱっ た ぱ た 0 | こっ ち へ いっ ちゃ | ぱっ た ぱ た 0 */
    | 3 - 3 3 2 - 1 - | 2 2 1 - 3 - 0 - | 2 - 2 2 1 - 6_ - | 6_ 6_ 1 - 6_ - 0 - |
    /* が ー ら す | た た き の | こ が ね む | し ー ー 0 */
    | 5_ - - 6_ 1 - 1 - | 2 - 2 - 3 - 5 - | 6 - 6 - 5 - 3 - | 1 - - - - - 0 - |
}

