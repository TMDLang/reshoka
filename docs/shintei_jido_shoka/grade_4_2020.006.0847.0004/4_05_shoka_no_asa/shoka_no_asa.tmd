::SCORE::
** 初夏の朝 **
!= 96
?= C
<3/4>
~ "詞：水田月人"
~ "曲：佐々木英"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第四學年用（2020.006.0847.0004）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P062.jpg，書頁 p. 39，參考教材第 5 首）：
   調性與拍號：は調三拍子（C 大調 3/4 拍）

   一
   夢（ゆめ）の如（ごと）く　あはく
   さぎり（に）　ねむれる
   初夏（はつなつ）の　あしたの
   けはひぞ　しづけき

   二
   木々（きゞ）の葉（は）の　みどり
   ひとしほ　さやけき
   初夏の　あしたの
   けしきぞ　ゆかしき
   ========================================================================= */

ShokaNoAsa:Piano@|0| {
    <8*>
    /* ================= 第一行 (5 小節, P062.jpg) ================= */
    /* (一): ユ メ ノ | ゴ ト ク | ア ー ハ | ク ー 0 | サ ー ー */
    /* (二): き ー ぎ | の は の | み ー ど | り ー 0 | ひ ー ー */
    | 5 - 6 - 7 - | 1^ - - 7 6 - | 5 - 6 - 4 - | 3 - - - 0 - | 5 - 1^ - 2^ - |

    /* ================= 第二行 (5 小節, P062.jpg) ================= */
    /* (一): ギ リ ニ | ネ ム レ | ル ー 0 | ハ ツ ナ | ツ ー ノ */
    /* (二): と し ほ | さ や け | き ー 0 | は つ な | つ ー の */
    | 3^ - - 2^ 1^ - | 2^ - 1^ - 7 - | 1^ - - - 0 - | 2 - 3 - 4 - | 3 - - 5 5 - |

    /* ================= 第三行 (6 小節, P062.jpg) ================= */
    /* (一): ア シ タ | ノ ー 0 | ケ ー ー | ハ ヒ ゾ | シ ヅ ケ | キ ー 0 */
    /* (二): あ し た | の ー 0 | け ー ー | し き ぞ | ゆ か し | き ー 0 */
    | 2 - 3 - 4 - | 5 - - - 0 - | 5 - 1^ - 2^ - | 3^ - - 2^ 1^ - | 2^ - 1^ - 7 - | 1^ - - - 0 - |
}

