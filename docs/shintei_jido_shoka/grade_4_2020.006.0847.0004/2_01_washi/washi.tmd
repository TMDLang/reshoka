::SCORE::
** 鷲 **
!= 96
?= G
<3/4>
~ "詞：葛原齒"
~ "曲：小松耕輔"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第四學年用（2020.006.0847.0004）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P034.jpg–P035.jpg，書頁 pp. 11–12，第二學期第 1 首）：
   調性與拍號：と調三拍子（G 大調 3/4 拍）
   速度指示：勇壯ニ（♩=96）

   怒（いか）れる肩（かた）の　その力
   落（お）ち着（つ）き拂（はら）ひし　眼（め）の光（ひかり）
   曲（まが）れる嘴（くちばし）　焦（こ）げ茶（ちゃ）の羽色（はいろ）
   羽根（はね）さへ　尾（を）さへ　飽（あ）くまで頑丈（がんぢゃう）
   一分（いちぶ）の隙（すき）の　あらばこそ
   五體（ごたい）に滿（み）ちたる　その力
   鳥（とり）の王（わう）　鳥の王
   ========================================================================= */

Washi:Piano@|0| {
    <16*>
    /* ================= 第一行 (4 小節, P034.jpg) ================= */
    /* い   かれ  る       | か   たの  そ       | の           ち   か | ら                   */
    | 5_ - - 5_ 1 - - - 2 - - - | 3 - - 2 3 - - - 3 - - - | 5 - - - - - - - 3 - - 2 | 2 - - - - - - - 0 - - - |

    /* ================= 第二行 (4 小節, P034.jpg) ================= */
    /* お   ちつ  き       | は   らひ  し       | め         の ひ  か | り                   */
    | 5_ - - 5_ 1 - - - 2 - - - | 3 - - 2 3 - - - 3 - - - | 5 - - - - - 5 - 3 - - 2 | 1 - - - - - - - 0 - - - |

    /* ================= 第三行 (4 小節, P034.jpg) ================= */
    /* ま   がれ  る       | く   ちば  し       | こ   げ ちゃ       の | は   い ろ           */
    | 2 - - 2 2 - - - 5_ - - - | 1 - - 2 3 - - - 3 - - - | 4 - - 3 2 - - - - - 2 - | 2 - - 3 4 - - - - - - - |

    /* ================= 第四行 (4 小節, P034.jpg) ================= */
    /* は   ね さ     へ   | を   さ へ          | あ   く ま     で   | が   ん ぢゃう        */
    | 5 - - 5 5 - - - 3 - - - | 2 - - 3 1 - - - - - - - | 2 - - 2 2 - - - 6_ - - - | 1 - - 7_ 1 - - - - - - - |

    /* ================= 第五行 (4 小節, P034.jpg) ================= */
    /* い   ち ぶ     の   | す   き の          | あ   ら ば     こ   | そ                   */
    | 2 - - 2 1 - - - 5_ - - - | 1 - - 2 3 - - - - - - - | 4 - - 2 1 - - - 7_ - - - | 2 - - - - - - - 0 - - - |

    /* ================= 第六行 (4 小節, P034.jpg) ================= */
    /* ご   た い     に   | み   ち た     る   | そ   の ち     か   | ら                   */
    | 5 - - 5 6 - - - 5 - - - | 3 - - 2 1 - - - 6_ - - - | 5_ - - 5_ 1 - - - 2 - - - | 1 - - - - - - - 0 - - - |

    /* ================= 第七行 (4 小節, P035.jpg) ================= */
    /* と   り の          | わ   ー う          | と   り の          | わ   ー う          */
    | 6_ - - 6_ 5 - - - - - - - | 3 - - 2 1 - - - - - - - | 5_ - - 5_ 2 - - - - - - - | 3 - - 2 1 - - - - - - - |
}

