    /* (二): あ れ か く れ ゆ く | ま つ ば ら は ー | 0 み ほ の は まー べー かー */
    | 3 - 4 - 3 - - - 2 - 1 - 7_ - 6_ - | 7_ - 1 - 2 - 7_ - 3 - - - - - - - | 0 - 3 - 4 - 3 - 6 - 7 6 4 3 2 - |

    /* ================= 第二行 (3 小節, P061.jpg) ================= */
    /* (一): カ ー ヘ リ ユ ー ク ー | 0 カ ゼ ニ タ モ ト ガ | 0 ヒ ラ ヒ ラ ー ト ー */
    /* (二): な ー つ か し ー や ー | 0 は ま の れ ふ し は | 0 や す ら か ー に ー */
    | 1 - - - 7_ - 6_ - 3 - - - 3 - - - | 0 - 6_ - 3 - 3 - 3 - - 4 3 - 2 - | 0 - 6_ - 2 - 2 - 3 - - - 3 - - - |

    /* ================= 第三行 (3 小節, P061.jpg) ================= */
