    /* (二): 0 さ か え さ かー え よ | 0 い つ ま で ー も ー | に つ ぽ ん いー ー ち のー */
    | 0 - 3 - 4 - 3 - 6 - 7 6 3 - 4 - | 0 - 6 - 7 - 6 - 3 - - - 6 - - - | 3^ - 2^ - 1^ - 6 - 7 6 3 - 4 3 2 - |

