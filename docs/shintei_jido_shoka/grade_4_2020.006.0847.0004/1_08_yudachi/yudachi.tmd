!= 120
?= D
<2/4>
~ "臺灣教育會公認《新定兒童唱歌》尋常科第四學年用（2020.006.0847.0004）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P031.jpg，書頁 p. 8，第一學期第 8 首）：
   調性與拍號：に調二拍子（D 大調 2/4 拍，♩=120）

   一
   あちらの山（やま）に黒雲（くろくも）おこり
   ひらめくいなづまぴか／＼／＼
   鳴（な）り出（だ）すかみなりごろ／＼／＼
   見（み）る間（ま）に空（そら）はくらくなる

   二
   かけゆく人（ひと）のあとおつかけて
   吹（ふ）き來（く）るかざ音（おと）さつ／＼／＼
   降（ふ）りだす夕立（ゆふだち）ばら／＼／＼
   見る間に庭（には）は池（いけ）となる

   三
   かみなりやんで雨風（あめかぜ）はれて
   落（お）ち來る白（しら）つゆはら／＼／＼
   鳴（な）き出（だ）す夕（ゆふ）ぜみじい／＼／＼
   見る間に虹（にじ）は消（き）えて行（ゆ）く
   ========================================================================= */

Yudachi:Piano@|0| {
    <16*>
    /* ================= 第一行 (4 小節, P031.jpg) ================= */
    /* (一): ア   チ   ラ   ノ   | ヤ   マ ニ       | ク   ロ ク   モ   | オ   コ   リ       */
    /* (二): か   け   ゆ   く   | ひ   と の       | あ   と お   つ   | か   け   て       */
    | 1 - 3 - 5 - 1^ - | 6 - - 5 5 - - - | 4 - - 4 3 - 4 - | 2 - 3 - 1 - - - |

    /* ================= 第二行 (4 小節, P031.jpg) ================= */
    /* (一): ヒ   ラ メ   ク   | イ   ナ ヅ   マ   | ピ カ     ピ カ     | ピ   カ           */
    /* (二): ふ   き く   る   | か   ざ お   と   | さ ーっ   さ ーっ   | さ   ーっ         */
    | 3 - - 5 1^ - 7 - | 6 - - 7 1^ - 6 - | 5 6 0 - 5 6 0 - | 5 - 1^ - - - 0 - |

    /* ================= 第三行 (4 小節, P031.jpg) ================= */
    /* (一): ナ   リ ダ   ス   | カ   ミ ナ   リ   | ゴ ロ     ゴ ロ     | ゴ   ロ           */
    /* (二): ふ   り だ   す   | ゆ   ふ だ   ち   | ば ら     ば ら     | ば   ら           */
    | 1^ - - 3^ 1^ - 5 - | 6 - - 4 5 - 3 - | 2 3 0 - 4 5 0 - | 2 - 5 - - - 0 - |

    /* ================= 第四行 (4 小節, P031.jpg) ================= */
    /* (一): ミ   ル マ   ニ   | ソ   ラ ハ       | ク   ラ ク   ナ   | ル               */
    /* (二): み   る ま   に   | に   は は       | い   け と   な   | る               */
    | 5 - - 6 5 - 3 - | 1 - - 2 3 - - - | 2 - - 3 4 - 2 - | 1 - - - - - 0 - |
}

