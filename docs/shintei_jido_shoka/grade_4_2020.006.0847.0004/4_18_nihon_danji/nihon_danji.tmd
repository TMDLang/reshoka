::SCORE::
** 日本男兒 **
!= 104
?= F
<4/4>
~ "曲：小山作之助／詞：東宮鐵眞呂"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第四學年用（2020.006.0847.0004）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P077.jpg，書頁 p. 54，參考教材第 18 首）：
   調性與拍號：へ四調四拍子（F 大調 4/4 拍，原書誤植「へ調」為「へ四調」）
   速度指示：活潑ニ（♩=104）

   我が君（きみ）の爲（ため）には
     身（み）をも捨（す）てゝ勉（つと）め
   我が國（くに）の爲には
     家（いへ）も棄（す）てゝ勵（はげ）み
   雨（あめ）・霰（あられ）降（ふ）り來（く）る
     たまのなかを犯（おか）し
   稻妻（いなづま）の煌（きら）めく
     太刀（たち）のもとも怖（お）ぢず
   ますらたけをこれぞ
     これぞますらたけを
   日本男兒（につぽんだんじ）これぞ
     これぞ日本男兒
   ========================================================================= */

NihonDanji:Piano@|0| {
    <16*>
    /* 1. ワ ガ キ ミ ノ | タ メ ニ ハ | ミ ヲ モ ス テ テ | ツ ト メ (1.) */
    | {mf} 5_ - - - 5_ - - 6_ 1 - - - 2 - - - | 3 - - - 5 - - 6 5 - - - - - - - |
    | 6 - - 5 3 - - 5 2 - - - 1 - - 2 | 3 - - - 2 - - - 5_ - - - - - - - |
    /* 2. ワ ガ ク ニ ノ | タ メ ニ ハ | イ ヘ モ ス テ テ | ハ ゲ ミ (2.) */
    | 5_ - - - 5_ - - 6_ 1 - - - 2 - - - | 3 - - - 5 - - 6 5 - - - - - - - |
    | 6 - - 5 3 - - 5 2 - - - 1 - - 2 | 2 - - - 3 - - - 1 - - - - - - - |

    /* ア メ ア ラ レ | フ リ ク ル | タ マ ノ ナ カ ヲ | オ カ シ */
    | 5 - - - 3 - - - (2 3 2)%(- - - -) 1 - - - | 6_ - - - 1 - - 2 1 - - - 5_ - - - |
    | 6_ - - - 1 - - 1 2 - - - 5 - - 3 | 2 - - - 5 - - - 5 - - - - - - - |

    /* イ ナ ヅ マ ノ | キ ラ メ ク | タ チ ノ モ ト モ | オ ヂ ズ */
    | 6 - - - 6 - - 6 5 - - - 3 - - - | 2 - - - 3 - - 2 1 - - - - - - - |
    | 6_ - - - 6_ - - 6_ 5_ - - - 1 - - 2 | 3 - - - 2 - - - 1 - - - - - - - |

    /* 1. マ ス ラ タ ケ ヲ | コ レ ゾ | コ レ ゾ マ ス ラ | タ ケ ヲ (1.) */
    | {f} 6 - - 6 3 - - 5 6 - - 5 3 - - - | 5 - - - 6 - - - 5 - - - - - - - |
    | 3 - - 2 1 - - - 2 - - 3 5 - - 3 | 2 - - - 3 - - - 5 - - - - - - - |
    /* 2. ニ ツ ポ ン ダ ン ジ | コ レ ゾ | コ レ ゾ ニ ツ ポ ン | ダ ン ジ (2.) */
    | 6 - - 6 3 - - 5 6 - - 5 3 - - - | 5 - - - 6 - - - 5 - - - - - - - |
    | 3 - - 2 1 - - - 2 - - 3 5 - - 3 | 2 - - - 3 - - - 1 - - - - - - - |
}

