    | 0 0 0 2 |
    | (2 -- 3)%(--) 4 6 | (5 -- 5)%(--) 3 5 |
    | (1^ -- 1^)%(--) 7 6 | 5 - 3 5 |
    | 1^ - 7 6 | (5 --6)%(--) 3 5 |
    | 5 - 6 7 | 1^ - 0 0 |
}

