    | 2 - - 3 2 - 1 - | 2 - - 6 5 - 6 - | 5 - - 6 5 - 4' - | 5 - - - - - 0 - |

    /* ================= 第三行 (4 小節, P010.jpg) ================= */
    | 2 - - 2 4 - 2 - | 3 - - 5 6 - 6 - | 6 - - 7 6 - 4 - | 5 - - - 3 - 5 - |

    /* ================= 第四行 (4 小節, P010.jpg) ================= */
