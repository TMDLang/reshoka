** チンコロヘイタイ（ピアノ伴奏付） **
!= 108
?= C
<2/4>
~ "曲：草川信"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第一學年用（2020.006.0847.0001）"

A:PianoRH@|0| {
    <16*>
    | 5 - 5 - 5 - 3 - | 5 - 5 - 5 - 3 - | 5 - 5 - 5 - 6 - | 5 - - - - - 0 - |
    | 6 - 6 - 6 - 5 - | 1^ - 1^ - 1^ - 6 - | 5 - 5 - 5 - 6 - | 5 - - - - - 0 - |
}

A:PianoLH@|0| {
    <8*>
    | [1] - [1] - | [1] - [1] - | [1] - [4] - | [1] - - 0 |
    | [4] - [1] - | [1] - [4] - | [1] - [4] - | [1] - - 0 |
}

B:PianoRH@|0| {
    <16*>
    | 3 - 3 - 3 - 2 - | 5 - 5 - 5 - 3 - | 2 - 2 - 2 - 1 - | 2 - - - - - 0 - |
    | 3 - 3 - 3 - 2 - | 5 - 5 - 5 - 3 - | 2 - 2 - 2 - 3 - | 1 - - - - - 0 - |
}

B:PianoLH@|0| {
    <8*>
    | [1] - [5_] - | [1] - [1] - | [5_] - [1] - | [5_] - - 0 |
    | [1] - [5_] - | [1] - [1] - | [5_] - [5_] - | [1] - - 0 |
}

-> A -> B -> A -> B -> A -> B -> A -> B -> A -> #

