    L2| し - - - - - ち - さ - - い の - - - |
    L3| ゆ - - - - - く - み - - ち は - - - |
    L4| べ - - - - - に - は - - ゆ る - - - |

    /* m.18（原譜第 4 拍 1 上方印有 f 而漏印高音點，依下小節 3^ 進行校訂為 1^） */
