    L3| む - - - - - - - け - ふ - - - か - |
    L4| せ - - - - - - - い - こ - - - う - |

    /* m.4 */
    | 1^ - 6 - 5 - 3 - 6 - - - 5 - - 3 |
    L1| さ - と - し - の - ひ - - - か - - り |
    L2| ぎ - を - な - げ - き - - - て - - は |
