    <8*>
    {<2/4>}
    {!= 58}
    /* ジュ ー ゴ ヤ | オ ツキ サ マ | ミ テ ハ ネ (rit.) | ル */
    | 6 7 1^ 1^ | 7 6 4 3 | 6 4 3 2 | 3 - - 0 |
