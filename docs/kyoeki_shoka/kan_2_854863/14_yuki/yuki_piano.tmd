::SCORE::
** 雪（鋼琴伴奏版） **
!= 160
?= G
<4/4>
~ "出處：共益商社樂器店《唱歌教科書 教師用 巻二》第三十～三十一頁（第十四曲）"
~ "NDL Digital Collections PID 854863（https://dl.ndl.go.jp/pid/854863）掃描 P021.jpg"

YukiA:PianoRH@|0| {
<16*>
    {<4/4>}
    {!= 160}
    {mf}
    /* シ ロ ガ ネ ノ | ウー テー ナ | シ ロ ガ ネ ノ | クー サー キ */
    | 5_ - - - 1 - - 3 5 - - - 6 - - - | 5 - 6 - 5 - 4 - 3 - - - - - - - | 1 - - - 3 - - 3 2 - - - 5_ - - - | 1 - 2 - 3 - 4 - 5 - - - - - - - |
    /* イ チ ヤー ニー | ナ レ ル | コ ノ ギ ン | セー カー イ */
    | 6 - - - 6 - - - 5 - 4 - 3 - 2 - | 1 - - - - - 3 - 2 - - - - - - - | 1 - - - 3 - - - 5 - - - - - 6 - | 5 - 4 - 3 - 2 - 1 - - - - - - - |
    {f}
    /* オ モ シ ロ ヤ | ニー ハー ノ | ユー キ ノ | ケ シ キ */
    | 5_ - - - 1 - - 3 5 - - - 6 - - - | 5 - 6 - 5 - 4 - 3 - - - - - - - | 1 - - - 3 - - - 2 - - - - - 5_ - | 3 - - - - - 2 - 1 - - - - - - - |
}

YukiA:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 1_ [1] 4_ [4] |
    | 4_ [4] 4_ [4] | | 1_ [1] 5__ [5_] |
    | 5__ [5_] 4_ [4] | | 4_ [4] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 4_ [4] |
    | 4_ [4] 5__ [5_] | | 1_ [1] 4_ [4] |
    | 4_ [4] 4_ [4] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ 0 |
}

YukiB:PianoRH@|0| {
<16*>
    {<2/4>}
    /* マ タ モ | フ リ キ ヌ | ア レ | チ ラ チ ラ (rit.) | チ | ラ (fermata) */
    | 5_ - - - 1 - - 3 | 5 - - 5 5 - 5 - | 6 - - - 5 - - - | 4 - 3 - 2 - 1 - | 2 - - - - - - - | 5 - - - - - - - |
}

YukiB:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 1_ [1] 1_ [1] |
    | 1_ [1] 1_ [1] | | 4_ [4] 1_ [1] |
    | 4_ [4] 5__ [5_] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 1_ 0 |
}

