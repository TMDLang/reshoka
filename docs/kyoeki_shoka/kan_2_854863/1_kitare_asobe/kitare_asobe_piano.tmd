Kitare:PianoRH@|0| {
<16*>
    {mf}
    /* キ ー タ レ ア ソ ベ | ワ レ ラ ガ ト モ ヨ | ノ ド ケ キ ハ ル ノ | コ ノ ノ ベ ニ */
    | 1 - - 1 1 - - 2 3 - - 3 3 - - - | 1 - - 2 3 - - 4 5 - - 6 5 - - - | 1^ - - 1^ 7 - - 6 5 - - 6 5 - - - | 6 - - 6 5 - - 5 1 - - - - - - - |
    /* シ キ ツ メ | タ ー ル | ハ ー ナ ー ノ ー | モ ー フ */
    | 1^ - - - - - 1^ - 7 - - - 6 - - - | 5 - - - 6 - - - 5 - - - - - - - | 6 - - - - - 6 - 5 - 4 - 3 - 2 - | 1 - - - 2 - - - 3 - - - - - - - |
    /* オ リ イ ダ | セ ー ル | ク ー サ ー ノ ー | モ ヨ ー */
    | 1^ - - - - - 1^ - 7 - - - 6 - - - | 5 - - - 6 - - - 5 - - - - - - - | 6 - - - - - 6 - 5 - 4 - 3 - 2 - | 1 - - - 3 - - - 2 - - - - - - - |
    {f}
    /* ショ ク ブ ツ サ イ シュー | コ コ ロ ノ マ ー | マ */
    | 1 - - 3 2 - - 2 3 - - 4 5 - - - | 6 - - 6 5 - - 5 6 - - - - - 5 - | 1^ - - - - - - - - - - - 0 - - - |
}

Kitare:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 5__ [5_] | | 5__ [5_] 4_ [4] |
    | 5__ [5_] 4_ [4] | | 4_ [4] 1_ [1] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 4_ [4] |
    | 4_ [4] 5__ [5_] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 4_ [4] |
