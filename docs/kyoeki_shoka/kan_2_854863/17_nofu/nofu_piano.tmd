Nofu:PianoLH@|0|{
    <4*>
    /* 莊重典雅伴奏 */
    {<3/4>}
    | 1_ [1] 1_ |
    {<4/4>}
    | 1_ [1] 5__ [5_] | | 4_ [4] 1_ [1] |
    | 1_ [1] 5__ 0 |
    {<3/4>}
    | 1_ [1] 1_ |
    {<4/4>}
    | 1_ [1] 5__ [5_] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ 0 |
    | 1_ [1] 1_ [1] | | 4_ [4] 4_ [4] |
    | 5__ [5_] 1_ [1] | | 5__ [5_] 5__ 0 |
    {<3/4>}
    | 1_ [1] 1_ |
    {<4/4>}
    | 1_ [1] 5__ [5_] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ 0 |
}

