::SCORE::
** 農夫（鋼琴伴奏版） **
!= 120
?= F
<4/4>
~ "出處：共益商社樂器店《唱歌教科書 教師用 巻二》第三十六～三十七頁（第十七曲）"
~ "NDL Digital Collections PID 854863（https://dl.ndl.go.jp/pid/854863）掃描 P024.jpg"

Nofu:PianoRH@|0| {
<16*>
    /* カ ゲ ロ ー フ ー | ノ ボ ー ル | ハ タ ー ニ ヲ ー | ダ ニ */
    {<3/4>}
    | 5_ - - 5_ 3_ - 5_ - 1 - 2 - |
    {<4/4>}
    | 3 - - - 5 - 3 - 2 - - - - - - - | 6_ - - - 1 - 6_ - 5_ - - - 1 - 2 - | 3 - - - - - - - 2 - - - 0 - - - |
    /* オ リ タ ー ツ ー | タ ゴ ー ノ | ウ タ キ ケ | バ */
    {<3/4>}
    | 5_ - - 5_ 3_ - 5_ - 1 - 2 - |
    {<4/4>}
    | 3 - - - 5 - 3 - 2 - - - - - - - | 5_ - - - 3 - - - 2 - - - - - 3 - | 1 - - - - - - - - - - - 0 - - - |
    /* ヒ ト ク ハ | フ ル モ | キ ミ ー ノ ー タ ー | メ ー */
    | 5 - - - - - 5 - 5 - - - 5 - - - | 6 - - - - - 6 - 6 - - - - - - - | 5 - - - 4 - 3 - 2 - 1 - 2 - 3 - | 2 - - - - - - - 5_ - - - 0 - - - |
    /* フ タ ク ー ハ ー | フ ル ー モ | ク ニ ノ タ | メ */
    {<3/4>}
    | 5_ - - 5_ 3_ - 5_ - 1 - 2 - |
    {<4/4>}
    | 3 - - - 5 - 3 - 2 - - - - - - - | 5_ - - - 3 - - - 2 - - - - - 3 - | 1 - - - - - - - - - - - 0 - - - |
}

Nofu:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 4_ [4] 5__ [5_] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ [1] |
    | 1_ [1] 1_ [1] | | 4_ [4] 4_ [4] |
    | 4_ [4] 5__ [5_] | | 5__ [5_] 1_ [1] |
    | 1_ [1] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ 0 |
}

