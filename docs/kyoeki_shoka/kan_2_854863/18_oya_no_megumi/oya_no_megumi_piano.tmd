::SCORE::
** 親のめぐみ（鋼琴伴奏版） **
!= 92
?= G
<4/4>
~ "出處：共益商社樂器店《唱歌教科書 教師用 巻二》第三十八～三十九頁（第十八曲）"
~ "NDL Digital Collections PID 854863（https://dl.ndl.go.jp/pid/854863）掃描 P025.jpg"

OyaNoMegumi:PianoRH@|0| {
<8*>
    {mf}
    /* ア ツ ク | フ カ キ ハ | ミ オ ヤ ノ | メ グ ミ */
    | 1 - - - 1 - 3 - | 2 - 1 - 6_ - 1 - | 5_ - - 5_ 1 - 3 - | 3 - 2 - 2 - - - |
    /* ヤ マ モ | オ ヨ バ ズ | ウ ミ ナ ニ | ナ ラ ズ (rit., fermata) */
    | 5 - - - 6 - 4 - | 3 - - 3 2 - 2 - | 3 - 2 - 3 - 3 - | 4' - 4' - 5 - - - |
    {mp}
    /* ナ ケ バ | ア ヤ カ ス | ネ ル メ モ | ネ ズ ニ */
    | 5_ - - - 6_ - 7_ - | 1 - 2 - 3 - 2 - | 3 - - 3 2 - 1 - | 7_ - 1 - 2 - - - |
    {mf}
    /* ヤ メ バ | カ ナ シ ム | ショ ク ヲ モ | ク ハ デ */
    | 5 - - - 3 - 6 - | 5 - 4 - 3 - 2 - | 1 - 5_ - 1 - 3 - | 3 - 2 - 1 - - - |
}

OyaNoMegumi:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 5__ [5_] 4_ [4] |
    | 1_ [1] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 4_ [4] | | 1_ [1] 5__ [5_] |
    | 5__ [5_] 1_ [1] | | 4_ [4] 4_ [4] |
    | 1_ [1] 5__ [5_] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 4_ [4] | | 4_ [4] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 1_ [1] 1_ 0 |
}

