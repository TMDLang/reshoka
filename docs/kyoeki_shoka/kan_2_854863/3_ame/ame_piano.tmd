::SCORE::
** 雨（鋼琴伴奏版） **
!= 116
?= F
<2/4>
~ "出處：共益商社樂器店《唱歌教科書 教師用 巻二》第六～七頁（第一學期第三曲）"
~ "NDL Digital Collections PID 854863（https://dl.ndl.go.jp/pid/854863）掃描 P009.jpg"

AmeA:PianoRH@|0| {
<16*>
    {<2/4>}
    {!= 116}
    {f}
    /* い づ こ を | 出 で ゝ | い づ こ に | 至 る (rit.) */
    | 5_ - 1 - 1 - - 3 | 5 - 3 - 2 - - - | 1 - 3 - 5 - - 6 | 5 - 5 - 3 - - - |
    L1| い - づ - こ - - を | い - で - て - - - | い - づ - こ - - に | い - た - る - - - |
    L2| い - ざ - い - - ざ | と - も - に - - - | わ - が - み - - も | ゆ - か - ん - - - |
    L3| あ - め - あ - - め | さ - ら - ば - - - | ど - ん - ど - - と | ふ - れ - や - - - |
    /* あ し ぶ み | は や く | 窓 う つ | 雨 よ (Fine) */
    | 1 - 2 - 3 - - 2 | 1 - 7_ - 6_ - - - | 5_ - 1 - 3 - - 2 | 3 - 2 - 1 - - - |
    L1| あ - し - ぶ - - み | は - や - く - - - | ま - ど - う - - つ | あ - め - よ - - - |
    L2| の - や - ま - - の | は - な - に - - - | や - ど - る - - は | う - れ - し - - - |
    L3| わ - れ - ら - - が | う - た - と - - - | あ - は - せ - - て | や - ら - ん - - - |
}

AmeA:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] | | 1_ [1] | | 5__ [5_] | | 4_ [4] |
    | 1_ [1] | | 5__ [5_] | | 5__ [5_] | | 5__ [5_] |
    | 1_ 0 |
}

AmeB:PianoRH@|0| {
<8*>
    {<4/4>}
    {!= 100}
    {mf}
    /* 雲 よ り い | で ゝ | 草 葉 に や | ど る */
    | 5 - - 5 3 - 2 - | 1 - 2 - 3 - - - | 2 - - 2 1 - 7_ - | 6_ - 1 - 5_ - - - |
    L1| く - - も よ - り - | い - で - て - - - | く - - さ ば - に - | や - ど - る - - - |
    L2| い - - な い - な - | わ - れ - ぞ - - - | お - - ん み - と - | な - ら - ん - - - |
    /* せ は し や | わ れ は | き の ふ も | 今 日 も (D.C. al 𝄋) */
    | 1 - 3 - 5 - - 6 | 5 - 4 - 3 - - - | 1 - 2 - 3 - - 4 | 3 - 2 - 1 - - - |
    L1| せ - は - し - - や | わ - れ - は - - - | き - の - ふ - - も | け - ふ - も - - - |
    L2| ぴ - あ - の - - を | ひ - き - て - - - | あ - そ - ぶ - - は | た - の - し - - - |
}

AmeB:PianoLH@|0| {
