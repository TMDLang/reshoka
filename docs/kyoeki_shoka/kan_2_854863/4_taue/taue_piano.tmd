    /* タ ヒ テ ウ エ | ヨ ー ヤ カ ド | タ ノ サ ナ ー | ヘ (コ) */
    | 2 - - 3 2 - 1 2 | 3 - - 2 1 - 5_ 5_ | 6_ - - 5_ 1 - 2 3 | 1 - - - - - {f} 3 - |
    /* ノ サ ナ ー ヘ ー | コ ー ソ チ | イ ホ ノ ー ア キ | ト (ナ) */
