    /* ア ア ソ ー ノ ー | ト モ ハ | シ ラ ヌ タ | コ ク ニ */
    | 6 - 5 - 4 3 2 1 | 2 - - 6_ 5_ - - - | 3 - 5 - 1^ - - 7 | 7 - 6 - 6 - - - |
