** ボート（鋼琴伴奏版） **
!= 126
?= G
<2/4>
~ "出處：共益商社樂器店《唱歌教科書 教師用 巻二》第四～五頁（第一學期第二曲）"
~ "NDL Digital Collections PID 854863（https://dl.ndl.go.jp/pid/854863）掃描 P008.jpg"

Boto:PianoRH@|0| {
<16*>
    {mf}
    /* シ ホ ミ チ | ヌ | コ ギ ダ セ | ヨ */
    | 5 - - 5 3 - - 2 | 1 - - - 0 - - - | 5 - - 5 3 - - 2 | 1 - - - 0 - - - |
    /* イ ザ | ト モ ニ | コ ゲ ヤ コ | ゲ */
    | 1 - - - 2 - - - | 3 - - 4 5 - - - | 6 - - 6 6 - - 6 | 5 - - - 0 - - - |
    {f}
    /* カ ゼ | タ ツ | モ ナ ミ | タ ツ モ */
    | 3 - - - 5 - - - | 1 - - - 3 - - - | 6_ - - - 1 - - - | 5_ - - - 1 - - - |
    /* 海 國 | イ チ ノ | ダ ン ジ ナ | リ */
    | 3 - - - 2 - - - | 1 - - 2 3 - - - | 5 - - 5 5 - - 5 | 1 - - - 0 - - - |
}

Boto:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 5__ [5_] | | 1_ [1] | | 5__ [5_] | | 1_ [1] |
    | 5__ [5_] | | 4_ [4] | | 4_ [4] | | 1_ [1] |
    | 1_ [1] | | 1_ [1] | | 4_ [4] | | 1_ [1] |
    | 5__ [5_] | | 5__ [5_] | | 1_ [1] | | 1_ 0 |
}

