Goshinei:PianoRH@|0| {
<8*>
    {f}
    /* (弱起) ア | キ ツ | ミ カ ミ オ | ホ ミ カ ミ | ト ク */
    | 0 - 0 - 0 - 5 - | 1^ - - - 5 - - - | 6 - - 6 5 - 4 - | 3 - - 3 2 - - 2 | 5 - - - 0 - 5 - |
    /* モ ノ ア | ナ タ ニ ア | フ ギ ナ | ル ミ */
    | 1^ - - - 5 - - 5 | 6 - - 6 5 - 4 - | 3 - - - 2 - - 2 | 1 - - - 0 - {mf} 1 - |
    /* カ ゲ ヲ | イ マ ゾ マ | ノ ア タ | リ ヲ */
    | 2 - - - 5_ - - 5_ | 1 - - 2 3 - 3 - | 6 - - - 5 - 4' - | 5 - - - 0 - 5_ - |
    /* ロ ガ ム | コ ト ノ ウ | レ シ サ | ヨ */
    | 1 - - - 2 - 2 - | 3 - - 4 5 - {f} 5 - | 6 - - - 5 - - 5 | 1^ - - - 0 - 0 - |
}

Goshinei:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 1_ [1] 1_ [1] |
    | 4_ [4] 4_ [4] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 1_ [1] 1_ [1] |
    | 4_ [4] 4_ [4] | | 5__ [5_] 5__ 0 |
    | 1_ [1] 1_ [1] | | 5__ [5_] 1_ [1] |
    | 5__ [5_] 1_ [1] | | 4_ [4] 4_ [4] |
    | 1_ [1] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 4_ [4] 1_ [1] | | 4_ [4] 1_ [1] |
    | 1_ [1] 1_ 0 |
}

