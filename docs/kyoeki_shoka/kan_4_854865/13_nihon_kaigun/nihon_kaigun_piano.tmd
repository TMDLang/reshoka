    /* (弱起) ヤ マ ナ | ス ー キョ カ ン | ハ ウ ー | ミ ノ ー シ ロ ー | カ ー ス イ ラ */
    | 0 - - - 0 - - - 0 - 5_ - 6_ - 7_ - | 1 - - - - - - - - - 3 - 2 - 1 - | 5 - - - - - - - - - - - 4 - 3 - | 2 - - - 3 - 4 - 5 - - - 3 - 1 - | 2 - - - - - - - - - 1 - 7_ - 6_ - |
    /* イ ー タ イ ホ | ー ソ ー | ナ ヘ キ ー ビ ー | シ マ */
    | 5_ - - - - - - - - - 5_ - 1 - 3 - | 2 - - - - - - - - - - - 1 - 3 - | 5 - - - - - 6 - 5 - 4 - 3 - 2 - | 1 - - - - - - - - - - - 2 - - - |
    /* ス ト ハ ー タ ー | カ ク ク | モ ヲ シ ー ノ ー | ギ ヒ ラ */
    | 2 - - - - - 1 - 2 - 3 - 4 - 5 - | 6 - - - - - - - 5 - - - 5 - - - | 6 - - - - - 5 - 4 - 3 - 2 - 1 - | 5 - - - - - - - - - - - 5_ - - 5_ |
    /* メ ク ヒ ー ノ ー | ハ ー タ ミ | ル モ ヲ ー ヽ ー | シ ド ト */
    | 1 - - - - - 7_ - 1 - 2 - 3 - 1 - | 5 - - - - - 6 - 5 - - - 6 - - - | 5 - - - - - 3 - 2 - 1 - 2 - 3 - | 1 - - - - - - - - - - - {f} 5_ - - 5_ |
    /* ー バ ン | リ ジュ ー | ヲ ー ジ ザ | イ ー */
    | 1 - - - - - - - - - - - 3 - - 1 | 5 - - - - - - - - - - - 5 - - 5 | 6 - - - - - 5 - 5 - - - 5 - - - | 1 - - - - - - - - - 0 - 0 - 0 - |
}

