NintokuTenno:PianoRH@|0| {
<8*>
    {mf}
    /* た ま の み | や ゐ は | な の み に | て */
    | 5_ - 5_ - 1 - 5_ - | 6_ - 6_ - 5_ - - - | 3 - 1 - 5_ - 3 - | 2 - - - - - 0 - |
    /* あ れ に ぞ | あ れ し | お ほ と の | に */
    | 5_ - 5_ - 1 - 5_ - | 6_ - 6_ - 5_ - - - | 3 - 1 - 5_ - 2 - | 1 - - - - - 0 - |
    {mp}
    /* み と せ の | つ き ひ | し の ぎ つ | ゝ */
    | 3 - 3 - 4 - 3 - | 2 - 2 - 5_ - - - | 6_ - 6_ - 5_ - 1 - | 2 - - - - - 0 - |
    /* た み の か | ま ど を | に ぎ は し | た ま ふ そ | の お ほ み | め ぐ み */
    | 3 - 3 - 4 - 3 - | 2 - 2 - 5_ - 0 - | 6_ - 6_ - 5_ - 1 - | 2 - 3 - {f} 1 - - 5_ | {!= 44} 5 - - 4 3 - - 3 | 2 - - 2 1 - - - |
}

NintokuTenno:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 4_ [4] 4_ [4] |
    | 1_ [1] 1_ [1] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 4_ [4] 4_ [4] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ [1] |
    | 1_ [1] 4_ [4] | | 5__ [5_] 5__ [5_] |
    | 4_ [4] 1_ [1] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 4_ [4] | | 5__ [5_] 5__ [5_] |
    | 4_ [4] 1_ [1] | | 5__ [5_] 1_ [1] |
    | 4_ [4] 1_ [1] | | 1_ [1] 1_ 0 |
}

