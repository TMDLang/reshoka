::SCORE::
** 富士山（鋼琴伴奏版） **
!= 104
?= E,
<4/4>
~ "出處：共益商社樂器店《唱歌教科書 教師用 巻四》第十四～十五頁（第二學期第一曲）"
~ "NDL Digital Collections PID 854865（https://dl.ndl.go.jp/pid/854865）掃描 P013.jpg"

Fujisan:PianoRH@|0| {
<8*>
    {f}
    /* (弱起) あ | ふ げ よ | や ふ | じ の や | ま や */
    | 0 - 0 - 0 - 1 - | 1 - - - 3 - - 5 | 1^ - - - 0 - 5 - | 1^ - - - 6 - - 6 | 6 - - - 0 - 6 - |
    /* ま や ま | の あ | る な か | に お */
    | 1^ - - - 7 - 6 - | 5 - - - 0 - 5 - | 4 - - - 3 - - 2 | 2 - - - 0 - {mf} 4 - |
    /* ほ ー ぞ ら | の く | も ー を き | て け */
    | 3 - 2 - 1 - 3 - | 5 - - - 0 - 6 - | 5 - 4 - 3 - 5 - | 1^ - - - 0 - {f} 5 - |
    /* だ か き | が そ | の す が | た */
    | 1^ - - - 6 - - 6 | 6 - - - 0 - 1^ - | 3 - - - 2 - - 1 | 1 - - - 0 - 0 - |
}

Fujisan:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 1_ [1] 1_ [1] |
    | 1_ [1] 1_ [1] | | 1_ [1] 4_ [4] |
    | 4_ [4] 4_ [4] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 5__ [5_] 5__ 0 |
    | 5__ [5_] 4_ [4] | | 5__ [5_] 1_ [1] |
    | 1_ [1] 4_ [4] | | 4_ [4] 1_ [1] |
    | 1_ [1] 1_ [1] | | 1_ [1] 4_ [4] |
    | 4_ [4] 1_ [1] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ 0 |
}

