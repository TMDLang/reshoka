    | 0 - 0 - 0 - 5_ 5_ | 1 - - 2 3 2 1 3 | 5 - - 6 5 - 5_ - | 5 - - 6 5 - 3 1 | 2 - - - - - 5_ 5_ |
    /* ぢ に し ー ら ー | る ー ゝ た | か ー を や ま ー | や は る */
    | 1 - - 3 2 1 1 6_ | 5_ - - - 3_ - 5_ - | 3 - - 4 3 2 1 2 | 1 - - - - - 5 5 |
    /* あ ー き つ き | せ ー ぬ ふ | ー ー け い | に と み */
    | 5 - - 6 5 - 5 3 | 3 - - 1 2 - 5 - | 5 - - 6 5 - 4' - | 5 - - - - - 5_ 5_ |
    /* た る と ー こ ー | ろ ー ぞ さ | い ー きょ ー | は */
    | 1 - - 3 2 1 1 6_ | 5_ - - - 3_ - 5_ - | 3 - - 2 1 - 2 - | 1 - - - - - 0 - |
}

