<8*>
    {f}
    /* てん は | ゆ る さ じ | りょー みん | の | じ ゆ ー を | な み す る */
    | 5 - - - 5 - - - | 3 - - 3 5 - 5 - | 6 - - - 6 - - - | 5 - - - - - 0 - | 3 - - 3 3 - 3 - | 5 - 5 - 3 - 1 - |
    /* ぎゃく せい | を | じゅう さん しゅ | ー の | ち は ほ と | ば し り */
    | 2 - - - 2 - - - | 5_ - - - - - 0 - | 5_ - - - 6_ - 7_ - | 1 - - 1 1 - - - | 2 - 2 - 3 - 6 - | 5 - - 5 5 - - - |
    /* こ ゝ に | た ち た る | ワ シ ン ト | ン | ロッ キー | お ろ し */
    | 1 - - - 2 - 3 - | 6 - - 6 6 - 6 - | 5 - - 5 5 - 5 - | 1 - - - - - 0 - | 5 - - - 5 - - - | 3 - - 3 5 - - - |
    /* ふ き あ れ | て | ハ ド ソ ン | わん に ー | な み さ は | ぎ */
    | 6 - - 6 6 - 6 - | 5 - - - - - 0 - | 3 - - 3 3 - - - | 5 - - - 3 - 1 - | 2 - - 2 2 - 2 - | 5_ - - - - - 0 - |
    /* けん げ き | ひ び き | ぐ ん ば い | な な く | す は た た | か ひ の */
    | 5_ - - - 6_ - 7_ - | 1 - - 1 1 - - - | 2 - 2 - 3 - - 4 | 5 - - 5 5 - - - | 1^ - - 1^ 5 - - 5 | 3 - - 3 1 - - - |
    /* と き の こ | ゑ | しょー り を | つ ぐ る | ラッ パ の | ね */
    | 2 - - 2 5 - - 5 | 1 - - - - - 0 - | 5 - - - 5 - - 5 | 3 - - 3 5 - - - | 6 - - - 6 - - 6 | 5 - - - - - 0 - |
    /* く に の | ち ち ぞ と | あ ふ が れ | て | ミ シ ガ ン | こ じょ ー */
    | 3 - - 3 3 - - - | 5 - - 5 3 - 1 - | 2 - - 2 2 - 2 - | 5_ - - - - - 0 - | 5_ - - 5_ 6_ - 7_ - | 1 - - 1 1 - - - |
    /* しゅう げ つ | た か く | か が や く | き み が ー | そ の い さ | を */
    | 2 - - - 3 - 6 - | 5 - - 5 5 - - - | 5 - - 5 1^ - - 1^ | 5 - - 5 3 - 1 - | 2 - - 2 5 - - 5 | 1 - - - - - 0 - |
}

