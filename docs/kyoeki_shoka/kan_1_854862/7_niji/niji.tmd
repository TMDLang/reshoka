/* =========================================================================
   原書資訊與歌詞全文（NDL PID 854862《唱歌教科書 生徒用 巻一》第十四～十五頁，掃描 P009.jpg）：
   調性與拍號：ヘ調四分ノ四拍子（F 大調 4/4 拍），♩=120，「清々ト」
   註記：第一學期第七曲。分節歌，二節同一旋律。開頭標 mf。第四行第二小節（第十四小節）「6. 6_」與「5 6」各有圓滑線（配字「サーマー」／「さーまー」）。右頁「おほぞらの」之「お」以變體假名（𛀙）排印。五線譜與簡譜一致。

   一、
   あふぎ見よ、やよともよ、
   おほぞらの、虹のかげ、
   昇天の、橋のごと、
   かゝるさま、うつくしや。

   二、
   あふぎ見よ、やよともよ、
   おほぞらの、虹のかげ、
   錦繡の、旗のごと、
   なびくさま、うるはしや。
   ========================================================================= */

Niji:Piano@|0| {
    <8*>
    {mf}
    /* ア フ ギ ミ | ヨ | ヤ ヨ ト モ | ヨ */
    | 1 - - 2 3 - 1 - | 5 - - - - - 0 - | 5 - - 6 5 - 3 - | 2 - - - - - 0 - |
    /* オ ホ ゾ | ラ ノ | ニ ジ ノ カ | ゲ */
    | 1 - - - 2 - 1 - | 6_ - - - 5_ - - - | 1 - 2 - 3 - 1 - | 5 - - - - - 0 - |
    /* ショ ー テ ン | ノ | ハ シ ノ ゴ | ト */
    | 5 - - 5 6 - 5 - | 5 - - - - - 0 - | 3 - - 3 2 - 1 - | 2 - - - - - 0 - |
    /* カ カ ル | サ ー マ ー | ウ ツ ク シ | ヤ */
    | 1 - - - 2 - 3 - | 6 - - 6 5 - 6 - | 5 - 3 - 2 - - 3 | 1 - - - - - 0 - |
}

