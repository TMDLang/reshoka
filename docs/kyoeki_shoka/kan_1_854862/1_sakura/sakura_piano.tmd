::SCORE::
** 櫻（鋼琴伴奏版） **
!= 112
?= F
<4/4>
~ "出處：共益商社樂器店《唱歌教科書 生徒用 巻一》第二～三頁（第一曲）"
~ "NDL Digital Collections PID 854862（https://dl.ndl.go.jp/pid/854862）掃描 P003.jpg"

Sakura:PianoRH@|0| {
<8*>
    /* か す み の | こ ろ も | ぬ ぎ か け | て */
    | 5_ - 1 - 1 - 2 - | 3 - 2 - 1 - - - | 5 - 5 - 5 - 3 - | 2 - - - - - 0 - |
    /* の ぼ る | あ さ ひ に | に ほ ふ な | る */
    | 3 - - - 3 - 2 - | 1 - 1 - 5_ - 5_ - | 1 - 1 - 2 - 2 - | 3 - - - - - 0 - |
    /* さ く ら の | は な は | う る は し | や */
    | 5 - 5 - 6 - 6 - | 5 - 5 - 3 - - - | 5 - 3 - 3 - 1 - | 2 - - - - - 0 - |
    /* ゑ み の | く ち び る | ひ ら き つ | ゝ */
    | 3 - - - 2 - 2 - | 1 - 1 - 5_ - 5_ - | 1 - 2 - 3 - 2 - | 1 - - - - - 0 - |
}

Sakura:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 5__ [5_] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ [1] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ [1] |
    | 1_ [1] 4_ [4] | | 1_ [1] 1_ [1] |
    | 1_ [1] 1_ [1] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ [1] |
    | 5__ [5_] 5__ [5_] | | 1_ [1] 1_ 0 |
}

-> Sakura -> #
