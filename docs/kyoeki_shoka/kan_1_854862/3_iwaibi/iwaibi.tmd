    L1| す - - ず め - の - | な - く - こ - え - | や - - ち よ - と - | き - こ - え - _ - |
    L2| あ - - さ ひ - の - | み - は - た - は - | か - - ど な - み - | な - び - き - _ - |
    L3| い - - ざ い - ざ - | わ - れ - ら - も - | て - - に て - を - | と - り - て - _ - |
    /* ニ ハ ナ ル ー | マ ツ ー カ ゼ | バン ザ イ ト ー | ヒ ビ ク */
    | 5 - - 5 1^ - 7 6 | 5 - 5 6 5 - 3 - | 5 - - 1^ 3^ - 2^ 1^ | 2^ - 2^ - 5 - 0 - |
    L1| に - - は な - る - | ま - つ - か - ぜ - | ばん - - ざ い - と - | ひ - び - く - _ - |
    L2| しょ - - - か - の - | こ - ゑ - ご - ゑ - | さ - - と ご - と - | み - て - り - _ - |
    L3| い - - は ひ - て - | あ - そ - ば - ん - | う - - れ し - き - | け - ふ - を - _ - |
