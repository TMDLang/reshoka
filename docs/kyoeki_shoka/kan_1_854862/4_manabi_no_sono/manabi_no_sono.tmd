    /* カ ヨ フ モ | ウ レ シ | マ ナ ビ ノ | ソ ノ ニ */
    | 1 - - 2 3 - 2 - | 1 - - - 3 - 2 - | 1 - - 3 5 - 3 - | 4 - - 2 1 - - - |
    /* ソ ー ノ ニ | ツ ミ タ ル | オ シ ヘ ノ | ク サ バ */
    | 5 - - 5 5 - - 3 | 1 - - 2 3 - 3 - | 5 - - 5 5 - 3 - | 1 - - 2 3 - - - |
    /* イ ー カ デ | ワ ス レ ン | ハ ナ サ ク | ヒ マ デ */
    | 1 - - 2 3 - 2 - | 1 - - 2 3 - 2 - | 3 - - 5 3 - 2 - | 3 - - 2 1 - - - |
