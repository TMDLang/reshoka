::SCORE::
** 竹馬（鋼琴伴奏版） **
!= 116
?= G
<2/4>
~ "出處：共益商社樂器店《唱歌教科書 生徒用 巻一》第三十二～三十三頁（第十六曲）"
~ "NDL Digital Collections PID 854862（https://dl.ndl.go.jp/pid/854862）掃描 P018.jpg"

Takeuma:PianoRH@|0| {
<16*>
    {mf}
    /* (弱起) ノ | レ ノ レ ノ | レ タ | ケ ー ウ マ | ニ (イ) */
    | 0 - 0 - 0 - 5_ - | 1 - - 1 2 - - 7_ | 1 - - - 0 - 1 - | 2 - - 1 2 - - 3 | 2 - - - 0 - 1 - |
    /* マ ヨ リ ノ | チ ヒ | ト ー ナ | リ */
    | 6 - - 5 4 - - 3 | 2 - - - 0 - 3 - | 2 - - 1 2 - - 2 | 5_ - - - 0 - - - |
    {f}
    /* セン バン | リ ノ | キ バ リョ コ | ー */
    | 5 - - - 5 - - - | 3 - - - 1 - - - | 2 - 3 - 4 - 6 - | 5 - - - 0 - - - |
    /* ナ サ ン | ト キ ノ | シ タ ナ ラ | シ */
    | 5 - 5 - 6 - 4 - | 3 - - - 1 - - - | 2 - 4 - 3 - 2 - | 1 - - - 0 - 0 - |
}

Takeuma:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] | | 5__ [5_] | | 1_ [1] | | 5__ [5_] |
    | 5__ [5_] | | 4_ [4] | | 5__ [5_] | | 5__ 0 |
    | 1_ [1] | | 1_ [1] | | 1_ [1] | | 5__ [5_] |
    | 1_ [1] | | 4_ [4] | | 1_ [1] | | 5__ [5_] |
    | 1_ 0 |
}

