NihonDanji1:PianoRH@|0| {
<16*>
    {f}
    /* ヨ ー シ ヤ | ヒャ ク マ ン ノ | タ イ グ ン | モ */
    | 5 - - - - - 5 - 3 - - - 1 - - - | 2 - 1 - 2 - 3 - 2 - - - 0 - - - | 1 - - - - - 1 - 6_ - - - 5_ - - - | 1 - - - - - - - - - - - 0 - - - |
    {mf}
    /* ウ バ フ ニ ヨ シ ナ キ | ヤ マ ト ダ マ | オ ノ オ ノ ミ ニ コ ソ */
    | 1 - - 1 1 - 2 - 1 - 7_ - 6_ - 5_ - | 1 - - 1 2 - 3 - 2 - - - 0 - - - | 3 - - 3 3 - 1 - 5 - - 5 5 - 3 - |
    /* ソ ナ ヘ タ レ | ヤ マ ナ ス ア ダ ナ ミ | ヨ セ ク ト モ */
    | 2 - - 2 3 - 2 - 1 - - - 0 - - - | 1 - - 1 1 - 3 - 2 - 1 - 7_ - 6_ - | 5_ - - 1 3 - 1 - 2 - - - 0 - - - |
    {f}
    /* ナ ー ド カ | オ ー ソ ー レ ン | ニ ー ッ ポ ン | ダ ン ジ */
    | 5 - - - - - 5 - 3 - - - 1 - - - | 2 - 1 - 2 - 3 - 2 - - - 1 - - - | 5_ - - - 1 - 2 - 3 - - - - - 1 - | 2 - - - 5 - - - 1 - - - 0 - - - |
}

NihonDanji1:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 4_ [4] | | 1_ [1] 1_ [1] |
    | 5__ [5_] 5__ [5_] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ 0 |
}

NihonDanji2:PianoRH@|0| {
<16*>
    {f}
    /* き た へ に | き ー た ー へ し | に ほ ん と | ー */
    | 5 - - - - - 5 - 3 - - - 1 - - - | 2 - 1 - 2 - 3 - 2 - - - 2 - - - | 1 - - - - - 1 - 6_ - - - 5_ - - - | 1 - - - - - - - - - - - 0 - - - |
    {mf}
    /* こ ほ り の や ー い ば | な つ さ む し | こ の ひ と ふ り こ そ */
    | 1 - - 1 1 - 2 - 1 - 7_ - 6_ - 5_ - | 1 - - 1 2 - 3 - 2 - - - 0 - - - | 3 - - 3 3 - 1 - 5 - - 5 5 - 3 - |
    /* そ な へ た れ | あ だ な す え み し ら | お ほ く と も */
    | 2 - - 2 3 - 2 - 1 - - - 0 - - - | 1 - - 1 1 - 3 - 2 - 1 - 7_ - 6_ - | 5_ - - 1 3 - 1 - 2 - - - 0 - - - |
    {f}
    /* な ー ど か | ひ ー る ー ま ん | に ー つ ぽ ん | だ ん じ */
    | 5 - - - - - 5 - 3 - - - 1 - - - | 2 - 1 - 2 - 3 - 2 - - - 1 - - - | 5_ - - - 1 - 2 - 3 - - - - - 1 - | 2 - - - 5 - - - 1 - - - 0 - - - |
}

