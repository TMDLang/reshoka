    /* コ ヨ ト カ | ヨ ブ ヒ バ | リ | ピ ヨ ピ ヨ | ピ ヨ ピ ヨ */
    | 1^ - 5 - 5 - 5 - | 6 - - 5 6 - 7 - | 1^ - - - - - - - | 2^ - 2^ - 5 - 5 - | 1^ - 1^ - 5 - 5 - |
    /* ヒ ラ ヒ ラ | ヒ ラ ヒ ラ | タ カ シ ヤ | タ カ シ ヤ | ア ノ ヒ バ */
    | 2^ - 2^ - 5 - 5 - | 1^ - 1^ - 5 - 5 - | 3 - - 4 5 - 5 - | 6 - - 5 6 - 7 - | 1^ - - 7 1^ - 2^ - |
