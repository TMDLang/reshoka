    /* ミ ー ニ ゾ コ ガ ネ ハ | ツ モ ル ベ キ */
    | 3_ - - 4_ 5_ - 3_ - 6_ - - 6_ 5_ - 1 - | 2 - - 2 1 - 3 - 5 - - - 0 - - - |
    /* ヤ ー ヨ ヤ ヒ ト ビ ト | モ チ ヰ テ ツ キ ヌ */
    | 5 - - 6 5 - - 5 3 - - 5 3 - - 3 | 2 - - 3 1 - 6_ - 5_ - 5_ - 5_ - 0 - |
    /* ト ー キ ー ハ ー | コ ー ガ ー ネ ノ | ハ ハ ー | ナ ル ゾ */
