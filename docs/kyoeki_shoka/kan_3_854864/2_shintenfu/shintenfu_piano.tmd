Shintenfu:PianoRH@|0| {
<16*>
    {!= 192}
    {f}
    /* 彈 丸 | 銃 砲 | ホ コ ツ ル | ギ | 日 清 */
    | 1 - - - - - - - 1 - - - - - - - | 5_ - - - - - - - 5_ - - - - - - - | 1 - - - - - 7_ - 1 - - - 2 - - - | 3 - - - - - - - - - - - 0 - - - | 5 - - - - - - - 5 - - - - - - - |
    /* 戰 利 ノ | シ ナ ジ ナ | ヲ | ツ ラ ネ | タ マ ヒ シ */
    | 3 - - - 3 - - - 5 - - - 5 - - - | 4 - - - - - 4 - 3 - - - 3 - - - | 2 - - - - - - - - - - - 0 - - - | 1 - - - - - - - 1 - - - 1 - - - | 5_ - - - - - 5_ - 5_ - - - 5_ - - - |
    /* (rit.) 振 テ ン | フ (Piu Lento) カ | シ コ シ | ヤ オ */
    | 2 - - - - - - - 2 - - - - - 3 - | 1 - - - - - - - - - - - {!= 96} {mf} 1 - - - | 5 - - - - - - - 5 - - - - - 5 - | 3 - - - - - - - - - - - 1 - - - |
    /* ホ ウ チ | ヤ マ ノ ウ | ヘ ニ | タ テ リ */
    | 2 - - - - - - - 3 - - - 3 - - - | 4 - - - 6 - - - 5 - - - {f} 5 - - - | 6 - - - - - - - 5 - - - - - - - | 5 - - - - - 5 - 1 - - - - - - - |
}

Shintenfu:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 1_ [1] 1_ [1] |
    | 5__ [5_] 5__ [5_] | | 1_ [1] 1_ [1] |
    | 1_ [1] 1_ [1] | | 1_ [1] 1_ [1] |
