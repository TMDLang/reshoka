    /* オ ホ セ タ | マ ヒ シ | コ ノ ニ ン | ギョ ー */
    | 3 - - - 3 - - - 1 - - - 7_ - - - | 6_ - - - 7_ - - - 1 - - - 1 - - - | 7_ - - - 7_ - - - 1 - - - 7_ - - - | 6_ - - - - - - - - - - - 0 - - - |
    /* キ モ ノ ヲ | キ ー セ ー テ | オ ビ シ ー メ ー | テ */
    | 3_ - - - 3_ - - - 4_ - - - 3_ - - - | 6_ - 7_ - 6_ - 7_ - 1 - - - - - - - | 6_ - - - 7_ - - - 6_ - 7_ - 1 - 2 - | 3 - - - - - - - - - - - 0 - - - |
    /* ハ コ ノ | ゴ テ ン ニ | ス ハ ラ セ | ン */
