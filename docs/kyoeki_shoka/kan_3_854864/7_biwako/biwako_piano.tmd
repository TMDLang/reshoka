Biwako:PianoRH@|0| {
<16*>
    {mf}
    /* ウ タ ー ヘ ヤ | ウ タ ヘ | ヨ ニ ナ モ ー | タ カ ー キ */
    | 1 - - - 1 - 3 - 5 - - - - - 5 - | 6 - - - 1^ - - - 5 - - - - - - - | 6 - - - 6 - - - 1^ - - - 7 - 6 - | 5 - - - 3 - 1 - 2 - - - - - - - |
    /* ア フ ミ ノ | ウ ー ミ ー ノ | ヤ ツ ー ノ ケ | イ */
    | 6 - - - - - 5 - 3 - - - 1 - - - | 3 - 2 - 2 - 1 - 5 - - - - - - - | 5 - - - 3 - 1 - 2 - - - - - 2 - | 1 - - - - - - - - - - - 0 - - - |
    {f}
    /* ミ ヰ ニ ー ツ ー | キ ダ ス | カ ネ ノ ネ ー | ク レ テ */
    | 1^ - - - - - 1^ - 2^ - 1^ - 1^ - 6 - | 5 - - - - - 6 - 5 - - - - - - - | 6 - - - 6 - - - 1^ - - - 7 - 6 - | 5 - - - 4' - - - 5 - - - - - - - |
    {mf}
    /* セ タ ノ ユ | フ ヒ ハ | カ ゲ ー モ ナ | シ */
    | 6 - - - 6 - - - 6 - - - - - 5 - | 6 - - - 1^ - - - 5 - - - - - - - | 5 - - - 3 - 1 - 2 - - - - - 2 - | 1 - - - - - - - - - - - 0 - - - |
}

Biwako:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 4_ [4] 1_ [1] |
    | 4_ [4] 5__ [5_] | | 1_ [1] 5__ [5_] |
    | 4_ [4] 1_ [1] | | 5__ [5_] 5__ [5_] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ [1] |
    | 5__ [5_] 4_ [4] | | 1_ [1] 4_ [4] |
    | 4_ [4] 5__ [5_] | | 1_ [1] 4_ [4] |
    | 4_ [4] 4_ [4] | | 4_ [4] 1_ [1] |
    | 1_ [1] 5__ [5_] | | 1_ [1] 1_ 0 |
}

