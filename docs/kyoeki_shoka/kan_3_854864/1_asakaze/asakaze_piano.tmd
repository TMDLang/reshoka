::SCORE::
** 朝風（鋼琴伴奏版） **
!= 112
?= D
<4/4>
~ "出處：共益商社樂器店《唱歌教科書 教師用 巻三》第二～三頁（第一學期第一曲）"
~ "NDL Digital Collections PID 854864（https://dl.ndl.go.jp/pid/854864）掃描 P007.jpg"

Asakaze:PianoRH@|0| {
<16*>
    {mp}
    /* (弱起) ふ く | よ ー あ さ か | ぜ す ず | し く ふ く | よ ー ま な び */
    | 0 - - - 0 - - - 0 - - - 1 - - 3 | 5 - - - - - - - - - - 5 6 - - 5 | 3 - - - - - - - - - - - 2 - - 3 | 4 - - - 5 - - - 5 - - - 6 - - - | 5 - - - - - - - - - - 6 1^ - - 6 |
    /* じ ー い そ ー | ぐ わ れ | ら が そ で | を */
    | 5 - - - - - - - - - - 5 6 - - 5 | 3 - - - - - - - - - - - 1 - - 2 | 3 - - - 4 - - - 3 - - - 2 - - - | 1 - - - - - - - - - - - 0 - - - |
    {mf}
    /* つ ゆ の | し ら た ま | か ゝ れ る | く さ ー ば | な び き て */
    | 5 - - - - - - - 3 - - - - - 1 - | 2 - - - - - 2 - 1 - - - 2 - - - | 3 - - - - - 4 - 5 - - - 6 - - - | 6 - - - 1^ - 6 - 5 - - - 0 - - - | 6 - - - - - 6 - 5 - - - 3 - - - |
    /* こ ぼ る ゝ | ま た ま ー の ー | つ ゆ あ | ゝ を し | や */
    | 3 - - - - - 3 - 2 - - - 1 - - - | 2 - - - - - 2 - 1 - 3 - 5 - 3 - | 2 - - - - - - - 1 - - - 5 - - - | 6 - - - - - - - 5 - - - - - 5 - | 1^ - - - - - - - - - - - 0 - - - |
}

Asakaze:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] 1_ [1] | | 1_ [1] 4_ [4] |
    | 1_ [1] 5__ [5_] | | 4_ [4] 4_ [4] |
    | 4_ [4] 4_ [4] | | 1_ [1] 4_ [4] |
    | 1_ [1] 5__ [5_] | | 4_ [4] 5__ [5_] |
    | 1_ [1] 1_ [1] | | 1_ [1] 1_ [1] |
    | 5__ [5_] 5__ [5_] | | 4_ [4] 4_ [4] |
    | 4_ [4] 4_ [4] | | 4_ [4] 1_ [1] |
    | 1_ [1] 5__ [5_] | | 5__ [5_] 1_ [1] |
    | 5__ [5_] 1_ [1] | | 4_ [4] 1_ [1] |
    | 1_ [1] 1_ 0 |
}

