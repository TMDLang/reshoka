    /* ツ ケ ー ヤ イ ザ | テ キ ー エ イ ヲ | タ テ ー ヨ イ ザ | ワ ー ガ ハ ー タ ヲ */
    | 5_ - - - (5_ 6_ 7_)%(----) 1 - - - 1 - - - | 2 - - - (2 3 4)%(----) 3 - - - 2 - - - | 5 - - - (6 5 4')%(----) 5 - - - 3 - - - | (3 2 1)%(----) (2 1 7_)%(----) 1 - - - - - 0 - |
