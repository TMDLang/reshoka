** 日本刀（鋼琴伴奏版） **
!= 116
?= G
<3/4>
~ "出處：共益商社樂器店《唱歌教科書 教師用 巻三》第三十～三十一頁（第三學期第二曲）"
~ "NDL Digital Collections PID 854864（https://dl.ndl.go.jp/pid/854864）掃描 P021.jpg"

Nihonto:PianoRH@|0| {
<16*>
    {mf}
    /* (弱起) ワ レ | タ マ シ ヒ | ア リ タ | レ カ ハ シ | ル (弱起) ワ レ */
    | 0 - - - 0 - - - 5_ - - 5_ | 1 - - - - - 1 - 3 - 1 - | 5 - - - 3 - - - 1 - - - | 2 - - - - - 2 - 1 - - 2 | 3 - - - - - - - 5_ - - 5_ |
    /* ニ タ カ ラ | ア リ ヨ | ニ カ ガ ヤ | ク (弱起) ミ ガ */
    | 1 - - - - - 1 - 3 - 1 - | 5 - - - 3 - - - 1 - - - | 6_ - - - - - 6_ - 5_ - - 6_ | 5_ - - - - - - - 1 - - 1 |
    /* キ ニ ミ ガ | ケ ル ヤ | マ ト ダ マ | シ ヒ (弱起) キ タ */
    | 3 - - - - - 2 - 1 - 6_ - | 6_ - - - 5_ - - - 5_ - - - | 2 - - - - - 1 - 7_ - - 1 | 2 - - - - - - - 5 - - 5 |
    /* ヒ ニ キ タ | ヘ ル ニ | ホ ー ン ト | ー */
    | 6 - - - - - 6 - 5 - 3 - | 1 - - - 2 - - - 3 - - - | 5 - - - - - 5 - 4 - - 2 | 1 - - - - - - - 0 - - - |
}

Nihonto:PianoLH@|0| {
    <4*>
    /* 莊重典雅伴奏 */
    | 1_ [1] [1] | | 1_ [1] [1] |
    | 1_ [1] [1] | | 5__ [5_] [5_] |
    | 1_ [1] [1] | | 1_ [1] [1] |
    | 1_ [1] [1] | | 4_ [4] [4] |
    | 1_ [1] [1] | | 5__ [5_] [5_] |
    | 4_ [4] [4] | | 5__ [5_] [5_] |
    | 5__ [5_] [5_] | | 4_ [4] [4] |
    | 5__ [5_] [5_] | | 5__ [5_] [5_] |
    | 1_ [1] 0 |
}

