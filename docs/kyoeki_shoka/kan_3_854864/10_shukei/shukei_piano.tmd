Shukei:PianoRH@|0| {
<16*>
    {mp}
    /* (弱起) ツ | キ サ エ ー ワ ー | タ リ ハ | ナ サ ク ー ノ ー | ベ (弱起) ム */
    | 0 - - - 0 - - - 0 - - - 5_ - - - | 1 - - - - - 1 - 1 - 7_ - 1 - 2 - | 3 - - - - - - - 1 - - - 1 - - - | 2 - - - - - 2 - 3 - 2 - 1 - 2 - | 3 - - - - - - - 0 - - - 4 - - - |
    /* シ ノ コ ー エ ー | ゴ エ ア | ハ レ フ ー カ ー | シ (弱起) フ */
    | 4 - - - - - 4 - 4 - 3 - 2 - 1 - | 2 - - - - - - - 2 - - - 5_ - - - | {mf} 5 - - - - - 6 - 5 - 4 - 3 - 2 - | 1 - - - - - - - 0 - - - {mp} 5 - - - |
    /* リ イ ダ ス | ス ズ カ | キ ナ ラ ス | コ ト (弱起) ゲ */
    | 5 - - - - - 4 - 3 - - - 1 - - - | 2 - - - - - - - 2 - - - 1 - - - | 5 - - - - - 6 - 5 - - - {mf} 4' - - - | 5 - - - - - - - 5_ - - - {mp} 5_ - - - |
    /* ニ タ グ ー ヒ ー | ナ キ ア | キ ノ フ ー ゼ ー | イ */
    | 1 - - - - - 1 - 1 - 7_ - 1 - 2 - | 3 - - - - - - - 1 - - - 1 - - - | 2 - - - - - 2 - 3 - 2 - 1 - 2 - | 1 - - - - - - - 0 - - - 0 - - - |
}

Shukei:PianoLH@|0| {
