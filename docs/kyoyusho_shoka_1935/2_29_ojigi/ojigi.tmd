!= 96
?= D
<2/4>
~ "臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年，索書號 0725 148）"

/* =========================================================================
   原書資訊與歌詞全文（對應 P100.jpg，原書 p. 72）：
   ・曲號標記：譜首左端印「13」（未載明作曲者）
   ・調性與拍號：D 大調（二升記號），2/4 拍（原譜未標速度，演奏速度 != 96 為編者設定）
   ・編制與曲式：雙手鋼琴大譜表器樂曲（禮法行禮伴奏曲，無歌詞）。
     第一段 4 小節末帶反覆記號 `:|`，第二段 4 小節帶 `|: ... :|` 並於結尾標註 `D.C`，
     依 Da Capo 慣例展開為 A（反覆，8 小節）→ B（反覆，8 小節）→ A（返始不反覆，4 小節），共 20 小節。

   【原書歌詞全文】
   （器樂曲，無歌詞）
   ========================================================================= */

Ojigi:PianoRH@|0|{
    <16*>
    /* ================= 第一段 A (4 小節反覆，P100.jpg 第 1 行) ================= */
    | 1 - 2 - 3 - 1 - | 1 - 2 - 3 - 1 - | 2+4 - - - 1+3 - - - | 2 1 2 3 1 - - - |
    | 1 - 2 - 3 - 1 - | 1 - 2 - 3 - 1 - | 2+4 - - - 1+3 - - - | 2 1 2 3 1 - - - |

    /* ================= 第二段 B (4 小節反覆，P100.jpg 第 2 行) ================= */
    | 5 - 6 7 1^ 5 3 4 | 5 4 2 3 4 - 3 - | 5 - 6 7 1^ 5 3 4 | 5 4 2 7_ 1 - - - |
    | 5 - 6 7 1^ 5 3 4 | 5 4 2 3 4 - 3 - | 5 - 6 7 1^ 5 3 4 | 5 4 2 7_ 1 - - - |

    /* ================= D.C. 返始 A (4 小節不反覆，P100.jpg 第 1 行) ================= */
    | 1 - 2 - 3 - 1 - | 1 - 2 - 3 - 1 - | 2+4 - - - 1+3 - - - | 2 1 2 3 1 - - - |
}

Ojigi:PianoLH@|0|{
    <16*>
    /* ================= 第一段 A 左手低音譜表伴奏 ================= */
    | 1_ - 5_ - 1 - 0 - | 1_ - 5_ - 1 - 0 - | 7__+5_ - - - 1_+5_ - - - | 5__+4_ - - - 1_+3_ - - - |
    | 1_ - 5_ - 1 - 0 - | 1_ - 5_ - 1 - 0 - | 7__+5_ - - - 1_+5_ - - - | 5__+4_ - - - 1_+3_ - - - |

    /* ================= 第二段 B 左手低音譜表伴奏 ================= */
    | 5_+7_+2 - 0 - 3_+5_+1 - 0 - | 7__+2_+5_ - 0 - 1_+5_ - - - | 5_+7_+2 - 0 - 3_+5_+1 - 0 - | 5__+4_ - - - 1_+3_ - - - |
    | 5_+7_+2 - 0 - 3_+5_+1 - 0 - | 7__+2_+5_ - 0 - 1_+5_ - - - | 5_+7_+2 - 0 - 3_+5_+1 - 0 - | 5__+4_ - - - 1_+3_ - - - |

    /* ================= D.C. 返始 A 左手低音譜表伴奏 ================= */
    | 1_ - 5_ - 1 - 0 - | 1_ - 5_ - 1 - 0 - | 7__+5_ - - - 1_+5_ - - - | 5__+4_ - - - 1_+3_ - - - |
}

