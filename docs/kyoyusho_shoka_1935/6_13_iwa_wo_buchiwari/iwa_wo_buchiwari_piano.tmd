::SCORE::
** 岩をぶちわり（鋼琴伴奏譜） **
!= 108
?= G
<3/4>
~ "臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年，索書號 0725 148）"

IwaWoBuchiwari:PianoRH@|0|{
    <8*>
    /* 第一行 (m.1-4) */
    | 5 - - 6 5 4 | 3 - 1 - 1 - | 2 - 5_ - 5_ - | 3 - 1 - 1 - |
    L1| イ - - - ハ ヲ | ブッ - チ - ワリ - | ブッ - チ - ワリ - | ブッ - チ - ワリ - |
    L2| な - - - み を | ぶっ - ち - わり - | ぶっ - ち - わり - | ぶっ - ち - わり - |

    /* 第二行 (m.5-8) */
    | 5 - - 6 5 4 | 3 - 1 - 1 - | 2 - 5_ - 5_ - | 1 - - - 0 - |
    L1| ミ - - - チ ヲ | ブッ - ピラ - キ - | ブッ - ピラ - ケ - | ヤ - - - _ - |
    L2| う - - - み を | ぶっ - こえ - て - | ぶっ - こえ - て - | や - - - _ - |

    /* 第三行 (m.9-12) */
    | 2 - 5_ - 5_ - | 3 - 1 - 1 - | 2 - 5_ - 5_ - | 3 - 1 - 1 - |
    L1| ブッ - チ - ワリ - | ブッ - ピラ - キ - | ブッ - チ - ワリ - | ブッ - ピラ - キ - |
    L2| ぶっ - ち - わり - | ぶっ - こえ - て - | ぶっ - ち - わり - | ぶっ - こえ - て - |

    /* 第四行 (m.13-16) */
    | 5 - - 6 5 4 | 3 - 1 - 1 - | 2 - 5_ - 5_ - | 1 - - - 0 - |
    L1| ケ - - ン ジ ノ | チ - カ - ラ - | シ - メ - セ - | ヤ - - - _ - |
    L2| け - - ん じ の | い - き - を - | み - せ - よ - | や - - - _ - |
}

IwaWoBuchiwari:PianoLH@|0|{
    <4*>
    /* m.1-4 */
    | 1_ [1] [5_] | 1_ [1] [1] | 5__ [5_] [5_] | 1_ [1] [1] |
    /* m.5-8 */
    | 1_ [1] [5_] | 1_ [1] [1] | 5__ [5_] [5_] | 1_ [1] 0 |
    /* m.9-12 */
    | 5__ [5_] [5_] | 1_ [1] [1] | 5__ [5_] [5_] | 1_ [1] [1] |
    /* m.13-16 */
    | 1_ [1] [5_] | 1_ [1] [1] | 5__ [5_] [5_] | 1_ [1] 0 |
}

-> IwaWoBuchiwari[L1] -> IwaWoBuchiwari[L2] -> #
