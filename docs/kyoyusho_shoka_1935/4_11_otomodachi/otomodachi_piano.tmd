** お友達（鋼琴伴奏譜） **
!= 96
?= C
key= Am
<4/4>
~ "臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年，索書號 0725 148）"
~ "詞：佐々木吉三郎"
~ "曲：田村虎藏"

/* 原譜未標速度，演奏速度（!= 96）為編者設定。 */

Main:PianoRH@|0|{
    <8*>
    /* 第一行 (m.1–4) */
    | 3 - 6 - 1^ - 7 - | 6 - 7 6 4 - 3 - | 2 - 4 - 3 - 2 - | 3 - 4 - 6 - 0 - |
    L1| ツ - マ - ヅ - キ - | コ - ロ - ン - ダ - | ヒ - ト - リ - ノ - | ト - モ - ヲ - _ - |
    L2| お - と - し - て - | ち - ら - か - る - | が - つ - か - う - | だ - う - ぐ - _ - |

    /* 第二行 (m.5–8) */
    | 7 - - - 1^ - 7 - | 6 - 7 6 4 - 3 - | 2 - 4 - 3 - - 2 | 7_ - 2 - 3 - 0 - |
    L1| ダ - - - イ - テ - | オ - コ - シ - テ - | チ - リ - ウ - - チ | ハ - ラ - ヒ - _ - |
    L2| ひ - - - ろ - ひ - | あ - つ - め - て - | か - ほ - さ - - し | の - ぞ - き - _ - |

    /* 第三行 (m.9–12) */
    | 3 - 3 - 4 - 3 - | 4 - 3 2 3 - 4 - | 6 - - 4 3 - 6 - | 1^ - 7 - 6 - 0 - |
    L1| イ - タ - ミ - ハ - | セ - ヌ - カ - ト - | ウ - - シ ロ - ニ - | ヒ - ト - リ - _ - |
    L2| け - - - が - は - | な - く - て - と - | ま - - へ に - も - | ひ - と - り - _ - |
}

Main:PianoLH@|0|{
    <4*>
    | 6__ [6_m] 6__ [3_m] | 6__ [3_m] 2__ [6_m] | 2__ [2_m] 6__ [2_m] | 6__ [4_] [6_m] 0 |
    | 3__ [3_m] 6__ [3_m] | 6__ [3_m] 2__ [6_m] | 2__ [2_m] 6__ 6__ | 3__ [5_] 3__ 0 |
    | 6__ [6_m] 2__ [6_m] | 2__ 6__ 6__ [2_m] | 6__ 2__ 6__ [6_m] | 6__ [3_m] [6_m] 0 |
}

