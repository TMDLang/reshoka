    L1| シ - - ノ ゲ - - - - - - - ル - _ - | フ - - ヨ ウ - - - - - - - ホ - - - | ウ - - - - - - - _ - - - テ - - ル | ヒ - - - - - - - ニ - - - ヒ - - カ | ル - - - - - - - - - - - ス - - ガ |
