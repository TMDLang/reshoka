    <16*>
    /* 第一行後半 (m.3-5) */
    | 1 - - 2 3 - - - - - - - 2 - 0 - | 3 - - 4 3 - - - - - - - 2 - 1 - | 7_ - - - - - - - 0 - 5_ - 3_ - - 5_ |
    L1| ハ - - レ タ - - - - - - - リ - _ - | キ - - ハ ス - - - - - - - ミ - - - | テ - - - - - - - _ - ク - モ - - ヲ |
