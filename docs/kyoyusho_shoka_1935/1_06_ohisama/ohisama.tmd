    | 6 - 6 - 5 - 5 - | 3 - 3 - 1 - 1 - | 2 - 2 - 5 - 4 - | 3 - 2 - 1 - 0 - |
    L| サ - ヨ - ナ - ラ - | オ - ヒ - サ - マ - | ア - シタ - マ - タ - | オ - メ - ニ - _ - |
