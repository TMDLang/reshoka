::SCORE::
** 櫻と小鳥（鋼琴伴奏譜） **
!= 100
?= E,
<4/4>
~ "詞：野口雨情"
~ "曲：本居長世"
~ "臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年，索書號 0725 148）"

/* （原譜未標速度，演奏速度為編者設定） */

Main:PianoRH@|0|{
    <8*>
    /* 第一行 (m.1-4) */
    | 5 - 6 5 3 - 5 - | 1 - 2 - 3 - 0 - | 2 - 3 2 1 - 2 - | 6_ - 1 - 2 - 0 - |
    L| イ - イ - ウ - タ - | キ - カ - ソ - _ - | イ - イ - ウ - タ - | キ - カ - ソ - _ - |

    /* 第二行 (m.5-8) */
    | 3 - 4 3 2 - 3 - | 5 - 6 - 5 - 0 - | 3 - 4 3 2 - 1 - | 2 - 3 - 1 - 0 - |
    L| サ - ク - ラ - ノ - | ハ - ナ - ノ - _ - | イ - イ - ウ - タ - | キ - カ - ソ - _ - |

    /* 第三行 (m.9-12) */
    | 5 - 6 5 5 - 6 5 | 5 - 6 5 5 - 0 - | 5 - 6 5 3 - 5 - | 1 - 2 - 3 - 0 - |
    L| コ - ト - リ - ノ - | ウ - タ - ノ - _ - | イ - イ - ウ - タ - | キ - カ - ソ - _ - |

    /* 第四行 (m.13-16) */
    | 2 - 3 2 2 - 3 2 | 2 - 3 2 1 - 0 - | 2 - 3 2 1 - 2 1 | 2 - 6 - 5 - 0 - |
    L| サ - ク - ラ - ノ - | ウ - タ - ハ - _ - | ド - ノ - コ - ニ - | キ - カ - ソ - _ - |

    /* 第五行 (m.17-20) */
    | 5 - 6 5 3 - 5 - | 1 - 2 - 3 - 0 - | 2 - 3 2 1 - 2 - | 6_ - 1 - 2 - 0 - |
    L| コ - ト - リ - ノ - | ウ - タ - ハ - _ - | ド - ノ - コ - ニ - | キ - カ - ソ - _ - |

    /* 第六行 (m.21-24) */
    | 3 - 4 3 2 - 3 - | 5 - 6 - 5 - 0 - | 3 - 4 3 2 - 1 - | 2 - 3 - 1 - 0 - |
    L| ア - シ - タ - ノ - | ア - サ - ハ - _ - | コ - ノ - コ - ニ - | キ - カ - ソ - _ - |
}

Main:PianoLH@|0|{
    <8*>
    | 1_ - [1] - 1_ - [1] - | 1_ - 5__ - 1_ - 0 - | 5__ - [5_] - 5__ - [5_] - | 6__ - 1_ - 5__ - 0 - |
    | 1_ - [5_] - 5__ - [1] - | 1_ - 4_ - 1_ - 0 - | 1_ - [5_] - 5__ - 1_ - | 5__ - 1_ - 1_ - 0 - |
    | 1_ - [1] - 1_ - [1] - | 1_ - [1] - 1_ - 0 - | 1_ - [1] - 1_ - [1] - | 1_ - 5__ - 1_ - 0 - |
    | 5__ - [5_] - 5__ - [5_] - | 5__ - [5_] - 1_ - 0 - | 5__ - [5_] - 1_ - [1] - | 2_ - 2_ - 5__ - 0 - |
    | 1_ - [1] - 1_ - [1] - | 1_ - 5__ - 1_ - 0 - | 5__ - [5_] - 5__ - [5_] - | 6__ - 1_ - 5__ - 0 - |
    | 1_ - [5_] - 5__ - [1] - | 1_ - 4_ - 1_ - 0 - | 1_ - [5_] - 5__ - 1_ - | 5__ - 1_ - 1_ - 0 - |
}

-> Main -> #
