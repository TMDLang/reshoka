/* =========================================================================
   【曲目說明與出處考證】
   ・出處：臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年／1935，國臺圖 0725 148）第二學年第 8 首，原書第 51 頁（P079.jpg）。
   ・出處考證：本曲原出大正 11 年（1922）童謠雜誌《金の星》，野口雨情作詞、中山晉平作曲，為日本童謠史上最著名名作之一（後入選日本歌百選）。雨情以悼念夭折長女之深情，寫下純真而帶哀婉的口語童謠。
   ・調性與拍號：ニ長調（D 大調），2/4 拍，速度 != 108。

   【歌詞全文】
   （第一遍）
   シャボンタマ　トンダ
   ヤネマデ　トンダ
   ヤネマデ　トンデ
   コハレテ　キエタ

   （第二遍）
   シャボンタマ　キエタ
   トバズニ　キエタ
   ウマレテ　スグニ
   コハレテ　キエタ

   （結句）
   カゼ　カゼ　フクナ
   シャボンダマ　トバソ
   ========================================================================= */

ShabondamaA:Vocal@|0|{
    <16*>
    | 5_ - 1 1 1 - 2 - | 3 - 5 - 5 - 0 - | 6 - 4 - 1^ - 6 - | 5 - 6 - 5 - 0 - |
    L1| シャ - ボ ン タ - マ - | ト - ン - ダ - 0 - | ヤ - ネ - マ - デ - | ト - ン - ダ - 0 - |
    L2| シャ - ボ ン タ - マ - | キ - エ - タ - 0 - | ト - バ - ズ - ニ - | キ - エ - タ - 0 - |

    | 3 - 3 - 2 - 1 - | 2 - 5 - 5 - 0 - | 6 - 6 - 5 - 1 - | 3 - 2 - 1 - 0 - |
    L1| ヤ - ネ - マ - デ - | ト - ン - デ - 0 - | コ - ハ - レ - テ - | キ - エ - タ - 0 - |
    L2| ウ - マ - レ - テ - | ス - グ - ニ - 0 - | コ - ハ - レ - テ - | キ - エ - タ - 0 - |
}

