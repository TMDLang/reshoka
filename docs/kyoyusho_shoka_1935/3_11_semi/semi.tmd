    L1| ミ - - ン ミ - ン - | ナ - - ク セ - ミ - | ナ - - ン ト - ナ - | ク - - - - - _ - |
    L2| み - - ん み - ん - | な - - く せ - み - | な - - ん と - な - | く - - - - - _ - |

    /* 第三行 (m.9–11) */
