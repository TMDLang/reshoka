** あの町この町（鋼琴伴奏譜） **
!= 96
?= F
<2/4>
~ "臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年，索書號 0725 148）"
~ "出處：大正13年（1924）童謠繪本《コドモノクニ》，野口雨情作詞、中山晉平作曲之大正新童謠黃金代表作"
~ "詞：野口雨情"
~ "曲：中山晉平"

/* 原譜未標速度，演奏速度（!= 96）為編者設定。

   出處考證：本曲原出大正 13 年（1924）婦人之友社《コドモノクニ》，野口雨情作詞、中山晉平作曲。描寫黃昏降臨時小鎮點燈、歸家雀鳥與溫馨童年，為日本童謠黃金期傳世代表作。
*/

Main:PianoRH@|0|{
    <16*>
    /* 第一行 (m.1–4) */
    | 6_ - 6_ - 6_ - 5_ - | 6_ - 1 - 2 - 1 - | 2 - 3 - 5 - 6 - | 5 - - - - - 0 - |
    L1| ア - ノ - マ - チ - | コ - ノ - マ - チ - | ヒ - ガ - ク - レ - | ル - - - - - _ - |
    L2| お - い - へ - が - | だ - ん - だ - ん - | と - お - く - な - | る - - - - - _ - |
    /* 第二行 (m.5–8) */
    | 3 - 5 - 6 - 6 - | 6 - - - - - 0 - | 6 - 6 - 5 - 3 - | 2 - 2 - 5 - 3 - |
    L1| ヒ - ガ - ク - レ - | ル - - - - - _ - | イ - マ - キ - タ - | コ - ノ - ミ - チ - |
    L2| と - お - く - な - | る - - - - - _ - | い - ま - き - た - | こ - の - み - ち - |
    /* 第三行 (m.9–12) */
    | 2 - 2 - 3 - 2 1 | 6_ - - - - - 1 - | 2 - 2 - 3 - 2 1 | 6_ - - - - - 0 - |
    L1| カ - エ - リヤ - ン - | セ - - - - - - - | カ - エ - リヤ - ン - | セ - - - - - _ - |
    L2| か - え - りや - ん - | せ - - - - - - - | か - え - りや - ん - | せ - - - - - _ - |
}

Main:PianoLH@|0|{
    <8*>
    | 6__ - 5__ - | 6__ - 1_ - | 1_ - [1] - | 1_ - [1] 0 |
    | 1_ - 6__ - | 6__ - [6_m] 0 | 6__ - [1] - | 2__ - [1] - |
    | 2__ - 1_ - | 6__ - [6_m] - | 2__ - 1_ - | 6__ - [6_m] 0 |
}

