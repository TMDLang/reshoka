** アイウエオ（鋼琴伴奏譜） **
!= 104
?= E,
<2/4>
~ "詞：吉村繁"
~ "曲：岩田泉"
~ "臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年，索書號 0725 148）"

/* 原譜未標速度，演奏速度 != 104 為編者設定；全曲五段通譜隨段落變換拍號（2/4 ➔ 4/4 ➔ 2/4 ➔ 4/4 ➔ 3/4）。 */

Main:PianoRH@|0|{
    <8*>
    /* 第一段：第一行 (m.1–4, P260.jpg, 2/4 拍) */
    | 5 6 6 5 | 3 5 5 3 | 1 - 2 - | 3 3 5 - |
    L| い ま ま で | し ら な い | ア - イ - | ウ エ オ - |

    /* 第一段：第二行 (m.5–8, P260.jpg, 2/4 拍) */
    | 6 6 - 5 | 3 3 3 1 | 2 - 5 - | 3 2 1 - |
    L| な らつ - つ | て が み が | カ - キ - | ク ケ コ - |

    /* 第二段：第三行 (m.9–12, P260.jpg, 4/4 拍) */
    | {<4/4>} 2 - - 2 1 - 2 - | 3 - 5 - 2 - 0 - | 3 - - 2 1 - 2 - | 3 - - - - - 0 - |
    L| あ - - さ ひ - が - | つ - よ - く - _ - | サ - - シ ス - セ - | ソ - - - - - _ - |

    /* 第二段：第四行 (m.13–16, P260.jpg, 4/4 拍) */
    | 5 - - 5 6 - 6 - | 2 - 2 3 4 - 0 - | 5 - 5 - 2 - 2 - | 1 - - - - - 0 - |
    L| く - - は ふ - り - | た - ん ぼ に - _ - | タ - チ - ツ - テ - | ト - - - - - _ - |

    /* 第三段：第五行 (m.17–20, P260.jpg, 2/4 拍) */
    | {<2/4>} 2 2 2 1 | 6_ 6_ 6_ - | 5_ 5_ 1 2 | 3 - 0 - |
    L| あ つ さ も | な に も - | ナ ニ ヌ ネ | ノ - _ - |

    /* 第三段：第六行 (m.21–24, P260.jpg, m.21–22 為 2/4 拍，m.23–24 變拍為 4/4 拍) */
    | 5 5 3 2 | 1 2 3 3 | {<4/4>} 5 - 5 - 5 - 5 - | 1 - - - - - 0 - |
    L| あ を た の | く さ と り | ハ - ヒ - フ - ヘ - | ホ - - - - - _ - |

    /* 第四段：第七行 (m.25–28, P261.jpg, 4/4 拍) */
    | 5 - - 5 1^ - 1^ - | 5 - 5 6 5 - 0 - | 3 - - 5 5 - 6 - | 5 - - - - - 0 - |
    L| つ - - き は - - - | まん - ま - る - _ - | マ - - ミ ム - メ - | モ - - - - - _ - |

    /* 第四段：第八行 (m.29–32, P261.jpg, 4/4 拍) */
    | 6 - - 6 5 - 3 - | 1 - - 2 3 - 3 - | 6 - 5 - 2 - 2 - | 1 - - - - - 0 - |
    L| べ - - ん きや - う - | や - - す ま - ず - | ヤ - イ - ユ - エ - | ヨ - - - - - _ - |

    /* 第五段：第九行 (m.33–36, P261.jpg, 3/4 拍) */
    | {<3/4>} 1 2 3 - 5 - | 5 6 5 - 3 - | 1^ 1^ 1^ - 6 - | 5 - - - 0 - |
    L| こ - く - ご - | は な せ - る - | ラ リ ル - レ - | ロ - - - _ - |

    /* 第五段：第十行 (m.37–40, P261.jpg, 3/4 拍) */
    | 1^ 1^ 6 - 5 - | 6 6 5 - 3 - | 5 - 5 - 2 2 | 1 - - - 0 - |
    L| こ く ご - が - | わ か つ - て - | ワ - ヰ - ウ ヱ | ヲ - - - _ - |
}

Main:PianoLH@|0|{
    <4*>
    /* 第一段：2/4 拍 */
    | 1_ 4_ | 1_ [1_] | 1_ 5__ | 1_ [1_] |
    | 6__ 4_ | 1_ [1_] | 5__ [5__7] | 1_ [1_] |

    /* 第二段：4/4 拍 */
    | {<4/4>} 5__ [5__] 1_ 5__ | 1_ [1_] 5__ 0 | 1_ [1_] 1_ 5__ | 1_ [1_] 1_ 0 |
    | 1_ [1_] 6__ [6__m] | 2_ 1_ 4_ 0 | 1_ [1_] 5__ [5__7] | 1_ [1_] 1_ 0 |

    /* 第三段：2/4 拍 ➔ 4/4 拍 */
    | {<2/4>} 5__ 1_ | 6__ [6__m] | 5__ 5__ | 1_ 0 |
    | 1_ [1_] | 1_ [1_] | {<4/4>} 5__ [5__] 5__ [5__7] | 1_ [1_] 1_ 0 |

    /* 第四段：4/4 拍 */
    | 1_ [1_] 1_ [1_] | 1_ [1_] 1_ 0 | 1_ [1_] 1_ 4_ | 1_ [1_] 1_ 0 |
    | 4_ [4_] 1_ [1_] | 1_ 5__ 1_ [1_] | 4_ 1_ 5__ [5__7] | 1_ [1_] 1_ 0 |

    /* 第五段：3/4 拍 */
    | {<3/4>} 1_ [1_] [1_] | 1_ [1_] [1_] | 1_ [1_] 4_ | 1_ [1_] 0 |
    | 1_ 4_ 1_ | 4_ 1_ [1_] | 5__ [5__] [5__7] | 1_ [1_] 0 |
}

