A:PianoLH@|0|{
    <4*>
    /* m.1-4 */
    | 1_ [1] 1_ [1] | 1_ [1] 5__ [1] | 1_ [1] 1_ [1] | 1_ [1] 6__ [6_m] |
    /* m.5-8 */
    | 4_ 1_ 5__ [1] | 4_ [4] 2_ 0 | 2_ 1_ 5__ [1] | 5__ 2_ 1_ [1] |
    /* m.9-12 */
    | 1_ [1] 4_ [4] | 1_ [1] 5__ [1] | 1_ [1] 5__ [1] | 1_ [1] 5__ [5_] |
    /* m.13-16 */
    | 1_ [1] 4_ [4] | 1_ [1] 5__ 0 | 1_ [1] 1_ [1] | 5__ [5_] 1_ [1] |
    /* m.17-20 */
