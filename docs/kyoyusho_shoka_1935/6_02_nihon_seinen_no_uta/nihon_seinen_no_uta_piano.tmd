}

End12:PianoRH@|0|{
    <16*>
    | 1^ - - - - - - - - - - - 0 - - - |
    L1| ヲ - - - - - - - - - - - _ - - - |
    L2| を - - - - - - - - - - - _ - - - |
}

End12:PianoLH@|0|{
    <4*>
    | 1_ [1] 1_ 0 |
}

End3:PianoRH@|0|{
    <16*>
    | 1^ - - - - - - - - - - - - - - - |
    L| ヲ - - - - - - - - - - - - - - - |
}

