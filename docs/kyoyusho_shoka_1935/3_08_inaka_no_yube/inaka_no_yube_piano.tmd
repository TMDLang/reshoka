** 田舍の夕（鋼琴伴奏譜） **
!= 92
?= E,
<4/4>
~ "臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年，索書號 0725 148）"

/* 原譜拍號印 C（4/4 拍）；原譜未標速度，演奏速度（!= 92）為編者設定。 */

Main:PianoRH@|0|{
    <8*>
    /* 第一行 (m.1–4) */
    | 5 - - 6 5 - 3 1 | 3 - 2 1 2 - - - | 1 - 2 3 4 - 3 2 | 5 - - - - - 0 - |
    L| ユ - - ラ ユ - ラ - | ユ - リ - ノ - - - | ハ - ナ - ユ - レ - | テ - - - - - _ - |

    /* 第二行 (m.5–8) */
    | 6 - - - 5 - 3 2 | 1 - 6_ 5_ 6_ - 1 - | 2 - - 2 2 - 4 - | 3 - - - - - 0 - |
    L| ヤ - - - マ - ノ - | ホ - ソ - ミ - チ - | ヒ - - ガ ク - レ - | ル - - - - - _ - |

    /* 第三行 (m.9–12) */
    | 6_ - - - 6_ - 5_ - | 5_ - - 1 2 - 3 - | 5 - - 6 5 - 3 1 | 2 - - - - - 0 - |
    L| ク - - - レ - ル - | ミ - - ソ ラ - ニ - | ツ - - キ ガ - デ - | テ - - - - - _ - |

    /* 第四行 (m.13–16) */
    | 6 - - 6 5 - 3 2 | 1 - 6_ 5_ 6_ - 1 - | 2 - - 2 2 - 3 - | 1 - - - - - 0 - |
    L| ワ - - タ シ - ノ - | カ - - - ゲ - ガ - | チ - - ニ ウ - ツ - | ル - - - - - _ - |
}

Main:PianoLH@|0|{
    <4*>
    | 1_ [1] 1_ [1] | 1_ [1] 5__ [5_] | 1_ [1] 2_ [5_] | 1_ [1] 1_ 0 |
    | 4__ [4_] 1_ [1] | 6__ [6_m] 4__ [4_] | 5__ [5_] 5__ [5_7] | 1_ [1] 1_ 0 |
    | 4__ [4_] 6__ [6_m] | 5__ [1] 5__ [1] | 1_ [1] 1_ [1] | 5__ [5_] 5__ 0 |
