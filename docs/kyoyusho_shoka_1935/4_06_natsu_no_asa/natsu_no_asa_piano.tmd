::SCORE::
** 夏の朝（鋼琴伴奏譜） **
!= 100
?= D
<4/4>
~ "詞：葛原しげる"
~ "曲：小松耕輔"
~ "臺灣總督府警務局《教育所用 唱歌教材集》（昭和十年，索書號 0725 148）"

/* （原譜未標速度，演奏速度為編者設定） */

Main:PianoRH@|0|{
    <8*>
    /* 第一行 (m.1-4) */
    | 3 - 5 - 1^ - 7 6 | 5 - 6 - 3 - - - | 5 - 5 - 6 - 1 - | 3 - 5 - 2 - - - |
    L1| オ - ニ - ハ - ノ - | ク - サ - ニ - - - | カ - キ - ネ - ノ - | エ - ダ - ニ - - - |
    L2| ひ - の - で - ぬ - | う - ち - に - - - | あ - さ - お - き - | し - て - は - - - |

    /* 第二行 (m.5-8) */
    | 3 - 5 - 1^ - 7 6 | 5 - 6 - 2 - - - | 2 - 5 - 2 - 2 1 | 2 - 2 - 1 - - - |
    L1| ア - レ - ア - レ - | ヒ - カ - ル - - - | キ - ラ - キ - ラ - | ツ - ユ - ガ - - - |
    L2| か - ほ - を - ば - | あ - ら - ふ - - - | く - さ - ば - の - | つ - ゆ - が - - - |

    /* 第三行 (m.9-12) */
    | 1^ - - 1^ 1^ - 7 6 | 5 - 3 5 6 - - - | 5 - 6 - 3 - 2 1 | 3 - 2 - 1 - - - |
    L1| ダ - - イ ヤ - ノ - | タ - マ - カ - - - | ル - ビ - イ - ノ - | タ - マ - カ - - - |
    L2| お - - に は - の - | こ - と - り - - - | か - き - ね - の - | こ - と - り - - - |
}

Main:PianoLH@|0|{
    <8*>
    | 1_ - [1] - 4__ - 4_ - | 1_ - 4__ - 1_ - [1] - | 1_ - [1] - 4__ - 1_ - | 1_ - [1] - 5__ - [5_] - |
    | 1_ - [1] - 4__ - 4_ - | 1_ - 4__ - 5__ - [5_] - | 5__ - [5_] - 5__ - 5_ - | 5__ - [5_] - 1_ - [1] - |
    | 1_ - [1] - 4__ - 4_ - | 1_ - [1] - 4__ - [4_] - | 1_ - 4__ - 1_ - 1_ - | 1_ - 5__ - 1_ - [1] - |
}

-> Main[L1] -> Main[L2] -> #
